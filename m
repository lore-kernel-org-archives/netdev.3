+/**
+ * @get_mpath: get a mesh path for the given parameters
+ */
+static int rwnx_cfg80211_get_mpath(struct wiphy *wiphy, struct net_device =
*dev,
+				   u8 *dst, u8 *next_hop,
+				   struct mpath_info *pinfo)
+{
+	struct rwnx_vif *rwnx_vif =3D netdev_priv(dev);
+	struct rwnx_mesh_path *mesh_path =3D NULL;
+	struct rwnx_mesh_path *cur;
+
+	if (RWNX_VIF_TYPE(rwnx_vif) !=3D NL80211_IFTYPE_MESH_POINT)
+		return -EOPNOTSUPP;
+
+	list_for_each_entry(cur, &rwnx_vif->ap.mpath_list, list) {
+		/*
+		 * Compare the path target address and the provided destination address
+		 */
+		if (memcmp(dst, &cur->tgt_mac_addr, ETH_ALEN))
+			continue;
+
+		mesh_path =3D cur;
+		break;
+	}
+
+	if (!mesh_path)
+		return -ENOENT;
+
+	/* Copy next HOP MAC address */
+	if (mesh_path->p_nhop_sta)
+		memcpy(next_hop, &mesh_path->p_nhop_sta->mac_addr, ETH_ALEN);
+
+	/* Fill path information */
+	pinfo->filled =3D 0;
+	pinfo->generation =3D rwnx_vif->ap.generation;
+
+	return 0;
+}
