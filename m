+static u8 *rwnx_ie_build_ht_oper(struct rwnx_hw *rwnx_hw,
+				 struct rwnx_vif *rwnx_vif, u8 *pos,
+				 struct ieee80211_sta_ht_cap *ht_cap,
+				 u16 prot_mode)
+{
+	struct ieee80211_ht_operation *ht_oper;
+	/* Build HT Information */
+	*pos++ =3D WLAN_EID_HT_OPERATION;
+	*pos++ =3D sizeof(struct ieee80211_ht_operation);
+	ht_oper =3D (struct ieee80211_ht_operation *)pos;
+	ht_oper->primary_chan =3D
+		ieee80211_frequency_to_channel(rwnx_vif->sta.ap->center_freq);
+	switch (rwnx_vif->sta.ap->width) {
+	case NL80211_CHAN_WIDTH_160:
+	case NL80211_CHAN_WIDTH_80P80:
+	case NL80211_CHAN_WIDTH_80:
+	case NL80211_CHAN_WIDTH_40:
+		if (rwnx_vif->sta.ap->center_freq1 > rwnx_vif->sta.ap->center_freq)
+			ht_oper->ht_param =3D IEEE80211_HT_PARAM_CHA_SEC_ABOVE;
+		else
+			ht_oper->ht_param =3D IEEE80211_HT_PARAM_CHA_SEC_BELOW;
+		break;
+	default:
+		ht_oper->ht_param =3D IEEE80211_HT_PARAM_CHA_SEC_NONE;
+		break;
+	}
+	if (ht_cap->cap & IEEE80211_HT_CAP_SUP_WIDTH_20_40 &&
+	    rwnx_vif->sta.ap->width !=3D NL80211_CHAN_WIDTH_20_NOHT &&
+	    rwnx_vif->sta.ap->width !=3D NL80211_CHAN_WIDTH_20)
+		ht_oper->ht_param |=3D IEEE80211_HT_PARAM_CHAN_WIDTH_ANY;
+
+	ht_oper->operation_mode =3D cpu_to_le16(prot_mode);
+	ht_oper->stbc_param =3D 0x0000;
+
+	/* It seems that Basic MCS set and Supported MCS set
+	 * are identical for the first 10 bytes
+	 */
+	memset(&ht_oper->basic_set, 0, 16);
+	memcpy(&ht_oper->basic_set, &ht_cap->mcs, 10);
+
+	return pos + sizeof(struct ieee80211_ht_operation);
+}
+
+static u8 *rwnx_ie_build_vht_oper(struct rwnx_hw *rwnx_hw,
+				  struct rwnx_vif *rwnx_vif, u8 *pos,
+				  struct ieee80211_sta_ht_cap *ht_cap,
+				  u16 prot_mode)
+{
+	struct ieee80211_vht_operation *vht_oper;
+	/* Build HT Information */
+	*pos++ =3D WLAN_EID_VHT_OPERATION;
+	*pos++ =3D sizeof(struct ieee80211_vht_operation);
+	vht_oper =3D (struct ieee80211_vht_operation *)pos;
+
+	switch (rwnx_vif->sta.ap->width) {
+	case NL80211_CHAN_WIDTH_80:
+		vht_oper->chan_width =3D IEEE80211_VHT_CHANWIDTH_80MHZ; // Channel Width
+		CCFS0(vht_oper) =3D ieee80211_frequency_to_channel
+				(rwnx_vif->sta.ap->center_freq);
+				// Channel Center Frequency Segment 0
+		CCFS1(vht_oper) =3D 0;    // Channel Center Frequency Segment 1 (N.A.)
+		break;
+	case NL80211_CHAN_WIDTH_160:
+		vht_oper->chan_width =3D IEEE80211_VHT_CHANWIDTH_160MHZ; // Channel Widt=
h
+		CCFS0(vht_oper) =3D ieee80211_frequency_to_channel
+				(rwnx_vif->sta.ap->center_freq);
+				// Channel Center Frequency Segment 0
+		CCFS1(vht_oper) =3D 0;    // Channel Center Frequency Segment 1 (N.A.)
+		break;
+	case NL80211_CHAN_WIDTH_80P80:
+		vht_oper->chan_width =3D
+			IEEE80211_VHT_CHANWIDTH_80P80MHZ; // Channel Width
+		CCFS0(vht_oper) =3D ieee80211_frequency_to_channel
+				(rwnx_vif->sta.ap->center_freq1);
+				// Channel Center Frequency Segment 0
+		CCFS1(vht_oper) =3D ieee80211_frequency_to_channel
+				(rwnx_vif->sta.ap->center_freq2);
+				// Channel Center Frequency Segment 1
+		break;
+	default:
+		vht_oper->chan_width =3D IEEE80211_VHT_CHANWIDTH_USE_HT;
+		CCFS0(vht_oper) =3D 0;
+		CCFS1(vht_oper) =3D 0;
+		break;
+	}
+
+	vht_oper->basic_mcs_set =3D cpu_to_le16(rwnx_hw->mod_params->mcs_map);
+
+	return pos + sizeof(struct ieee80211_vht_operation);
+}
