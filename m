+static int aic_load_firmware(u32 **fw_buf, char *fw_path, const char *name=
,
+			     struct device *device)
+{
+#ifdef CONFIG_USE_FW_REQUEST
+	const struct firmware *fw =3D NULL;
+	u32 *dst =3D NULL;
+	void *buffer =3D NULL;
+	MD5_CTX md5;
+	unsigned char decrypt[16];
+	int size =3D 0;
+	int ret =3D 0;
+
+	AICWFDBG(LOGINFO, "%s: request firmware =3D %s\n", __func__, name);
+
+	ret =3D request_firmware(&fw, name, NULL);
+
+	if (ret < 0) {
+		AICWFDBG(LOGERROR, "Load %s fail\n", name);
+		release_firmware(fw);
+		return -1;
+	}
+
+	size =3D fw->size;
+	dst =3D (u32 *)fw->data;
+
+	if (size <=3D 0) {
+		AICWFDBG(LOGERROR, "wrong size of firmware file\n");
+		release_firmware(fw);
+		return -1;
+	}
+
+	buffer =3D vmalloc(size);
+	memset(buffer, 0, size);
+	memcpy(buffer, dst, size);
+
+	*fw_buf =3D buffer;
+
+	md5_init(&md5);
+	md5_update(&md5, (unsigned char *)buffer, size);
+	md5_final(&md5, decrypt);
+	AICWFDBG(LOGINFO, MD5PINRT, decrypt[0], decrypt[1], decrypt[2], decrypt[3=
], decrypt[4],
+		 decrypt[5], decrypt[6], decrypt[7], decrypt[8], decrypt[9], decrypt[10]=
,
+		 decrypt[11], decrypt[12], decrypt[13], decrypt[14], decrypt[15]);
+
+	release_firmware(fw);
+
+	return size;
+#else
+	void *buffer =3D NULL;
+	char *path =3D NULL;
+	struct file *fp =3D NULL;
+	int size =3D 0, len =3D 0; //, i=3D0;
+	ssize_t rdlen =3D 0;
+	// u32 *src=3DNULL, *dst =3D NULL;
+
+	/* get the firmware path */
+	path =3D __getname();
+	if (!path) {
+		*fw_buf =3D NULL;
+		return -1;
+	}
+
+	len =3D sprintf(path, "%s/%s", fw_path, name);
+
+	AICWFDBG(LOGINFO, "%s :firmware path =3D %s\n", __func__, path);
+
+	/* open the firmware file */
+	fp =3D filp_open(path, O_RDONLY, 0);
+	if (IS_ERR(fp) || !fp) {
+		AICWFDBG(LOGDEBUG, "AICWF %s: %s file failed to open\n", __func__, name)=
;
+		if (IS_ERR(fp))
+			AICWFDBG(LOGDEBUG, "AICWF is_Err\n");
+		if (!fp)
+			AICWFDBG(LOGDEBUG, "AICWF null\n");
+		*fw_buf =3D NULL;
+		__putname(path);
+		fp =3D NULL;
+		return -1;
+	}
+
+	size =3D i_size_read(file_inode(fp));
+	if (size <=3D 0) {
+		AICWFDBG(LOGDEBUG, "AICWF %s: %s file size invalid %d\n", __func__, name=
, size);
+		*fw_buf =3D NULL;
+		__putname(path);
+		filp_close(fp, NULL);
+		fp =3D NULL;
+		return -1;
+	}
+
+	/* start to read from firmware file */
+	buffer =3D vmalloc(size);
+	memset(buffer, 0, size);
+	if (!buffer) {
+		*fw_buf =3D NULL;
+		__putname(path);
+		filp_close(fp, NULL);
+		fp =3D NULL;
+		return -1;
+	}
+
+	rdlen =3D kernel_read(fp, buffer, size, &fp->f_pos);
+
+	if (size !=3D rdlen) {
+		AICWFDBG(LOGDEBUG, "AICWF %s: %s file rdlen invalid %d %d\n",
+			 __func__, name, (int)rdlen, size);
+		*fw_buf =3D NULL;
+		__putname(path);
+		filp_close(fp, NULL);
+		fp =3D NULL;
+		vfree(buffer);
+		buffer =3D NULL;
+		return -1;
+	}
+	if (rdlen > 0)
+		fp->f_pos +=3D rdlen;
+
+	__putname(path);
+	filp_close(fp, NULL);
+	fp =3D NULL;
+	// vfree(buffer);
+	// buffer=3DNULL;
+	*fw_buf =3D (u32 *)buffer;
+
+	return size;
+#endif
+}
