+bool key_flag;
+/**
+ * @add_key: add a key with the given parameters. @mac_addr will be %NULL
+ *	when adding a group key.
+ */
+static int rwnx_cfg80211_add_key(struct wiphy *wiphy, struct net_device *n=
etdev,
+				 int link_id,
+				 u8 key_index, bool pairwise,
+				 const u8 *mac_addr, struct key_params *params)
+{
+	struct rwnx_hw *rwnx_hw =3D wiphy_priv(wiphy);
+	struct rwnx_vif *vif =3D netdev_priv(netdev);
+	int i, error =3D 0;
+	struct mm_key_add_cfm key_add_cfm;
+	u8_l cipher =3D 0;
+	struct rwnx_sta *sta =3D NULL;
+	struct rwnx_key *rwnx_key;
+
+	RWNX_DBG(RWNX_FN_ENTRY_STR);
+
+	if (mac_addr) {
+		sta =3D rwnx_get_sta(rwnx_hw, mac_addr);
+		if (!sta)
+			return -EINVAL;
+		rwnx_key =3D &sta->key;
+		if (vif->wdev.iftype =3D=3D NL80211_IFTYPE_STATION ||
+		    vif->wdev.iftype =3D=3D NL80211_IFTYPE_P2P_CLIENT)
+			vif->sta.paired_cipher_type =3D params->cipher;
+	} else {
+		rwnx_key =3D &vif->key[key_index];
+		vif->key_has_add =3D 1;
+		if (vif->wdev.iftype =3D=3D NL80211_IFTYPE_STATION ||
+		    vif->wdev.iftype =3D=3D NL80211_IFTYPE_P2P_CLIENT)
+			vif->sta.group_cipher_type =3D params->cipher;
+	}
+
+	/* Retrieve the cipher suite selector */
+	switch (params->cipher) {
+	case WLAN_CIPHER_SUITE_WEP40:
+		cipher =3D MAC_CIPHER_WEP40;
+		break;
+	case WLAN_CIPHER_SUITE_WEP104:
+		cipher =3D MAC_CIPHER_WEP104;
+		break;
+	case WLAN_CIPHER_SUITE_TKIP:
+		cipher =3D MAC_CIPHER_TKIP;
+		break;
+	case WLAN_CIPHER_SUITE_CCMP:
+		cipher =3D MAC_CIPHER_CCMP;
+		break;
+	case WLAN_CIPHER_SUITE_AES_CMAC:
+		cipher =3D MAC_CIPHER_BIP_CMAC_128;
+		break;
+	case WLAN_CIPHER_SUITE_SMS4: {
+		// Need to reverse key order
+		u8 tmp, *key =3D (u8 *)params->key;
+
+		cipher =3D MAC_CIPHER_WPI_SMS4;
+		for (i =3D 0; i < WPI_SUBKEY_LEN / 2; i++) {
+			tmp =3D key[i];
+			key[i] =3D key[WPI_SUBKEY_LEN - 1 - i];
+			key[WPI_SUBKEY_LEN - 1 - i] =3D tmp;
+		}
+		for (i =3D 0; i < WPI_SUBKEY_LEN / 2; i++) {
+			tmp =3D key[i + WPI_SUBKEY_LEN];
+			key[i + WPI_SUBKEY_LEN] =3D key[WPI_KEY_LEN - 1 - i];
+			key[WPI_KEY_LEN - 1 - i] =3D tmp;
+		}
+		break;
+	}
+	default:
+		return -EINVAL;
+	}
+
+	key_flag =3D false;
+	error =3D rwnx_send_key_add(rwnx_hw, vif->vif_index,
+				  (sta ? sta->sta_idx : 0xFF), pairwise,
+				  (u8 *)params->key, params->key_len,
+				  key_index, cipher, &key_add_cfm);
+	if (error)
+		return error;
+
+	if (key_add_cfm.status !=3D 0) {
+		RWNX_PRINT_CFM_ERR(key_add);
+		return -EIO;
+	}
+
+	/* Save the index retrieved from LMAC */
+	rwnx_key->hw_idx =3D key_add_cfm.hw_key_idx;
+
+	return 0;
+}
