+/*********************************************************************
+ * Cfg80211 callbacks (and helper)
+ *********************************************************************/
+static struct wireless_dev *
+rwnx_virtual_interface_add(struct rwnx_hw *rwnx_hw, const char *name,
+			   unsigned char name_assign_type,
+			   enum nl80211_iftype type, struct vif_params *params)
+{
+	struct wireless_dev *wdev =3D NULL;
+	struct rwnx_vif *vif;
+	int min_idx, max_idx;
+	int vif_idx =3D -1;
+	int i;
+
+	AICWFDBG(LOGDEBUG, "AICWF %s: %d, %s\n", __func__, type, name);
+
+	if (type =3D=3D NL80211_IFTYPE_AP_VLAN) {
+		min_idx =3D NX_VIRT_DEV_MAX;
+		max_idx =3D NX_VIRT_DEV_MAX + NX_REMOTE_STA_MAX;
+	} else {
+		min_idx =3D 0;
+		max_idx =3D NX_VIRT_DEV_MAX;
+	}
+
+	for (i =3D min_idx; i < max_idx; i++) {
+		if (rwnx_hw->avail_idx_map & BIT(i)) {
+			vif_idx =3D i;
+			break;
+		}
+	}
+
+	if (vif_idx < 0) {
+		AICWFDBG(LOGDEBUG, "AICWF virtual_interface_add %s fail\n", name);
+		return NULL;
+	}
+
+	vif =3D kzalloc(sizeof(*vif), GFP_KERNEL);
+	if (unlikely(!vif)) {
+		AICWFDBG(LOGDEBUG, "AICWF Could not allocate wireless device\n");
+		return NULL;
+	}
+	wdev =3D &vif->wdev;
+	wdev->wiphy =3D rwnx_hw->wiphy;
+	wdev->iftype =3D type;
+
+	AICWFDBG(LOGDEBUG,
+		 "AICWF %s, ifname=3D%s, wdev=3D%p, vif_idx=3D%d\n",
+		 __func__, name,
+		 wdev, vif_idx);
+
+#ifndef CONFIG_USE_P2P0
+	vif->is_p2p_vif =3D 1;
+	vif->rwnx_hw =3D rwnx_hw;
+	vif->vif_index =3D vif_idx;
+	vif->wdev.wiphy =3D rwnx_hw->wiphy;
+	vif->drv_vif_index =3D vif_idx;
+	vif->up =3D false;
+	vif->ch_index =3D RWNX_CH_NOT_SET;
+	memset(&vif->net_stats, 0, sizeof(vif->net_stats));
+	vif->use_4addr =3D false;
+
+	spin_lock_bh(&rwnx_hw->cb_lock);
+	list_add_tail(&vif->list, &rwnx_hw->vifs);
+	spin_unlock_bh(&rwnx_hw->cb_lock);
+
+	if (rwnx_hw->is_p2p_alive =3D=3D 0) {
+		timer_setup(&rwnx_hw->p2p_alive_timer, aicwf_p2p_alive_timeout, 0);
+		rwnx_hw->is_p2p_alive =3D 0;
+		rwnx_hw->is_p2p_connected =3D 0;
+		rwnx_hw->p2p_dev_vif =3D vif;
+		atomic_set(&rwnx_hw->p2p_alive_timer_count, 0);
+	}
+#endif
+	rwnx_hw->avail_idx_map &=3D ~BIT(vif_idx);
+
+	memcpy(vif->wdev.address, rwnx_hw->wiphy->perm_addr, ETH_ALEN);
+	vif->wdev.address[5] ^=3D vif_idx;
+	AICWFDBG(LOGDEBUG, "AICWF p2p dev addr=3D%x %x %x %x %x %x\n", vif->wdev.=
address[0],
+		 vif->wdev.address[1], vif->wdev.address[2], vif->wdev.address[3],
+		 vif->wdev.address[4], vif->wdev.address[5]);
+
+	return wdev;
+}
