+static void rwnx_tdls_add_link_ie(struct rwnx_hw *rwnx_hw,
+				  struct rwnx_vif *rwnx_vif,
+				  struct sk_buff *skb, const u8 *peer,
+				  bool initiator)
+{
+	struct ieee80211_tdls_lnkie *lnkid;
+	const u8 *init_addr, *rsp_addr;
+
+	if (initiator) {
+		init_addr =3D rwnx_hw->wiphy->perm_addr;
+		rsp_addr =3D peer;
+	} else {
+		init_addr =3D peer;
+		rsp_addr =3D rwnx_hw->wiphy->perm_addr;
+	}
+
+	lnkid =3D (void *)skb_put(skb, sizeof(struct ieee80211_tdls_lnkie));
+
+	lnkid->ie_type =3D WLAN_EID_LINK_ID;
+	lnkid->ie_len =3D sizeof(struct ieee80211_tdls_lnkie) - 2;
+
+	memcpy(lnkid->bssid, rwnx_vif->sta.ap->mac_addr, ETH_ALEN);
+	memcpy(lnkid->init_sta, init_addr, ETH_ALEN);
+	memcpy(lnkid->resp_sta, rsp_addr, ETH_ALEN);
+}
