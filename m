+static int aic_set_diag(struct hci_dev *hdev, bool enable)
+{
+	struct hci_uart *hu =3D hci_get_drvdata(hdev);
+	struct aic_data *aic =3D hu->priv;
+	struct sk_buff *skb;
+
+	if (!test_bit(HCI_RUNNING, &hdev->flags))
+		return -ENETDOWN;
+
+	skb =3D bt_skb_alloc(3, GFP_KERNEL);
+	if (!skb)
+		return -ENOMEM;
+
+	skb_put_u8(skb, AIC_LM_DIAG_PKT);
+	skb_put_u8(skb, 0xf0);
+	skb_put_u8(skb, enable);
+
+	skb_queue_tail(&aic->txq, skb);
+	aic_hci_uart_tx_wakeup(hu);
+
+	return 0;
+}
