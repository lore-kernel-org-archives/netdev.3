+struct reord_ctrl_info *reord_init_sta(struct aicwf_rx_priv *rx_priv,
+				       const u8 *mac_addr)
+{
+	u8 i =3D 0;
+	struct reord_ctrl *preorder_ctrl =3D NULL;
+	struct reord_ctrl_info *reord_info;
+#ifdef AICWF_SDIO_SUPPORT
+	struct aicwf_bus *bus_if =3D rx_priv->sdiodev->bus_if;
+#else
+	struct aicwf_bus *bus_if =3D rx_priv->usbdev->bus_if;
+#endif
+
+	if (bus_if->state =3D=3D BUS_DOWN_ST || !rx_priv) {
+		AICWFDBG(LOGERROR, "bad stat!\n");
+		return NULL;
+	}
+
+	AICWFDBG(LOGINFO, "%s:%pM\n", __func__, mac_addr);
+	reord_info =3D kmalloc(sizeof(*reord_info), GFP_ATOMIC);
+	if (!reord_info)
+		return NULL;
+
+	memcpy(reord_info->mac_addr, mac_addr, ETH_ALEN);
+	for (i =3D 0; i < 8; i++) {
+		preorder_ctrl =3D &reord_info->preorder_ctrl[i];
+		preorder_ctrl->enable =3D true;
+		preorder_ctrl->ind_sn =3D 0xffff;
+		preorder_ctrl->wsize_b =3D AICWF_REORDER_WINSIZE;
+		preorder_ctrl->rx_priv =3D rx_priv;
+		INIT_LIST_HEAD(&preorder_ctrl->reord_list);
+		spin_lock_init(&preorder_ctrl->reord_list_lock);
+		timer_setup(&preorder_ctrl->reord_timer, reord_timeout_handler, 0);
+		INIT_WORK(&preorder_ctrl->reord_timer_work, reord_timeout_worker);
+	}
+
+	return reord_info;
+}
