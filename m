+static void
+__mtk_wed_detach(struct mtk_wed_device *dev)
+{
+    struct mtk_wed_hw *hw = dev->hw;
+
+    airoha_wed_info(dev, "detach: wlan=%s running=%d init_done=%d\n",
+                   dev->wlan.pci_dev ? 
dev_name(&dev->wlan.pci_dev->dev) : "none",
+                   dev->running, dev->init_done);
