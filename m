+    if (ret) {
+        dev_err(priv->dev,
+            "failed to configure OMCI T-CONT %#x alloc-id %u: %d\n",
+            entity_id, alloc_id, ret);
+    } else if (valid) {
+        dev_info(priv->dev,
+             "OMCI T-CONT %#x enabled alloc-id %u channel %u\n",
+             entity_id, alloc_id, channel);
+    } else {
+        dev_info(priv->dev, "OMCI T-CONT %#x disabled channel %u\n",
+             entity_id, channel);
+    }
+    return ret;
+}
