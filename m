+	    interface_desc->bInterfaceSubClass !=3D 0xff ||
+		interface_desc->bInterfaceProtocol !=3D 0xff) {
+		usb_err("non WLAN interface %d: 0x%x:0x%x:0x%x\n",
+			interface_desc->bInterfaceNumber,
+				interface_desc->bInterfaceClass,
+				interface_desc->bInterfaceSubClass,
+				interface_desc->bInterfaceProtocol);
+		ret =3D -ENODEV;
+		goto exit;
+	}
+
+	for (i =3D 0; i < endpoints; i++) {
+		endpoint =3D &host_interface->endpoint[i].desc;
+		endpoint_num =3D usb_endpoint_num(endpoint);
+
+		if (usb_endpoint_dir_in(endpoint) && usb_endpoint_xfer_bulk(endpoint)) {
+			if (!usb_dev->bulk_in_pipe)
+				usb_dev->bulk_in_pipe =3D usb_rcvbulkpipe(usb, endpoint_num);
+		}
+
+		if (usb_endpoint_dir_out(endpoint) &&
+		    usb_endpoint_xfer_bulk(endpoint)) {
+			if (!usb_dev->bulk_out_pipe)
+				usb_dev->bulk_out_pipe =3D usb_sndbulkpipe(usb, endpoint_num);
+		}
+	}
+
+	if (usb_dev->bulk_in_pipe =3D=3D 0) {
+		usb_err("No RX (in) Bulk EP found\n");
+		ret =3D -ENODEV;
+		goto exit;
+	}
+	if (usb_dev->bulk_out_pipe =3D=3D 0) {
+		usb_err("No TX (out) Bulk EP found\n");
+		ret =3D -ENODEV;
+		goto exit;
+	}
+
+	if (usb->speed =3D=3D USB_SPEED_HIGH)
+		pr_info("Aic high speed USB device detected\n");
+	else
+		pr_info("Aic full speed USB device detected\n");
+
+exit:
+	return ret;
+}
+
+static struct aicwf_bus_ops aicwf_usb_bus_ops =3D {
+	.start =3D aicwf_usb_bus_start,
+	.stop =3D aicwf_usb_bus_stop,
+	.txdata =3D aicwf_usb_bus_txdata,
+	.txmsg =3D aicwf_usb_bus_txmsg,
+};
+
+static int aicwf_usb_probe(struct usb_interface *intf,
+			   const struct usb_device_id *id)
+{
+	int ret =3D 0;
+	struct usb_device *usb =3D interface_to_usbdev(intf);
+	struct aicwf_bus *bus_if;
+	struct device *dev =3D NULL;
+	struct aicwf_rx_priv *rx_priv =3D NULL;
+	struct aic_usb_dev *usb_dev =3D NULL;
+
+	usb_dev =3D kzalloc(sizeof(*usb_dev), GFP_ATOMIC);
+	if (!usb_dev)
+		return -ENOMEM;
+
+	usb_dev->udev =3D usb;
+	usb_dev->dev =3D &usb->dev;
+	usb_set_intfdata(intf, usb_dev);
+
+	ret =3D aicwf_parse_usb(usb_dev, intf);
+	if (ret) {
+		usb_err("aicwf_parse_usb err %d\n", ret);
+		goto out_free;
+	}
+
+	ret =3D aicwf_usb_init(usb_dev);
+	if (ret) {
+		usb_err("aicwf_usb_init err %d\n", ret);
+		goto out_free;
+	}
+
+	bus_if =3D kzalloc(sizeof(*bus_if), GFP_ATOMIC);
+	if (!bus_if) {
+		ret =3D -ENOMEM;
+		goto out_free_usb;
+	}
+
+	dev =3D usb_dev->dev;
+	bus_if->dev =3D dev;
+	usb_dev->bus_if =3D bus_if;
+	bus_if->bus_priv.usb =3D usb_dev;
+	dev_set_drvdata(dev, bus_if);
+
+	bus_if->ops =3D &aicwf_usb_bus_ops;
+
+	rx_priv =3D aicwf_rx_init(usb_dev);
+	if (!rx_priv) {
+		txrx_err("rx init failed\n");
+		ret =3D -1;
+		goto out_free_bus;
+	}
+	usb_dev->rx_priv =3D rx_priv;
+
+	ret =3D aicwf_bus_init(0, dev);
+	if (ret < 0) {
+		usb_err("aicwf_bus_init err %d\n", ret);
+		goto out_free_bus;
+	}
+
+	ret =3D aicwf_bus_start(bus_if);
+	if (ret < 0) {
+		usb_err("aicwf_bus_start err %d\n", ret);
+		goto out_free_bus;
+	}
+
+	aicwf_rwnx_usb_platform_init(usb_dev);
+	aicwf_hostif_ready();
+	return 0;
+
+out_free_bus:
+	aicwf_bus_deinit(dev);
+	kfree(bus_if);
+out_free_usb:
+	aicwf_usb_deinit(usb_dev);
+out_free:
+	usb_err("failed with errno %d\n", ret);
+	kfree(usb_dev);
+	usb_set_intfdata(intf, NULL);
+	return ret;
+}
+
+static void aicwf_usb_disconnect(struct usb_interface *intf)
+{
+	struct aic_usb_dev *usb_dev =3D (struct aic_usb_dev *)usb_get_intfdata(in=
tf);
+
+	if (!usb_dev)
+		return;
+
+	aicwf_bus_deinit(usb_dev->dev);
+	aicwf_usb_deinit(usb_dev);
+	rwnx_cmd_mgr_deinit(&usb_dev->cmd_mgr);
+
+	if (usb_dev->rx_priv)
+		aicwf_rx_deinit(usb_dev->rx_priv);
+	kfree(usb_dev->bus_if);
+	kfree(usb_dev);
+}
+
+static int aicwf_usb_suspend(struct usb_interface *intf, pm_message_t stat=
e)
+{
+	struct aic_usb_dev *usb_dev =3D (struct aic_usb_dev *)usb_get_intfdata(in=
tf);
+
+	aicwf_usb_state_change(usb_dev, USB_SLEEP_ST);
+	aicwf_bus_stop(usb_dev->bus_if);
+	return 0;
+}
+
+static int aicwf_usb_resume(struct usb_interface *intf)
+{
+	struct aic_usb_dev *usb_dev =3D (struct aic_usb_dev *)usb_get_intfdata(in=
tf);
+
+	if (usb_dev->state =3D=3D USB_UP_ST)
+		return 0;
+
+	aicwf_bus_start(usb_dev->bus_if);
+	return 0;
+}
+
+static int aicwf_usb_reset_resume(struct usb_interface *intf)
+{
+	return aicwf_usb_resume(intf);
+}
+
+static struct usb_device_id aicwf_usb_id_table[] =3D {
+#ifndef CONFIG_USB_BT
+	{USB_DEVICE(USB_VENDOR_ID_AIC, USB_PRODUCT_ID_AIC)},
+#else
+	{USB_DEVICE_AND_INTERFACE_INFO(USB_VENDOR_ID_AIC, USB_PRODUCT_ID_AIC, 0xf=
f,
+								   0xff, 0xff)},
+#endif
+	{}};
+
+MODULE_DEVICE_TABLE(usb, aicwf_usb_id_table);
+
+static struct usb_driver aicwf_usbdrvr =3D {
+	.name =3D KBUILD_MODNAME,
+	.probe =3D aicwf_usb_probe,
+	.disconnect =3D aicwf_usb_disconnect,
+	.id_table =3D aicwf_usb_id_table,
+	.suspend =3D aicwf_usb_suspend,
+	.resume =3D aicwf_usb_resume,
+	.reset_resume =3D aicwf_usb_reset_resume,
+	.supports_autosuspend =3D 1,
+	.disable_hub_initiated_lpm =3D 1,
+};
+
+void aicwf_usb_register(void)
+{
+	if (usb_register(&aicwf_usbdrvr) < 0)
+		usb_err("usb_register failed\n");
+}
+
+void aicwf_usb_exit(void)
+{
+	if (g_rwnx_plat && g_rwnx_plat->enabled)
+		rwnx_platform_deinit(g_rwnx_plat->usbdev->rwnx_hw);
+	usb_deregister(&aicwf_usbdrvr);
+	kfree(g_rwnx_plat);
+}
