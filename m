+/*********************************************************************
+ * netdev callbacks
+ ********************************************************************/
+/**
+ * int (*ndo_open)(struct net_device *dev);
+ *     This function is called when network device transistions to the up
+ *     state.
+ *
+ * - Start FW if this is the first interface opened
+ * - Add interface at fw level
+ */
+static int rwnx_open(struct net_device *dev)
+{
+	struct rwnx_vif *rwnx_vif =3D netdev_priv(dev);
+	struct rwnx_hw *rwnx_hw =3D rwnx_vif->rwnx_hw;
+	struct mm_add_if_cfm add_if_cfm;
+	int error =3D 0;
+	u8 rwnx_rx_gain =3D 0x0E;
+	int err =3D 0;
+	int waiting_counter =3D 10;
+
+	RWNX_DBG(RWNX_FN_ENTRY_STR);
+
+	while (test_bit(RWNX_DEV_STARTED, &rwnx_vif->drv_flags)) {
+		msleep(100);
+		AICWFDBG(LOGDEBUG, "%s waiting for rwnx_close \r\n", __func__);
+		waiting_counter--;
+		if (waiting_counter =3D=3D 0) {
+			AICWFDBG(LOGERROR, "%s error waiting for close time out \r\n",
+				 __func__);
+			break;
+		}
+	}
+
+	// Check if it is the first opened VIF
+	if (rwnx_hw->vif_started =3D=3D 0) {
+		// Start the FW
+		error =3D rwnx_send_start(rwnx_hw);
+		if (error)
+			return error;
+
+		if (rwnx_hw->sdiodev->chipid =3D=3D PRODUCT_ID_AIC8800DC ||
+		    rwnx_hw->sdiodev->chipid =3D=3D PRODUCT_ID_AIC8800DW) {
+			error =3D rwnx_send_dbg_mem_mask_write_req(rwnx_hw, 0x4033b300, 0xFF,
+								 rwnx_rx_gain);
+			if (error)
+				return error;
+		}
+
+#ifdef CONFIG_COEX
+		if (rwnx_hw->sdiodev->chipid =3D=3D PRODUCT_ID_AIC8801 ||
+		    ((rwnx_hw->sdiodev->chipid =3D=3D PRODUCT_ID_AIC8800DC ||
+		      rwnx_hw->sdiodev->chipid =3D=3D PRODUCT_ID_AIC8800DW ||
+		      rwnx_hw->sdiodev->chipid =3D=3D PRODUCT_ID_AIC8800D80) &&
+		     testmode =3D=3D 0)) {
+			if (RWNX_VIF_TYPE(rwnx_vif) =3D=3D NL80211_IFTYPE_STATION ||
+			    RWNX_VIF_TYPE(rwnx_vif) =3D=3D NL80211_IFTYPE_P2P_CLIENT) {
+				rwnx_send_coex_req(rwnx_hw, 0, 1);
+			}
+		}
+#endif
+		/* Device is now started */
+	}
+#ifdef CONFIG_COEX
+	else if ((RWNX_VIF_TYPE(rwnx_vif) =3D=3D NL80211_IFTYPE_AP ||
+		  RWNX_VIF_TYPE(rwnx_vif) =3D=3D NL80211_IFTYPE_P2P_GO)) {
+		rwnx_send_coex_req(rwnx_hw, 1, 0);
+	}
+#endif
+
+	set_bit(RWNX_DEV_STARTED, &rwnx_vif->drv_flags);
+	rwnx_set_conn_state(&rwnx_vif->drv_conn_state, RWNX_DRV_STATUS_DISCONNECT=
ED);
+	AICWFDBG(LOGDEBUG, "%s rwnx_vif->drv_flags:%d\r\n", __func__,
+		 (int)rwnx_vif->drv_flags);
+
+	if (RWNX_VIF_TYPE(rwnx_vif) =3D=3D NL80211_IFTYPE_P2P_CLIENT ||
+	    RWNX_VIF_TYPE(rwnx_vif) =3D=3D NL80211_IFTYPE_P2P_GO) {
+		if (!rwnx_hw->is_p2p_alive &&
+		    (rwnx_hw->p2p_dev_vif && !rwnx_hw->p2p_dev_vif->up)) {
+			err =3D rwnx_send_add_if(rwnx_hw,
+					       rwnx_hw->p2p_dev_vif->wdev.address,
+					       RWNX_VIF_TYPE(rwnx_hw->p2p_dev_vif),
+					       false, &add_if_cfm);
+			if (err)
+				return -EIO;
+
+			if (add_if_cfm.status !=3D 0)
+				return -EIO;
+
+			/* Save the index retrieved from LMAC */
+			spin_lock_bh(&rwnx_hw->cb_lock);
+			rwnx_hw->p2p_dev_vif->vif_index =3D add_if_cfm.inst_nbr;
+			rwnx_hw->p2p_dev_vif->up =3D true;
+			rwnx_hw->vif_started++;
+			rwnx_hw->vif_table[add_if_cfm.inst_nbr] =3D rwnx_hw->p2p_dev_vif;
+			spin_unlock_bh(&rwnx_hw->cb_lock);
+			rwnx_hw->is_p2p_alive =3D 1;
+#ifndef CONFIG_USE_P2P0
+			mod_timer(&rwnx_hw->p2p_alive_timer,
+				  jiffies + msecs_to_jiffies(1000));
+			atomic_set(&rwnx_hw->p2p_alive_timer_count, 0);
+#endif
+		}
+	}
+
+	if (RWNX_VIF_TYPE(rwnx_vif) =3D=3D NL80211_IFTYPE_AP_VLAN) {
+		/* For AP_vlan use same fw and drv indexes. We ensure that this index
+		 * will not be used by fw for another vif by taking index >=3D
+		 * NX_VIRT_DEV_MAX
+		 */
+		add_if_cfm.inst_nbr =3D rwnx_vif->drv_vif_index;
+		netif_tx_stop_all_queues(dev);
+
+		/* Save the index retrieved from LMAC */
+		spin_lock_bh(&rwnx_hw->cb_lock);
+		rwnx_vif->vif_index =3D add_if_cfm.inst_nbr;
+		rwnx_vif->up =3D true;
+		rwnx_hw->vif_started++;
+		rwnx_hw->vif_table[add_if_cfm.inst_nbr] =3D rwnx_vif;
+		AICWFDBG(LOGDEBUG, "%s ap create vif in rwnx_hw->vif_table[%d] \r\n",
+			 __func__, rwnx_vif->vif_index);
+		spin_unlock_bh(&rwnx_hw->cb_lock);
+	} else {
+		/* Forward the information to the LMAC,
+		 * p2p value not used in FMAC configuration, iftype is sufficient
+		 */
+		error =3D rwnx_send_add_if(rwnx_hw, rwnx_vif->wdev.address,
+					 RWNX_VIF_TYPE(rwnx_vif), false, &add_if_cfm);
+		if (error) {
+			AICWFDBG(LOGDEBUG, "AICWF add if fail\n");
+			return error;
+		}
+
+		if (add_if_cfm.status !=3D 0) {
+			RWNX_PRINT_CFM_ERR(add_if);
+			return -EIO;
+		}
+
+		/* Save the index retrieved from LMAC */
+		spin_lock_bh(&rwnx_hw->cb_lock);
+		rwnx_vif->vif_index =3D add_if_cfm.inst_nbr;
+		rwnx_vif->up =3D true;
+		rwnx_hw->vif_started++;
+		rwnx_hw->vif_table[add_if_cfm.inst_nbr] =3D rwnx_vif;
+		AICWFDBG(LOGDEBUG, "%s sta create vif in rwnx_hw->vif_table[%d] \r\n",
+			 __func__, rwnx_vif->vif_index);
+		spin_unlock_bh(&rwnx_hw->cb_lock);
+
+#ifdef CONFIG_USE_P2P0
+		if (rwnx_vif->is_p2p_vif) {
+			rwnx_hw->p2p_dev_vif =3D rwnx_vif;
+			rwnx_hw->is_p2p_alive =3D 1;
+		}
+#endif
+	}
+
+	if (RWNX_VIF_TYPE(rwnx_vif) =3D=3D NL80211_IFTYPE_MONITOR) {
+		rwnx_hw->monitor_vif =3D rwnx_vif->vif_index;
+		if (rwnx_vif->ch_index !=3D RWNX_CH_NOT_SET) {
+			// Configure the monitor channel
+			error =3D rwnx_send_config_monitor_req
+				(rwnx_hw,
+				 &rwnx_hw->chanctx_table[rwnx_vif->ch_index].chan_def,
+				 NULL);
+		}
+	}
+
+#ifdef CONFIG_BR_SUPPORT
+	netdev_br_init(dev);
+#endif /* CONFIG_BR_SUPPORT */
+
+	netif_start_queue(dev);
+
+	return error;
+}
