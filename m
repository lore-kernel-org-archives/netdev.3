+	if (!list_empty(&rwnx_hw->defrag_list)) {
+		list_for_each_entry(iter, &rwnx_hw->defrag_list, list) {
+			if (iter->sn =3D=3D seq_num &&
+			    iter->tid =3D=3D tid &&
+			    iter->sta_idx =3D=3D sta_idx) {
