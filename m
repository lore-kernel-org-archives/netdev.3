+static int aic_setup(struct hci_uart *hu)
+{
+	struct aic_data *aic =3D hu->priv;
+	bool fw_load_done =3D false;
+	unsigned int speed;
+	int err;
+
+	bt_dev_dbg(hu->hdev, "hu %p", hu);
+
+	hu->hdev->set_diag =3D aic_set_diag;
+	hu->hdev->set_bdaddr =3D btaic_set_bdaddr;
+
+	err =3D btaic_initialize(hu->hdev, &fw_load_done);
+	if (err)
+		return err;
+
+	if (!fw_load_done)
+		return 0;
+
+	/* Init speed if any */
+	if (hu->init_speed)
+		speed =3D hu->init_speed;
+	else if (hu->proto->init_speed)
+		speed =3D hu->proto->init_speed;
+	else
+		speed =3D 0;
+
+	if (speed)
+		host_set_baudrate(hu, speed);
+
+	/* Operational speed if any */
+	if (hu->oper_speed)
+		speed =3D hu->oper_speed;
+	else if (aic->dev && aic->dev->oper_speed)
+		speed =3D aic->dev->oper_speed;
+	else if (hu->proto->oper_speed)
+		speed =3D hu->proto->oper_speed;
+	else
+		speed =3D 0;
+
+	if (speed) {
+		err =3D aic_set_baudrate(hu, speed);
+		if (!err)
+			host_set_baudrate(hu, speed);
+	}
+
+	/* PCM parameters if provided */
+	if (aic->dev && aic->dev->pcm_int_params[0] !=3D 0xff) {
+		struct aic_set_pcm_int_params params;
+
+		btaic_read_pcm_int_params(hu->hdev, &params);
+
+		memcpy(&params, aic->dev->pcm_int_params, 5);
+		btaic_write_pcm_int_params(hu->hdev, &params);
+	}
+
+	err =3D btaic_finalize(hu->hdev, &fw_load_done);
+	if (err)
+		return err;
+
+	/* Some devices ship with the controller default address.
+	 * Allow the bootloader to set a valid address through the
+	 * device tree.
+	 */
+	set_bit(HCI_QUIRK_USE_BDADDR_PROPERTY, &hu->hdev->quirks);
+
+	if (!aic_request_irq(aic))
+		err =3D aic_setup_sleep(hu);
+
+	return err;
+}
