+static int
+rwnx_cfg80211_sched_scan_start(struct wiphy *wiphy, struct net_device *dev=
,
+			       struct cfg80211_sched_scan_request *request)
+{
+	struct rwnx_hw *rwnx_hw =3D wiphy_priv(wiphy);
+	struct rwnx_vif *rwnx_vif =3D netdev_priv(dev);
+	struct cfg80211_scan_request *scan_request =3D NULL;
