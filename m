+	/* Get Karst TX IQ compensation value for path0 on 2.4GHz */
+	tag_ptr =3D
+		rwnx_find_tag(config_fw->data, config_fw->size,
+			      "KARST_TX_IQ_COMP_2_4G_PATH_0=3D", strlen("00000000"));
+	if (tag_ptr) {
+		if (sscanf(tag_ptr, "%08x", &config->karst.tx_iq_comp_2_4G[0]) !=3D 1)
+			config->karst.tx_iq_comp_2_4G[0] =3D 0x01000000;
+	} else {
+		config->karst.tx_iq_comp_2_4G[0] =3D 0x01000000;
+	}
+
+	RWNX_DBG("Karst TX IQ compensation for path 0 on 2.4GHz is: %08X\n",
+		 config->karst.tx_iq_comp_2_4G[0]);
+
+	/* Get Karst TX IQ compensation value for path1 on 2.4GHz */
+	tag_ptr =3D
+		rwnx_find_tag(config_fw->data, config_fw->size,
+			      "KARST_TX_IQ_COMP_2_4G_PATH_1=3D", strlen("00000000"));
+	if (tag_ptr) {
+		if (sscanf(tag_ptr, "%08x", &config->karst.tx_iq_comp_2_4G[1]) !=3D 1)
+			config->karst.tx_iq_comp_2_4G[1] =3D 0x01000000;
+	} else {
+		config->karst.tx_iq_comp_2_4G[1] =3D 0x01000000;
+	}
+
+	RWNX_DBG("Karst TX IQ compensation for path 1 on 2.4GHz is: %08X\n",
+		 config->karst.tx_iq_comp_2_4G[1]);
+
+	/* Get Karst RX IQ compensation value for path0 on 2.4GHz */
+	tag_ptr =3D
+		rwnx_find_tag(config_fw->data, config_fw->size,
+			      "KARST_RX_IQ_COMP_2_4G_PATH_0=3D", strlen("00000000"));
+	if (tag_ptr) {
+		if (sscanf(tag_ptr, "%08x", &config->karst.rx_iq_comp_2_4G[0]) !=3D 1)
+			config->karst.rx_iq_comp_2_4G[0] =3D 0x01000000;
+	} else {
+		config->karst.rx_iq_comp_2_4G[0] =3D 0x01000000;
+	}
+
+	RWNX_DBG("Karst RX IQ compensation for path 0 on 2.4GHz is: %08X\n",
+		 config->karst.rx_iq_comp_2_4G[0]);
+
+	/* Get Karst RX IQ compensation value for path1 on 2.4GHz */
+	tag_ptr =3D
+		rwnx_find_tag(config_fw->data, config_fw->size,
+			      "KARST_RX_IQ_COMP_2_4G_PATH_1=3D", strlen("00000000"));
+	if (tag_ptr) {
+		if (sscanf(tag_ptr, "%08x", &config->karst.rx_iq_comp_2_4G[1]) !=3D 1)
+			config->karst.rx_iq_comp_2_4G[1] =3D 0x01000000;
+	} else {
+		config->karst.rx_iq_comp_2_4G[1] =3D 0x01000000;
+	}
+
+	RWNX_DBG("Karst RX IQ compensation for path 1 on 2.4GHz is: %08X\n",
+		 config->karst.rx_iq_comp_2_4G[1]);
+
+	/* Get Karst TX IQ compensation value for path0 on 5GHz */
+	tag_ptr =3D rwnx_find_tag(config_fw->data, config_fw->size,
+				"KARST_TX_IQ_COMP_5G_PATH_0=3D", strlen("00000000"));
+	if (tag_ptr) {
+		if (sscanf(tag_ptr, "%08x", &config->karst.tx_iq_comp_5G[0]) !=3D 1)
+			config->karst.tx_iq_comp_5G[0] =3D 0x01000000;
+	} else {
+		config->karst.tx_iq_comp_5G[0] =3D 0x01000000;
+	}
+
+	RWNX_DBG("Karst TX IQ compensation for path 0 on 5GHz is: %08X\n",
+		 config->karst.tx_iq_comp_5G[0]);
+
+	/* Get Karst TX IQ compensation value for path1 on 5GHz */
+	tag_ptr =3D rwnx_find_tag(config_fw->data, config_fw->size,
+				"KARST_TX_IQ_COMP_5G_PATH_1=3D", strlen("00000000"));
+	if (tag_ptr) {
+		if (sscanf(tag_ptr, "%08x", &config->karst.tx_iq_comp_5G[1]) !=3D 1)
+			config->karst.tx_iq_comp_5G[1] =3D 0x01000000;
+	} else {
+		config->karst.tx_iq_comp_5G[1] =3D 0x01000000;
+	}
+
+	RWNX_DBG("Karst TX IQ compensation for path 1 on 5GHz is: %08X\n",
+		 config->karst.tx_iq_comp_5G[1]);
+
+	/* Get Karst RX IQ compensation value for path0 on 5GHz */
+	tag_ptr =3D rwnx_find_tag(config_fw->data, config_fw->size,
+				"KARST_RX_IQ_COMP_5G_PATH_0=3D", strlen("00000000"));
+	if (tag_ptr) {
+		if (sscanf(tag_ptr, "%08x", &config->karst.rx_iq_comp_5G[0]) !=3D 1)
+			config->karst.rx_iq_comp_5G[0] =3D 0x01000000;
+	} else {
+		config->karst.rx_iq_comp_5G[0] =3D 0x01000000;
+	}
+
+	RWNX_DBG("Karst RX IQ compensation for path 0 on 5GHz is: %08X\n",
+		 config->karst.rx_iq_comp_5G[0]);
+
+	/* Get Karst RX IQ compensation value for path1 on 5GHz */
+	tag_ptr =3D rwnx_find_tag(config_fw->data, config_fw->size,
+				"KARST_RX_IQ_COMP_5G_PATH_1=3D", strlen("00000000"));
+	if (tag_ptr) {
+		if (sscanf(tag_ptr, "%08x", &config->karst.rx_iq_comp_5G[1]) !=3D 1)
+			config->karst.rx_iq_comp_5G[1] =3D 0x01000000;
+	} else {
+		config->karst.rx_iq_comp_5G[1] =3D 0x01000000;
+	}
+
+	RWNX_DBG("Karst RX IQ compensation for path 1 on 5GHz is: %08X\n",
+		 config->karst.rx_iq_comp_5G[1]);
+
+	/* Get Karst default path */
+	tag_ptr =3D rwnx_find_tag(config_fw->data, config_fw->size,
+				"KARST_DEFAULT_PATH=3D", strlen("00"));
+	if (tag_ptr) {
+		u8 val;
+
+		if (kstrtou8(tag_ptr, 16, &val) =3D=3D 0)
+			config->karst.path_used =3D val;
+		else
+			config->karst.path_used =3D path;
+	} else {
+		config->karst.path_used =3D path;
+	}
+
+	RWNX_DBG("Karst default path is: %d\n", config->karst.path_used);
+
+	/* Release the configuration file */
+	release_firmware(config_fw);
+
+	return 0;
+}
