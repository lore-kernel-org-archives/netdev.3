+int genl_parse_sep(char *dst[], char *src, const char *delimiter)
+{
+	int count =3D 0;
+	char *token;
+
+	token =3D strsep(&src, delimiter);
+	while (token) {
+		dst[count++] =3D token;
+		token =3D strsep(&src, delimiter);
