+static inline char *aicwf_get_iwe_stream_rate(struct rwnx_hw *rwnx_hw,
+					      struct iw_request_info *info,
+					      struct scanu_result_wext *scan_re,
+					      char *start, char *stop,
+					      struct iw_event *iwe)
+{
+	struct ieee80211_mgmt *mgmt =3D (struct ieee80211_mgmt *)scan_re->payload=
;
+	u8 *payload =3D mgmt->u.beacon.variable;
+	const u8 *ie_content;
+
+	u16 mcs_rate =3D 0;
+	u8 bw_40mhz =3D 0;
+	u8 short_gi =3D 0;
+	u16 max_rate =3D 0;
+	u8 bw_160mhz =3D 0;
+
+	u16 ht_cap =3D false;
+	struct ieee80211_ht_cap *ht_capie;
+
+	u16 vht_cap =3D false;
+	u8 tx_mcs_map[2];
+	u8 tx_mcs_index =3D 0;
+	u16 vht_data_rate =3D 0;
+
+	u16 he_cap =3D false;
+	u8 he_ch_width_set =3D 0;
+	u8 he_bw =3D 0;
+
+	/* parsing HT_CAP_IE	 */
+	ie_content =3D NULL;
+	ie_content =3D cfg80211_find_ie(WLAN_EID_HT_CAPABILITY, payload, scan_re-=
>ind->length);
+	if (ie_content) {
+		ht_cap =3D true;
+		ht_capie =3D (struct ieee80211_ht_cap *)(ie_content + 2);
+		bw_40mhz =3D (ht_capie->cap_info & NL80211_CHAN_WIDTH_40) ? 1 : 0;
+		short_gi =3D (ht_capie->cap_info &
+			    (IEEE80211_HT_CAP_SGI_20 | IEEE80211_HT_CAP_SGI_40)) ? 1 : 0;
+		memcpy(&mcs_rate, ht_capie->mcs.rx_mask, 2);
+	}
+
+	/* parsing VHT_CAP_IE	 */
+	ie_content =3D NULL;
+	ie_content =3D cfg80211_find_ie(WLAN_EID_VHT_CAPABILITY, payload, scan_re=
->ind->length);
+	if (ie_content) {
+		vht_cap =3D true;
+		bw_160mhz =3D ((*(u8 *)(ie_content + 2)) >> 2) & ((u8)(0xFF >> (8 - (2))=
));
+		if (bw_160mhz)
+			short_gi =3D ((*(u8 *)(ie_content + 2)) >> 6) & ((u8)(0xFF >> (8 - (1))=
));
+		else
+			short_gi =3D ((*(u8 *)(ie_content + 2)) >> 5) & ((u8)(0xFF >> (8 - (1))=
));
+
+		memcpy(tx_mcs_map, ((ie_content + 2) + 8), 2);
+
+		tx_mcs_index =3D (tx_mcs_map[0] & 0x0F) - 1;
+		if (ieee80211_frequency_to_channel(scan_re->ind->center_freq) > 14)
+			vht_data_rate =3D VHT_MCS_DATA_RATE[2][short_gi][tx_mcs_index];
+		else
+			vht_data_rate =3D VHT_MCS_DATA_RATE[1][short_gi][tx_mcs_index];
+		//TO DO:
+		//need to counter antenna number for AC
+	}
+
+	/* parsing HE_CAP_IE	 */
+	ie_content =3D NULL;
+	/*0xFF+len+WLAN_EID_EXTENSION+playload */
+	ie_content =3D cfg80211_find_ie(WLAN_EID_EXTENSION, payload, scan_re->ind=
->length);
+	if (ie_content && ie_content[2] =3D=3D WLAN_EID_EXT_HE_CAPABILITY) {
+		he_cap =3D true;
+		he_ch_width_set =3D ie_content[8];
+		if (he_ch_width_set & IEEE80211_HE_CH_BW_SET_160_80P80)
+			he_bw =3D NL80211_CHAN_WIDTH_80;
+		else if (he_ch_width_set & IEEE80211_HE_CH_BW_SET_160_IN_5G)
+			he_bw =3D NL80211_CHAN_WIDTH_160;
+		else if (he_ch_width_set & IEEE80211_HE_CH_BW_SET_40_AND_80_IN_5G)
+			he_bw =3D NL80211_CHAN_WIDTH_40;
+		else if (he_ch_width_set & IEEE80211_HE_CH_BW_SET_40_IN_2_4G)
+			he_bw =3D NL80211_CHAN_WIDTH_40;
+		else
+			he_bw =3D NL80211_CHAN_WIDTH_20;
+		//TO DO:
+		//need to counter antenna number for AX
+	}
+
+	if (he_cap) {
+		if (he_bw =3D=3D NL80211_CHAN_WIDTH_20)
+			max_rate =3D 144;
+		else if (he_bw =3D=3D NL80211_CHAN_WIDTH_40)
+			max_rate =3D 287;
+		else if (he_bw =3D=3D NL80211_CHAN_WIDTH_80)
+			max_rate =3D 601;
+		else if (he_bw =3D=3D NL80211_CHAN_WIDTH_160)
+			max_rate =3D 1147;
+		max_rate =3D max_rate * 2;
+	} else if (vht_cap) {
+		max_rate =3D vht_data_rate;
+	} else if (ht_cap) {
+		if (mcs_rate & 0x8000) /* MCS15 */
+			max_rate =3D (bw_40mhz) ? ((short_gi) ? 300 : 270) : ((short_gi) ? 144 =
: 130);
+
+		else if (mcs_rate & 0x0080) {
+			/* MCS7 */
+			max_rate =3D (bw_40mhz) ? ((short_gi) ? 150 : 135) : ((short_gi) ? 72 :=
 65);
+		} else {
+			/* default MCS7 */
+			max_rate =3D (bw_40mhz) ? ((short_gi) ? 150 : 135) : ((short_gi) ? 72 :=
 65);
+		}
+	}
+
+	iwe->cmd =3D SIOCGIWRATE;
+	iwe->u.bitrate.disabled =3D 0;
+	iwe->u.bitrate.fixed =3D iwe->u.bitrate.disabled;
+	iwe->u.bitrate.value =3D max_rate * 1000000;
+	start =3D iwe_stream_add_event(info, start, stop, iwe, IW_EV_PARAM_LEN);
+	return start;
+}
