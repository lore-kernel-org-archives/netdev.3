@@ -0,0 +1,45 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+compatible: "aic,aic-bt"
+description: |
+  AIC Bluetooth UART device tree binding.
+
+  This binding describes the device tree properties for the AIC Bluetooth
+  UART interface used to communicate with a Bluetooth module.
+
+properties:
+  compatible:
+    const: "aic,aic-bt"
+
+  reg:
+    description: UART register base address and length
+    maxItems: 1
+
+  interrupts:
+    description: Interrupt specifier for the Bluetooth module
+    minItems: 1
+    maxItems: 1
+
+  clocks:
+    description: Phandle to the clock used by the UART interface
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - interrupts
+
+examples:
+  - |
+	&uart2 {
+        pinctrl-names =3D "default", "sleep";
+        pinctrl-0 =3D <&uart2_pins_a>;
+        pinctrl-1 =3D <&uart2_pins_b>;
+        uart-supply =3D <&reg_aldo1>;
+        status =3D "okay";
+        bluetooth {
+                compatible =3D "aic,aic-bt";
+                max-speed =3D <1500000>;
+        };
+};
