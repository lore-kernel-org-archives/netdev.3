+/**
+ * @add_station: Add a new station.
+ */
+static int rwnx_cfg80211_add_station(struct wiphy *wiphy,
+				     struct net_device *dev,
+				     const u8 *mac,
+				     struct station_parameters *params)
+{
+	struct rwnx_hw *rwnx_hw =3D wiphy_priv(wiphy);
+	struct rwnx_vif *rwnx_vif =3D netdev_priv(dev);
+	struct me_sta_add_cfm me_sta_add_cfm;
+	int error =3D 0;
+
+	RWNX_DBG(RWNX_FN_ENTRY_STR);
+
+	WARN_ON(RWNX_VIF_TYPE(rwnx_vif) =3D=3D NL80211_IFTYPE_AP_VLAN);
+
+	/* Do not add TDLS station */
+	if (params->sta_flags_set & BIT(NL80211_STA_FLAG_TDLS_PEER))
+		return 0;
+
+	/* Indicate we are in a STA addition process - This will allow handling
+	 * potential PS mode change indications correctly
+	 */
+	rwnx_hw->adding_sta =3D true;
+
+	/* Forward the information to the LMAC */
+	error =3D rwnx_send_me_sta_add(rwnx_hw, params, mac, rwnx_vif->vif_index,
+				     &me_sta_add_cfm);
+	if (error)
+		return error;
+
+	// Check the status
+	switch (me_sta_add_cfm.status) {
+	case CO_OK: {
+		struct rwnx_sta *sta =3D &rwnx_hw->sta_table[me_sta_add_cfm.sta_idx];
+		int tid;
+
+		sta->aid =3D params->aid;
+		sta->sta_idx =3D me_sta_add_cfm.sta_idx;
+		sta->ch_idx =3D rwnx_vif->ch_index;
+		sta->vif_idx =3D rwnx_vif->vif_index;
+		sta->vlan_idx =3D sta->vif_idx;
+		sta->qos =3D (params->sta_flags_set & BIT(NL80211_STA_FLAG_WME)) !=3D 0;
+		sta->ht =3D params->link_sta_params.ht_capa ? 1 : 0;
+		sta->vht =3D params->link_sta_params.vht_capa ? 1 : 0;
+		sta->acm =3D 0;
+		sta->key.hw_idx =3D 0;
+
+		if (params->local_pm !=3D NL80211_MESH_POWER_UNKNOWN)
+			sta->mesh_pm =3D params->local_pm;
+		else
+			sta->mesh_pm =3D rwnx_vif->ap.next_mesh_pm;
+		rwnx_update_mesh_power_mode(rwnx_vif);
+
+		for (tid =3D 0; tid < NX_NB_TXQ_PER_STA; tid++) {
+			int uapsd_bit =3D rwnx_hwq2uapsd[rwnx_tid2hwq[tid]];
+
+			if (params->uapsd_queues & uapsd_bit)
+				sta->uapsd_tids |=3D 1 << tid;
+			else
+				sta->uapsd_tids &=3D ~(1 << tid);
+		}
+		memcpy(sta->mac_addr, mac, ETH_ALEN);
+#ifdef CONFIG_RWNX_DEBUGFS
+		rwnx_dbgfs_register_rc_stat(rwnx_hw, sta);
+#endif
+
+		/* Ensure that we won't process PS change or channel switch ind */
+		spin_lock_bh(&rwnx_hw->cb_lock);
+		rwnx_txq_sta_init(rwnx_hw, sta, rwnx_txq_vif_get_status(rwnx_vif));
+		list_add_tail(&sta->list, &rwnx_vif->ap.sta_list);
+		sta->valid =3D true;
+		rwnx_ps_bh_enable(rwnx_hw, sta,
+				  sta->ps.active || me_sta_add_cfm.pm_state);
+		spin_unlock_bh(&rwnx_hw->cb_lock);
+
+		error =3D 0;
+
+		if (rwnx_vif->wdev.iftype =3D=3D NL80211_IFTYPE_AP ||
+		    rwnx_vif->wdev.iftype =3D=3D NL80211_IFTYPE_P2P_GO) {
+			struct station_info sinfo;
+
+			memset(&sinfo, 0, sizeof(struct station_info));
+			sinfo.assoc_req_ies =3D NULL;
+			sinfo.assoc_req_ies_len =3D 0;
+			cfg80211_new_sta(rwnx_vif->ndev, sta->mac_addr, &sinfo, GFP_KERNEL);
+		}
+#ifdef CONFIG_RWNX_BFMER
+		if (rwnx_hw->mod_params->bfmer)
+			rwnx_send_bfmer_enable(rwnx_hw, sta, params->vht_capa);
+
+		rwnx_mu_group_sta_init(sta, params->vht_capa);
+#endif /* CONFIG_RWNX_BFMER */
+
+#define PRINT_STA_FLAG(f)                                                 =
     \
+	(params->sta_flags_set & BIT(NL80211_STA_FLAG_##f) ? "[" #f "]" : "")
+
+		netdev_info(dev, "Add sta %d (%pM) flags=3D%s%s%s%s%s%s%s", sta->sta_idx=
,
+			    mac, PRINT_STA_FLAG(AUTHORIZED),
+			    PRINT_STA_FLAG(SHORT_PREAMBLE), PRINT_STA_FLAG(WME),
+			    PRINT_STA_FLAG(MFP), PRINT_STA_FLAG(AUTHENTICATED),
+			    PRINT_STA_FLAG(TDLS_PEER), PRINT_STA_FLAG(ASSOCIATED));
+#undef PRINT_STA_FLAG
+		break;
+	}
+	default:
+		error =3D -EBUSY;
+		break;
+	}
+
+	rwnx_hw->adding_sta =3D false;
+
+	return error;
+}
