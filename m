+static int aicwf_vendor_subcmd_get_feature_set(struct wiphy *wiphy,
+					       struct wireless_dev *wdev,
+					       const void *data, int len)
+{
+	int ret;
+	struct sk_buff *reply;
+	u32 feature =3D 0, payload;
+	struct rwnx_hw *rwnx_hw =3D wiphy_priv(wiphy);
+
+	payload =3D sizeof(feature);
+	reply =3D cfg80211_vendor_cmd_alloc_reply_skb(wiphy, payload);
+
+	if (!reply)
+		return -ENOMEM;
+
+	/* TODO
+	 * Add handle in the future!
+	 */
+	/*bit 1:Basic infrastructure mode */
+	if (wiphy->interface_modes & BIT(NL80211_IFTYPE_STATION))
+		feature |=3D WIFI_FEATURE_INFRA;
+
+	/*bit 2:Support for 5 GHz Band */
+	if (rwnx_hw->band_5g_support)
+		feature |=3D WIFI_FEATURE_INFRA_5G;
+
+	/*bit3:HOTSPOT is a supplicant feature, enable it by default */
+	feature |=3D WIFI_FEATURE_HOTSPOT;
+
+	/*bit 4:P2P */
+	if ((wiphy->interface_modes & BIT(NL80211_IFTYPE_P2P_CLIENT)) &&
+	    (wiphy->interface_modes & BIT(NL80211_IFTYPE_P2P_GO)))
+		feature |=3D WIFI_FEATURE_P2P;
+
+	/*bit 5:soft AP feature supported */
+	if (wiphy->interface_modes & BIT(NL80211_IFTYPE_AP))
+		feature |=3D WIFI_FEATURE_SOFT_AP;
+
+	/*bit 18:WiFi Logger */
+	feature |=3D WIFI_FEATURE_LOGGER;
+
+	/*bit 21:WiFi mkeep_alive */
+	feature |=3D WIFI_FEATURE_MKEEP_ALIVE;
+
+#ifdef AICWF_LATENCY_MODE
+	feature |=3D WIFI_FEATURE_SET_LATENCY_MODE;
+#endif
+
+	if (nla_put_u32(reply, ANDR_WIFI_ATTRIBUTE_NUM_FEATURE_SET, feature)) {
+		wiphy_err(wiphy, "%s put u32 error\n", __func__);
+		goto out_put_fail;
+	}
+
+	ret =3D cfg80211_vendor_cmd_reply(reply);
+	if (ret)
+		wiphy_err(wiphy, "%s reply cmd error\n", __func__);
+
+	return ret;
+
+out_put_fail:
+	kfree_skb(reply);
+	return -EMSGSIZE;
+}
