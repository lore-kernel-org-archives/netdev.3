+int aicwf_sdio_flow_ctrl_msg(struct aic_sdio_dev *sdiodev)
+{
+	int ret =3D -1;
+	u8 fc_reg =3D 0;
+	u32 count =3D 0;
+
+	while (true) {
+		ret =3D
+			aicwf_sdio_readb(sdiodev, sdiodev->sdio_reg.flow_ctrl_reg, &fc_reg);
+		if (ret)
+			return -1;
+
+		if (sdiodev->chipid =3D=3D PRODUCT_ID_AIC8801 ||
+		    sdiodev->chipid =3D=3D PRODUCT_ID_AIC8800DC ||
+			sdiodev->chipid =3D=3D PRODUCT_ID_AIC8800DW) {
+			fc_reg =3D fc_reg & SDIOWIFI_FLOWCTRL_MASK_REG;
+		}
+
+		if (fc_reg !=3D 0) {
+			ret =3D fc_reg;
+			if (ret > tx_aggr_counter)
+				ret =3D tx_aggr_counter;
+			return ret;
+		}
+		if (count >=3D FLOW_CTRL_RETRY_COUNT) {
+			ret =3D -fc_reg;
+			break;
+		}
+		count++;
+		if (count < 30)
+			usleep_range(50, 100);
+		else if (count < 40)
+			usleep_range(2000, 2500);
+		else
+			usleep_range(10000, 12000);
+	}
+
+	return ret;
+}
