+static void find_defrag_info(struct rwnx_hw *rwnx_hw, u16 seq_num,
+			     u8 tid, u8 sta_idx,
+			     struct defrag_ctrl_info **defrag_info,
+			     struct defrag_ctrl_info **defrag_info_tmp)
+{
