+/**
+ * int (*ndo_stop)(struct net_device *dev);
+ *     This function is called when network device transistions to the dow=
n
+ *     state.
+ *
+ * - Remove interface at fw level
+ * - Reset FW if this is the last interface opened
+ */
+static int rwnx_close(struct net_device *dev)
+{
+	struct rwnx_vif *rwnx_vif =3D netdev_priv(dev);
+	struct rwnx_hw *rwnx_hw =3D rwnx_vif->rwnx_hw;
+	int ret;
+#if defined(AICWF_USB_SUPPORT)
+	struct aicwf_bus *bus_if =3D NULL;
+	struct aic_usb_dev *usbdev =3D NULL;
+
+	bus_if =3D dev_get_drvdata(rwnx_hw->dev);
+	usbdev =3D bus_if->bus_priv.usb;
+#elif defined(AICWF_SDIO_SUPPORT)
+	struct aicwf_bus *bus_if =3D NULL;
+	struct aic_sdio_dev *sdiodev =3D NULL;
+#else
+#endif
+	int waiting_counter =3D 20;
+	int test_counter =3D 0;
+
+	RWNX_DBG(RWNX_FN_ENTRY_STR);
+
+	test_counter =3D waiting_counter;
+	while (atomic_read(&rwnx_vif->drv_conn_state) =3D=3D (int)RWNX_DRV_STATUS=
_DISCONNECTING ||
+	       atomic_read(&rwnx_vif->drv_conn_state) =3D=3D (int)RWNX_DRV_STATUS=
_CONNECTING) {
+		AICWFDBG(LOGDEBUG,
+			 "%s wifi is connecting or disconnecting, waiting 200ms for state to st=
able\r\n",
+			 __func__);
+		msleep(200);
+		test_counter--;
+		if (test_counter =3D=3D 0) {
+			AICWFDBG(LOGERROR, "%s connecting or disconnecting, not finish\r\n",
+				 __func__);
+			//WARN_ON(1);
+			break;
+		}
+	}
+
+#if defined(AICWF_USB_SUPPORT) || defined(AICWF_SDIO_SUPPORT)
+	if (scanning)
+		scanning =3D false;
+#endif
+
+	netdev_info(dev, "CLOSE");
+
+	rwnx_radar_cancel_cac(&rwnx_hw->radar);
+
+	/* Abort scan request on the vif */
+	if (rwnx_hw->scan_request &&
+	    rwnx_hw->scan_request->wdev =3D=3D &rwnx_vif->wdev) {
+		struct cfg80211_scan_info info =3D {
+			.aborted =3D true,
+		};
+
+		cfg80211_scan_done(rwnx_hw->scan_request, &info);
+		rwnx_hw->scan_request =3D NULL;
+
+		ret =3D rwnx_send_scanu_cancel_req(rwnx_hw, NULL);
+		mdelay(35); // make sure firmware take affect
+		if (ret) {
+			AICWFDBG(LOGDEBUG, "AICWF scanu_cancel fail\n");
+			return ret;
+		}
+	}
+
+	if (rwnx_hw->roc_elem && rwnx_hw->roc_elem->wdev =3D=3D &rwnx_vif->wdev) =
{
+		AICWFDBG(LOGDEBUG, KERN_CRIT "AICWF %s clear roc\n", __func__);
+		/* Initialize RoC element pointer to NULL, indicate that RoC can be
+		 * started
+		 */
+		kfree(rwnx_hw->roc_elem);
+		rwnx_hw->roc_elem =3D NULL;
+	}
+
+	rwnx_vif->up =3D false;
+	AICWFDBG(LOGDEBUG, "%s rwnx_vif[%d] down \r\n", __func__,
+		 rwnx_vif->vif_index);
+
+	if (netif_carrier_ok(dev)) {
+		if (RWNX_VIF_TYPE(rwnx_vif) =3D=3D NL80211_IFTYPE_STATION ||
+		    RWNX_VIF_TYPE(rwnx_vif) =3D=3D NL80211_IFTYPE_P2P_CLIENT) {
+			cfg80211_disconnected(dev, WLAN_REASON_DEAUTH_LEAVING, NULL, 0,
+					      true, GFP_ATOMIC);
+			netif_tx_stop_all_queues(dev);
+			netif_carrier_off(dev);
+			usleep_range(1000, 2000);
+		} else if (RWNX_VIF_TYPE(rwnx_vif) =3D=3D NL80211_IFTYPE_AP_VLAN) {
+			netif_carrier_off(dev);
+		} else {
+			netdev_warn(dev, "AP not stopped when disabling interface");
+		}
+
+#ifdef CONFIG_BR_SUPPORT
+		/* void nat25_db_cleanup(_adapter *priv); */
+		nat25_db_cleanup(rwnx_vif);
+#endif /* CONFIG_BR_SUPPORT */
+	}
+
+#if defined(AICWF_USB_SUPPORT)
+	if (usbdev) {
+		if (usbdev->state !=3D USB_DOWN_ST)
+			rwnx_send_remove_if(rwnx_hw, rwnx_vif->vif_index, false);
+	}
+#endif
+#if defined(AICWF_SDIO_SUPPORT)
+	bus_if =3D dev_get_drvdata(rwnx_hw->dev);
+	if (bus_if)
+		sdiodev =3D bus_if->bus_priv.sdio;
+	if (sdiodev && sdiodev->bus_if->state !=3D BUS_DOWN_ST) {
+		if (RWNX_VIF_TYPE(rwnx_vif) =3D=3D NL80211_IFTYPE_STATION ||
+		    RWNX_VIF_TYPE(rwnx_vif) =3D=3D NL80211_IFTYPE_P2P_CLIENT) {
+			test_counter =3D waiting_counter;
+			if (atomic_read(&rwnx_vif->drv_conn_state) =3D=3D
+			    (int)RWNX_DRV_STATUS_CONNECTED) {
+				rwnx_set_conn_state(&rwnx_vif->drv_conn_state,
+						    RWNX_DRV_STATUS_DISCONNECTING);
+				rwnx_send_sm_disconnect_req(rwnx_hw, rwnx_vif, 3);
+				while (atomic_read(&rwnx_vif->drv_conn_state) =3D=3D
+				       (int)RWNX_DRV_STATUS_DISCONNECTING) {
+					AICWFDBG(LOGDEBUG,
+						 "%s wifi is disconnecting, waiting 100ms for state to stable\r\n",
+						 __func__);
+					msleep(100);
+					test_counter--;
+					if (test_counter =3D=3D 0)
+						break;
+				}
+			}
+		}
+#ifdef CONFIG_USE_P2P0
+		if (!rwnx_vif->is_p2p_vif ||
+		    (rwnx_vif->is_p2p_vif && rwnx_hw->is_p2p_alive)) {
+			if (rwnx_vif->is_p2p_vif)
+				rwnx_hw->is_p2p_alive =3D 0;
+#endif
+			rwnx_send_remove_if(rwnx_hw, rwnx_vif->vif_index, false);
+#ifdef CONFIG_USE_P2P0
+		}
+#endif
+	}
+#endif
+	/* Ensure that we won't process disconnect ind */
+	spin_lock_bh(&rwnx_hw->cb_lock);
+
+	rwnx_hw->vif_table[rwnx_vif->vif_index] =3D NULL;
+
+	rwnx_chanctx_unlink(rwnx_vif);
+
+	if (RWNX_VIF_TYPE(rwnx_vif) =3D=3D NL80211_IFTYPE_MONITOR)
+		rwnx_hw->monitor_vif =3D RWNX_INVALID_VIF;
+
+	rwnx_hw->vif_started--;
+	spin_unlock_bh(&rwnx_hw->cb_lock);
+
+	if (rwnx_hw->vif_started =3D=3D 0) {
+		/* This also lets both ipc sides remain in sync before resetting */
+#ifdef AICWF_USB_SUPPORT
+		if (usbdev->bus_if->state !=3D BUS_DOWN_ST)
+#else
+		if (sdiodev->bus_if->state !=3D BUS_DOWN_ST)
+#endif
+		{
+#ifdef CONFIG_COEX
+			if (testmode =3D=3D 0)
+				rwnx_send_coex_req(rwnx_hw, 1, 0);
+#endif
+			rwnx_send_reset(rwnx_hw);
+			// Set parameters to firmware
+			if (testmode =3D=3D 0) {
+				rwnx_send_me_config_req(rwnx_hw);
+				// Set channel parameters to firmware
+				rwnx_send_me_chan_config_req(rwnx_hw);
+			}
+		}
+	} else {
+#ifdef CONFIG_COEX
+		if (RWNX_VIF_TYPE(rwnx_vif) =3D=3D NL80211_IFTYPE_AP ||
+		    RWNX_VIF_TYPE(rwnx_vif) =3D=3D NL80211_IFTYPE_P2P_GO)
+			rwnx_send_coex_req(rwnx_hw, 0, 1);
+#endif
+	}
+
+	clear_bit(RWNX_DEV_STARTED, &rwnx_vif->drv_flags);
+	AICWFDBG(LOGDEBUG, "%s rwnx_vif->drv_flags:%d\r\n", __func__,
+		 (int)rwnx_vif->drv_flags);
+
+	return 0;
+}
