+
+    /* skb->protocol is not reliable at this point on EN7523. */
+    for (i = 0; i < ARRAY_SIZE(fixed_offsets); i++) {
+        off = fixed_offsets[i];
+        if (airoha_ppe_skb_read_ipv4_tuple_at(skb, off, tuple) ||
+            airoha_ppe_skb_read_ipv6_tuple_at(skb, off, tuple))
+            return true;
+    }
