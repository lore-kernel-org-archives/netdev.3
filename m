+static bool
+airoha_ppe_skb_find_tuple(struct sk_buff *skb,
+              struct airoha_ppe_skb_tuple *tuple)
+{
+    static const unsigned int fixed_offsets[] = {
+        0,
+        ETH_HLEN,
+        ETH_HLEN + VLAN_HLEN,
+        ETH_HLEN + 2 * VLAN_HLEN,
+    };
