+/**
+ * rwnx_rx_vector_convert - Convert a legacy RX vector into a new RX vecto=
r
+ * format
+ *
+ * @rwnx_hw: main driver data.
+ * @rx_vect1: Rx vector 1 descriptor of the received frame.
+ * @rx_vect2: Rx vector 2 descriptor of the received frame.
+ */
+static void rwnx_rx_vector_convert(struct rwnx_hw *rwnx_hw,
+				   struct rx_vector_1 *rx_vect1,
+				   struct rx_vector_2 *rx_vect2)
+{
+	struct rx_vector_1_old rx_vect1_leg;
+	struct rx_vector_2_old rx_vect2_leg;
+	u32_l phy_vers =3D rwnx_hw->version_cfm.version_phy_2;
+
+	// Check if we need to do the conversion. Only if old modem is used
+	if (__MDM_MAJOR_VERSION(phy_vers) > 0) {
+		rx_vect1->rssi1 =3D rx_vect1->rssi_leg;
+		return;
+	}
+	// Copy the received vector locally
+	memcpy(&rx_vect1_leg, rx_vect1, sizeof(struct rx_vector_1_old));
+
+	// Reset it
+	memset(rx_vect1, 0, sizeof(struct rx_vector_1));
+
+	// Perform the conversion
+	rx_vect1->format_mod =3D rx_vect1_leg.format_mod;
+	rx_vect1->ch_bw =3D rx_vect1_leg.ch_bw;
+	rx_vect1->antenna_set =3D rx_vect1_leg.antenna_set;
+	rx_vect1->leg_length =3D rx_vect1_leg.leg_length;
+	rx_vect1->leg_rate =3D rx_vect1_leg.leg_rate;
+	rx_vect1->rssi1 =3D rx_vect1_leg.rssi1;
+
+	switch (rx_vect1->format_mod) {
+	case FORMATMOD_NON_HT:
+	case FORMATMOD_NON_HT_DUP_OFDM:
+		rx_vect1->leg.lsig_valid =3D rx_vect1_leg.lsig_valid;
+		rx_vect1->leg.chn_bw_in_non_ht =3D rx_vect1_leg.num_extn_ss;
+		rx_vect1->leg.dyn_bw_in_non_ht =3D rx_vect1_leg.dyn_bw;
+		break;
+	case FORMATMOD_HT_MF:
+	case FORMATMOD_HT_GF:
+		rx_vect1->ht.aggregation =3D rx_vect1_leg.aggregation;
+		rx_vect1->ht.fec =3D rx_vect1_leg.fec_coding;
+		rx_vect1->ht.lsig_valid =3D rx_vect1_leg.lsig_valid;
+		rx_vect1->ht.length =3D rx_vect1_leg.ht_length;
+		rx_vect1->ht.mcs =3D rx_vect1_leg.mcs;
+		rx_vect1->ht.num_extn_ss =3D rx_vect1_leg.num_extn_ss;
+		rx_vect1->ht.short_gi =3D rx_vect1_leg.short_gi;
+		rx_vect1->ht.smoothing =3D rx_vect1_leg.smoothing;
+		rx_vect1->ht.sounding =3D rx_vect1_leg.sounding;
+		rx_vect1->ht.stbc =3D rx_vect1_leg.stbc;
+		break;
+	case FORMATMOD_VHT:
+		rx_vect1->vht.beamformed =3D !rx_vect1_leg.smoothing;
+		rx_vect1->vht.fec =3D rx_vect1_leg.fec_coding;
+		rx_vect1->vht.length =3D rx_vect1_leg.ht_length | rx_vect1_leg._ht_lengt=
h	<< 8;
+		rx_vect1->vht.mcs =3D rx_vect1_leg.mcs & 0x0F;
+		rx_vect1->vht.nss =3D
+			rx_vect1_leg.stbc ? rx_vect1_leg.n_sts / 2 : rx_vect1_leg.n_sts;
+		rx_vect1->vht.doze_not_allowed =3D rx_vect1_leg.doze_not_allowed;
+		rx_vect1->vht.short_gi =3D rx_vect1_leg.short_gi;
+		rx_vect1->vht.sounding =3D rx_vect1_leg.sounding;
+		rx_vect1->vht.stbc =3D rx_vect1_leg.stbc;
+		rx_vect1->vht.group_id =3D rx_vect1_leg.group_id;
+		rx_vect1->vht.partial_aid =3D rx_vect1_leg.partial_aid;
+		rx_vect1->vht.first_user =3D rx_vect1_leg.first_user;
+		break;
+	}
+
+	if (!rx_vect2)
+		return;
+
+	// Copy the received vector 2 locally
+	memcpy(&rx_vect2_leg, rx_vect2, sizeof(struct rx_vector_2_old));
+
+	// Reset it
+	memset(rx_vect2, 0, sizeof(struct rx_vector_2));
+
+	rx_vect2->rcpi1 =3D rx_vect2_leg.rcpi;
+	rx_vect2->rcpi2 =3D rx_vect2_leg.rcpi;
+	rx_vect2->rcpi3 =3D rx_vect2_leg.rcpi;
+	rx_vect2->rcpi4 =3D rx_vect2_leg.rcpi;
+
+	rx_vect2->evm1 =3D rx_vect2_leg.evm1;
+	rx_vect2->evm2 =3D rx_vect2_leg.evm2;
+	rx_vect2->evm3 =3D rx_vect2_leg.evm3;
+	rx_vect2->evm4 =3D rx_vect2_leg.evm4;
+}
