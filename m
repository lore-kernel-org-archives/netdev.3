+
+    airoha_fe_rmw(eth, REG_CDM_VLAN_CTRL(1),
+              CDM_VLAN_MASK | STAG_EN,
+              FIELD_PREP(CDM_VLAN_MASK, 0x8100) |
+              STAG_EN);
