+static void airoha_npu_debugfs_json_string(struct seq_file *m,
+                        const char *str)
+{
+    const unsigned char *p = (const unsigned char *)str;
+
+    seq_putc(m, '"');
+    for (; *p; p++) {
+        switch (*p) {
+        case '"':
+            seq_puts(m, "\\\"");
+            break;
+        case '\\':
+            seq_puts(m, "\\\\");
+            break;
+        case '\b':
+            seq_puts(m, "\\b");
+            break;
+        case '\f':
+            seq_puts(m, "\\f");
+            break;
+        case '\n':
+            seq_puts(m, "\\n");
+            break;
+        case '\r':
+            seq_puts(m, "\\r");
+            break;
+        case '\t':
+            seq_puts(m, "\\t");
+            break;
+        default:
+            if (*p < 0x20)
+                seq_printf(m, "\\u%04x", *p);
+            else
+                seq_putc(m, *p);
+            break;
+        }
+    }
+    seq_putc(m, '"');
+}
