+static int aic_request_irq(struct aic_data *aic)
+{
+	struct aic_device *bdev =3D aic->dev;
+	int err;
+
+	mutex_lock(&aic_device_lock);
+	if (!aic_device_exists(bdev)) {
+		err =3D -ENODEV;
+		goto unlock;
+	}
+
+	if (bdev->irq <=3D 0) {
+		err =3D -EOPNOTSUPP;
+		goto unlock;
+	}
+
+	err =3D devm_request_irq(bdev->dev, bdev->irq, aic_host_wake,
+			       bdev->irq_active_low ? IRQF_TRIGGER_FALLING
+			       : IRQF_TRIGGER_RISING, "host_wake", bdev);
+	if (err) {
+		bdev->irq =3D err;
+		goto unlock;
+	}
+
+	bdev->irq_acquired =3D true;
+
+	device_init_wakeup(bdev->dev, true);
+
+	pm_runtime_set_autosuspend_delay(bdev->dev, AIC_AUTOSUSPEND_DELAY);
+	pm_runtime_use_autosuspend(bdev->dev);
+	pm_runtime_set_active(bdev->dev);
+	pm_runtime_enable(bdev->dev);
+
+unlock:
+	mutex_unlock(&aic_device_lock);
+
+	return err;
+}
