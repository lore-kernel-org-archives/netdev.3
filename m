+static bool
+airoha_ppe_ipv4_tuple_match(const struct airoha_foe_ipv4_tuple *foe,
+                const struct airoha_ppe_skb_tuple *skb,
+                bool with_ports)
+{
+    if (skb->family != AIROHA_PPE_TUPLE_IPV4)
