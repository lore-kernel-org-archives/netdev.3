+static inline void find_matching_defrag_info(struct rwnx_hw *rwnx_hw,
+					     u16 seq_num, u8 tid, u8 sta_idx,
+					     struct defrag_ctrl_info **defrag_info,
+					     struct defrag_ctrl_info **defrag_info_tmp)
+{
+	struct defrag_ctrl_info *iter;
+
+	list_for_each_entry(iter, &rwnx_hw->defrag_list, list) {
+		if (iter->sn =3D=3D seq_num &&
+		    iter->tid =3D=3D tid &&
+		    iter->sta_idx =3D=3D sta_idx) {
+			*defrag_info_tmp =3D iter;
+			*defrag_info =3D *defrag_info_tmp;
+			break;
+		}
+	}
+}
+
+static int process_defrag_reassembly(struct rwnx_hw *rwnx_hw,
+				     struct defrag_ctrl_info *defrag_info,
+				     u16 frag_num,
+				     struct sk_buff *skb,
+				     u8 pull_len,
+				     struct hw_rxhdr *hw_rxhdr,
+				     u8 *is_frag,
+				     struct rwnx_vif **rwnx_vif,
+				     struct sk_buff **skb_tmp)
+{
+	if (!defrag_info) {
+		spin_unlock_bh(&rwnx_hw->defrag_lock);
+		return 1;
+	}
+
+	if (defrag_info->next_fn !=3D frag_num) {
+		AICWFDBG(LOGDEBUG, "discard:%d:%d\n",
+			 defrag_info->next_fn, frag_num);
+		dev_kfree_skb(skb);
+		spin_unlock_bh(&rwnx_hw->defrag_lock);
+		return 0;
+	}
+
+	skb_put(defrag_info->skb, skb->len - (pull_len - 8));
+	memcpy(&defrag_info->skb->data[defrag_info->frm_len],
+	       &skb->data[pull_len - 8],
+	       skb->len - (pull_len - 8));
+	defrag_info->frm_len +=3D skb->len - (pull_len - 8);
+	*is_frag =3D 1;
+
+	*rwnx_vif =3D rwnx_rx_get_vif(rwnx_hw, hw_rxhdr->flags_vif_idx);
+	if (!*rwnx_vif) {
+		AICWFDBG(LOGDEBUG, "Frame received but no active vif (%d)",
+			 hw_rxhdr->flags_vif_idx);
+		dev_kfree_skb(skb);
+		spin_unlock_bh(&rwnx_hw->defrag_lock);
+		return 0;
+	}
+
+	dev_kfree_skb(skb);
+	*skb_tmp =3D defrag_info->skb;
+	list_del_init(&defrag_info->list);
+	if (timer_pending(&defrag_info->defrag_timer))
+		del_timer(&defrag_info->defrag_timer);
+	kfree(defrag_info);
+	spin_unlock_bh(&rwnx_hw->defrag_lock);
+
+	if (!rwnx_rx_data_skb(rwnx_hw, *rwnx_vif, *skb_tmp, hw_rxhdr))
+		dev_kfree_skb(*skb_tmp);
+
+	return 0;
+}
+
+static inline void check_packet_forward_flags(struct rwnx_hw *rwnx_hw,
+					      struct hw_rxhdr *hw_rxhdr,
+					      struct rwnx_vif *rwnx_vif,
+					      bool *resend,
+					      bool *forward)
+{
+	if (hw_rxhdr->flags_dst_idx !=3D RWNX_INVALID_STA) {
+		struct rwnx_sta *sta =3D &rwnx_hw->sta_table[hw_rxhdr->flags_dst_idx];
+
+		if (sta->valid && sta->vlan_idx =3D=3D rwnx_vif->vif_index) {
+			*resend =3D true;
+			*forward =3D false;
+		}
+	}
+}
+
+u8 rwnx_rxdataind_aicwf(struct rwnx_hw *rwnx_hw, void *hostid, void *rx_pr=
iv)
+{
+	struct hw_rxhdr *hw_rxhdr;
+	struct rxdesc_tag *rxdesc =3D NULL;
+	struct rwnx_vif *rwnx_vif;
+	struct sk_buff *skb =3D hostid;
+	int msdu_offset =3D sizeof(struct hw_rxhdr) + 2;
+	u16_l status =3D 0;
+	struct aicwf_rx_priv *rx_priv_tmp;
+	u8 hdr_len =3D 24;
+	u8 ra[MAC_ADDR_LEN] =3D {0};
+	u8 ta[MAC_ADDR_LEN] =3D {0};
+	u8 ether_type[2] =3D {0};
+	u8 pull_len =3D 0;
+	u16 seq_num =3D 0;
+	u8_l frag_num =3D 0;
+	u8 tid =3D 0;
+	u8 is_qos =3D 0;
+	u8 is_frag =3D 0;
+	struct defrag_ctrl_info *defrag_info =3D NULL;
+	struct defrag_ctrl_info *defrag_info_tmp =3D NULL;
+	struct sk_buff *skb_tmp =3D NULL;
+	int ret;
+	u8 sta_idx =3D 0;
+	u16_l frame_ctrl;
+	u8 is_amsdu =3D 0;
+	bool resend =3D false, forward =3D true;
+	const struct ethhdr *eth;
+
+	hw_rxhdr =3D (struct hw_rxhdr *)skb->data;
+
+	if (hw_rxhdr->is_monitor_vif) {
+		status =3D RX_STAT_MONITOR;
+		AICWFDBG(LOGDEBUG, "monitor rx\n");
+	}
+
+	if (hw_rxhdr->flags_upload)
+		status |=3D RX_STAT_FORWARD;
+
+	/* Check if we need to delete the buffer */
+	if (status & RX_STAT_DELETE) {
+		/* Remove the SK buffer from the rxbuf_elems table */
+		/* Free the buffer */
+		dev_kfree_skb(skb);
+		goto end;
+	}
+
+	/* Check if we need to forward the buffer coming from a monitor interface=
 */
+	if (status & RX_STAT_MONITOR) {
+		struct sk_buff *skb_monitor;
+		struct hw_rxhdr hw_rxhdr_copy;
+		u8 rtap_len;
+		u16 frm_len;
+
+		// Check if monitor interface exists and is open
+		rwnx_vif =3D rwnx_rx_get_vif(rwnx_hw, rwnx_hw->monitor_vif);
+		if (!rwnx_vif) {
+			dev_err(rwnx_hw->dev,
+				"Received monitor frame but there is no monitor interface open\n");
+			goto check_len_update;
+		}
+
+		rwnx_rx_vector_convert(rwnx_hw, &hw_rxhdr->hwvect.rx_vect1,
+				       &hw_rxhdr->hwvect.rx_vect2);
+		rtap_len =3D rwnx_rx_rtap_hdrlen(&hw_rxhdr->hwvect.rx_vect1, false);
+
+		// Move skb->data pointer to MAC Header or Ethernet header
+		skb->data +=3D (msdu_offset + 2); // sdio/usb word align
+
+		// Save frame length
+		frm_len =3D le32_to_cpu(hw_rxhdr->hwvect.len);
+
+		// Reserve space for frame
+		skb->len =3D frm_len;
+
+		if (status =3D=3D RX_STAT_MONITOR) {
+			/*
+			 * Remove the SK buffer from the rxbuf_elems table. It will also
+			 * unmap the buffer and then sync the buffer for the cpu
+			 */
+
+			// Check if there is enough space to add the radiotap header
+			if (skb_headroom(skb) > rtap_len) {
+				skb_monitor =3D skb;
+
+				// Duplicate the HW Rx Header to override with the radiotap
+				// header
+				memcpy(&hw_rxhdr_copy, hw_rxhdr, sizeof(hw_rxhdr_copy));
+
+				hw_rxhdr =3D &hw_rxhdr_copy;
+
+				skb_reset_tail_pointer(skb);
+				skb->len =3D 0;
+				skb_reset_tail_pointer(skb_monitor);
+				skb_monitor->len =3D 0;
+				skb_put(skb_monitor, frm_len);
+				if (rwnx_rx_monitor(rwnx_hw, rwnx_vif,
+						    skb_monitor, hw_rxhdr, rtap_len))
+					dev_kfree_skb(skb_monitor);
+			} else {
+				// Duplicate the skb and extend the headroom
+				skb_monitor =3D skb_copy_expand(skb, rtap_len, 0, GFP_ATOMIC);
+
+				// Reset original skb->data pointer
+				skb->data =3D (void *)hw_rxhdr;
+
+				skb_reset_tail_pointer(skb);
+				skb->len =3D 0;
+				skb_reset_tail_pointer(skb_monitor);
+				skb_monitor->len =3D 0;
+				skb_put(skb_monitor, frm_len);
+				if (rwnx_rx_monitor(rwnx_hw, rwnx_vif,
+						    skb_monitor, hw_rxhdr, rtap_len))
+					dev_kfree_skb(skb_monitor);
+			}
+		} else {
+			skb->data =3D (void *)hw_rxhdr;
+
+			wiphy_err(rwnx_hw->wiphy,
+				  "RX status %d is invalid when MON_DATA is disabled\n",
+				  status);
+			goto check_len_update;
+		}
+
+		if (status =3D=3D RX_STAT_MONITOR) {
+			status |=3D RX_STAT_ALLOC;
+			if (skb_monitor !=3D skb)
+				dev_kfree_skb(skb);
+		}
+	}
+
+check_len_update:
+	/* Check if we need to update the length */
+	if (status & RX_STAT_LEN_UPDATE) {
+		if (rxdesc)
+			hw_rxhdr->hwvect.len =3D rxdesc->frame_len;
+
+		if (status & RX_STAT_ETH_LEN_UPDATE) {
+			/* Update Length Field inside the Ethernet Header */
+			struct ethhdr *hdr =3D
+				(struct ethhdr *)((u8 *)hw_rxhdr + msdu_offset);
+
+			if (rxdesc)
+				hdr->h_proto =3D htons(rxdesc->frame_len - sizeof(struct ethhdr));
+		}
+
+		goto end;
+	}
+
+	/* Check if it must be discarded after informing upper layer */
+	if (status & RX_STAT_SPURIOUS) {
+		struct ieee80211_hdr *hdr;
+
+		hdr =3D (struct ieee80211_hdr *)(skb->data + msdu_offset);
+		rwnx_vif =3D rwnx_rx_get_vif(rwnx_hw, hw_rxhdr->flags_vif_idx);
+		if (rwnx_vif) {
+#ifdef CONFIG_GKI
+			rwnx_cfg80211_rx_spurious_frame(rwnx_vif->ndev, hdr->addr2,
+							GFP_ATOMIC);
+#else
+			cfg80211_rx_spurious_frame(rwnx_vif->ndev, hdr->addr2, GFP_ATOMIC);
+#endif
+		}
+		goto end;
+	}
+
+	/* Check if we need to forward the buffer */
+	if (status & RX_STAT_FORWARD) {
+		rwnx_rx_vector_convert(rwnx_hw, &hw_rxhdr->hwvect.rx_vect1,
+				       &hw_rxhdr->hwvect.rx_vect2);
+		skb_pull(skb, msdu_offset + 2); //+2 since sdio align 58->60
+
+#define MAC_FCTRL_MOREFRAG 0x0400
+		frame_ctrl =3D (skb->data[1] << 8) | skb->data[0];
+		seq_num =3D ((skb->data[22] & 0xf0) >> 4) | (skb->data[23] << 4);
+		frag_num =3D (skb->data[22] & 0x0f);
+		is_amsdu =3D 0;
+
+		if ((skb->data[0] & 0x0f) =3D=3D 0x08) {
+			if ((skb->data[0] & 0x80) =3D=3D 0x80) { // qos data
+				hdr_len =3D 26;
+				tid =3D skb->data[24] & 0x0F;
+				is_qos =3D 1;
+				if (skb->data[24] & 0x80)
+					is_amsdu =3D 1;
+			}
+
+			if (skb->data[1] & 0x80) // htc
+				hdr_len +=3D 4;
+
+			if ((skb->data[1] & 0x3) =3D=3D 0x1) { // to ds
+				memcpy(ra, &skb->data[16], MAC_ADDR_LEN);
+				memcpy(ta, &skb->data[10], MAC_ADDR_LEN);
+			} else if ((skb->data[1] & 0x3) =3D=3D 0x2) { // from ds
+				memcpy(ta, &skb->data[16], MAC_ADDR_LEN);
+				memcpy(ra, &skb->data[4], MAC_ADDR_LEN);
+			}
+
+			pull_len +=3D (hdr_len + 8);
+
+			switch (hw_rxhdr->hwvect.decr_status) {
+			case RWNX_RX_HD_DECR_CCMP128:
+				pull_len +=3D 8; // ccmp_header
+				memcpy(ether_type, &skb->data[hdr_len + 6 + 8], 2);
+				break;
+			case RWNX_RX_HD_DECR_TKIP:
+				pull_len +=3D 8; // tkip_header
+				memcpy(ether_type, &skb->data[hdr_len + 6 + 8], 2);
+				break;
+			case RWNX_RX_HD_DECR_WEP:
+				pull_len +=3D 4; // wep_header
+				memcpy(ether_type, &skb->data[hdr_len + 6 + 4], 2);
+				break;
+			case RWNX_RX_HD_DECR_WAPI:
+				pull_len +=3D 18; // wapi_header
+				memcpy(ether_type, &skb->data[hdr_len + 6 + 18], 2);
+				break;
+
+			default:
+				memcpy(ether_type, &skb->data[hdr_len + 6], 2);
+				break;
+			}
+			if (is_amsdu)
+				hw_rxhdr->flags_is_amsdu =3D 1;
+			else
+				hw_rxhdr->flags_is_amsdu =3D 0;
+
+			if (is_amsdu)
+				skb_pull(skb, pull_len - 8);
+
+			if (hw_rxhdr->flags_dst_idx !=3D RWNX_INVALID_STA)
+				sta_idx =3D hw_rxhdr->flags_dst_idx;
+
+			if (!hw_rxhdr->flags_need_reord &&
+			    ((frame_ctrl & MAC_FCTRL_MOREFRAG) || frag_num)) {
+				AICWFDBG(LOGDEBUG, "rxfrag:%d,%d,%d,sn=3D%d,%d\r\n",
+					 (frame_ctrl & MAC_FCTRL_MOREFRAG), frag_num, skb->len,
+					 seq_num, pull_len);
+				if (frame_ctrl & MAC_FCTRL_MOREFRAG) {
+					spin_lock_bh(&rwnx_hw->defrag_lock);
+					if (!list_empty(&rwnx_hw->defrag_list)) {
+						find_defrag_info(rwnx_hw, seq_num, tid, sta_idx,
+								 &defrag_info, &defrag_info_tmp);
+					}
+					/* debug trace */
+					// AICWFDBG(LOGDEBUG,
+					// "rx frag: sn=3D%d, fn=3D%d, skb->len=3D%d\r\n", seq_num,
+					// frag_num, skb->len);
+					if (process_fragment_reassembly(defrag_info, frag_num,
+									skb, pull_len,
+									rwnx_hw, &is_frag) =3D=3D 0)
+						return 0;
+					defrag_info =3D
+						kzalloc(sizeof(struct defrag_ctrl_info),
+							GFP_KERNEL);
+					if (!defrag_info) {
+						AICWFDBG(LOGDEBUG,
+							 "no defrag_ctrl_info\r\n");
+						dev_kfree_skb(skb);
+						spin_unlock_bh(&rwnx_hw->defrag_lock);
+						return 0;
+					}
+					defrag_info->skb =3D __dev_alloc_skb(2000, GFP_KERNEL);
+					if (!defrag_info->skb) {
+						AICWFDBG(LOGDEBUG, "no fragment skb\r\n");
+						dev_kfree_skb(skb);
+						kfree(defrag_info);
+						spin_unlock_bh(&rwnx_hw->defrag_lock);
+						return 0;
+					}
+					is_frag =3D 1;
+					skb_pull(skb, pull_len);
+					skb_push(skb, 14);
+					memcpy(skb->data, ra, MAC_ADDR_LEN);
+					memcpy(&skb->data[6], ta, MAC_ADDR_LEN);
+					memcpy(&skb->data[12], ether_type, 2);
+					defrag_info->sn =3D seq_num;
+					defrag_info->next_fn =3D 1;
+					defrag_info->tid =3D tid;
+					defrag_info->sta_idx =3D sta_idx;
+
+					skb_put(defrag_info->skb, skb->len);
+					memcpy(defrag_info->skb->data, skb->data, skb->len);
+					defrag_info->frm_len =3D skb->len;
+					defrag_info->rwnx_hw =3D rwnx_hw;
+					/* debug trace */
+					// AICWFDBG(LOGDEBUG,
+					// "first:%p,%p,%p,%p,%p, %d,%d\r\n",defrag_info,
+					// defrag_info->skb, defrag_info->skb->head,
+					// defrag_info->skb->tail, defrag_info->skb->end,
+					// defrag_info->frm_len, skb->len);
+					list_add_tail(&defrag_info->list,
+						      &rwnx_hw->defrag_list);
+					spin_unlock_bh(&rwnx_hw->defrag_lock);
+					timer_setup(&defrag_info->defrag_timer,
+						    defrag_timeout_cb, 0);
+					ret =3D mod_timer(&defrag_info->defrag_timer,
+							jiffies +
+							msecs_to_jiffies(DEFRAG_MAX_WAIT));
+					dev_kfree_skb(skb);
+					return 0;
+				}
+				// check whether the last fragment
+				if (!list_empty(&rwnx_hw->defrag_list)) {
+					spin_lock_bh(&rwnx_hw->defrag_lock);
+					find_matching_defrag_info(rwnx_hw, seq_num, tid, sta_idx,
+								  &defrag_info, &defrag_info_tmp);
+
+					if (process_defrag_reassembly(rwnx_hw, defrag_info,
+								      frag_num, skb,
+								      pull_len, hw_rxhdr,
+								      &is_frag, &rwnx_vif,
+								      &skb_tmp) =3D=3D 0)
+						return 0;
+				}
+			}
+
+			if (!is_frag && !is_amsdu) {
+				skb_pull(skb, pull_len);
+				skb_push(skb, 14);
+				memcpy(skb->data, ra, MAC_ADDR_LEN);
+				memcpy(&skb->data[6], ta, MAC_ADDR_LEN);
+				memcpy(&skb->data[12], ether_type, 2);
+			}
+		}
+
+		if (hw_rxhdr->flags_is_80211_mpdu) {
+			remove_sec_hdr_mgmt_frame(hw_rxhdr, skb);
+			rwnx_rx_mgmt_any(rwnx_hw, skb, hw_rxhdr);
+		} else {
+			rwnx_vif =3D rwnx_rx_get_vif(rwnx_hw, hw_rxhdr->flags_vif_idx);
+
+			if (!rwnx_vif) {
+				dev_err(rwnx_hw->dev, "Frame received but no active vif(%d)",
+					hw_rxhdr->flags_vif_idx);
+				dev_kfree_skb(skb);
+				goto end;
+			}
+
+			if (hw_rxhdr->flags_sta_idx !=3D RWNX_INVALID_STA) {
+				struct rwnx_sta *sta;
+
+				sta =3D &rwnx_hw->sta_table[hw_rxhdr->flags_sta_idx];
+				rwnx_rx_statistic(rwnx_hw, hw_rxhdr, sta);
+
+				if (sta->vlan_idx !=3D rwnx_vif->vif_index) {
+					rwnx_vif =3D rwnx_hw->vif_table[sta->vlan_idx];
+					if (!rwnx_vif) {
+						dev_kfree_skb(skb);
+						goto end;
+					}
+				}
+
+				if (hw_rxhdr->flags_is_4addr && !rwnx_vif->use_4addr) {
+#ifdef CONFIG_GKI
+					rwnx_cfg80211_rx_unexpected_4addr_frame
+						(rwnx_vif->ndev, sta->mac_addr, GFP_ATOMIC);
+#else
+					cfg80211_rx_unexpected_4addr_frame
+						(rwnx_vif->ndev, sta->mac_addr, GFP_ATOMIC);
+#endif
+				}
+			}
+
+			skb->priority =3D 256 + tid; // hw_rxhdr->flags_user_prio;
+
+#ifdef AICWF_RX_REORDER
+			rx_priv_tmp =3D rx_priv;
+			rx_priv_tmp->rwnx_vif =3D (void *)rwnx_vif;
+
+			if (rwnx_vif->wdev.iftype =3D=3D NL80211_IFTYPE_STATION ||
+			    rwnx_vif->wdev.iftype =3D=3D NL80211_IFTYPE_P2P_CLIENT) {
+				if (is_qos && hw_rxhdr->flags_need_reord)
+					reord_process_unit((struct aicwf_rx_priv *)rx_priv, skb,
+							   seq_num, tid, 1,
+							   hw_rxhdr->flags_is_amsdu);
+				else if (is_qos && !hw_rxhdr->flags_need_reord) {
+					reord_flush_tid((struct aicwf_rx_priv *)rx_priv, skb, tid);
+					if (!rwnx_rx_data_skb(rwnx_hw, rwnx_vif, skb, hw_rxhdr) &&
+					    !hw_rxhdr->flags_is_amsdu)
+						dev_kfree_skb(skb);
+				} else {
+					if (!rwnx_rx_data_skb(rwnx_hw, rwnx_vif, skb, hw_rxhdr) &&
+					    !hw_rxhdr->flags_is_amsdu)
+						dev_kfree_skb(skb);
+				}
+			} else if ((rwnx_vif->wdev.iftype =3D=3D NL80211_IFTYPE_AP) ||
+					   (rwnx_vif->wdev.iftype =3D=3D NL80211_IFTYPE_P2P_GO)) {
+				skb_reset_mac_header(skb);
+				eth =3D eth_hdr(skb);
+				/* debug trace */
+				// AICWFDBG(LOGDEBUG,
+				// "da:%pM, %x,%x, len=3D%d\n", eth->h_dest, skb->data[12],
+				// skb->data[13], skb->len);
+
+				if (unlikely(is_multicast_ether_addr(eth->h_dest))) {
+					/*
+					 * broadcast pkt need to be forwarded to upper layer and
+					 * resent on wireless interface
+					 */
+					resend =3D true;
+				} else {
+					/*
+					 * unicast pkt for STA inside the BSS, no need to forward to
+					 * upper layer simply resend on wireless interface
+					 */
+					check_packet_forward_flags(rwnx_hw, hw_rxhdr,
+								   rwnx_vif, &resend,
+								   &forward);
+				}
+
+				if (resend)
+					rwnx_rx_data_skb_resend(rwnx_hw, rwnx_vif, skb, hw_rxhdr);
+
+				if (forward) {
+					if (is_qos && hw_rxhdr->flags_need_reord) {
+						reord_process_unit
+							((struct aicwf_rx_priv *)rx_priv, skb,
+							 seq_num, tid, 1,
+							 hw_rxhdr->flags_is_amsdu);
+					} else if (is_qos && !hw_rxhdr->flags_need_reord) {
+						reord_flush_tid
+							((struct aicwf_rx_priv *)rx_priv, skb,
+							 tid);
+						rwnx_rx_data_skb_forward(rwnx_hw, rwnx_vif, skb,
+									 hw_rxhdr);
+					} else {
+						rwnx_rx_data_skb_forward(rwnx_hw, rwnx_vif, skb,
+									 hw_rxhdr);
+					}
+				} else if (resend) {
+					if (is_qos && hw_rxhdr->flags_need_reord)
+						reord_process_unit
+							((struct aicwf_rx_priv *)rx_priv, skb,
+							 seq_num, tid, 0,
+							 hw_rxhdr->flags_is_amsdu);
+					else if (is_qos && !hw_rxhdr->flags_need_reord) {
+						reord_flush_tid
+							((struct aicwf_rx_priv *)rx_priv, skb,
+							 tid);
+						dev_kfree_skb(skb);
+					}
+				} else {
+					dev_kfree_skb(skb);
+				}
