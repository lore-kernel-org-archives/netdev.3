+/**
+ * @change_station: Modify a given station. Note that flags changes are no=
t much
+ *	validated in cfg80211, in particular the auth/assoc/authorized flags
+ *	might come to the driver in invalid combinations -- make sure to check
+ *	them, also against the existing state! Drivers must call
+ *	cfg80211_check_station_change() to validate the information.
+ */
+static int rwnx_cfg80211_change_station(struct wiphy *wiphy,
+					struct net_device *dev,
+					const u8 *mac,
+					struct station_parameters *params)
+{
+	struct rwnx_hw *rwnx_hw =3D wiphy_priv(wiphy);
+	struct rwnx_vif *vif =3D netdev_priv(dev);
+	struct rwnx_sta *sta;
+
+	sta =3D rwnx_get_sta(rwnx_hw, mac);
+	if (!sta) {
+		/* Add the TDLS station */
+		if (params->sta_flags_set & BIT(NL80211_STA_FLAG_TDLS_PEER)) {
+			struct rwnx_vif *rwnx_vif =3D netdev_priv(dev);
+			struct me_sta_add_cfm me_sta_add_cfm;
+			int error =3D 0;
+
+			/* Indicate we are in a STA addition process - This will allow
+			 * handling potential PS mode change indications correctly
+			 */
+			rwnx_hw->adding_sta =3D true;
+
+			/* Forward the information to the LMAC */
+			error =3D rwnx_send_me_sta_add(rwnx_hw, params, mac,
+						     rwnx_vif->vif_index, &me_sta_add_cfm);
+			if (error)
+				return error;
+
+			// Check the status
+			switch (me_sta_add_cfm.status) {
+			case CO_OK: {
+				int tid;
+
+				sta =3D &rwnx_hw->sta_table[me_sta_add_cfm.sta_idx];
+				sta->aid =3D params->aid;
+				sta->sta_idx =3D me_sta_add_cfm.sta_idx;
+				sta->ch_idx =3D rwnx_vif->ch_index;
+				sta->vif_idx =3D rwnx_vif->vif_index;
+				sta->vlan_idx =3D sta->vif_idx;
+				sta->qos =3D
+					(params->sta_flags_set & BIT(NL80211_STA_FLAG_WME)) !=3D 0;
+				sta->ht =3D params->link_sta_params.ht_capa ? 1 : 0;
+				sta->vht =3D params->link_sta_params.vht_capa ? 1 : 0;
+				sta->acm =3D 0;
+				for (tid =3D 0; tid < NX_NB_TXQ_PER_STA; tid++) {
+					int uapsd_bit =3D rwnx_hwq2uapsd[rwnx_tid2hwq[tid]];
+
+					if (params->uapsd_queues & uapsd_bit)
+						sta->uapsd_tids |=3D 1 << tid;
+					else
+						sta->uapsd_tids &=3D ~(1 << tid);
+				}
+				memcpy(sta->mac_addr, mac, ETH_ALEN);
+#ifdef CONFIG_RWNX_DEBUGFS
+				rwnx_dbgfs_register_rc_stat(rwnx_hw, sta);
+#endif
+				/* Ensure that we won't process PS change or channel switch ind
+				 */
+				spin_lock_bh(&rwnx_hw->cb_lock);
+				rwnx_txq_sta_init(rwnx_hw, sta,
+						  rwnx_txq_vif_get_status(rwnx_vif));
+				if (rwnx_vif->tdls_status =3D=3D TDLS_SETUP_RSP_TX) {
+					rwnx_vif->tdls_status =3D TDLS_LINK_ACTIVE;
+					sta->tdls.initiator =3D true;
+					sta->tdls.active =3D true;
+				}
+				/* Set TDLS channel switch capability */
+				if ((params->ext_capab[3] & WLAN_EXT_CAPA4_TDLS_CHAN_SWITCH) &&
+				    !rwnx_vif->tdls_chsw_prohibited)
+					sta->tdls.chsw_allowed =3D true;
+				rwnx_vif->sta.tdls_sta =3D sta;
+				sta->valid =3D true;
+				spin_unlock_bh(&rwnx_hw->cb_lock);
+#ifdef CONFIG_RWNX_BFMER
+				if (rwnx_hw->mod_params->bfmer)
+					rwnx_send_bfmer_enable(rwnx_hw, sta, params->vht_capa);
+
+				rwnx_mu_group_sta_init(sta, NULL);
+#endif /* CONFIG_RWNX_BFMER */
+
+#define PRINT_STA_FLAG(f)                                                 =
     \
+	(params->sta_flags_set & BIT(NL80211_STA_FLAG_##f) ? "[" #f "]" : "")
+
+				netdev_info(dev, "Add %s TDLS sta %d (%pM) flags=3D%s%s%s%s%s%s%s",
+					    sta->tdls.initiator ? "initiator" : "responder",
+					    sta->sta_idx, mac, PRINT_STA_FLAG(AUTHORIZED),
+					    PRINT_STA_FLAG(SHORT_PREAMBLE), PRINT_STA_FLAG(WME),
+					    PRINT_STA_FLAG(MFP), PRINT_STA_FLAG(AUTHENTICATED),
+					    PRINT_STA_FLAG(TDLS_PEER), PRINT_STA_FLAG(ASSOCIATED));
+#undef PRINT_STA_FLAG
+
+				break;
+			}
+			default:
+				error =3D -EBUSY;
+				break;
+			}
+			rwnx_hw->adding_sta =3D false;
+		} else {
+			return -EINVAL;
+		}
+	}
+
+	if (params->sta_flags_mask & BIT(NL80211_STA_FLAG_AUTHORIZED))
+		rwnx_send_me_set_control_port_req
+		(rwnx_hw,
+		 (params->sta_flags_set & BIT(NL80211_STA_FLAG_AUTHORIZED)) !=3D 0,
+		 sta->sta_idx);
+
+	if (RWNX_VIF_TYPE(vif) =3D=3D NL80211_IFTYPE_MESH_POINT) {
+		if (params->sta_modify_mask & STATION_PARAM_APPLY_PLINK_STATE) {
+			if (params->plink_state < NUM_NL80211_PLINK_STATES) {
+				rwnx_send_mesh_peer_update_ntf(rwnx_hw, vif, sta->sta_idx,
+							       params->plink_state);
+			}
+		}
+
+		if (params->local_pm !=3D NL80211_MESH_POWER_UNKNOWN) {
+			sta->mesh_pm =3D params->local_pm;
+			rwnx_update_mesh_power_mode(vif);
+		}
+	}
+
+	if (params->vlan) {
+		u8_l vlan_idx;
+
+		vif =3D netdev_priv(params->vlan);
+		vlan_idx =3D vif->vif_index;
+
+		if (sta->vlan_idx !=3D vlan_idx) {
+			struct rwnx_vif *old_vif;
+
+			old_vif =3D rwnx_hw->vif_table[sta->vlan_idx];
+			rwnx_txq_sta_switch_vif(sta, old_vif, vif);
+			sta->vlan_idx =3D vlan_idx;
+
+			if (RWNX_VIF_TYPE(vif) =3D=3D NL80211_IFTYPE_AP_VLAN &&
+			    vif->use_4addr) {
+				WARN(vif->ap_vlan.sta_4a,
+				     "4A AP_VLAN interface with more than one sta");
+				vif->ap_vlan.sta_4a =3D sta;
+			}
+
+			if (RWNX_VIF_TYPE(old_vif) =3D=3D NL80211_IFTYPE_AP_VLAN &&
+			    old_vif->use_4addr) {
+				old_vif->ap_vlan.sta_4a =3D NULL;
+			}
+		}
+	}
+	return 0;
+}
