+void rwnx_skb_append(struct sk_buff *old, struct sk_buff *newsk,
+		     struct sk_buff_head *list)
+{
+	unsigned long flags;
+	struct sk_buff *prev =3D old;
+	struct sk_buff *next =3D prev->next;
+
+	spin_lock_irqsave(&list->lock, flags);
+	WRITE_ONCE(newsk->next, next);
+	WRITE_ONCE(newsk->prev, prev);
+	WRITE_ONCE(next->prev, newsk);
+	WRITE_ONCE(prev->next, newsk);
+	list->qlen++;
+	spin_unlock_irqrestore(&list->lock, flags);
+}
+
+bool rwnx_ieee80211_chandef_to_operating_class(struct cfg80211_chan_def *c=
handef, u8 *op_class)
+{
+	u8 vht_opclass;
+	u32 freq =3D chandef->center_freq1;
+
+	if (freq >=3D 2412 && freq <=3D 2472) {
+		if (chandef->width > NL80211_CHAN_WIDTH_40)
+			return false;
+
+		/* 2.407 GHz, channels 1..13 */
+		if (chandef->width =3D=3D NL80211_CHAN_WIDTH_40) {
+			if (freq > chandef->chan->center_freq)
+				*op_class =3D 83; /* HT40+ */
+			else
+				*op_class =3D 84; /* HT40- */
+		} else {
+			*op_class =3D 81;
+		}
+
+		return true;
+	}
+
+	if (freq =3D=3D 2484) {
+		/* channel 14 is only for IEEE 802.11b */
+		if (chandef->width !=3D NL80211_CHAN_WIDTH_20_NOHT)
+			return false;
+
+		*op_class =3D 82; /* channel 14 */
+		return true;
+	}
+
+	switch (chandef->width) {
+	case NL80211_CHAN_WIDTH_80:
+		vht_opclass =3D 128;
+		break;
+	case NL80211_CHAN_WIDTH_160:
+		vht_opclass =3D 129;
+		break;
+	case NL80211_CHAN_WIDTH_80P80:
+		vht_opclass =3D 130;
+		break;
+	case NL80211_CHAN_WIDTH_10:
+	case NL80211_CHAN_WIDTH_5:
+		return false; /* unsupported for now */
+	default:
+		vht_opclass =3D 0;
+		break;
+	}
+
+	/* 5 GHz, channels 36..48 */
+	if (freq >=3D 5180 && freq <=3D 5240) {
+		if (vht_opclass) {
+			*op_class =3D vht_opclass;
+		} else if (chandef->width =3D=3D NL80211_CHAN_WIDTH_40) {
+			if (freq > chandef->chan->center_freq)
+				*op_class =3D 116;
+			else
+				*op_class =3D 117;
+		} else {
+			*op_class =3D 115;
+		}
+
+		return true;
+	}
+
+	/* 5 GHz, channels 52..64 */
+	if (freq >=3D 5260 && freq <=3D 5320) {
+		if (vht_opclass) {
+			*op_class =3D vht_opclass;
+		} else if (chandef->width =3D=3D NL80211_CHAN_WIDTH_40) {
+			if (freq > chandef->chan->center_freq)
+				*op_class =3D 119;
+			else
+				*op_class =3D 120;
+		} else {
+			*op_class =3D 118;
+		}
+
+		return true;
+	}
+
+	/* 5 GHz, channels 100..144 */
+	if (freq >=3D 5500 && freq <=3D 5720) {
+		if (vht_opclass) {
+			*op_class =3D vht_opclass;
+		} else if (chandef->width =3D=3D NL80211_CHAN_WIDTH_40) {
+			if (freq > chandef->chan->center_freq)
+				*op_class =3D 122;
+			else
+				*op_class =3D 123;
+		} else {
+			*op_class =3D 121;
+		}
+
+		return true;
+	}
+
+	/* 5 GHz, channels 149..169 */
+	if (freq >=3D 5745 && freq <=3D 5845) {
+		if (vht_opclass) {
+			*op_class =3D vht_opclass;
+		} else if (chandef->width =3D=3D NL80211_CHAN_WIDTH_40) {
+			if (freq > chandef->chan->center_freq)
+				*op_class =3D 126;
+			else
+				*op_class =3D 127;
+		} else if (freq <=3D 5805) {
+			*op_class =3D 124;
+		} else {
+			*op_class =3D 125;
+		}
+
+		return true;
+	}
+
+	/* 56.16 GHz, channel 1..4 */
+	if (freq >=3D 56160 + 2160 * 1 && freq <=3D 56160 + 2160 * 6) {
+		if (chandef->width >=3D NL80211_CHAN_WIDTH_40)
+			return false;
+
+		*op_class =3D 180;
+		return true;
+	}
+
+	/* not supported yet */
+	return false;
+}
