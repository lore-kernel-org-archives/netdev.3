+#else
+/**
+ * Handles HCI device events.
+ * @param this Not used.
+ * @param event The event that occurred.
+ * @param data The HCI device associated with the event.
+ * @return <code>NOTIFY_DONE</code>.
+ */
+static int bluesleep_hci_event(struct notifier_block *this, unsigned long =
event,
+			       void *data)
+{
+	struct hci_dev *hdev =3D (struct hci_dev *)data;
+	struct hci_uart *hu;
+	struct uart_state *state;
+
+	if (!hdev)
+		return NOTIFY_DONE;
+
+	switch (event) {
+	case HCI_DEV_REG:
+		if (!bluesleep_hdev) {
+			bluesleep_hdev =3D hdev;
+			hu =3D (struct hci_uart *)hdev->driver_data;
+			state =3D (struct uart_state *)hu->tty->driver_data;
+			bsi->uport =3D state->uart_port;
+		}
+		break;
+	case HCI_DEV_UNREG:
+		bluesleep_hdev =3D NULL;
+		bsi->uport =3D NULL;
+		break;
+	case HCI_DEV_WRITE:
+		bluesleep_outgoing_data();
+		break;
+	}
+
+	return NOTIFY_DONE;
+}
+#endif
+
+/**
+ * Function to check wheather bluetooth can sleep when btwrite was deasser=
ted
+ * by bluedroid.
+ */
+static void bluesleep_tx_allow_sleep(void)
+{
+	unsigned long irq_flags;
+
+	BT_DBG("Tx has been idle");
+	spin_lock_irqsave(&rw_lock, irq_flags);
+	gpio_set_value(bsi->ext_wake, !bsi->ext_wake_assert);
+	set_bit(BT_TXIDLE, &flags);
+	clear_bit(BT_TXDATA, &flags);
+	bluesleep_tx_idle();
+	spin_unlock_irqrestore(&rw_lock, irq_flags);
+}
+
+/* Handles reception timer expiration.
+ * Clear BT_RXTIMER.
+ * @param data Not used.
+ */
+static void bluesleep_rx_timer_expire(struct timer_list *t)
+{
+	// BT_DBG("bluesleep_rx_timer_expire");
+	clear_bit(BT_RXTIMER, &flags);
+	bluesleep_rx_idle();
+}
+
+/**
+ * Schedules a tasklet to run when receiving an interrupt on the
+ * <code>HOST_WAKE</code> GPIO pin.
+ * @param irq Not used.
+ * @param dev_id Not used.
+ */
+static irqreturn_t bluesleep_hostwake_isr(int irq, void *dev_id)
+{
+	// printk("bt_isr\n");
+	/* schedule a tasklet to handle the change in the host wake line */
+	tasklet_schedule(&hostwake_task);
+	return IRQ_HANDLED;
+}
+
+/**
+ * Starts the Sleep-Mode Protocol on the Host.
+ * @return On success, 0. On error, -1, and <code>errno</code> is set
+ * appropriately.
+ */
+static int bluesleep_start(void)
+{
+	int retval;
+	unsigned long irq_flags;
+
+	spin_lock_irqsave(&rw_lock, irq_flags);
+
+	if (test_bit(BT_PROTO, &flags)) {
+		spin_unlock_irqrestore(&rw_lock, irq_flags);
+		return 0;
+	}
+
+	spin_unlock_irqrestore(&rw_lock, irq_flags);
+
+	if (!atomic_dec_and_test(&open_count)) {
+		atomic_inc(&open_count);
+		return -EBUSY;
+	}
+
+	/* start the timer */
+	spin_lock_bh(&bsi->t_lock);
+	if (bsi->t_flag)
+		mod_timer(&rx_timer, jiffies + (RX_TIMER_INTERVAL * HZ));
+	else
+		BT_DBG("rx_timer should stop");
+	spin_unlock_bh(&bsi->t_lock);
+
+	/*deassert BT_WAKE first */
+	gpio_set_value(bsi->ext_wake, !bsi->ext_wake_assert);
+	msleep(20);
+
+	/* assert BT_WAKE */
+	gpio_set_value(bsi->ext_wake, bsi->ext_wake_assert);
+	retval =3D request_irq(bsi->host_wake_irq, bluesleep_hostwake_isr,
+			     IRQF_TRIGGER_FALLING | IRQF_TRIGGER_RISING,
+						 "bt_wakeup", &bsi->pdev->dev);
+	if (retval < 0) {
+		BT_ERR("Couldn't acquire BT_HOST_WAKE IRQ");
+		goto fail;
+	}
+
+	set_bit(BT_PROTO, &flags);
+
+	return 0;
+fail:
+	del_timer(&rx_timer);
+	atomic_inc(&open_count);
+
+	return retval;
+}
+
+/**
+ * Stops the Sleep-Mode Protocol on the Host.
+ */
+static __maybe_unused void bluesleep_stop(void)
+{
+	unsigned long irq_flags;
+
+	spin_lock_irqsave(&rw_lock, irq_flags);
+
+	if (!test_bit(BT_PROTO, &flags)) {
+		spin_unlock_irqrestore(&rw_lock, irq_flags);
+		return;
+	}
+
+	/* assert BT_WAKE */
+	gpio_set_value(bsi->ext_wake, bsi->ext_wake_assert);
+
+	del_timer(&rx_timer);
+	clear_bit(BT_PROTO, &flags);
+
+	if (test_bit(BT_ASLEEP, &flags)) {
+		clear_bit(BT_ASLEEP, &flags);
+		hsuart_power(1);
+	}
+
+	atomic_inc(&open_count);
+
+	spin_unlock_irqrestore(&rw_lock, irq_flags);
+	free_irq(bsi->host_wake_irq, &bsi->pdev->dev);
+
+	__pm_wakeup_event(bsi->ws, HZ / 2);
+}
+
+static int assert_level =3D -1;
+module_param(assert_level, int, 0444);
+MODULE_PARM_DESC(assert_level, "BT_LPM hostwake/btwake assert level");
+
+static struct platform_device *sw_uart_get_pdev(int id)
+{
+	struct device_node *np;
+	char match[20];
+
+	sprintf(match, "uart%d", id);
+	np =3D of_find_node_by_type(NULL, match);
+	return of_find_device_by_node(np);
+}
+
+static int __init bluesleep_probe(struct platform_device *pdev)
+{
+	struct device_node *np =3D pdev->dev.of_node;
+	struct device *dev =3D &pdev->dev;
+	int ret, uart_index;
+	u32 val;
+	struct aicbsp_feature_t bsp_feature_lpm;
+
+	bsi =3D devm_kzalloc(&pdev->dev, sizeof(struct bluesleep_info), GFP_KERNE=
L);
+	if (!bsi)
+		return -ENOMEM;
+
+	bsi->host_wake =3D of_get_named_gpio(np, "bt_wake_host", 0);
+
+	if (!gpio_is_valid(bsi->host_wake)) {
+		BT_ERR("get gpio bt_wake_host failed\n");
+		ret =3D -EINVAL;
+		goto err0;
+	}
+
+	/* set host_wake_assert */
+	aicbsp_get_feature(&bsp_feature_lpm, NULL);
+	if (bsp_feature_lpm.irqf =3D=3D 0)
+		bsi->host_wake_assert =3D 1;
+	else
+		bsi->host_wake_assert =3D 0;
+
+	BT_DBG("bt_wake_host gpio=3D%d assert=3D%d\n", bsi->host_wake,
+	       bsi->host_wake_assert);
+
+	if (assert_level !=3D -1) {
+		bsi->host_wake_assert =3D (assert_level & 0x02) > 0;
+		BT_DBG("override host_wake_bt assert to %d", bsi->host_wake_assert);
+	}
+
+	ret =3D devm_gpio_request(dev, bsi->host_wake, "bt_wake_host");
+	if (ret < 0) {
+		BT_ERR("can't request bt_wake_host gpio %d\n", bsi->host_wake);
+		goto err0;
+	}
+	ret =3D gpio_direction_input(bsi->host_wake);
+	if (ret < 0) {
+		BT_ERR("can't request input direction bt_wake_host gpio %d\n",
+		       bsi->host_wake);
+		goto err1;
+	}
+	if (!of_property_read_bool(np, "wakeup-source")) {
+		BT_DBG("wakeup source is disabled!\n");
+	} else {
+		ret =3D device_init_wakeup(dev, true);
+		if (ret < 0) {
+			BT_ERR("device init wakeup failed!\n");
+			goto err1;
+		}
+		ret =3D dev_pm_set_wake_irq(dev, gpio_to_irq(bsi->host_wake));
+		if (ret < 0) {
+			BT_ERR("can't enable wakeup src for bt_wake_host %d\n",
+			       bsi->host_wake);
+			goto err2;
+		}
+		bsi->wakeup_enable =3D 1;
+	}
+
+	bsi->ext_wake =3D of_get_named_gpio(np, "host_wake_bt", 0);
+
+	if (!gpio_is_valid(bsi->ext_wake)) {
+		BT_ERR("get gpio host_wake_bt failed\n");
+		ret =3D -EINVAL;
+		goto err2;
+	}
+
+	ret =3D devm_gpio_request(dev, bsi->ext_wake, "host_wake_bt");
+	if (ret < 0) {
+		BT_ERR("can't request host_wake_bt gpio %d\n", bsi->ext_wake);
+		goto err2;
+	}
+
+	/* set ext_wake_assert */
+	bsi->ext_wake_assert =3D 1;
+	BT_DBG("host_wake_bt gpio=3D%d assert=3D%d\n", bsi->ext_wake,
+	       bsi->ext_wake_assert);
+
+	if (assert_level !=3D -1) {
+		bsi->ext_wake_assert =3D (assert_level & 0x01) > 0;
+		BT_DBG("override ext_wake assert to %d", bsi->ext_wake_assert);
+	}
+
+	/* 1.set bt_wake as output and the level is assert, assert bt wake */
+	ret =3D gpio_direction_output(bsi->ext_wake, bsi->ext_wake_assert);
+	if (ret < 0) {
+		BT_ERR("can't request output direction host_wake_bt gpio %d\n",
+		       bsi->ext_wake);
+		goto err3;
+	}
+	/*set ext_wake deassert as default */
+	gpio_set_value(bsi->ext_wake, !bsi->ext_wake_assert);
+
+	/* 2.get bt_host_wake gpio irq */
+	bsi->host_wake_irq =3D gpio_to_irq(bsi->host_wake);
+	if (bsi->host_wake_irq < 0) {
+		BT_ERR("map gpio [%d] to virq failed, errno =3D %d\n", bsi->host_wake,
+		       bsi->host_wake_irq);
+		ret =3D -ENODEV;
+		goto err3;
+	}
+
+	uart_index =3D DEFAULT_UART_INDEX;
+	if (!of_property_read_u32(np, "uart_index", &val)) {
+		switch (val) {
+		case 0:
+		case 1:
+		case 2:
+		case 3:
+			uart_index =3D val;
+			break;
+		default:
+			BT_ERR("unsupported uart_index (%u)\n", val);
+		}
+	}
+	BT_DBG("uart_index (%u)\n", uart_index);
+	bluesleep_uart_dev =3D sw_uart_get_pdev(uart_index);
+
+	bsi->ws =3D wakeup_source_register(dev, "bluesleep");
+	bsi->pdev =3D pdev;
+
+	bsi->t_flag =3D 1;
+	spin_lock_init(&bsi->t_lock);
+
+	return 0;
+
+err3:
+err2:
+	device_init_wakeup(dev, false);
+err1:
+err0:
+	devm_kfree(dev, bsi);
+
+	BT_ERR("probe fail, err: %d", ret);
+	return ret;
+}
+
+static void bluesleep_remove(struct platform_device *pdev)
+{
+	/* assert bt wake */
+	gpio_set_value(bsi->ext_wake, !bsi->ext_wake_assert);
+
+	spin_lock_bh(&bsi->t_lock);
+	bsi->t_flag =3D 0;
+	spin_unlock_bh(&bsi->t_lock);
+
+	cancel_delayed_work_sync(&sleep_workqueue);
+
+	if (test_bit(BT_PROTO, &flags)) {
+		free_irq(bsi->host_wake_irq, &bsi->pdev->dev);
+		//BT_DBG("del rx_timer");
+		//del_timer(&rx_timer);
+		if (test_bit(BT_ASLEEP, &flags))
+			hsuart_power(1);
+	}
+
+	del_timer(&rx_timer);
+
+	gpio_free(bsi->host_wake);
+	gpio_free(bsi->ext_wake);
+
+	wakeup_source_unregister(bsi->ws);
+	if (bsi->wakeup_enable) {
+		BT_DBG("Deinit wakeup source");
+		device_init_wakeup(&pdev->dev, false);
+		dev_pm_clear_wake_irq(&pdev->dev);
+	}
+}
+
+#ifdef CONFIG_AUTO_PM
+static int bluesleep_suspend(struct platform_device *pdev, pm_message_t st=
ate)
+{
+	BT_DBG("enter");
+
+	clear_bit(BT_RXTIMER, &flags);
+	bluesleep_tx_allow_sleep();
+
+	return 0;
+}
+
+static int bluesleep_resume(struct platform_device *pdev)
+{
+	BT_DBG("enter");
+
+	bluesleep_outgoing_data();
+
+	return 0;
+}
+#endif
+
+static const struct of_device_id aic_btlpm_ids[] =3D {
+	{.compatible =3D "aic,btlpm-wake-host"}, {/* Sentinel */}};
+
+static struct platform_driver bluesleep_driver =3D {
+	.remove =3D bluesleep_remove,
+#ifdef CONFIG_AUTO_PM
+	.suspend =3D bluesleep_suspend,
+	.resume =3D bluesleep_resume,
+#endif
+	.driver =3D {
+			.owner =3D THIS_MODULE,
+			.name =3D "aic-btlpm",
+			.of_match_table =3D aic_btlpm_ids,
+		},
+};
+
+/**
+ * Initializes the module.
+ * @return On success, 0. On error, -1, and <code>errno</code> is set
+ * appropriately.
+ */
+static int __init bluesleep_init(void)
+{
+	int retval;
+	struct proc_dir_entry *ent;
+
+	//BT_DBG("BlueSleep Mode Driver Ver %s", VERSION);
+	pr_info("AIC_BTLPM RELEASE VERSION: %s\n", RELEASE_VERSION);
+
+#ifdef CONFIG_BT_IND_PWR
+	if (aicbsp_set_subsys(AIC_BLUETOOTH, AIC_PWR_ON) < 0)
+		BT_ERR("power on fail");
+#endif
+
+	retval =3D platform_driver_probe(&bluesleep_driver, bluesleep_probe);
+	if (retval)
+		return retval;
+
+#if !BT_BLUEDROID_SUPPORT
+	bluesleep_hdev =3D NULL;
+#endif
+
+	bluetooth_dir =3D proc_mkdir("bluetooth", NULL);
+	if (!bluetooth_dir) {
+		BT_ERR("Unable to create /proc/bluetooth directory");
+		return -ENOMEM;
+	}
+
+	sleep_dir =3D proc_mkdir("sleep", bluetooth_dir);
+	if (!sleep_dir) {
+		BT_ERR("Unable to create /proc/%s directory", PROC_DIR);
+		return -ENOMEM;
+	}
+#if BT_BLUEDROID_SUPPORT
+	/* read/write proc entries */
+	ent =3D proc_create("lpm", 0660, sleep_dir, &lpm_fops);
+	if (!ent) {
+		BT_ERR("Unable to create /proc/%s/lpm entry", PROC_DIR);
+		retval =3D -ENOMEM;
+		goto fail;
+	}
+
+	ent =3D proc_create("btwrite", 0660, sleep_dir, &btwrite_fops);
+	if (!ent) {
+		BT_ERR("Unable to create /proc/%s/btwrite entry", PROC_DIR);
+		retval =3D -ENOMEM;
+		goto fail;
+	}
+#endif
+
+	flags =3D 0; /* clear all status bits */
+
+	/* Initialize spinlock. */
+	spin_lock_init(&rw_lock);
+
+	/* Initialize timer */
+	timer_setup(&rx_timer, bluesleep_rx_timer_expire, 0);
+
+	/* initialize host wake tasklet */
+	tasklet_init(&hostwake_task, bluesleep_hostwake_task, 0);
+
+#if !BT_BLUEDROID_SUPPORT
+	hci_register_notifier(&hci_event_nblock);
+#endif
+
+#ifdef CONFIG_AUTO_PM
+	bluesleep_outgoing_data();
+
+	clear_bit(BT_PAUSE, &flags);
+	/* HCI_DEV_REG */
+	if (!has_lpm_enabled) {
+		has_lpm_enabled =3D true;
+		if (bluesleep_uart_dev)
+			bsi->uport =3D bluesleep_get_uart_port();
+
+		/* if bluetooth started, start bluesleep */
+		bluesleep_start();
+	}
+#endif
+
+	return 0;
+
+fail:
+#if BT_BLUEDROID_SUPPORT
+	remove_proc_entry("btwrite", sleep_dir);
+	remove_proc_entry("lpm", sleep_dir);
+#endif
+	remove_proc_entry("sleep", bluetooth_dir);
+	remove_proc_entry("bluetooth", 0);
+	return retval;
+}
+
+/**
+ * Cleans up the module.
+ */
+static void __exit bluesleep_exit(void)
+{
+#if !BT_BLUEDROID_SUPPORT
+	hci_unregister_notifier(&hci_event_nblock);
+#endif
+	platform_driver_unregister(&bluesleep_driver);
+
+#if BT_BLUEDROID_SUPPORT
+	remove_proc_entry("btwrite", sleep_dir);
+	remove_proc_entry("lpm", sleep_dir);
+#endif
+	remove_proc_entry("sleep", bluetooth_dir);
+	remove_proc_entry("bluetooth", 0);
+
+#ifdef CONFIG_BT_IND_PWR
+	if (aicbsp_set_subsys(AIC_BLUETOOTH, AIC_PWR_OFF) < 0)
+		BT_ERR("power on fail");
+#endif
+}
+
+module_init(bluesleep_init);
+module_exit(bluesleep_exit);
+
+MODULE_DESCRIPTION("Bluetooth Sleep Mode Driver ver %s " VERSION);
+#ifdef MODULE_LICENSE
+MODULE_LICENSE("GPL");
+#endif
