+static void rwnx_tdls_add_ext_capab(struct rwnx_hw *rwnx_hw,
+				    struct sk_buff *skb)
+{
+	u8 *pos =3D (void *)skb_put(skb, 7);
+	bool chan_switch =3D
+		rwnx_hw->wiphy->features & NL80211_FEATURE_TDLS_CHANNEL_SWITCH;
+
+	*pos++ =3D WLAN_EID_EXT_CAPABILITY;
+	*pos++ =3D 5; /* len */
+	*pos++ =3D 0x0;
+	*pos++ =3D 0x0;
+	*pos++ =3D 0x0;
+	*pos++ =3D WLAN_EXT_CAPA4_TDLS_BUFFER_STA |
+			 (chan_switch ? WLAN_EXT_CAPA4_TDLS_CHAN_SWITCH : 0);
+	*pos++ =3D WLAN_EXT_CAPA5_TDLS_ENABLED;
+}
