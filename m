+static int aic_gpio_set_power(struct aic_device *dev, bool powered)
+{
+	int err;
+
+	if (powered && !dev->res_enabled) {
+		/* Intel Macs use aic_apple_get_resources() and don't
+		 * have regulator supplies configured.
+		 */
+		if (dev->supplies[0].supply) {
+			err =3D regulator_bulk_enable(AIC_NUM_SUPPLIES, dev->supplies);
+			if (err)
+				return err;
+		}
+
+		/* LPO clock needs to be 32.768 kHz */
+		err =3D clk_set_rate(dev->lpo_clk, 32768);
+		if (err) {
+			dev_err(dev->dev, "Could not set LPO clock rate\n");
+			goto err_regulator_disable;
+		}
+
+		err =3D clk_prepare_enable(dev->lpo_clk);
+		if (err)
+			goto err_regulator_disable;
+
+		err =3D clk_prepare_enable(dev->txco_clk);
+		if (err)
+			goto err_lpo_clk_disable;
+	}
+
+	err =3D dev->set_shutdown(dev, powered);
+	if (err)
+		goto err_txco_clk_disable;
+
+	err =3D dev->set_device_wakeup(dev, powered);
+	if (err)
+		goto err_revert_shutdown;
+
+	if (!powered && dev->res_enabled) {
+		clk_disable_unprepare(dev->txco_clk);
+		clk_disable_unprepare(dev->lpo_clk);
+
+		/* Intel Macs use aic_apple_get_resources() and don't
+		 * have regulator supplies configured.
+		 */
+		if (dev->supplies[0].supply)
+			regulator_bulk_disable(AIC_NUM_SUPPLIES, dev->supplies);
+	}
+
+	/* wait for device to power on and come out of reset */
+	usleep_range(100000, 120000);
+
+	dev->res_enabled =3D powered;
+
+	return 0;
+
+err_revert_shutdown:
+	dev->set_shutdown(dev, !powered);
+err_txco_clk_disable:
+	if (powered && !dev->res_enabled)
+		clk_disable_unprepare(dev->txco_clk);
+err_lpo_clk_disable:
+	if (powered && !dev->res_enabled)
+		clk_disable_unprepare(dev->lpo_clk);
+err_regulator_disable:
+	if (powered && !dev->res_enabled)
+		regulator_bulk_disable(AIC_NUM_SUPPLIES, dev->supplies);
+	return err;
+}
