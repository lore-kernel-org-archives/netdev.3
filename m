+static void rwnx_rc_stat_work(struct work_struct *ws)
+{
+	struct rwnx_debugfs *rwnx_debugfs =3D
+		container_of(ws, struct rwnx_debugfs, rc_stat_work);
+	struct rwnx_hw *rwnx_hw =3D
+		container_of(rwnx_debugfs, struct rwnx_hw, debugfs);
+	struct rwnx_sta *sta;
+	u8_l ridx, sta_idx;
+
+	ridx =3D rwnx_debugfs->rc_read;
+	sta_idx =3D rwnx_debugfs->rc_sta[ridx];
+	if (sta_idx > (NX_REMOTE_STA_MAX + NX_VIRT_DEV_MAX)) {
+		WARN(1, "Invalid sta index %d", sta_idx);
+		return;
+	}
+
+	rwnx_debugfs->rc_sta[ridx] =3D 0xFF;
+	ridx =3D (ridx + 1) % ARRAY_SIZE(rwnx_debugfs->rc_sta);
+	rwnx_debugfs->rc_read =3D ridx;
+	sta =3D &rwnx_hw->sta_table[sta_idx];
+	if (!sta) {
+		WARN(1, "Invalid sta %d", sta_idx);
+		return;
+	}
+
+	if (!rwnx_debugfs->dir_sta[sta_idx]) {
+		/* register the sta */
+		struct dentry *dir_rc =3D rwnx_debugfs->dir_rc;
+		struct dentry *dir_sta;
+		struct dentry *file;
+		char sta_name[18];
+		struct rwnx_rx_rate_stats *rate_stats =3D &sta->stats.rx_rate;
+		int nb_rx_rate =3D N_CCK + N_OFDM;
+		struct rwnx_rc_config_save *rc_cfg, *next;
+
+		if (sta->sta_idx >=3D NX_REMOTE_STA_MAX)
+			scnprintf(sta_name, sizeof(sta_name), "bc_mc");
+		else
+			scnprintf(sta_name, sizeof(sta_name), "%pM", sta->mac_addr);
+
+		dir_sta =3D debugfs_create_dir(sta_name, dir_rc);
+		if (!dir_sta)
+			goto error;
+
+		rwnx_debugfs->dir_sta[sta->sta_idx] =3D dir_sta;
+
+		file =3D debugfs_create_file("stats", 0400, dir_sta, rwnx_hw,
+					   &rwnx_dbgfs_rc_stats_ops);
+		if (IS_ERR_OR_NULL(file))
+			goto error_after_dir;
+
+		file =3D debugfs_create_file("fixed_rate_idx", 0200, dir_sta, rwnx_hw,
+					   &rwnx_dbgfs_rc_fixed_rate_idx_ops);
+		if (IS_ERR_OR_NULL(file))
+			goto error_after_dir;
+
+		file =3D debugfs_create_file("rx_rate", 0600, dir_sta,
+					   rwnx_hw, &rwnx_dbgfs_last_rx_ops);
+		if (IS_ERR_OR_NULL(file))
+			goto error_after_dir;
+
+		if (rwnx_hw->mod_params->ht_on)
+			nb_rx_rate +=3D N_HT;
+
+		if (rwnx_hw->mod_params->vht_on)
+			nb_rx_rate +=3D N_VHT;
+
+		if (rwnx_hw->mod_params->he_on)
+			nb_rx_rate +=3D N_HE_SU + N_HE_MU;
+
+		rate_stats->table =3D
+			kcalloc(nb_rx_rate, sizeof(rate_stats->table[0]), GFP_KERNEL);
+		if (!rate_stats->table)
+			goto error_after_dir;
+
+		rate_stats->size =3D nb_rx_rate;
+		rate_stats->cpt =3D 0;
+		rate_stats->rate_cnt =3D 0;
+
+		/* By default enable rate controller */
+		rwnx_debugfs->rc_config[sta_idx] =3D -1;
+
+		/* Unless we already fix the rate for this station */
+		list_for_each_entry_safe(rc_cfg, next, &rwnx_debugfs->rc_config_save,
+					 list) {
+			if (jiffies_to_msecs(jiffies - rc_cfg->timestamp) > RC_CONFIG_DUR) {
+				list_del(&rc_cfg->list);
+				kfree(rc_cfg);
+			} else if (!memcmp(rc_cfg->mac_addr, sta->mac_addr, ETH_ALEN)) {
+				rwnx_debugfs->rc_config[sta_idx] =3D rc_cfg->rate;
+				list_del(&rc_cfg->list);
+				kfree(rc_cfg);
+				break;
+			}
+		}
+
+		if (rwnx_debugfs->rc_config[sta_idx] >=3D 0 &&
+		    rwnx_send_me_rc_set_rate(rwnx_hw, sta_idx,
+					     (u16)rwnx_debugfs->rc_config[sta_idx]))
+			rwnx_debugfs->rc_config[sta_idx] =3D -1;
+	} else {
+		/* unregister the sta */
+		kfree(sta->stats.rx_rate.table);
+		sta->stats.rx_rate.table =3D NULL;
+		sta->stats.rx_rate.size =3D 0;
+		sta->stats.rx_rate.cpt =3D 0;
+		sta->stats.rx_rate.rate_cnt =3D 0;
+
+		/* If fix rate was set for this station, save the configuration in case
+		 * we reconnect to this station within RC_CONFIG_DUR msec
+		 */
+		if (rwnx_debugfs->rc_config[sta_idx] >=3D 0) {
+			struct rwnx_rc_config_save *rc_cfg;
+
+			rc_cfg =3D kmalloc(sizeof(*rc_cfg), GFP_KERNEL);
+			if (rc_cfg) {
+				rc_cfg->rate =3D rwnx_debugfs->rc_config[sta_idx];
+				rc_cfg->timestamp =3D jiffies;
+				memcpy(rc_cfg->mac_addr, sta->mac_addr, ETH_ALEN);
+				list_add_tail(&rc_cfg->list, &rwnx_debugfs->rc_config_save);
+			}
+		}
+
+		debugfs_remove_recursive(rwnx_debugfs->dir_sta[sta_idx]);
+		rwnx_debugfs->dir_sta[sta->sta_idx] =3D NULL;
+	}
+
+	return;
+
+error_after_dir:
+	debugfs_remove_recursive(rwnx_debugfs->dir_sta[sta_idx]);
+	rwnx_debugfs->dir_sta[sta->sta_idx] =3D NULL;
+error:
+	AICWFDBG(LOGDEBUG,
+		 "AICWF Error while (un)registering debug entry for sta %d\n", sta_idx);
+}
+
+void _rwnx_dbgfs_rc_stat_write(struct rwnx_debugfs *rwnx_debugfs,
+			       uint8_t sta_idx)
+{
+	u8_l widx =3D rwnx_debugfs->rc_write;
+
+	if (rwnx_debugfs->rc_sta[widx] !=3D 0XFF)
+		WARN(1, "Overlap in debugfs rc_sta table\n");
+
+	if (rwnx_debugfs->unregistering)
+		return;
+
+	rwnx_debugfs->rc_sta[widx] =3D sta_idx;
+	widx =3D (widx + 1) % ARRAY_SIZE(rwnx_debugfs->rc_sta);
+	rwnx_debugfs->rc_write =3D widx;
+
+	schedule_work(&rwnx_debugfs->rc_stat_work);
+}
+
+void rwnx_dbgfs_register_rc_stat(struct rwnx_hw *rwnx_hw, struct rwnx_sta =
*sta)
+{
+	_rwnx_dbgfs_rc_stat_write(&rwnx_hw->debugfs, sta->sta_idx);
+}
