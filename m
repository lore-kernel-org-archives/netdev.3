+/**
+ * rwnx_amsdu_del_subframe_header - remove AMSDU header
+ *
+ * amsdu_txhdr: amsdu tx descriptor
+ *
+ * Move back the ethernet header at the "beginning" of the data buffer.
+ * (which has been moved in @rwnx_amsdu_add_subframe_header)
+ */
+static void rwnx_amsdu_del_subframe_header(struct rwnx_amsdu_txhdr *amsdu_=
txhdr)
+{
+	struct sk_buff *skb =3D amsdu_txhdr->skb;
+	struct ethhdr *eth;
+	u8 *pos;
+
+	pos =3D skb->data;
+	pos +=3D sizeof(struct rwnx_amsdu_txhdr);
+	eth =3D (struct ethhdr *)pos;
+	pos +=3D amsdu_txhdr->pad + sizeof(struct ethhdr);
+
+	if (ntohs(eth->h_proto) >=3D ETH_P_802_3_MIN)
+		pos +=3D sizeof(rfc1042_header) + 2;
+
+	memmove(pos, eth, sizeof(*eth));
+	skb_pull(skb, (pos - skb->data));
+}
