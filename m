+	disable_irq(sdiodev->wf_wake_host);
+
+	sdiodev->host_wake_wf =3D of_get_named_gpio(node, "host_wake_wifi", 0);
+
+	if (!gpio_is_valid(sdiodev->host_wake_wf)) {
