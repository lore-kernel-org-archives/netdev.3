+# SPDX-License-Identifier: GPL-2.0 OR BSD-3-Clause
+menuconfig AIC8800
+	tristate "aic8800 wireless chips support"
+	help
+	  This module adds support for aic8800 wireless drivers.
+	  If you choose to build a module, it'll be called aic8800.
+
+if AIC8800
+
+menuconfig AIC_WLAN_SUPPORT
+	tristate "AIC wireless Support"
+	default m
+	help
+	  This is support for aic wireless chip.
+
+if AIC_WLAN_SUPPORT
+source "drivers/net/wireless/aic/aic8800/aic8800_bsp/Kconfig"
+endif
+
+menuconfig AIC8800_WLAN_SUPPORT
+  depends on AIC_WLAN_SUPPORT
+  tristate "AIC8800 WLAN Support"
+  default m
+  help
+    This is support for aic wifi driver.
+
+if AIC8800_WLAN_SUPPORT
+source "drivers/net/wireless/aic/aic8800/aic8800_fdrv/Kconfig"
+endif
+
+menuconfig AIC8800_BTLPM_SUPPORT
+  depends on AIC_WLAN_SUPPORT
+  tristate "AIC8800 bluetooth Support (UART)"
+  default m
+  help
+    This is support for aic uart bluetooh driver.
+
+if AIC8800_BTLPM_SUPPORT
+source "drivers/net/wireless/aic/aic8800/aic8800_btlpm/Kconfig"
+endif
+
+menuconfig AIC_HCIUART_BT
+  depends on AIC_WLAN_SUPPORT
+  tristate "AIC Bluetooth HCI UART Support"
+  default m
+  help
+    Enable Bluetooth HCI UART support for AIC controllers.
+    This driver provides HCI over serial port (UART) for AIC Bluetooth chi=
ps.
+    Say 'M' to build as a module, or 'Y' to compile directly into the kern=
el.
+
+if AIC_HCIUART_BT
+source "drivers/net/wireless/aic/aic8800/hci_aic/Kconfig"
+endif
+
+config AIC_FW_PATH
+	depends on AIC_WLAN_SUPPORT
+	string "Firmware & config file path"
+	default "/vendor/etc/firmware"
+	#default "/lib/firmware/aic8800_sdio"
+	help
+	  Path to the firmware & config file.
+
+if AIC_WLAN_SUPPORT
+
+config USE_FW_REQUEST
+  bool "Enable firmware request support"
+  default n
+  help
+    Enable firmware loading support for the driver.
+
+config PREALLOC_RX_SKB
+  bool "Preallocate RX SKBs"
+  default n
+  help
+    Preallocate RX SKBs for better performance.
+
+config PREALLOC_TXQ
+  bool "Preallocate TX queue buffers"
+  default y
+  help
+    Preallocate TX queue buffers to reduce runtime allocation overhead.
+
+config OOB
+  bool "Enable Out-of-Band (OOB) support"
+  default n
+  help
+    Enable OOB (Out-of-Band) communication support.
+
+config GPIO_WAKEUP
+  bool "Enable GPIO wakeup support"
+  default n
+  help
+    Enable wakeup via GPIO interrupt.
+
+config RESV_MEM_SUPPORT
+  bool "Enable reserved memory support"
+  default y
+  help
+    Enable reserved memory allocation for DMA buffers.
+
+config PLATFORM_EXTERNAL
+  bool "Enable external platform support"
+  default y
+  help
+    This option enables support for external hardware platforms.
+    Say Y to include drivers for external devices (default).
+
+config SDIO_SUPPORT
+  bool "Enable SDIO interface support"
+  default y
+  help
+    This option enables SDIO bus support for the driver.
+    Say Y to enable SDIO functionality.
+
+config SDIO_PWRCTRL
+  bool "Enable SDIO power control"
+  default y
+  help
+    This option allows dynamic power management for SDIO devices.
+    Say Y to enable power saving features.
+
+config MCU_MESSAGE
+  bool "Enable MCU message support"
+  default n
+  help
+    This option enables support for MCU message communication.
+    Say N to disable this feature (default).
+
+config USE_FW_REQUEST
+  bool "Enable firmware request support"
+  default n
+  help
+    This option enables firmware loading support for the driver.
+    Say N to disable firmware request functionality (default).
+
+config FDRV_NO_REG_SDIO
+  bool "Disable SDIO register access"
+  default n
+  help
+    This option disables direct SDIO register access for the driver.
+    Say N to keep SDIO register access enabled (default).
+
+config VRF_DCDC_MODE
+  bool "Enable VRF DCDC mode"
+  default y
+  help
+    This option enables DCDC mode for VRF (Voltage Regulator Function).
+    Say Y to enable power-efficient DCDC operation (default).
+
+config DPD
+  bool "Enable DPD support"
+  default y
+  help
+    This option enables DPD (Digital Pre-Distortion or other features).
+    Say 'Y' here to compile DPD support directly into the kernel.
+    If unsure, keep the default value.
+
+config FORCE_DPD_CALIB
+  bool "Force DPD calibration"
+  default y
+  help
+    This option forces DPD (Digital Pre-Distortion) calibration during ini=
tialization.
+    Enabling this may improve signal accuracy but could increase boot time=
.
+    Say 'Y' here unless you have specific reasons to disable it.
+
+config SDIO_BT
+  bool "SDIO Bluetooth support"
+  default n
+  help
+    Enable SDIO Bluetooth interface support.
+    This option provides basic SDIO Bluetooth functionality.
+    Say 'Y' here if you need Bluetooth over SDIO.
+
+endif
+
+endif
