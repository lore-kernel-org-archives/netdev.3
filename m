+static void rwnx_set_wiphy_params(struct rwnx_hw *rwnx_hw, struct wiphy *w=
iphy)
+{
+#ifdef CONFIG_RWNX_FULLMAC
+	/* FULLMAC specific parameters */
+	wiphy->flags |=3D WIPHY_FLAG_REPORTS_OBSS;
+	wiphy->max_scan_ssids =3D SCAN_SSID_MAX;
+	wiphy->max_scan_ie_len =3D SCANU_MAX_IE_LEN;
+#endif /* CONFIG_RWNX_FULLMAC */
+
+	if (rwnx_hw->mod_params->tdls) {
+		/* TDLS support */
+		wiphy->flags |=3D WIPHY_FLAG_SUPPORTS_TDLS;
+#ifdef CONFIG_RWNX_FULLMAC
+		/* TDLS external setup support */
+		wiphy->flags |=3D WIPHY_FLAG_TDLS_EXTERNAL_SETUP;
+#endif
+	}
+
+	if (rwnx_hw->mod_params->ap_uapsd_on)
+		wiphy->flags |=3D WIPHY_FLAG_AP_UAPSD;
+
+#ifdef CONFIG_RWNX_FULLMAC
+	if (rwnx_hw->mod_params->ps_on)
+		wiphy->flags |=3D WIPHY_FLAG_PS_ON_BY_DEFAULT;
+	else
+		wiphy->flags &=3D ~WIPHY_FLAG_PS_ON_BY_DEFAULT;
+#endif
+
+	if (rwnx_hw->mod_params->custregd) {
+		// Check if custom channel set shall be enabled. In such case only
+		// monitor mode is supported
+		if (rwnx_hw->mod_params->custchan) {
+			wiphy->interface_modes =3D BIT(NL80211_IFTYPE_MONITOR);
+
+			// Enable "extra" channels
+			wiphy->bands[NL80211_BAND_2GHZ]->n_channels +=3D 13;
+			if (rwnx_hw->band_5g_support)
+				wiphy->bands[NL80211_BAND_5GHZ]->n_channels +=3D 59;
+		}
+	}
