+static int aicwf_set_scan(struct net_device *dev, struct iw_request_info *=
a,
+			  union iwreq_data *wrqu, char *extra)
+{
+	int ret =3D 0;
+	struct rwnx_vif *rwnx_vif =3D netdev_priv(dev);
+	struct rwnx_hw *rwnx_hw =3D rwnx_vif->rwnx_hw;
+	struct cfg80211_scan_request *request;
+	int index =3D 0;
+	struct wiphy *wiphy =3D priv_to_wiphy(rwnx_hw);
+	unsigned long wext_scan_timeout;
+
+	if (!wiphy)
+		pr_err("aic_wiphy error \r\n");
+
+	if (rwnx_hw->wext_scan || scanning) {
+		AICWFDBG(LOGINFO, "is scanning, abort\n");
+		ret =3D  rwnx_send_scanu_cancel_req(rwnx_hw, NULL);
+		if (ret)
+			return ret;
+		msleep(150);
+	}
+
+	rwnx_hw->wext_scan =3D 1;
+
+	request =3D vmalloc(sizeof(*request));
+
+	request->n_channels =3D rwnx_hw->support_freqs_number;
+	request->n_ssids =3D 0;
+	request->no_cck =3D false;
+	request->ie =3D NULL;
+	request->ie_len =3D 0;
+
+	for (index =3D 0; index < rwnx_hw->support_freqs_number; index++) {
+		request->channels[index] =3D ieee80211_get_channel(wiphy,
+								 rwnx_hw->support_freqs[index]);
+		if (!request->channels[index]) {
+			AICWFDBG(LOGERROR, "%s ERROR!!! channels is NULL", __func__);
+			continue;
+		}
+	}
+
+#if WIRELESS_EXT >=3D 17
+		if (wrqu->data.length =3D=3D sizeof(struct iw_scan_req)) {
+			struct iw_scan_req *req =3D (struct iw_scan_req *)extra;
+
+			if (wrqu->data.flags & IW_SCAN_THIS_ESSID) {
+				int len =3D min_t(int, req->essid_len, 32);
+
+				request->ssids =3D kmalloc(sizeof(*request->ssids), GFP_KERNEL);
+				if (!request->ssids) {
+					AICWFDBG(LOGERROR, "%s Failed to alloc memory for ssids",
+						 __func__);
+					return -ENOMEM;
+				}
+				memset(request->ssids, 0, sizeof(struct cfg80211_ssid));
+				memcpy(request->ssids[0].ssid, req->essid, len);
+				request->ssids[0].ssid_len =3D len;
+				request->n_ssids =3D 1;
+				AICWFDBG(LOGDEBUG, "IW_SCAN_THIS_ESSID, ssid=3D%s, len=3D%d\n",
+					 req->essid, req->essid_len);
+			} else if (req->scan_type =3D=3D IW_SCAN_TYPE_PASSIVE) {
+				AICWFDBG(LOGDEBUG,
+					 "aic_set_scan, req->scan_type =3D=3D IW_SCAN_TYPE_PASSIVE\n");
+			}
+		}
+#endif
+	ret =3D rwnx_send_scanu_req(rwnx_hw, rwnx_vif, request);
+	if (ret)
+		return ret;
+
+	rwnx_vif->rwnx_hw->scan_request =3D request;
+	wext_scan_timeout =3D msecs_to_jiffies(5000);
+
+	if (!wait_for_completion_killable_timeout(&rwnx_hw->wext_scan_com,
+						  wext_scan_timeout)) {
+		AICWFDBG(LOGERROR, "%s WEXT scan timeout", __func__);
+	}
+	return 0;
+}
