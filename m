+int hci_recv_fragment(struct hci_dev *hdev, int type, void *data, int coun=
t)
+{
+	int rem =3D 0;
+
+	if (type < HCI_ACLDATA_PKT || type > HCI_EVENT_PKT)
+		return -EILSEQ;
+
+	while (count) {
+		rem =3D hci_reassembly(hdev, type, data, count, type - 1);
+		if (rem < 0)
+			return rem;
+
+		data +=3D (count - rem);
+		count =3D rem;
+	}
+
+	return rem;
+}
