+#ifdef AICWF_ARP_OFFLOAD
+
+static void handle_dhcp_ack(u8 *option, u16 offset, struct dhcpinfo *dhcph=
,
+			    struct rwnx_vif *rwnx_vif)
+{
+	if (option[offset] =3D=3D DHCP_OPTION_MESSAGE_TYPE &&
+	    option[offset + 2] =3D=3D DHCP_ACK) {
+		dhcped =3D 1;
+		AICWFDBG(LOGINFO, "paired=3D%x, should=3D%x\n",
+			 rwnx_vif->sta.paired_cipher_type,
+			 WLAN_CIPHER_SUITE_CCMP);
+
+		if (rwnx_vif->sta.paired_cipher_type =3D=3D WLAN_CIPHER_SUITE_CCMP ||
+		    rwnx_vif->sta.paired_cipher_type =3D=3D WLAN_CIPHER_SUITE_AES_CMAC |=
|
+		    (rwnx_vif->sta.group_cipher_type =3D=3D 0xff &&
+		     rwnx_vif->sta.paired_cipher_type =3D=3D 0xff)) {
+			rwnx_send_arpoffload_en_req(rwnx_vif->rwnx_hw, rwnx_vif, dhcph->yiaddr,=
 1);
+		} else {
+			rwnx_send_arpoffload_en_req(rwnx_vif->rwnx_hw, rwnx_vif, dhcph->yiaddr,=
 0);
+		}
+	}
+}
+
+void arpoffload_proc(struct sk_buff *skb, struct rwnx_vif *rwnx_vif)
+{
+	struct iphdr *iphead =3D (struct iphdr *)(skb->data);
+	struct udphdr *udph;
+	struct dhcpinfo *dhcph;
+
+	if (skb->protocol =3D=3D htons(ETH_P_IP) && iphead->protocol =3D=3D IPPRO=
TO_UDP) {    // IP && UDP
+		udph =3D (struct udphdr *)((u8 *)iphead + (iphead->ihl << 2));
+		if (udph->source =3D=3D htons(SERVER_PORT) &&
+		    udph->dest =3D=3D htons(CLIENT_PORT)) { // DHCP offset/ack
+			dhcph =3D (struct dhcpinfo *)((u8 *)udph + sizeof(struct udphdr));
+			if (dhcph->cookie =3D=3D htonl(DHCP_MAGIC) && dhcph->op =3D=3D 2 &&
+			    !memcmp(dhcph->chaddr, rwnx_vif->ndev->dev_addr, 6)) {
+				// match magic word
+				u32 length =3D ntohs(udph->len) - sizeof(struct udphdr) -
+						offsetof(struct dhcpinfo, options);
+				u16 offset =3D 0;
+				u8 *option =3D dhcph->options;
+
+				while (option[offset] !=3D DHCP_OPTION_END && offset < length) {
+					handle_dhcp_ack(option, offset, dhcph, rwnx_vif);
+					offset +=3D 2 + option[offset + 1];
+				}
+			}
+		}
+	}
+}
