+/**
+ * @connect: Connect to the ESS with the specified parameters. When connec=
ted,
+ *	call cfg80211_connect_result() with status code %WLAN_STATUS_SUCCESS.
+ *	If the connection fails for some reason, call cfg80211_connect_result()
+ *	with the status from the AP.
+ *	(invoked with the wireless_dev mutex held)
+ */
+static int rwnx_cfg80211_connect(struct wiphy *wiphy, struct net_device *d=
ev,
+				 struct cfg80211_connect_params *sme)
+{
+	struct rwnx_hw *rwnx_hw =3D wiphy_priv(wiphy);
+	struct rwnx_vif *rwnx_vif =3D netdev_priv(dev);
+	struct sm_connect_cfm sm_connect_cfm;
+	int error =3D 0;
+	int is_wep =3D (sme->crypto.cipher_group =3D=3D WLAN_CIPHER_SUITE_WEP40 |=
|
+		      sme->crypto.cipher_group =3D=3D WLAN_CIPHER_SUITE_WEP104 ||
+		      sme->crypto.ciphers_pairwise[0] =3D=3D WLAN_CIPHER_SUITE_WEP40 ||
+		      sme->crypto.ciphers_pairwise[0] =3D=3D WLAN_CIPHER_SUITE_WEP104);
+
+	RWNX_DBG(RWNX_FN_ENTRY_STR);
+
+	if ((int)atomic_read(&rwnx_vif->drv_conn_state) =3D=3D (int)RWNX_DRV_STAT=
US_CONNECTED) {
+		AICWFDBG(LOGDEBUG, "%s this connection is roam \r\n", __func__);
+		rwnx_vif->sta.is_roam =3D true;
+	} else {
+		rwnx_vif->sta.is_roam =3D false;
+	}
+
+	if ((int)atomic_read(&rwnx_vif->drv_conn_state) =3D=3D (int)RWNX_DRV_STAT=
US_DISCONNECTING ||
+	    (int)atomic_read(&rwnx_vif->drv_conn_state) =3D=3D (int)RWNX_DRV_STAT=
US_CONNECTING) {
+		AICWFDBG(LOGERROR,
+			 "%s driver is disconnecting or connecting ,return it \r\n",
+			 __func__);
+		return 0;
+	}
+
+	if (rwnx_vif->sta.is_roam)
+		rwnx_set_conn_state(&rwnx_vif->drv_conn_state, (int)RWNX_DRV_STATUS_ROAM=
ING);
+	else
+		rwnx_set_conn_state(&rwnx_vif->drv_conn_state, (int)RWNX_DRV_STATUS_CONN=
ECTING);
+
+	if (is_wep) {
+		if (sme->auth_type =3D=3D NL80211_AUTHTYPE_AUTOMATIC) {
+			if (rwnx_vif->wep_enabled && rwnx_vif->wep_auth_err) {
+				if (rwnx_vif->last_auth_type =3D=3D NL80211_AUTHTYPE_SHARED_KEY)
+					sme->auth_type =3D NL80211_AUTHTYPE_OPEN_SYSTEM;
+				else
+					sme->auth_type =3D NL80211_AUTHTYPE_SHARED_KEY;
+			} else {
+				if (rwnx_vif->wep_enabled && !rwnx_vif->wep_auth_err)
+					sme->auth_type =3D rwnx_vif->last_auth_type;
+				else
+					sme->auth_type =3D NL80211_AUTHTYPE_SHARED_KEY;
+			}
+			AICWFDBG(LOGDEBUG, "AICWF auto: use sme->auth_type =3D %d\r\n",
+				 sme->auth_type);
+		} else {
+			if (rwnx_vif->wep_enabled && rwnx_vif->wep_auth_err &&
+			    sme->auth_type =3D=3D rwnx_vif->last_auth_type) {
+				if (sme->auth_type =3D=3D NL80211_AUTHTYPE_SHARED_KEY) {
+					sme->auth_type =3D NL80211_AUTHTYPE_OPEN_SYSTEM;
+					AICWFDBG(LOGDEBUG,
+						 "AICWF start connect, auth_type changed, shared --> open\n");
+				} else if (sme->auth_type =3D=3D NL80211_AUTHTYPE_OPEN_SYSTEM) {
+					sme->auth_type =3D NL80211_AUTHTYPE_SHARED_KEY;
+					AICWFDBG(LOGDEBUG,
+						 "AICWF start connect, auth_type changed, open --> shared\n");
+				}
+			}
+		}
+	}
+
+	/* For SHARED-KEY authentication, must install key first */
+	if (sme->auth_type =3D=3D NL80211_AUTHTYPE_SHARED_KEY && sme->key) {
+		struct key_params key_params;
+
+		key_params.key =3D (u8 *)sme->key;
+		key_params.seq =3D NULL;
+		key_params.key_len =3D sme->key_len;
+		key_params.seq_len =3D 0;
+		key_params.cipher =3D sme->crypto.cipher_group;
+		rwnx_cfg80211_add_key(wiphy, dev, 0,
+				      sme->key_idx, false, NULL, &key_params);
+	} else if (sme->auth_type =3D=3D NL80211_AUTHTYPE_SAE &&
+		 !(sme->flags & CONNECT_REQ_EXTERNAL_AUTH_SUPPORT)) {
+		netdev_err(dev,
+			   "Doesn't support SAE without external authentication\n");
+		return -EINVAL;
+	}
+
+	if (rwnx_vif->wdev.iftype =3D=3D NL80211_IFTYPE_P2P_CLIENT)
+		rwnx_hw->is_p2p_connected =3D 1;
+
+	if (rwnx_vif->wdev.iftype =3D=3D NL80211_IFTYPE_STATION ||
+	    rwnx_vif->wdev.iftype =3D=3D NL80211_IFTYPE_P2P_CLIENT) {
+		rwnx_vif->sta.paired_cipher_type =3D 0xff;
+		rwnx_vif->sta.group_cipher_type =3D 0xff;
+	}
+
+	/* Forward the information to the LMAC */
+	error =3D rwnx_send_sm_connect_req(rwnx_hw, rwnx_vif, sme, &sm_connect_cf=
m);
+	if (error)
+		return error;
+
+	// Check the status
+	switch (sm_connect_cfm.status) {
+	case CO_OK:
+		error =3D 0;
+		break;
+	case CO_BUSY:
+		error =3D -EINPROGRESS;
+		break;
+	case CO_OP_IN_PROGRESS:
+		error =3D -EALREADY;
+		break;
+	default:
+		error =3D -EIO;
+		break;
+	}
+
+	return error;
+}
