+static void rwnx_tdls_add_bss_coex_ie(struct sk_buff *skb)
+{
+	u8 *pos =3D (void *)skb_put(skb, 3);
+
+	*pos++ =3D WLAN_EID_BSS_COEX_2040;
+	*pos++ =3D 1; /* len */
+
+	*pos++ =3D WLAN_BSS_COEX_INFORMATION_REQUEST;
+}
