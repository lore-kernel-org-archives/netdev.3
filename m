+static inline void host_set_baudrate(struct hci_uart *hu, unsigned int spe=
ed)
+{
+	if (hu->serdev)
+		serdev_device_set_baudrate(hu->serdev, speed);
+	else
+		aic_hci_uart_set_baudrate(hu, speed);
+}
+
+static int aic_set_baudrate(struct hci_uart *hu, unsigned int speed)
+{
+	struct hci_dev *hdev =3D hu->hdev;
+	struct sk_buff *skb;
+	struct aic_update_uart_baud_rate param;
+
+	if (speed > 3000000) {
+		struct aic_write_uart_clock_setting clock;
+
+		clock.type =3D AIC_UART_CLOCK_48MHZ;
+
+		bt_dev_dbg(hdev, "Set Controller clock (%d)", clock.type);
+
+		/* This Broadcom specific command changes the UART's controller
+		 * clock for baud rate > 3000000.
+		 */
+		skb =3D __hci_cmd_sync(hdev, 0xfc45, 1, &clock, HCI_INIT_TIMEOUT);
+		if (IS_ERR(skb)) {
+			int err =3D PTR_ERR(skb);
+
+			bt_dev_err(hdev, "AIC: failed to write clock (%d)", err);
+			return err;
+		}
+
+		kfree_skb(skb);
+	}
+
+	bt_dev_dbg(hdev, "Set Controller UART speed to %d bit/s", speed);
+
+	param.zero =3D cpu_to_le16(0);
+	param.baud_rate =3D cpu_to_le32(speed);
+
+	/* This Broadcom specific command changes the UART's controller baud
+	 * rate.
+	 */
+	skb =3D __hci_cmd_sync(hdev, 0xfc18, sizeof(param), &param, HCI_INIT_TIME=
OUT);
+	if (IS_ERR(skb)) {
+		int err =3D PTR_ERR(skb);
+
+		bt_dev_err(hdev, "AIC: failed to write update baudrate (%d)", err);
+		return err;
+	}
+
+	kfree_skb(skb);
+
+	return 0;
+}
+
+/* aic_device_exists should be protected by aic_device_lock */
+static bool aic_device_exists(struct aic_device *device)
+{
+	struct list_head *p;
+
+#ifdef CONFIG_PM
+	/* Devices using serdev always exist */
+	if (device && device->hu && device->hu->serdev)
+		return true;
+#endif
+
+	list_for_each(p, &aic_device_list)
+	{
+		struct aic_device *dev =3D list_entry(p, struct aic_device, list);
+
+		if (device =3D=3D dev)
+			return true;
+	}
+
+	return false;
+}
