+	req->chan.prim20_freq =3D center_freq;
+	req->chan.center1_freq =3D center_freq1;
+	req->chan.center2_freq =3D center_freq2;
+	req->chan.tx_power =3D tx_power;
+	req->chan.flags =3D flags;
