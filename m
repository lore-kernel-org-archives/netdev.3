+/**
+ * rwnx_rx_rtap_hdrlen - Return radiotap header length
+ *
+ * @rxvect: Rx vector used to fill the radiotap header
+ * @has_vend_rtap: boolean indicating if vendor specific data is present
+ *
+ * Compute the length of the radiotap header based on @rxvect and vendor
+ * specific data (if any).
+ */
+static u8 rwnx_rx_rtap_hdrlen(struct rx_vector_1 *rxvect, bool has_vend_rt=
ap)
+{
+	u8 rtap_len;
+
+	/* Compute radiotap header length */
+	rtap_len =3D sizeof(struct ieee80211_radiotap_header) + 8;
+
+	// Check for multiple antennas
+	if (hweight32(rxvect->antenna_set) > 1)
+		// antenna and antenna signal fields
+		rtap_len +=3D 4 * hweight8(rxvect->antenna_set);
+
+	// TSFT
+	if (!has_vend_rtap) {
+		rtap_len =3D ALIGN(rtap_len, 8);
+		rtap_len +=3D 8;
+	}
+
+	// IEEE80211_HW_SIGNAL_DBM
+	rtap_len++;
+
+	// Check if single antenna
+	if (hweight32(rxvect->antenna_set) =3D=3D 1)
+		rtap_len++; // Single antenna
+
+	// padding for RX FLAGS
+	rtap_len =3D ALIGN(rtap_len, 2);
+
+	// Check for HT frames
+	if (rxvect->format_mod =3D=3D FORMATMOD_HT_MF ||
+	    rxvect->format_mod =3D=3D FORMATMOD_HT_GF)
+		rtap_len +=3D 3;
+
+	// Check for AMPDU
+	if (!(has_vend_rtap) &&
+	    (rxvect->format_mod >=3D FORMATMOD_VHT ||
+	     (rxvect->format_mod > FORMATMOD_NON_HT_DUP_OFDM &&
+	      rxvect->ht.aggregation))) {
+		rtap_len =3D ALIGN(rtap_len, 4);
+		rtap_len +=3D 8;
+	}
+
+	// Check for VHT frames
+	if (rxvect->format_mod =3D=3D FORMATMOD_VHT) {
+		rtap_len =3D ALIGN(rtap_len, 2);
+		rtap_len +=3D 12;
+	}
+
+	// Check for HE frames
+	if (rxvect->format_mod =3D=3D FORMATMOD_HE_SU) {
+		rtap_len =3D ALIGN(rtap_len, 2);
+		rtap_len +=3D sizeof(struct ieee80211_radiotap_he);
+	}
+
+	// Check for multiple antennas
+	if (hweight32(rxvect->antenna_set) > 1) {
+		// antenna and antenna signal fields
+		rtap_len +=3D 2 * hweight8(rxvect->antenna_set);
+	}
+
+	// Check for vendor specific data
+	if (has_vend_rtap) {
+		/* vendor presence bitmap */
+		rtap_len +=3D 4;
+		/* alignment for fixed 6-byte vendor data header */
+		rtap_len =3D ALIGN(rtap_len, 2);
+	}
+
+	return rtap_len;
+}
