+int rwnx_atoi(char *value)
+{
+	int len =3D 0;
+	int i =3D 0;
+	int result =3D 0;
+	int flag =3D 1;
+
+	if (value[0] =3D=3D '-') {
+		flag =3D -1;
+		value++;
+	}
+	len =3D strlen(value);
+
+	for (i =3D 0; i < len; i++) {
+		result =3D result * 10;
+		if (value[i] >=3D 48 && value[i] <=3D 57) {
+			result +=3D value[i] - 48;
+		} else {
+			result =3D 0;
+			break;
+		}
+	}
+
+	return result * flag;
+}
