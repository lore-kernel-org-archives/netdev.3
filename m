+ * Bitfield accessors for: gdm_mymac_msb
+ * MAC address bytes a,b (indices 0-1) and LSB matching mask
+ */
+#define GDM_MYMAC_MSB_LSB_MASK_MASK            GENMASK(23, 16)
+#define GDM_MYMAC_MSB_A_MASK                GENMASK(15, 8)
