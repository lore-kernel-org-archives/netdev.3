+static int aicwf_get_rate(struct net_device *dev,
+			  struct iw_request_info *info,
+			   union iwreq_data *wrqu, char *extra)
+{
+	u16 max_rate =3D 0;
+	struct rwnx_vif *rwnx_vif =3D netdev_priv(dev);
+	struct rwnx_hw *rwnx_hw =3D rwnx_vif->rwnx_hw;
+	struct rwnx_sta *sta =3D NULL;
+
+	union rwnx_rate_ctrl_info *rate_info;
+	struct mm_get_sta_info_cfm cfm;
+	u16 tmp =3D 0;
+
+	if (rwnx_vif->sta.ap) {
+		sta =3D rwnx_vif->sta.ap;
+		rwnx_send_get_sta_info_req(rwnx_hw, sta->sta_idx, &cfm);
+			rate_info =3D (union rwnx_rate_ctrl_info *)&cfm.rate_info;
+			ht_tmp =3D VHT_MCS_DATA_RATE[rate_info->bw_tx][1][rate_info->mcs_index_=
tx];
+			he_tmp =3D HE_MCS_DATA_RATE[rate_info->bw_tx][rate_info->mcs_index_tx];
+
+			switch (rate_info->format_mod_tx) {
+			case FORMATMOD_NON_HT:
+			case FORMATMOD_NON_HT_DUP_OFDM:
+				//get bg mode datarate
+				max_rate =3D tx_legrates_lut_rate[rate_info->mcs_index_tx] / 10;
+				break;
+			case FORMATMOD_HT_MF:
+			case FORMATMOD_HT_GF:
+			case FORMATMOD_VHT:
+				//get bg mode MCS index
+				max_rate =3D tmp / 2;
+				break;
+			case FORMATMOD_HE_MU:
+			case FORMATMOD_HE_SU:
+			case FORMATMOD_HE_ER:
+				//get bg mode MCS index
+				max_rate =3D he_tmp;
+				break;
+			}
+	}
+
+	wrqu->bitrate.fixed =3D 0;	/* no auto select */
+	wrqu->bitrate.value =3D max_rate * 1000000;
+
+	return 0;
+}
