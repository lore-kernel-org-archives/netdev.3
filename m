+static unsigned char *scan_tlv(unsigned char *data, int len, unsigned char=
 tag,
+			       unsigned char len8b)
+{
+	while (len > 0) {
+		if (*data =3D=3D tag && *(data + 1) =3D=3D len8b && len >=3D len8b * 8)
+			return data + 2;
+
+		len -=3D (*(data + 1)) * 8;
+		data +=3D (*(data + 1)) * 8;
+	}
+	return NULL;
+}
