+static const int ru_size[] =3D {26, 52, 106, 242, 484, 996};
+
+static int print_rate(char *buf, int size, int format, int nss, int mcs, i=
nt bw,
+		      int sgi, int pre, int *r_idx)
+{
+	int res =3D 0;
+	int bitrates_cck[4] =3D {10, 20, 55, 110};
+	int bitrates_ofdm[8] =3D {6, 9, 12, 18, 24, 36, 48, 54};
+	char he_gi[3][4] =3D {"0.8", "1.6", "3.2"};
+
+	if (format < FORMATMOD_HT_MF) {
+		if (mcs < 4) {
+			if (r_idx) {
+				*r_idx =3D (mcs * 2) + pre;
+				res =3D scnprintf(buf, size - res, "%3d ", *r_idx);
+			}
+			res +=3D scnprintf(&buf[res], size - res,
+					 "L-CCK/%cP      %2u.%1uM    ", pre > 0 ? 'L' : 'S',
+					 bitrates_cck[mcs] / 10, bitrates_cck[mcs] % 10);
+		} else {
+			mcs -=3D 4;
+			if (r_idx) {
+				*r_idx =3D N_CCK + mcs;
+				res =3D scnprintf(buf, size - res, "%3d ", *r_idx);
+			}
+			res +=3D scnprintf(&buf[res], size - res, "L-OFDM        %2u.0M    ",
+					 bitrates_ofdm[mcs]);
+		}
+	} else if (format < FORMATMOD_VHT) {
+		if (r_idx) {
+			*r_idx =3D N_CCK + N_OFDM + nss * 32 + mcs * 4 + bw * 2 + sgi;
+			res =3D scnprintf(buf, size - res, "%3d ", *r_idx);
+		}
+		mcs +=3D nss * 8;
+		res +=3D scnprintf(&buf[res], size - res, "HT%d/%cGI       MCS%-2d   ",
+				 20 * (1 << bw), sgi ? 'S' : 'L', mcs);
+	} else if (format =3D=3D FORMATMOD_VHT) {
+		if (r_idx) {
+			*r_idx =3D N_CCK + N_OFDM + N_HT + nss * 80 + mcs * 8 + bw * 2 + sgi;
+			res =3D scnprintf(buf, size - res, "%3d ", *r_idx);
+		}
+		res +=3D scnprintf(&buf[res], size - res, "VHT%d/%cGI%*cMCS%d/%1d  ",
+				 20 * (1 << bw), sgi ? 'S' : 'L', bw > 2 ? 5 : 6, ' ',
+				 mcs, nss + 1);
+	} else if (format =3D=3D FORMATMOD_HE_SU) {
+		if (r_idx) {
+			*r_idx =3D N_CCK + N_OFDM + N_HT + N_VHT + nss * 144 + mcs * 12 +
+					bw * 3 + sgi;
+			res =3D scnprintf(buf, size - res, "%3d ", *r_idx);
+		}
+		res +=3D scnprintf(&buf[res], size - res, "HE%d/GI%s%*cMCS%d/%1d%*c",
+				 20 * (1 << bw), he_gi[sgi], bw > 2 ? 4 : 5, ' ', mcs,
+				 nss + 1, mcs > 9 ? 1 : 2, ' ');
+	} else {
+		if (r_idx) {
+			*r_idx =3D N_CCK + N_OFDM + N_HT + N_VHT + N_HE_SU + nss * 216 +
+					mcs * 18 + bw * 3 + sgi;
+			res =3D scnprintf(buf, size - res, "%3d ", *r_idx);
+		}
+		res +=3D scnprintf(&buf[res], size - res, "HEMU-%d/GI%s%*cMCS%d/%1d%*c",
+				 ru_size[bw], he_gi[sgi], bw > 1 ? 1 : 2, ' ', mcs,
+				 nss + 1, mcs > 9 ? 1 : 2, ' ');
+	}
+
+	return res;
+}
