+#ifndef _SL_CORE_TIMER_LINK_H_
+#define _SL_CORE_TIMER_LINK_H_
+
+#include <linux/timer.h>
+
+struct sl_core_link;
+
+enum {
+	SL_CORE_TIMER_LINK_UP         = 0,
+	SL_CORE_TIMER_LINK_UP_CHECK,
+	SL_CORE_TIMER_LINK_UP_FEC_SETTLE,
