+	if (txq->idx !=3D TXQ_INACTIVE && txq->pkt_pushed[user] =3D=3D 1 &&
+	    txq->status & RWNX_TXQ_STOP_MU_POS)
+		rwnx_txq_start(txq, RWNX_TXQ_STOP_MU_POS);
+
