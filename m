+static ssize_t rwnx_dbgfs_last_rx_write(struct file *file,
+					const char __user *user_buf,
+					size_t count, loff_t *ppos)
+{
+	struct rwnx_sta *sta =3D NULL;
+	struct rwnx_hw *priv =3D file->private_data;
+	u8 mac[6];
+	int ret =3D 0;
+
+	/* Get the station index from MAC address */
+	ret =3D sscanf(file->f_path.dentry->d_parent->d_iname,
+		     "%hhx:%hhx:%hhx:%hhx:%hhx:%hhx", &mac[0],
+		     &mac[1], &mac[2], &mac[3], &mac[4], &mac[5]);
+	if (ret !=3D 6)
+		pr_warn("Invalid MAC string: %s\n",
+			file->f_path.dentry->d_parent->d_iname);
+	sta =3D rwnx_get_sta(priv, mac);
+	if (!sta)
+		return 0;
+
+	/* Prevent from interrupt preemption as these statistics are updated unde=
r
+	 * interrupt
+	 */
+	spin_lock_bh(&priv->tx_lock);
+	memset(sta->stats.rx_rate.table, 0,
+	       sta->stats.rx_rate.size * sizeof(sta->stats.rx_rate.table[0]));
+	sta->stats.rx_rate.cpt =3D 0;
+	sta->stats.rx_rate.rate_cnt =3D 0;
+	spin_unlock_bh(&priv->tx_lock);
+
+	return count;
+}
