+int aic_get_sec_ie(u8 *in_ie, uint in_len, u8 *rsn_ie, u16 *rsn_len, u8 *w=
pa_ie, u16 *wpa_len)
+{
+	u8 authmode;
+	u8 sec_idx;
+	u8 wpa_oui[4] =3D {0x00, 0x50, 0xf2, 0x01};
+	uint cnt =3D 0;
+
+	/* Search required WPA or WPA2 IE and copy to sec_ie[ ] */
+
+	cnt =3D 0;
+
+	sec_idx =3D 0;
+
+	while (cnt < in_len) {
+		authmode =3D in_ie[cnt];
+
+		if ((authmode =3D=3D 0xdd/*_WPA_IE_ID_*/) &&
+		    (memcmp(&in_ie[cnt + 2], &wpa_oui[0], 4) =3D=3D 0)) {
+			if (wpa_ie)
+				memcpy(wpa_ie, &in_ie[cnt], in_ie[cnt + 1] + 2);
+
+			*wpa_len =3D in_ie[cnt + 1] + 2;
+			cnt +=3D in_ie[cnt + 1] + 2; /* get next */
+		} else {
+			if (authmode =3D=3D 0x30/*_WPA2_IE_ID_*/) {
+				if (rsn_ie)
+					memcpy(rsn_ie, &in_ie[cnt], in_ie[cnt + 1] + 2);
+
+				*rsn_len =3D in_ie[cnt + 1] + 2;
+				cnt +=3D in_ie[cnt + 1] + 2; /* get next */
+			} else {
+				cnt +=3D in_ie[cnt + 1] + 2; /* get next */
+			}
+		}
+	}
+
+	return *rsn_len + *wpa_len;
+}
