+	struct ieee80211_supported_band *rwnx_band_2ghz =3D
+		rwnx_hw->wiphy->bands[NL80211_BAND_2GHZ];
+	struct ieee80211_supported_band *rwnx_band_5ghz =3D
+		rwnx_hw->wiphy->bands[NL80211_BAND_5GHZ];
+
+	num_channels +=3D rwnx_band_2ghz->n_channels;
+	num_channels +=3D (rwnx_hw->band_5g_support) ? rwnx_band_5ghz->n_channels=
 : 0;
+
+	channel_list =3D kcalloc(num_channels, sizeof(int), GFP_KERNEL);
+	if (!channel_list)
+		return -ENOMEM;
+
+	for (i =3D 0; i < rwnx_band_2ghz->n_channels; i++)
+		channel_list[i] =3D rwnx_band_2ghz->channels[i].center_freq;
+
+	for (; rwnx_hw->band_5g_support && i < num_channels; i++)
+		channel_list[i] =3D rwnx_band_5ghz->channels[i].center_freq;
+
+	payload =3D sizeof(num_channels) + sizeof(int) * num_channels + 4;
+
+	nla_for_each_attr(iter, data, len, rem) {
+		type =3D nla_type(iter);
+		switch (type) {
+		case GSCAN_ATTRIBUTE_BAND:
+			reply =3D cfg80211_vendor_cmd_alloc_reply_skb(wiphy, payload);
+
+			if (!reply)
+				return -ENOMEM;
+
+			if (nla_put_u32(reply, GSCAN_ATTRIBUTE_NUM_CHANNELS, num_channels))
+				goto out_put_fail;
+
+			if (nla_put(reply, GSCAN_ATTRIBUTE_CHANNEL_LIST,
+				    sizeof(int) * num_channels, channel_list))
+				goto out_put_fail;
+
+			ret =3D cfg80211_vendor_cmd_reply(reply);
+			if (ret)
+				wiphy_err(wiphy, "%s reply cmd error\n", __func__);
+			break;
+		default:
+			pr_err("%s(%d), Unknown type: %d\n", __func__, __LINE__, type);
+			return -EINVAL;
+		}
+	}
+
+	kfree(channel_list);
+	return ret;
+
+out_put_fail:
+	kfree(channel_list);
+	kfree_skb(reply);
+	return -EMSGSIZE;
+}
