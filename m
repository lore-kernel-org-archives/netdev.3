+	AICWFDBG(LOGINFO, "%s enter wiphy:%p\r\n", __func__, wiphy);
+
+	if (rwnx_hw->is_sched_scan || scanning) {
+		AICWFDBG(LOGERROR, "%s is_sched_scanning and scanning, busy", __func__);
+		return -EBUSY;
+	}
+
+	scan_request =3D (struct cfg80211_scan_request *)
+			kmalloc(sizeof(struct cfg80211_scan_request), GFP_KERNEL);
+
+	scan_request->ssids =3D request->ssids;
+	scan_request->n_channels =3D request->n_channels;
+	scan_request->n_ssids =3D request->n_match_sets;
+	scan_request->no_cck =3D false;
+	scan_request->ie =3D request->ie;
+	scan_request->ie_len =3D request->ie_len;
+	scan_request->flags =3D request->flags;
+
+	scan_request->wiphy =3D wiphy;
+	scan_request->scan_start =3D request->scan_start;
+	memcpy(scan_request->mac_addr, request->mac_addr, ETH_ALEN);
+	memcpy(scan_request->mac_addr_mask, request->mac_addr_mask, ETH_ALEN);
+	rwnx_hw->sched_scan_req =3D request;
+	scan_request->wdev =3D &rwnx_vif->wdev;
+	AICWFDBG(LOGDEBUG, "%s scan_request->n_channels:%d \r\n", __func__,
+		 scan_request->n_channels);
+	AICWFDBG(LOGDEBUG, "%s scan_request->n_ssids:%d \r\n", __func__,
+		 scan_request->n_ssids);
+
+	for (index =3D 0; index < scan_request->n_ssids; index++) {
+		memset(scan_request->ssids[index].ssid, 0, IEEE80211_MAX_SSID_LEN);
+
+		memcpy(scan_request->ssids[index].ssid,
+		       request->match_sets[index].ssid.ssid, IEEE80211_MAX_SSID_LEN);
+
+		scan_request->ssids[index].ssid_len =3D request->match_sets[index].ssid.=
ssid_len;
+
+		AICWFDBG(LOGDEBUG, "%s request ssid:%s len:%d \r\n", __func__,
+			 scan_request->ssids[index].ssid,
+			 scan_request->ssids[index].ssid_len);
+	}
+
+	for (index =3D 0; index < scan_request->n_channels; index++) {
+		scan_request->channels[index] =3D request->channels[index];
+
+		AICWFDBG(LOGDEBUG, "%s scan_request->channels[%d]:%d \r\n", __func__,
+			 index, scan_request->channels[index]->center_freq);
+
+		if (!scan_request->channels[index]) {
+			AICWFDBG(LOGERROR, "%s ERROR!!! channels is NULL", __func__);
+			continue;
+		}
+	}
+
+	rwnx_hw->is_sched_scan =3D true;
+
+	if (scanning) {
+		AICWFDBG(LOGERROR, "%s scanning, about it", __func__);
+		kfree(scan_request);
+		return -EBUSY;
+	}
+	ret =3D rwnx_cfg80211_scan(wiphy, scan_request);
+	return ret;
+}
