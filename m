+static int rwnx_fill_station_info(struct rwnx_sta *sta, struct rwnx_vif *v=
if,
+				  struct station_info *sinfo)
+{
+	struct rwnx_sta_stats *stats =3D &sta->stats;
+	struct rx_vector_1 *rx_vect1 =3D &stats->last_rx.rx_vect1;
+	union rwnx_rate_ctrl_info *rate_info;
+	struct mm_get_sta_info_cfm cfm;
+
+	rwnx_send_get_sta_info_req(vif->rwnx_hw, sta->sta_idx, &cfm);
+	sinfo->tx_failed =3D cfm.txfailed;
+	rate_info =3D (union rwnx_rate_ctrl_info *)&cfm.rate_info;
+
+	AICWFDBG(LOGDEBUG,
+		 "%s ModTx(%d):%d TxIndex:%d ModRx(%d):%d RxHTIndex:%d RxVHTIndex:%d RxH=
EIndex:%d RSSI:%d \r\n",
+		 __func__, rate_info->bw_tx, rate_info->format_mod_tx,
+		 rate_info->mcs_index_tx, rx_vect1->ch_bw, rx_vect1->format_mod,
+		 rx_vect1->ht.mcs, rx_vect1->vht.mcs, rx_vect1->he.mcs,
+		 (s8)cfm.rssi);
+
+	switch (rate_info->format_mod_tx) {
+	case FORMATMOD_NON_HT:
+	case FORMATMOD_NON_HT_DUP_OFDM:
+		sinfo->txrate.flags =3D 0;
+		sinfo->txrate.legacy =3D tx_legrates_lut_rate[rate_info->mcs_index_tx];
+		break;
+	case FORMATMOD_HT_MF:
+	case FORMATMOD_HT_GF:
+		sinfo->txrate.flags =3D RATE_INFO_FLAGS_MCS;
+		sinfo->txrate.mcs =3D rate_info->mcs_index_tx;
+		break;
+	case FORMATMOD_VHT:
+		sinfo->txrate.flags =3D RATE_INFO_FLAGS_VHT_MCS;
+		sinfo->txrate.mcs =3D rate_info->mcs_index_tx;
+		break;
+	case FORMATMOD_HE_MU:
+	case FORMATMOD_HE_SU:
+	case FORMATMOD_HE_ER:
+		sinfo->txrate.flags =3D RATE_INFO_FLAGS_HE_MCS;
+		sinfo->txrate.mcs =3D rate_info->mcs_index_tx;
+		break;
+	default:
+		return -EINVAL;
+	}
+	switch (rate_info->bw_tx) {
+	case PHY_CHNL_BW_20:
+		sinfo->txrate.bw =3D RATE_INFO_BW_20;
+		break;
+	case PHY_CHNL_BW_40:
+		sinfo->txrate.bw =3D RATE_INFO_BW_40;
+		break;
+	case PHY_CHNL_BW_80:
+		sinfo->txrate.bw =3D RATE_INFO_BW_80;
+		break;
+	case PHY_CHNL_BW_160:
+		sinfo->txrate.bw =3D RATE_INFO_BW_160;
+		break;
+	default:
+		sinfo->txrate.bw =3D RATE_INFO_BW_HE_RU;
+		break;
+	}
+
+	sinfo->txrate.nss =3D 1;
+	sinfo->filled |=3D
+		(BIT(NL80211_STA_INFO_TX_BITRATE) | BIT(NL80211_STA_INFO_TX_FAILED));
+
+	if (RWNX_VIF_TYPE(vif) =3D=3D NL80211_IFTYPE_STATION ||
+	    RWNX_VIF_TYPE(vif) =3D=3D NL80211_IFTYPE_P2P_CLIENT) {
+		sinfo->connected_time =3D
+			le32_to_cpu(jiffies_to_msecs(jiffies - vif->sta.link_time) / 1000);
+		sinfo->filled |=3D BIT(NL80211_STA_INFO_CONNECTED_TIME);
+	}
+
+	sinfo->inactive_time =3D
+		jiffies_to_msecs(jiffies - vif->rwnx_hw->stats.last_tx);
+	sinfo->rx_bytes =3D vif->net_stats.rx_bytes;
+	sinfo->tx_bytes =3D vif->net_stats.tx_bytes;
+	sinfo->tx_packets =3D vif->net_stats.tx_packets;
+	sinfo->rx_packets =3D vif->net_stats.rx_packets;
+	sinfo->signal =3D (s8)cfm.rssi;
+	sinfo->rxrate.nss =3D 1;
+
+	switch (rx_vect1->ch_bw) {
+	case PHY_CHNL_BW_20:
+		sinfo->rxrate.bw =3D RATE_INFO_BW_20;
+		break;
+	case PHY_CHNL_BW_40:
+		sinfo->rxrate.bw =3D RATE_INFO_BW_40;
+		break;
+	case PHY_CHNL_BW_80:
+		sinfo->rxrate.bw =3D RATE_INFO_BW_80;
+		break;
+	case PHY_CHNL_BW_160:
+		sinfo->rxrate.bw =3D RATE_INFO_BW_160;
+		break;
+	default:
+		sinfo->rxrate.bw =3D RATE_INFO_BW_HE_RU;
+		break;
+	}
+
+	switch (rx_vect1->format_mod) {
+	case FORMATMOD_NON_HT:
+	case FORMATMOD_NON_HT_DUP_OFDM:
+		sinfo->rxrate.flags =3D 0;
+		sinfo->rxrate.legacy =3D legrates_lut[rx_vect1->leg_rate].rate;
+		break;
+	case FORMATMOD_HT_MF:
+	case FORMATMOD_HT_GF:
+		sinfo->rxrate.flags =3D RATE_INFO_FLAGS_MCS;
+		if (rx_vect1->ht.short_gi)
+			sinfo->rxrate.flags |=3D RATE_INFO_FLAGS_SHORT_GI;
+		sinfo->rxrate.mcs =3D rx_vect1->ht.mcs;
+		break;
+	case FORMATMOD_VHT:
+		sinfo->rxrate.flags =3D RATE_INFO_FLAGS_VHT_MCS;
+		if (rx_vect1->vht.short_gi)
+			sinfo->rxrate.flags |=3D RATE_INFO_FLAGS_SHORT_GI;
+		sinfo->rxrate.mcs =3D rx_vect1->vht.mcs;
+		break;
+	case FORMATMOD_HE_MU:
+		sinfo->rxrate.he_ru_alloc =3D rx_vect1->he.ru_size;
+	case FORMATMOD_HE_SU:
+	case FORMATMOD_HE_ER:
+		sinfo->rxrate.flags =3D RATE_INFO_FLAGS_HE_MCS;
+		sinfo->rxrate.mcs =3D rx_vect1->he.mcs;
+		sinfo->rxrate.he_gi =3D rx_vect1->he.gi_type;
+		sinfo->rxrate.he_dcm =3D rx_vect1->he.dcm;
+		break;
+	default:
+		return -EINVAL;
+	}
+	sinfo->filled |=3D
+		(BIT(NL80211_STA_INFO_INACTIVE_TIME) |
+		 BIT(NL80211_STA_INFO_RX_BYTES64) | BIT(NL80211_STA_INFO_TX_BYTES64) |
+		 BIT(NL80211_STA_INFO_RX_PACKETS) | BIT(NL80211_STA_INFO_TX_PACKETS) |
+		 BIT(NL80211_STA_INFO_SIGNAL) | BIT(NL80211_STA_INFO_RX_BITRATE));
+	return 0;
+}
