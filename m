+/* return val: -1 for no index, others for index */
+int tcp_ack_alloc_index(struct tcp_ack_manage *ack_m)
+{
+	int i, ret =3D -1;
+	struct tcp_ack_info *ack_info;
+	unsigned int start;
+
+	spin_lock_bh(&ack_m->lock);
+	if (ack_m->max_num =3D=3D TCP_ACK_NUM) {
+		spin_unlock_bh(&ack_m->lock);
+		return -1;
+	}
+
+	if (ack_m->free_index >=3D 0) {
+		i =3D ack_m->free_index;
+		ack_m->free_index =3D -1;
+		ack_m->max_num++;
+		spin_unlock_bh(&ack_m->lock);
+		return i;
+	}
+
+	for (i =3D 0; ((ret < 0) && (i < TCP_ACK_NUM)); i++) {
+		ack_info =3D &ack_m->ack_info[i];
+		do {
+			start =3D read_seqbegin(&ack_info->seqlock);
+			ret =3D -1;
+			if (!ack_info->busy) {
+				ack_m->free_index =3D -1;
+				ack_m->max_num++;
+				ret =3D i;
+			}
+		} while (read_seqretry(&ack_info->seqlock, start));
+	}
+	spin_unlock_bh(&ack_m->lock);
+
+	return ret;
+}
