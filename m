+static int genl_send_generic(struct genl_info *info, u8 attr, u8 cmd, u32 =
len,
+			     u8 *data)
+{
+	struct sk_buff *skb;
+	void *hdr;
+	int ret;
+
+	skb =3D nlmsg_new(NLMSG_GOODSIZE, GFP_KERNEL);
+	if (!skb)
+		return -ENOMEM;
+	hdr =3D genlmsg_put(skb, info->snd_portid, info->snd_seq, &aicwf_genl_fam=
ily,
+			  0, cmd);
+	if (IS_ERR(hdr)) {
+		genl_debug(LOG_INFO, "%s fail\n", __func__);
+		ret =3D PTR_ERR(hdr);
+		goto err_put;
+	}
+	if (nla_put(skb, attr, len, data)) {
+		ret =3D -1;
+		goto err_put;
+	}
+
+	genlmsg_end(skb, hdr);
+	return genlmsg_reply(skb, info);
+
+err_put:
+	nlmsg_free(skb);
+	return ret;
+}
