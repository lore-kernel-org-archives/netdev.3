+/**
+ * rwnx_start_mgmt_xmit - Transmit a management frame
+ *
+ * @vif: Vif that send the frame
+ * @sta: Destination of the frame. May be NULL if the destiantion is unkno=
wn
+ *       to the AP.
+ * @params: Mgmt frame parameters
+ * @offchan: Indicate whether the frame must be send via the offchan TXQ.
+ *           (is is redundant with params->offchan ?)
+ * @cookie: updated with a unique value to identify the frame with upper l=
ayer
+ *
+ */
+
+int rwnx_start_mgmt_xmit(struct rwnx_vif *vif, struct rwnx_sta *sta,
+			 struct cfg80211_mgmt_tx_params *params, bool offchan,
+			 u64 *cookie)
+{
+	struct rwnx_hw *rwnx_hw =3D vif->rwnx_hw;
+	struct rwnx_txhdr *txhdr;
+	struct rwnx_sw_txhdr *sw_txhdr;
+	struct txdesc_api *desc;
+	struct sk_buff *skb;
+	u16 frame_len, headroom, frame_oft;
+	u8 *data;
+	int nx_off_chan_txq_idx =3D NX_OFF_CHAN_TXQ_IDX;
+	struct rwnx_txq *txq;
+	bool robust;
+	const u8 *buf =3D params->buf;
+	size_t len =3D params->len;
+	bool no_cck =3D params->no_cck;
+
+	AICWFDBG(LOGDEBUG, "mgmt xmit %x %x ", buf[0], buf[1]);
+
+	if (g_rwnx_plat->sdiodev->chipid =3D=3D PRODUCT_ID_AIC8801 ||
+	    ((g_rwnx_plat->sdiodev->chipid =3D=3D PRODUCT_ID_AIC8800DC ||
+	      g_rwnx_plat->sdiodev->chipid =3D=3D PRODUCT_ID_AIC8800DW) &&
+	    chip_id < 3)) {
+		nx_off_chan_txq_idx =3D NX_OFF_CHAN_TXQ_IDX_FOR_OLD_IC;
+	}
+
+	headroom =3D sizeof(struct rwnx_txhdr);
+	frame_len =3D len;
+
+	/* Set TID and Queues indexes */
+	if (sta) {
+		txq =3D rwnx_txq_sta_get(sta, 8, rwnx_hw);
+	} else {
+		if (offchan)
+			txq =3D &rwnx_hw->txq[nx_off_chan_txq_idx];
+		else
+			txq =3D rwnx_txq_vif_get(vif, NX_UNK_TXQ_TYPE);
+	}
+
+	/* Ensure that TXQ is active */
+	if (txq->idx =3D=3D TXQ_INACTIVE) {
+		netdev_dbg(vif->ndev, "TXQ inactive\n");
+		return -EBUSY;
+	}
+
+	/*
+	 * Create a SK Buff object that will contain the provided data
+	 */
+	skb =3D dev_alloc_skb(headroom + frame_len);
+
+	if (!skb)
+		return -ENOMEM;
+
+	*cookie =3D (unsigned long)skb;
+
+	/*
+	 * Move skb->data pointer in order to reserve room for rwnx_txhdr
+	 * headroom value will be equal to sizeof(struct rwnx_txhdr)
+	 */
+	skb_reserve(skb, headroom);
+
+	/*
+	 * Extend the buffer data area in order to contain the provided packet
+	 * len value (for skb) will be equal to param->len
+	 */
+	data =3D skb_put(skb, frame_len);
+	/* Copy the provided data */
+	memcpy(data, buf, frame_len);
+
+	robust =3D ieee80211_is_robust_mgmt_frame(skb);
+
+	/* Update CSA counter if present */
+	if (unlikely(params->n_csa_offsets) &&
+	    vif->wdev.iftype =3D=3D NL80211_IFTYPE_AP && vif->ap.csa) {
+		int i;
+
+		data =3D skb->data;
+		for (i =3D 0; i < params->n_csa_offsets; i++)
+			data[params->csa_offsets[i]] =3D vif->ap.csa->count;
+	}
+
+	/*
+	 * Go back to the beginning of the allocated data area
+	 * skb->data pointer will move backward
+	 */
+	skb_push(skb, headroom);
+
+	/* Fill the TX Header */
+	txhdr =3D (struct rwnx_txhdr *)skb->data;
+
+	txhdr->hw_hdr.cfm.status.value =3D 0;
+
+	/* Fill the SW TX Header */
+	sw_txhdr =3D kmem_cache_alloc(rwnx_hw->sw_txhdr_cache, GFP_ATOMIC);
+	if (unlikely(!sw_txhdr)) {
+		dev_kfree_skb(skb);
+		return -ENOMEM;
+	}
+	txhdr->sw_hdr =3D sw_txhdr;
+
+	sw_txhdr->txq =3D txq;
+	sw_txhdr->frame_len =3D frame_len;
+	sw_txhdr->rwnx_sta =3D sta;
+	sw_txhdr->rwnx_vif =3D vif;
+	sw_txhdr->skb =3D skb;
+	sw_txhdr->headroom =3D headroom;
+	sw_txhdr->map_len =3D skb->len - offsetof(struct rwnx_txhdr, hw_hdr);
+#ifdef CONFIG_RWNX_AMSDUS_TX
+	sw_txhdr->amsdu.len =3D 0;
+	sw_txhdr->amsdu.nb =3D 0;
+#endif
+
+	/* Fill the Descriptor to be provided to the MAC SW */
+	desc =3D &sw_txhdr->desc;
+
+	desc->host.ethertype =3D 0;
+	desc->host.staid =3D (sta) ? sta->sta_idx : 0xFF;
+	desc->host.vif_idx =3D vif->vif_index;
+	desc->host.tid =3D 0xFF;
+	desc->host.flags =3D TXU_CNTRL_MGMT;
+	if (robust)
+		desc->host.flags |=3D TXU_CNTRL_MGMT_ROBUST;
+
+#ifdef CONFIG_RWNX_SPLIT_TX_BUF
+	desc->host.packet_len[0] =3D frame_len;
+#else
+	desc->host.packet_len =3D frame_len;
+#endif
+
+	if (no_cck)
+		desc->host.flags |=3D TXU_CNTRL_MGMT_NO_CCK;
+
+	/* Get DMA Address */
+	if (unlikely(rwnx_prep_tx(rwnx_hw, txhdr))) {
+		kmem_cache_free(rwnx_hw->sw_txhdr_cache, sw_txhdr);
+		dev_kfree_skb(skb);
+		return -EBUSY;
+	}
+
+	frame_oft =3D sizeof(struct rwnx_txhdr) - offsetof(struct rwnx_txhdr, hw_=
hdr);
+	desc->host.hostid =3D sw_txhdr->dma_addr;
+
+	spin_lock_bh(&rwnx_hw->tx_lock);
+	if (rwnx_txq_queue_skb(skb, txq, rwnx_hw, false))
+		rwnx_hwq_process(rwnx_hw, txq->hwq);
+	spin_unlock_bh(&rwnx_hw->tx_lock);
+
+	return 0;
+}
