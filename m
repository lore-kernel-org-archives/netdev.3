+/**
+ * @del_virtual_intf: remove the virtual interface
+ */
+static int rwnx_cfg80211_del_iface(struct wiphy *wiphy,
+				   struct wireless_dev *wdev)
+{
+	struct net_device *dev =3D wdev->netdev;
+	struct rwnx_hw *rwnx_hw =3D wiphy_priv(wiphy);
+	struct rwnx_vif *rwnx_vif =3D container_of(wdev, struct rwnx_vif, wdev);
+
+	AICWFDBG(LOGINFO, "del_iface: %p, %x\n", wdev, wdev->address[5]);
+
+	if (!dev || !rwnx_vif->ndev) {
+		cfg80211_unregister_wdev(wdev);
+		spin_lock_bh(&rwnx_hw->cb_lock);
+		list_del(&rwnx_vif->list);
+		spin_unlock_bh(&rwnx_hw->cb_lock);
+		rwnx_hw->avail_idx_map |=3D BIT(rwnx_vif->drv_vif_index);
+		rwnx_vif->ndev =3D NULL;
+		kfree(rwnx_vif);
+		return 0;
+	}
+
+	netdev_info(dev, "Remove Interface");
+
+	if (dev->reg_state =3D=3D NETREG_REGISTERED) {
+		/* Will call rwnx_close if interface is UP */
+		cfg80211_unregister_netdevice(dev);
+	}
+
+	spin_lock_bh(&rwnx_hw->cb_lock);
+	list_del(&rwnx_vif->list);
+	spin_unlock_bh(&rwnx_hw->cb_lock);
+	rwnx_hw->avail_idx_map |=3D BIT(rwnx_vif->drv_vif_index);
+	rwnx_vif->ndev =3D NULL;
+
+	/* Clear the priv in adapter */
+	dev->ieee80211_ptr =3D NULL;
+
+	return 0;
+}
