+	bus_if->cmd_buf =3D kzalloc(CMD_BUF_MAX, GFP_KERNEL);
+	if (!bus_if->cmd_buf) {
+		ret =3D -ENOMEM;
+		txrx_err("proto_attach failed\n");
+		goto out;
+	}
+	memset(bus_if->cmd_buf, '\0', CMD_BUF_MAX);
+
+	init_completion(&bus_if->bustx_trgg);
+	init_completion(&bus_if->busrx_trgg);
+	// new oob feature
+	init_completion(&bus_if->busirq_trgg);
+#ifdef AICWF_SDIO_SUPPORT
+	spin_lock_init(&bus_if->bus_priv.sdio->wslock);
+	bus_if->bustx_thread =3D
+		kthread_run(sdio_bustx_thread, (void *)bus_if, "aicwf_bustx_thread");
+	bus_if->busrx_thread =3D
+		kthread_run(sdio_busrx_thread, (void *)bus_if->bus_priv.sdio->rx_priv,
+			    "aicwf_busrx_thread");
+	// new oob feature
+#ifdef CONFIG_OOB
+	if (bus_if->bus_priv.sdio->oob_enable) {
+		bus_if->busirq_thread =3D kthread_run(sdio_busirq_thread,
+						    (void *)bus_if->bus_priv.sdio->rx_priv,
+						    "aicwf_busirq_thread");
+	}
+#endif // CONFIG_OOB
+#endif
+#ifdef AICWF_USB_SUPPORT
+	bus_if->bustx_thread =3D
+		kthread_run(usb_bustx_thread, (void *)bus_if, "aicwf_bustx_thread");
+	bus_if->busrx_thread =3D
+		kthread_run(usb_busrx_thread, (void *)bus_if->bus_priv.usb->rx_priv,
+			    "aicwf_busrx_thread");
+#endif
+
+	if (IS_ERR(bus_if->bustx_thread)) {
+		bus_if->bustx_thread =3D NULL;
+		txrx_err("aicwf_bustx_thread run fail\n");
+		ret =3D -1;
+	}
+
+	if (IS_ERR(bus_if->busrx_thread)) {
+		bus_if->busrx_thread =3D NULL;
+		txrx_err("aicwf_bustx_thread run fail\n");
+		ret =3D -1;
+	}
+
+	if (ret < 0)
+		goto out;
+
+	return ret;
+
+out:
+	return ret;
+}
