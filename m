+/**
+ * @update_mesh_config: Update mesh parameters on a running mesh.
+ */
+static int rwnx_cfg80211_update_mesh_config(struct wiphy *wiphy,
+					    struct net_device *dev, u32 mask,
+					    const struct mesh_config *nconf)
+{
+	struct rwnx_vif *rwnx_vif =3D netdev_priv(dev);
+	struct rwnx_hw *rwnx_hw =3D wiphy_priv(wiphy);
+	struct mesh_update_cfm cfm;
+	int status;
+
+	if (RWNX_VIF_TYPE(rwnx_vif) !=3D NL80211_IFTYPE_MESH_POINT)
+		return -EOPNOTSUPP;
+
+	if (mask & CO_BIT(NL80211_MESHCONF_POWER_MODE - 1)) {
+		rwnx_vif->ap.next_mesh_pm =3D nconf->power_mode;
+
+		if (!list_empty(&rwnx_vif->ap.sta_list)) {
+			// If there are mesh links we don't want to update the power mode
+			// It will be updated with rwnx_update_mesh_power_mode() when the
+			// ps mode of a link is updated or when a new link is added/removed
+			mask &=3D ~BIT(NL80211_MESHCONF_POWER_MODE - 1);
+
+			if (!mask)
+				return 0;
+		}
+	}
+
+	status =3D rwnx_send_mesh_update_req(rwnx_hw, rwnx_vif, mask, nconf, &cfm=
);
+
+	if (!status && cfm.status !=3D 0)
+		status =3D -EINVAL;
+
+	return status;
+}
