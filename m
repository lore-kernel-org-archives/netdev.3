+
+	if (scan_re->bss) {
+		start =3D aicwf_get_iwe_stream_mac_addr(rwnx_hw, info, scan_re, start, s=
top, &iwe);
+		start =3D aicwf_get_iwe_stream_essid(rwnx_hw, info, scan_re, start, stop=
, &iwe);
+		start =3D aicwf_get_iwe_stream_protocol(rwnx_hw, info, scan_re, start, s=
top, &iwe);
+		start =3D aicwf_get_iwe_stream_chan(rwnx_hw, info, scan_re, start, stop,=
 &iwe);
+		start =3D aicwf_get_iwe_stream_mode(rwnx_hw, info, scan_re, start, stop,=
 &iwe);
+		start =3D aicwf_get_iwe_stream_encryption(rwnx_hw, info, scan_re, start,=
 stop, &iwe);
+		start =3D aicwf_get_iwe_stream_rate(rwnx_hw, info, scan_re, start, stop,=
 &iwe);
+		start =3D aicwf_get_iwe_stream_wpa_wpa2(rwnx_hw, info, scan_re, start, s=
top, &iwe);
+		start =3D aicwf_get_iwe_stream_wps(rwnx_hw, info, scan_re, start, stop, =
&iwe);
+		start =3D aicwf_get_iwe_stream_rssi(rwnx_hw, info, scan_re, start, stop,=
 &iwe);
