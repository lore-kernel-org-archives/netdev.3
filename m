+					     char *start, char *stop,
+					     struct iw_event *iwe)
+{
+	struct ieee80211_mgmt *mgmt =3D (struct ieee80211_mgmt *)scan_re->payload=
;
+	u8 *payload =3D mgmt->u.beacon.variable;
+
+	/* parsing WPS IE */
+	uint cnt =3D 0, total_ielen;
+	u8 *wpsie_ptr =3D NULL;
+	uint wps_ielen =3D 0;
+	u8 *ie_ptr =3D payload;
+
+	total_ielen =3D scan_re->ind->length;
+
+	while (cnt < total_ielen) {
+		if (aicwf_get_is_wps_ie(&ie_ptr[cnt], &wps_ielen) && wps_ielen > 2) {
+			wpsie_ptr =3D &ie_ptr[cnt];
+			iwe->cmd =3D IWEVGENIE;
+			iwe->u.data.length =3D (u16)wps_ielen;
+			start =3D iwe_stream_add_point(info, start, stop, iwe, wpsie_ptr);
+		}
+		cnt +=3D ie_ptr[cnt + 1] + 2; /* goto next */
+	}
+	return start;
+}
