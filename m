+
+	for (i =3D 0; ((ret < 0) && (i < TCP_ACK_NUM)); i++) {
+		ack_info =3D &ack_m->ack_info[i];
+		do {
+			start =3D read_seqbegin(&ack_info->seqlock);
+			ret =3D -1;
+
+			ack =3D &ack_info->ack_msg;
+			if (ack_info->busy && ack->dest =3D=3D ack_msg->dest &&
+			    ack->source =3D=3D ack_msg->source &&
+				ack->saddr =3D=3D ack_msg->saddr && ack->daddr =3D=3D ack_msg->daddr)
+				ret =3D i;
