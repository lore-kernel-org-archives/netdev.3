+int match_cmd_table(struct rwnx_hw *rwnx_hw, char *s_buf, char *r_buf,
+		    unsigned long *r_len)
+{
+	size_t i;
+	int ret, len;
+	struct cmd_table_ops *cmd_table =3D NULL;
+	char **cmd =3D NULL;
+
+	cmd =3D
+	kzalloc((CMD_MAX + 1) * sizeof(char *), GFP_KERNEL);
+	if (!cmd) {
+		genl_debug(LOG_ERROR, "%s cmd alloc fail\n", __func__);
+		return -ENOMEM;
+	}
+
+	len =3D genl_parse_sep(cmd, s_buf, " ");
+	if (len =3D=3D 0 || len > CMD_MAX) {
+		genl_debug(LOG_ERROR, "%s params error, count: %d\n", __func__, len);
+		kfree(cmd);
+		return -EINVAL;
+	}
+
+	for (i =3D 0; i < ARRAY_SIZE(g_cmd_table); i++) {
+		if (strcmp(cmd[0], g_cmd_table[i].name) !=3D 0)
+			continue;
+
+		cmd_table =3D &g_cmd_table[i];
+		break;
+	}
+
+	if (!cmd_table) {
+		genl_debug(LOG_INFO, "%s cmd does not exist\n", __func__);
+		kfree(cmd);
+		return -EINVAL;
+	}
+
+	ret =3D cmd_table->func(rwnx_hw, &cmd[1], len - 1, r_buf, r_len);
+
+	kfree(cmd);
+	return ret;
+}
