+DEBUGFS_READ_FUNC(last_rx);
+DEBUGFS_WRITE_FUNC(last_rx);
+static const struct file_operations rwnx_dbgfs_last_rx_ops =3D {
+	.write =3D rwnx_dbgfs_last_rx_write,
+	.read =3D rwnx_dbgfs_last_rx_read,
+	.open =3D simple_open,
+	.llseek =3D generic_file_llseek,
+}
