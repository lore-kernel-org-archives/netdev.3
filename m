+static int aic_probe(struct platform_device *pdev)
+{
+	struct aic_device *dev;
+	int ret;
+
+	dev =3D devm_kzalloc(&pdev->dev, sizeof(*dev), GFP_KERNEL);
+	if (!dev)
+		return -ENOMEM;
+
+	dev->dev =3D &pdev->dev;
+
+	ret =3D platform_get_irq(pdev, 0);
+	if (ret < 0)
