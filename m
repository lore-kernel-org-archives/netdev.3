+static void rwnx_add_wmm_info_ie(struct sk_buff *skb, u8 qosinfo)
+{
+	u8 *pos =3D (void *)skb_put(skb, 9);
+
+	*pos++ =3D WLAN_EID_VENDOR_SPECIFIC;
+	*pos++ =3D 7;    /* len */
+	*pos++ =3D 0x00; /* Microsoft OUI 00:50:F2 */
+	*pos++ =3D 0x50;
+	*pos++ =3D 0xf2;
+	*pos++ =3D 2;       /* WME */
+	*pos++ =3D 0;       /* WME info */
+	*pos++ =3D 1;       /* WME ver */
+	*pos++ =3D qosinfo; /* U-APSD no in use */
+}
+
+/* translate numbering in the WMM parameter IE to the mac80211 notation */
+static u8 rwnx_ac_from_wmm(int ac)
+{
+	switch (ac) {
+	default:
+		WARN_ON_ONCE(1);
+	case 0:
+		return AC_BE;
+	case 1:
+		return AC_BK;
+	case 2:
+		return AC_VI;
+	case 3:
+		return AC_VO;
+	}
+}
+
+static void rwnx_add_wmm_param_ie(struct sk_buff *skb, u8 acm_bits,
+				  u32 *ac_params)
+{
+	struct ieee80211_wmm_param_ie *wmm;
+	int i, j;
+	u8 cw_min, cw_max;
+	bool acm;
+
+	wmm =3D (void *)skb_put(skb, sizeof(struct ieee80211_wmm_param_ie));
+	memset(wmm, 0, sizeof(*wmm));
+
+	wmm->element_id =3D WLAN_EID_VENDOR_SPECIFIC;
+	wmm->len =3D sizeof(*wmm) - 2;
+
+	wmm->oui[0] =3D 0x00; /* Microsoft OUI 00:50:F2 */
+	wmm->oui[1] =3D 0x50;
+	wmm->oui[2] =3D 0xf2;
+	wmm->oui_type =3D 2;    /* WME */
+	wmm->oui_subtype =3D 1; /* WME param */
+	wmm->version =3D 1;     /* WME ver */
+	wmm->qos_info =3D 0;    /* U-APSD not in use */
+
+	/*
+	 * Use the EDCA parameters defined for the BSS, or default if the AP
+	 * doesn't support it, as mandated by 802.11-2012 section 10.22.4
+	 */
+	for (i =3D 0; i < AC_MAX; i++) {
+		j =3D rwnx_ac_from_wmm(i);
+		cw_min =3D (ac_params[j] & 0xF0) >> 4;
+		cw_max =3D (ac_params[j] & 0xF00) >> 8;
+		acm =3D (acm_bits & (1 << j)) !=3D 0;
+
+		wmm->ac[i].aci_aifsn =3D (i << 5) | (acm << 4) | (ac_params[j] & 0xF);
+		wmm->ac[i].cw =3D (cw_max << 4) | cw_min;
+		wmm->ac[i].txop_limit =3D (ac_params[j] & 0x0FFFF000) >> 12;
+	}
+}
