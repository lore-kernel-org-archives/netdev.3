+
+	struct kobject             *parent_kobj;
+	struct kobject              kobj;
+	struct kobject              counters_kobj;
+
+	struct kref                 ref_cnt;
+	/*
+	 * Owns the memory, not the logical object: ref_cnt reaching zero runs
+	 * the release, which signals del_complete. A deleter that waits on
+	 * del_complete holds a reference here, so the completion embedded in
+	 * this object cannot be freed while it is still being used.
+	 */
+	struct kref                 mem_ref;
+	struct completion           del_complete;
