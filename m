+int aicwf_sdio_sleep_allow(struct aic_sdio_dev *sdiodev)
+{
+	int ret =3D 0;
+	struct aicwf_bus *bus_if =3D sdiodev->bus_if;
+	struct rwnx_hw *rwnx_hw =3D sdiodev->rwnx_hw;
+	u8 read_retry;
+	u8 val;
+
+	if (bus_if->state =3D=3D BUS_DOWN_ST) {
+		ret =3D aicwf_sdio_writeb(sdiodev, sdiodev->sdio_reg.sleep_reg, 0x10);
+		if (ret)
+			sdio_err("Write sleep fail!\n");
+		aicwf_sdio_pwrctl_timer(sdiodev, 0);
+		return ret;
+	}
+
+	sdio_info("sleep: %d, %d\n", sdiodev->state, scanning);
+	if (sdiodev->state =3D=3D SDIO_ACTIVE_ST  && !scanning && !rwnx_hw->is_p2=
p_alive &&
+	    !rwnx_hw->is_p2p_connected &&
+	    (int)(atomic_read(&sdiodev->tx_priv->tx_pktcnt) <=3D 0) &&
+	    !sdiodev->tx_priv->cmd_txstate &&
+	    (int)(atomic_read(&sdiodev->rx_priv->rx_cnt) =3D=3D 0)) {
+		AICWFDBG(LOGSDPWRC, "%s s\n", __func__);
+		if (sdiodev->chipid =3D=3D PRODUCT_ID_AIC8800D80) {
+			if (aicwf_sdio_writeb(sdiodev, sdiodev->sdio_reg.wakeup_reg, 0x02) < 0)
+				sdio_err("reg:%d write failed!\n", sdiodev->sdio_reg.wakeup_reg);
+		} else if (sdiodev->chipid =3D=3D PRODUCT_ID_AIC8801 ||
+			   sdiodev->chipid =3D=3D PRODUCT_ID_AIC8800DC ||
+			   sdiodev->chipid =3D=3D PRODUCT_ID_AIC8800DW) {
+			if (aicwf_sdio_func2_writeb(sdiodev, sdiodev->sdio_reg.wakeup_reg, 0x2)=
 < 0)
+				sdio_err("reg:%d write failed!\n", sdiodev->sdio_reg.wakeup_reg);
+			read_retry =3D 100;
+			while (read_retry) {
+				val =3D 0;
+				if (aicwf_sdio_func2_readb(sdiodev,
+							   sdiodev->sdio_reg.wakeup_reg,
+							   &val) < 0)
+					sdio_err("reg %d read fail\n",
+						 sdiodev->sdio_reg.wakeup_reg);
+				else if ((val & 0x2) =3D=3D 0)
+					break;
+				sdio_err("val:%d\n", val);
+				read_retry--;
+				if (read_retry < 90)
+					pr_warn("warning: read cnt %d\n", read_retry);
+				usleep_range(50, 60);
+			}
+		}
+		sdiodev->state =3D SDIO_SLEEP_ST;
+		aicwf_sdio_pwrctl_timer(sdiodev, 0);
+	} else {
+		aicwf_sdio_pwrctl_timer(sdiodev, sdiodev->active_duration);
+	}
+
+	return ret;
+}
