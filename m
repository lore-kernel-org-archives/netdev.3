+int tcp_check_ack(unsigned char *buf, struct tcp_ack_msg *msg,
+		  unsigned short *win_scale)
+{
+	int ret;
+	int ip_hdr_len;
+	int tcp_tot_len;
+	unsigned char *temp;
+	struct ethhdr *ethhdr;
+	struct iphdr *iphdr;
+	struct tcphdr *tcphdr;
+
+	ethhdr =3D (struct ethhdr *)buf;
+	if (ethhdr->h_proto !=3D htons(ETH_P_IP))
+		return 0;
+
+	iphdr =3D (struct iphdr *)(ethhdr + 1);
+	if (iphdr->version !=3D 4 || iphdr->protocol !=3D IPPROTO_TCP)
+		return 0;
+
+	ip_hdr_len =3D iphdr->ihl * 4;
+	temp =3D (unsigned char *)(iphdr) + ip_hdr_len;
+	tcphdr =3D (struct tcphdr *)temp;
+	/* TCP_FLAG_ACK */
+	if (!(temp[13] & 0x10))
+		return 0;
+
+	tcp_tot_len =3D ntohs(iphdr->tot_len) - ip_hdr_len;
+	ret =3D is_drop_tcp_ack(tcphdr, tcp_tot_len, win_scale);
+
+	if (ret > 0) {
+		msg->saddr =3D iphdr->saddr;
+		msg->daddr =3D iphdr->daddr;
+		msg->source =3D tcphdr->source;
+		msg->dest =3D tcphdr->dest;
+		msg->seq =3D ntohl(tcphdr->ack_seq);
+		msg->win =3D ntohs(tcphdr->window);
+	}
