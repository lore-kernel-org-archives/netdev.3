+int aicwf_sdio_func_init(struct aic_sdio_dev *sdiodev)
+{
+	struct mmc_host *host;
+	u8 block_bit0 =3D 0x1;
+	u8 byte_mode_disable =3D 0x1; // 1: no byte mode
+	int ret =3D 0;
+	struct aicbsp_feature_t feature;
+	//u8 val =3D 0;
+
+	aicbsp_get_feature(&feature, NULL);
+	aicwf_sdio_reg_init(sdiodev);
+	if (!sdiodev->func) {
+		pr_warn("%s, NULL sdio func\n", __func__);
+		return 0;
+	}
+
+	host =3D sdiodev->func->card->host;
+
+	sdio_claim_host(sdiodev->func);
+	ret =3D sdio_set_block_size(sdiodev->func, SDIOWIFI_FUNC_BLOCKSIZE);
+	if (ret < 0) {
+		AICWFDBG(LOGERROR, "set blocksize fail %d\n", ret);
+		sdio_release_host(sdiodev->func);
+		return ret;
+	}
+	ret =3D sdio_enable_func(sdiodev->func);
+	if (ret < 0) {
+		sdio_release_host(sdiodev->func);
+		AICWFDBG(LOGERROR, "enable func fail %d.\n", ret);
+		return ret;
+	}
+
+	if (feature.sdio_clock > 0) {
+		host->ios.clock =3D feature.sdio_clock;
+		host->ops->set_ios(host, &host->ios);
+		AICWFDBG(LOGINFO, "Set SDIO Clock %d MHz\n", host->ios.clock / 1000000);
+	}
+
+	sdio_release_host(sdiodev->func);
+
+	if (sdiodev->chipid =3D=3D PRODUCT_ID_AIC8801 || sdiodev->chipid =3D=3D P=
RODUCT_ID_AIC8800DC ||
+	    sdiodev->chipid =3D=3D PRODUCT_ID_AIC8800DW) {
+		sdio_claim_host(sdiodev->func2);
+		//set sdio blocksize
+		ret =3D sdio_set_block_size(sdiodev->func2, SDIOWIFI_FUNC_BLOCKSIZE);
+		if (ret < 0) {
+			AICWFDBG(LOGERROR, "set func2 blocksize fail %d\n", ret);
+			sdio_release_host(sdiodev->func2);
+			return ret;
+		}
+
+		//set sdio enable func
+		ret =3D sdio_enable_func(sdiodev->func2);
+		if (ret < 0) {
+			sdio_release_host(sdiodev->func2);
+			AICWFDBG(LOGERROR, "enable func2 fail %d.\n", ret);
+			return ret;
+		}
+
+		sdio_release_host(sdiodev->func2);
+
+		ret =3D aicwf_sdio_func2_writeb(sdiodev,
+					      sdiodev->sdio_reg.register_block, block_bit0);
+		if (ret < 0) {
+			AICWFDBG(LOGERROR, "reg:%d write failed!\n",
+				 sdiodev->sdio_reg.register_block);
+			return ret;
+		}
+
+		//1: no byte mode
+		ret =3D aicwf_sdio_func2_writeb(sdiodev, sdiodev->sdio_reg.bytemode_enab=
le_reg,
+					      byte_mode_disable);
+		if (ret < 0) {
+			AICWFDBG(LOGERROR, "reg:%d write failed!\n",
+				 sdiodev->sdio_reg.bytemode_enable_reg);
+			return ret;
+		}
+	}
+
+	ret =3D aicwf_sdio_writeb(sdiodev, sdiodev->sdio_reg.register_block, bloc=
k_bit0);
+	if (ret < 0) {
+		AICWFDBG(LOGERROR, "reg:%d write failed!\n", sdiodev->sdio_reg.register_=
block);
+		return ret;
+	}
+
+	//1: no byte mode
+	ret =3D aicwf_sdio_writeb(sdiodev, sdiodev->sdio_reg.bytemode_enable_reg,=
 byte_mode_disable);
+	if (ret < 0) {
+		AICWFDBG(LOGERROR, "reg:%d write failed!\n", sdiodev->sdio_reg.bytemode_=
enable_reg);
+		return ret;
+	}
+
+	mdelay(10);
+	return ret;
