        \
+ *		ac < NX_NB_TXQ_PER_VIF; ac++, txq =3D rwnx_txq_vif_get(vif, ac))
+ *#else
+ *#define foreach_vif_txq(vif, txq, ac)                                   =
       \
+ *	for (ac =3D RWNX_HWQ_BK, txq =3D &vif->txqs[0]; ac < NX_NB_TXQ_PER_VIF;=
        \
+ *		ac++, txq++)
+ *#endif
