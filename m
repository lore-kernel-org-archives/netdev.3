+static int process_fragment_reassembly(struct defrag_ctrl_info *defrag_inf=
o,
+				       u16 frag_num, struct sk_buff *skb,
+				       u8 pull_len, struct rwnx_hw *rwnx_hw,
+				       u8 *is_frag)
+{
+	if (!defrag_info)
+		return 1;
+
+	*is_frag =3D 1;
+	if (defrag_info->next_fn !=3D frag_num) {
+		AICWFDBG(LOGDEBUG, "discard:%d:%d\n",
+			 defrag_info->next_fn, frag_num);
+		dev_kfree_skb(skb);
+		spin_unlock_bh(&rwnx_hw->defrag_lock);
+		return 0;
+	}
+
+	skb_put(defrag_info->skb, skb->len - (pull_len - 8));
+	memcpy(&defrag_info->skb->data[defrag_info->frm_len],
+	       &skb->data[pull_len - 8],
+	       skb->len - (pull_len - 8));
+
+	defrag_info->frm_len +=3D skb->len - (pull_len - 8);
+	defrag_info->next_fn++;
+
+	dev_kfree_skb(skb);
+	spin_unlock_bh(&rwnx_hw->defrag_lock);
+
+	return 0;
+}
