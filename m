+	u16 aggr_len =3D 0;
+
+	if (!skb->data || skb->len =3D=3D 0)
+		return false;
+	data =3D skb->data;
+	aggr_len =3D (*skb->data | (*(skb->data + 1) << 8));
+	if (aggr_len =3D=3D 0)
+		return false;
+
+	return true;
+}
