+int android_priv_cmd(struct net_device *net, struct ifreq *ifr, int cmd)
+{
+#define PRIVATE_COMMAND_MAX_LEN 8192
+#define PRIVATE_COMMAND_DEF_LEN 6144
+
+	int ret =3D 0;
+	char *command =3D NULL;
+	int bytes_written =3D 0;
+	struct android_wifi_priv_cmd priv_cmd;
+	int buf_size =3D 0;
+#ifdef ANDROID_PLATFORM
+	struct rwnx_vif *vif =3D netdev_priv(net);
+	int skip =3D 0;
+	char *country =3D NULL;
+	int setsusp_mode;
+	struct ieee80211_regdomain *regdomain;
+#endif
+
+	RWNX_DBG(RWNX_FN_ENTRY_STR);
+
+	if (!ifr->ifr_data) {
+		ret =3D -EINVAL;
+		goto exit;
+	}
+
+#ifdef CONFIG_COMPAT
+	if (in_compat_syscall()) {
+		struct compat_android_wifi_priv_cmd compat_priv_cmd;
+
+		if (copy_from_user(&compat_priv_cmd, ifr->ifr_data,
+				   sizeof(struct compat_android_wifi_priv_cmd))) {
+			ret =3D -EFAULT;
+			goto exit;
+		}
+		priv_cmd.buf =3D compat_ptr(compat_priv_cmd.buf);
+		priv_cmd.used_len =3D compat_priv_cmd.used_len;
+		priv_cmd.total_len =3D compat_priv_cmd.total_len;
+	} else {
+#endif /* CONFIG_COMPAT */
+		if (copy_from_user(&priv_cmd, ifr->ifr_data,
+				   sizeof(struct android_wifi_priv_cmd))) {
+			ret =3D -EFAULT;
+			goto exit;
+		}
+	}
+	if (priv_cmd.total_len > PRIVATE_COMMAND_MAX_LEN ||
+	    priv_cmd.total_len < 0) {
+		pr_err("%s: buf length invalid:%d\n", __func__, priv_cmd.total_len);
+		ret =3D -EINVAL;
+		goto exit;
+	}
+
+	buf_size =3D max(priv_cmd.total_len, PRIVATE_COMMAND_DEF_LEN);
+	command =3D
+		kmalloc((buf_size + 1), GFP_KERNEL);
+	if (!command) {
+		pr_err("%s: failed to allocate memory\n", __func__);
+		ret =3D -ENOMEM;
+		goto exit;
+	}
+	if (copy_from_user(command, priv_cmd.buf, priv_cmd.total_len)) {
+		ret =3D -EFAULT;
+		goto exit;
+	}
+	command[priv_cmd.total_len] =3D '\0';
+
+	AICWFDBG(LOGINFO, "%s: Android private cmd \"%s\" on %s\n", __func__,
+		 command, ifr->ifr_name);
+
+#ifdef ANDROID_PLATFORM
+	if (!strncasecmp(command, CMD_SET_COUNTRY, strlen(CMD_SET_COUNTRY))) {
+		skip =3D strlen(CMD_SET_COUNTRY) + 1;
+		country =3D command + skip;
+		if (!country || strlen(country) < RWNX_COUNTRY_CODE_LEN) {
+			pr_err("%s: invalid country code\n", __func__);
+			ret =3D -EINVAL;
+			goto exit;
+		}
+
+		AICWFDBG(LOGINFO, "%s country code:%c%c\n", __func__,
+			 toupper(country[0]), toupper(country[1]));
+		regdomain =3D get_regdomain_from_rwnx_db(vif->rwnx_hw->wiphy, country);
+		ret =3D regulatory_set_wiphy_regd(vif->rwnx_hw->wiphy, regdomain);
+		if (ret)
+			pr_warn("regulatory_set_wiphy_regd fail \r\n");
+#ifdef CONFIG_POWER_LIMIT
+		if (vif->rwnx_hw->sdiodev->chipid =3D=3D PRODUCT_ID_AIC8800D80)
+			rwnx_plat_powerlimit_load_8800d80(vif->rwnx_hw);
+		if (!testmode)
+			rwnx_send_me_chan_config_req(vif->rwnx_hw);
+#endif
+	}
+#ifdef CONFIG_SET_VENDOR_EXTENSION_IE
+	else if (!strncasecmp(command, CMD_SET_VENDOR_EX_IE,
+			      strlen(CMD_SET_VENDOR_EX_IE))) {
+		set_vendor_extension_ie(command);
+	}
+#endif // CONFIG_SET_VENDOR_EXTENSION_IE
+	else if (!strncasecmp(command, CMD_SET_AP_WPS_P2P_IE,
+			      strlen(CMD_SET_AP_WPS_P2P_IE))) {
+		ret =3D 0;
+		goto exit;
+	} else if (!strncasecmp(command, CMD_SETSUSPENDMODE,
+							strlen(CMD_SETSUSPENDMODE))) {
+#ifdef AICWF_SDIO_SUPPORT
+#if defined(CONFIG_GPIO_WAKEUP) && !defined(CONFIG_AUTO_POWERSAVE)
+		skip =3D strlen(CMD_SETSUSPENDMODE) + 1;
+		setsusp_mode =3D command_strtoul(command + skip, NULL, 10);
+#ifdef AICWF_LATENCY_MODE
+		if (setsusp_mode)
+			rwnx_send_me_set_lp_level(g_rwnx_plat->sdiodev->rwnx_hw, setsusp_mode, =
0);
+		else
+			rwnx_send_me_set_lp_level(g_rwnx_plat->sdiodev->rwnx_hw, 1, 1);
+#else
+		rwnx_send_me_set_lp_level(g_rwnx_plat->sdiodev->rwnx_hw,
+					  setsusp_mode, !setsusp_mode);
+#endif
+
+	AICWFDBG(LOGINFO, "set suspend mode %d\n", setsusp_mode);
+#endif // CONFIG_GPIO_WAKEUP
+#endif
+		goto exit;
+	}
+#endif // Handle Android command
+
+	bytes_written =3D handle_private_cmd(net, command, priv_cmd.total_len);
+	if (bytes_written >=3D 0) {
+		if (bytes_written =3D=3D 0 && priv_cmd.total_len > 0)
+			command[0] =3D '\0';
+		if (bytes_written >=3D priv_cmd.total_len) {
+			pr_info("%s: err. bytes_written:%d >=3D buf_size:%d\n", __func__,
+				bytes_written, buf_size);
+			goto exit;
+		}
+		bytes_written++;
+		priv_cmd.used_len =3D bytes_written;
+		if (copy_to_user(priv_cmd.buf, command, bytes_written)) {
+			pr_err("%s: failed to copy data to user buffer\n", __func__);
+			ret =3D -EFAULT;
+		}
+	} else {
+		/* Propagate the error */
+		ret =3D bytes_written;
+	}
+
+exit:
+	kfree(command);
+	return ret;
+}
