+unsigned int command_strtoul(const char *cp, char **endp, unsigned int bas=
e)
+{
+	unsigned int result =3D 0, value, is_neg =3D 0;
+
+	if (*cp =3D=3D '0') {
+		cp++;
+		if ((*cp =3D=3D 'x') && isxdigit(cp[1])) {
+			base =3D 16;
+			cp++;
+		}
+		if (!base)
+			base =3D 8;
+	}
+	if (!base)
+		base =3D 10;
+	if (*cp =3D=3D '-') {
+		is_neg =3D 1;
+		cp++;
+	}
+	while (isxdigit(*cp) &&
+	       (value =3D isdigit(*cp) ? *cp - '0'
+		: (islower(*cp) ? toupper(*cp) : *cp) - 'A' +
+		10) < base) {
+		result =3D result * base + value;
+		cp++;
+	}
+	if (is_neg)
+		result =3D (unsigned int)((int)result * (-1));
+
+	if (endp)
+		*endp =3D (char *)cp;
+	return result;
+}
