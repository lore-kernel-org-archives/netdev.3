+/**
+ * @dump_survey: get site survey information.
+ */
+static int rwnx_cfg80211_dump_survey(struct wiphy *wiphy,
+				     struct net_device *netdev, int idx,
+				     struct survey_info *info)
+{
+	struct rwnx_hw *rwnx_hw =3D wiphy_priv(wiphy);
+	struct ieee80211_supported_band *sband;
+	struct rwnx_survey_info *rwnx_survey;
+
+	// RWNX_DBG(RWNX_FN_ENTRY_STR);
+
+	if (idx >=3D ARRAY_SIZE(rwnx_hw->survey))
+		return -ENOENT;
+
+	rwnx_survey =3D &rwnx_hw->survey[idx];
+
+	// Check if provided index matches with a supported 2.4GHz channel
+	sband =3D wiphy->bands[NL80211_BAND_2GHZ];
+	if (sband && idx >=3D sband->n_channels) {
+		idx -=3D sband->n_channels;
+		sband =3D NULL;
+	}
+
+	if (rwnx_hw->band_5g_support) {
+		if (!sband) {
+			// Check if provided index matches with a supported 5GHz channel
+			sband =3D wiphy->bands[NL80211_BAND_5GHZ];
+
+			if (!sband || idx >=3D sband->n_channels)
+				return -ENOENT;
+		}
+	} else {
+		if (!sband || idx >=3D sband->n_channels)
+			return -ENOENT;
+	}
+
+	// Fill the survey
+	info->channel =3D &sband->channels[idx];
+	info->filled =3D rwnx_survey->filled;
+
+	if (rwnx_survey->filled !=3D 0) {
+		SURVEY_TIME(info) =3D (u64)rwnx_survey->chan_time_ms;
+		SURVEY_TIME_BUSY(info) =3D (u64)rwnx_survey->chan_time_busy_ms;
+		// info->noise =3D rwnx_survey->noise_dbm;
+		info->noise =3D
+			((IS_2P4GHZ(info->channel->center_freq)) ? DEFAULT_NOISE_FLOOR_2GHZ
+			 : (IS_5GHZ(info->channel->center_freq))
+				 ? DEFAULT_NOISE_FLOOR_5GHZ
+				 : DEFAULT_NOISE_FLOOR_5GHZ);
+
+		// Set the survey report as not used
+		if (info->noise =3D=3D 0)
+			rwnx_survey->filled =3D 0;
+		else
+			rwnx_survey->filled |=3D SURVEY_INFO_NOISE_DBM;
+	}
+
+	return 0;
+}
