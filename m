+	pos =3D skb_put(skb, 4);
+	*pos++ =3D WLAN_EID_SUPPORTED_REGULATORY_CLASSES;
+	*pos++ =3D 2; /* len */
+
+	// current op class
+	*pos++ =3D op_class;
+	*pos++ =3D op_class; /* give current operating class as alternate too */
+
+	// need to add 5GHz classes?
+}
