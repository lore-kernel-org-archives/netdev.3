+    off = skb_network_offset(skb);
+    if (off < skb->len &&
+        (airoha_ppe_skb_read_ipv4_tuple_at(skb, off, tuple) ||
+         airoha_ppe_skb_read_ipv6_tuple_at(skb, off, tuple)))
