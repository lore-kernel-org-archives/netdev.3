+int aic_enqueue(struct sk_buff *skb)
+{
+	unsigned long flags =3D 0;
+	int ret =3D 0;
+
+	spin_lock_irqsave(&queue_lock, flags);
+	if (aic_skb_queue_front =3D=3D (aic_skb_queue_rear + 1) % QUEUE_SIZE) {
+		/*
+		 * If queue is full, current solution is to drop
+		 * the following entries.
+		 */
+		AICBT_WARN("%s: Queue is full, entry will be dropped", __func__);
+		ret =3D -1;
+	} else {
+		aic_skb_queue[aic_skb_queue_rear] =3D skb;
+
+		aic_skb_queue_rear++;
+		aic_skb_queue_rear %=3D QUEUE_SIZE;
+	}
+	spin_unlock_irqrestore(&queue_lock, flags);
+	return ret;
+}
+
+static struct sk_buff *aic_dequeue_try(unsigned int deq_len)
+{
+	struct sk_buff *skb;
+	struct sk_buff *skb_copy;
+	unsigned long flags =3D 0;
+
+	spin_lock_irqsave(&queue_lock, flags);
+	if (aic_skb_queue_front =3D=3D aic_skb_queue_rear) {
+		AICBT_WARN("%s: Queue is empty", __func__);
+		spin_unlock_irqrestore(&queue_lock, flags);
+		return NULL;
+	}
+
+	skb =3D aic_skb_queue[aic_skb_queue_front];
+	if (deq_len >=3D skb->len) {
+		aic_skb_queue_front++;
+		aic_skb_queue_front %=3D QUEUE_SIZE;
+
+		/*
+		 * Return skb addr to be dequeued, and the caller
+		 * should free the skb eventually.
+		 */
+		spin_unlock_irqrestore(&queue_lock, flags);
+		return skb;
+	}
+	skb_copy =3D pskb_copy(skb, GFP_ATOMIC);
+	skb_pull(skb, deq_len);
+	/* Return its copy to be freed */
+	spin_unlock_irqrestore(&queue_lock, flags);
+	return skb_copy;
+}
+
+static inline int is_queue_empty(void)
+{
+	return (aic_skb_queue_front =3D=3D aic_skb_queue_rear) ? 1 : 0;
+}
+
+void aic_clear_queue(void)
+{
+	struct sk_buff *skb;
+	unsigned long flags =3D 0;
+
+	spin_lock_irqsave(&queue_lock, flags);
+	while (!is_queue_empty()) {
+		skb =3D aic_skb_queue[aic_skb_queue_front];
+		aic_skb_queue[aic_skb_queue_front] =3D NULL;
+		aic_skb_queue_front++;
+		aic_skb_queue_front %=3D QUEUE_SIZE;
+		if (skb)
+			kfree_skb(skb);
+	}
+	spin_unlock_irqrestore(&queue_lock, flags);
+}
+
+int aic_queue_cnt(void)
+{
+	int ret_cnt =3D 0;
+	unsigned long flags =3D 0;
+
+	spin_lock_irqsave(&queue_lock, flags);
+	if (is_queue_empty()) {
+		ret_cnt =3D 0;
+	} else {
+		if (aic_skb_queue_rear > aic_skb_queue_front)
+			ret_cnt =3D aic_skb_queue_rear - aic_skb_queue_front;
+		else
+			ret_cnt =3D aic_skb_queue_rear + QUEUE_SIZE - aic_skb_queue_front;
+	}
+	spin_unlock_irqrestore(&queue_lock, flags);
+	return ret_cnt;
+}
