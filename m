+int aicwf_sdio_bustx_thread(void *data)
+{
+	struct aicwf_bus *bus =3D (struct aicwf_bus *)data;
+	struct aic_sdio_dev *sdiodev =3D bus->bus_priv.sdio;
+
+	while (1) {
+		if (kthread_should_stop()) {
+			sdio_dbg("sdio bustx thread stop\n");
