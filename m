+static int aicwf_get_scan(struct net_device *dev, struct iw_request_info *=
a,
+			  union iwreq_data *wrqu, char *extra)
+{
+	int ret =3D 0;
+	struct rwnx_vif *rwnx_vif =3D netdev_priv(dev);
+	struct rwnx_hw *rwnx_hw =3D rwnx_vif->rwnx_hw;
+	struct scanu_result_wext *scan_re;
+	struct scanu_result_wext *tmp;
+	char *start =3D extra;
+	char *stop =3D start + wrqu->data.length;
+
+	AICWFDBG(LOGDEBUG, "%s Enter %p %p len:%d \r\n", __func__, start, stop, w=
rqu->data.length);
+
+	//TODO: spinlock
+	list_for_each_entry_safe(scan_re, tmp, &rwnx_hw->wext_scanre_list, scanu_=
re_list) {
+		start =3D translate_scan(rwnx_hw, a, scan_re, start, stop);
+		if ((stop - start) < 768)
+			return -E2BIG;
+	}
+
+	list_for_each_entry_safe(scan_re, tmp, &rwnx_hw->wext_scanre_list, scanu_=
re_list) {
+		list_del(&scan_re->scanu_re_list);
+		vfree(scan_re->payload);
+		vfree(scan_re->ind);
+		vfree(scan_re);
+		scan_re =3D NULL;
+	}
+
+	wrqu->data.length =3D start - extra;
+	wrqu->data.flags =3D 0;
+
+	return ret;
+}
