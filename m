+static void rwnx_cfgp2p_stop_p2p_device(struct wiphy *wiphy,
+					struct wireless_dev *wdev)
+{
+	int ret =3D 0;
+	struct rwnx_hw *rwnx_hw =3D wiphy_priv(wiphy);
+	struct rwnx_vif *rwnx_vif =3D container_of(wdev, struct rwnx_vif, wdev);
+	/* Abort scan request on the vif */
+	if (rwnx_hw->scan_request &&
+	    rwnx_hw->scan_request->wdev =3D=3D &rwnx_vif->wdev) {
+		struct cfg80211_scan_info info =3D {
+			.aborted =3D true,
+		};
+
+		cfg80211_scan_done(rwnx_hw->scan_request, &info);
+		rwnx_hw->scan_request =3D NULL;
+		ret =3D rwnx_send_scanu_cancel_req(rwnx_hw, NULL);
+		if (ret)
+			AICWFDBG(LOGDEBUG, "AICWF scanu_cancel fail\n");
+	}
+
+	if (rwnx_vif =3D=3D rwnx_hw->p2p_dev_vif) {
+		rwnx_hw->is_p2p_alive =3D 0;
+		if (timer_pending(&rwnx_hw->p2p_alive_timer))
+			del_timer_sync(&rwnx_hw->p2p_alive_timer);
+
+		if (rwnx_vif->up) {
+			rwnx_send_remove_if(rwnx_hw, rwnx_vif->vif_index, true);
+			/* Ensure that we won't process disconnect ind */
+			spin_lock_bh(&rwnx_hw->cb_lock);
+			rwnx_vif->up =3D false;
+			rwnx_hw->vif_table[rwnx_vif->vif_index] =3D NULL;
+			AICWFDBG(LOGDEBUG, "%s rwnx_vif[%d] down \r\n", __func__,
+				 rwnx_vif->vif_index);
+			rwnx_hw->vif_started--;
+			spin_unlock_bh(&rwnx_hw->cb_lock);
+		}
+	}
+	AICWFDBG(LOGDEBUG, "AICWF Exit. P2P interface stopped\n");
+}
