+/**
+ * @start_ap: Start acting in AP mode defined by the parameters.
+ */
+static int rwnx_cfg80211_start_ap(struct wiphy *wiphy, struct net_device *=
dev,
+				  struct cfg80211_ap_settings *settings)
+{
+	struct rwnx_hw *rwnx_hw =3D wiphy_priv(wiphy);
+	struct rwnx_vif *rwnx_vif =3D netdev_priv(dev);
+	struct apm_start_cfm apm_start_cfm;
+	struct rwnx_ipc_elem_var elem;
+	struct rwnx_sta *sta;
+	int error =3D 0;
+
+	RWNX_DBG(RWNX_FN_ENTRY_STR);
+
+	INIT_WORK(&rwnx_vif->sta_probe.apmprobesta_work, apm_probe_sta_work_proce=
ss);
+	rwnx_vif->sta_probe.apmprobesta_wq =3D
+		create_singlethread_workqueue("apmprobe_wq");
+	if (!rwnx_vif->sta_probe.apmprobesta_wq) {
+		txrx_err("insufficient memory to create apmprobe_wq.\n");
+		return -ENOBUFS;
+	}
+
+	if (rwnx_vif->wdev.iftype =3D=3D NL80211_IFTYPE_P2P_GO)
+		rwnx_hw->is_p2p_connected =3D 1;
+	/* Forward the information to the LMAC */
+	error =3D rwnx_send_apm_start_req(rwnx_hw, rwnx_vif, settings,
+					&apm_start_cfm, &elem);
+	if (error)
+		goto end;
+
+	// Check the status
+	switch (apm_start_cfm.status) {
+	case CO_OK: {
+		u8 txq_status =3D 0;
+
+		rwnx_vif->ap.bcmc_index =3D apm_start_cfm.bcmc_idx;
+		rwnx_vif->ap.flags =3D 0;
+#if (defined CONFIG_HE_FOR_OLD_KERNEL) || (defined CONFIG_VHT_FOR_OLD_KERN=
EL)
+		rwnx_vif->ap.aic_index =3D 0;
+#endif
+		rwnx_vif->ap.csa =3D NULL;
+		sta =3D &rwnx_hw->sta_table[apm_start_cfm.bcmc_idx];
+		sta->valid =3D true;
+		sta->aid =3D 0;
+		sta->sta_idx =3D apm_start_cfm.bcmc_idx;
+		sta->ch_idx =3D apm_start_cfm.ch_idx;
+		sta->vif_idx =3D rwnx_vif->vif_index;
+		sta->qos =3D false;
+		sta->acm =3D 0;
+		sta->ps.active =3D false;
+		rwnx_mu_group_sta_init(sta, NULL);
+		spin_lock_bh(&rwnx_hw->cb_lock);
+		rwnx_chanctx_link(rwnx_vif, apm_start_cfm.ch_idx, &settings->chandef);
+		if (rwnx_hw->cur_chanctx !=3D apm_start_cfm.ch_idx)
+			txq_status =3D RWNX_TXQ_STOP_CHAN;
+
+		rwnx_txq_vif_init(rwnx_hw, rwnx_vif, txq_status);
+		spin_unlock_bh(&rwnx_hw->cb_lock);
+
+		netif_tx_start_all_queues(dev);
+		netif_carrier_on(dev);
+		error =3D 0;
+		/* If the AP channel is already the active, we probably skip radar
+		 * activation on MM_CHANNEL_SWITCH_IND (unless another vif use this
+		 * ctxt). In anycase retest if radar detection must be activated
+		 */
+		if (txq_status =3D=3D 0)
+			rwnx_radar_detection_enable_on_cur_channel(rwnx_hw);
+		break;
+	}
+	case CO_BUSY:
+		error =3D -EINPROGRESS;
+		break;
+	case CO_OP_IN_PROGRESS:
+		error =3D -EALREADY;
+		break;
+	default:
+		error =3D -EIO;
+		break;
+	}
+
+	if (error)
+		netdev_info(dev, "Failed to start AP (%d)", error);
+	else
+		netdev_info(dev, "AP started: ch=3D%d, bcmc_idx=3D%d channel=3D%d bw=3D%=
d",
+			    rwnx_vif->ch_index, rwnx_vif->ap.bcmc_index,
+			    ((settings->chandef).chan)->center_freq,
+			    ((settings->chandef).width));
+
+end:
+	return error;
+}
