+int rwnx_load_firmware(u32 **fw_buf, const char *name, struct device *devi=
ce)
+{
+#ifdef CONFIG_USE_FW_REQUEST
+	const struct firmware *fw =3D NULL;
+	u32 *dst =3D NULL;
+	void *buffer =3D NULL;
+#ifdef CONFIG_TEDIOUS_PRT
+	struct MD5_CTX md5;
+#endif
+	unsigned char decrypt[16];
+	int size =3D 0;
+	int ret =3D 0;
+
+	pr_info("aicbsp %s: request firmware =3D %s\n", __func__, name);
+
+	ret =3D request_firmware(&fw, name, NULL);
+
+	if (ret < 0) {
+		pr_err("aicbsp Load %s fail\n", name);
+		release_firmware(fw);
+		return -1;
+	}
+
+	size =3D fw->size;
+	dst =3D (u32 *)fw->data;
+
+	if (size <=3D 0) {
+		pr_err("aicbsp wrong size of firmware file\n");
+		release_firmware(fw);
+		return -1;
+	}
+
+	buffer =3D vmalloc(size);
+	memset(buffer, 0, size);
+	memcpy(buffer, dst, size);
+
+	*fw_buf =3D buffer;
+
+#ifdef CONFIG_TEDIOUS_PRT
+	md5_init(&md5);
+	md5_update(&md5, (unsigned char *)buffer, size);
+	md5_final(&md5, decrypt);
+	print_md5(decrypt);
+#endif
+
+	release_firmware(fw);
+
+	return size;
+#else
+	void *buffer =3D NULL;
+	char *path =3D NULL;
+	struct file *fp =3D NULL;
+	int size =3D 0, len =3D 0;
+	ssize_t rdlen =3D 0;
+#ifdef CONFIG_TEDIOUS_PRT
+	struct MD5_CTX md5;
+	unsigned char decrypt[16];
+#endif
+
+#ifdef CONFIG_FIRMWARE_ARRAY
+	size =3D aicwf_get_firmware_array((char *)name, fw_buf);
+	pr_info("aicbsp %s size:%d \r\n", __func__, size);
+#ifdef CONFIG_TEDIOUS_PRT
+	md5_init(&md5);
+	md5_update(&md5, (unsigned char *)*fw_buf, size);
+	md5_final(&md5, decrypt);
+	print_md5(decrypt);
+#endif
+
+	return size;
+#endif
+
+	/* get the firmware path */
+	path =3D __getname();
+	if (!path) {
+		*fw_buf =3D NULL;
+		return -1;
+	}
+
+	if (strlen(aic_fw_path) > 0)
+		len =3D snprintf(path, AICBSP_FW_PATH_MAX, "%s/%s", aic_fw_path, name);
+	else
+		len =3D snprintf(path, AICBSP_FW_PATH_MAX, "%s/%s", AICBSP_FW_PATH, name=
);
+	if (len >=3D AICBSP_FW_PATH_MAX) {
+		pr_err("aicbsp %s: %s file's path too long\n", __func__, name);
+		*fw_buf =3D NULL;
+		__putname(path);
+		return -1;
+	}
+
+	pr_info("aicbsp %s :firmware path =3D %s\n", __func__, path);
+
+	/* open the firmware file */
+	fp =3D filp_open(path, O_RDONLY, 0);
+	if (IS_ERR_OR_NULL(fp)) {
+		pr_err("aicbsp %s: %s file failed to open\n", __func__, name);
+		*fw_buf =3D NULL;
+		__putname(path);
+		fp =3D NULL;
+		return -1;
+	}
+
+	size =3D i_size_read(file_inode(fp));
+	if (size <=3D 0) {
+		pr_err("aicbsp %s: %s file size invalid %d\n", __func__, name, size);
+		*fw_buf =3D NULL;
+		__putname(path);
+		filp_close(fp, NULL);
+		fp =3D NULL;
+		return -1;
+	}
+
+	/* start to read from firmware file */
+	buffer =3D vmalloc(size);
+
+	if (!buffer) {
+		*fw_buf =3D NULL;
+		__putname(path);
+		filp_close(fp, NULL);
+		fp =3D NULL;
+		return -1;
+	}
+	memset(buffer, 0, size);
+
+	rdlen =3D kernel_read(fp, buffer, size, &fp->f_pos);
+
+	if (size !=3D rdlen) {
+		pr_err("aicbsp %s: %s file rdlen invalid %ld\n", __func__, name,
+		       (long)rdlen);
+		*fw_buf =3D NULL;
