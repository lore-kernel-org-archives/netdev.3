+int aicbsp_resv_mem_deinit(void)
+{
+	int i =3D 0;
+
+	pr_info("aicbsp %s\n", __func__);
+	for (i =3D 0; i < ARRAY_SIZE(resv_skb); i++) {
+		if (resv_skb[i].used =3D=3D 0 && resv_skb[i].skb)
+			dev_kfree_skb(resv_skb[i].skb);
