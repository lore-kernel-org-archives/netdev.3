+static void idx_to_rate_cfg(int idx, union rwnx_rate_ctrl_info *r_cfg,
+			    int *ru_size)
+{
+	r_cfg->value =3D 0;
+	if (idx < N_CCK) {
+		r_cfg->format_mod_tx =3D FORMATMOD_NON_HT;
+		r_cfg->gi_and_pre_type_tx =3D (idx & 1) << 1;
+		r_cfg->mcs_index_tx =3D idx / 2;
+	} else if (idx < (N_CCK + N_OFDM)) {
+		r_cfg->format_mod_tx =3D FORMATMOD_NON_HT;
+		r_cfg->mcs_index_tx =3D idx - N_CCK + 4;
+	} else if (idx < (N_CCK + N_OFDM + N_HT)) {
+		union rwnx_mcs_index *r =3D (union rwnx_mcs_index *)r_cfg;
+
+		idx -=3D (N_CCK + N_OFDM);
+		r_cfg->format_mod_tx =3D FORMATMOD_HT_MF;
+		r->ht.nss =3D idx / (8 * 2 * 2);
+		r->ht.mcs =3D (idx % (8 * 2 * 2)) / (2 * 2);
+		r_cfg->bw_tx =3D ((idx % (8 * 2 * 2)) % (2 * 2)) / 2;
+		r_cfg->gi_and_pre_type_tx =3D idx & 1;
+	} else if (idx < (N_CCK + N_OFDM + N_HT + N_VHT)) {
+		union rwnx_mcs_index *r =3D (union rwnx_mcs_index *)r_cfg;
+
+		idx -=3D (N_CCK + N_OFDM + N_HT);
+		r_cfg->format_mod_tx =3D FORMATMOD_VHT;
+		r->vht.nss =3D idx / (10 * 4 * 2);
+		r->vht.mcs =3D (idx % (10 * 4 * 2)) / (4 * 2);
+		r_cfg->bw_tx =3D ((idx % (10 * 4 * 2)) % (4 * 2)) / 2;
+		r_cfg->gi_and_pre_type_tx =3D idx & 1;
+	} else if (idx < (N_CCK + N_OFDM + N_HT + N_VHT + N_HE_SU)) {
+		union rwnx_mcs_index *r =3D (union rwnx_mcs_index *)r_cfg;
+
+		idx -=3D (N_CCK + N_OFDM + N_HT + N_VHT);
+		r_cfg->format_mod_tx =3D FORMATMOD_HE_SU;
+		r->vht.nss =3D idx / (12 * 4 * 3);
+		r->vht.mcs =3D (idx % (12 * 4 * 3)) / (4 * 3);
+		r_cfg->bw_tx =3D ((idx % (12 * 4 * 3)) % (4 * 3)) / 3;
+		r_cfg->gi_and_pre_type_tx =3D idx % 3;
+	} else {
+		union rwnx_mcs_index *r =3D (union rwnx_mcs_index *)r_cfg;
+
+		WARN_ON_ONCE(!ru_size);
+
+		idx -=3D (N_CCK + N_OFDM + N_HT + N_VHT + N_HE_SU);
+		r_cfg->format_mod_tx =3D FORMATMOD_HE_MU;
+		r->vht.nss =3D idx / (12 * 6 * 3);
+		r->vht.mcs =3D (idx % (12 * 6 * 3)) / (6 * 3);
+		*ru_size =3D ((idx % (12 * 6 * 3)) % (6 * 3)) / 3;
+		r_cfg->gi_and_pre_type_tx =3D idx % 3;
+		r_cfg->bw_tx =3D 0;
+	}
+}
+
+static void idx_to_rate_cfg1(unsigned int formatmod, unsigned int mcs,
+			     unsigned int nss, unsigned int bw_tx,
+			     unsigned int gi, union rwnx_rate_ctrl_info *r_cfg,
+			     int *ru_size)
+{
+	r_cfg->value =3D 0;
+
+	switch (formatmod) {
+	case FORMATMOD_NON_HT: {
+		r_cfg->format_mod_tx =3D formatmod;
+		r_cfg->gi_and_pre_type_tx =3D 1;
+		r_cfg->mcs_index_tx =3D mcs;
+		break;
+	}
+	case FORMATMOD_NON_HT_DUP_OFDM: {
+		r_cfg->format_mod_tx =3D formatmod;
+		r_cfg->gi_and_pre_type_tx =3D gi;
+		r_cfg->mcs_index_tx =3D mcs;
+		break;
+	}
+	case FORMATMOD_HT_MF: {
+		union rwnx_mcs_index *r =3D (union rwnx_mcs_index *)r_cfg;
+
+		r_cfg->formati_mod_tx =3D formatmod;
+		r->ht.nss =3D nss;
+		r->ht.mcs =3D mcs;
+		r_cfg->bw_tx =3D bw_tx;
+		r_cfg->gi_and_pre_type_tx =3D gi;
+		break;
+	}
+	case FORMATMOD_VHT:
+	case FORMATMOD_HE_SU: {
+		union rwnx_mcs_index *r =3D (union rwnx_mcs_index *)r_cfg;
+
+		r_cfg->format_mod_tx =3D formatmod;
+		r->vht.nss =3D nss;
+		r->vht.mcs =3D mcs;
+		r_cfg->bw_tx =3D bw_tx;
+		r_cfg->gi_and_pre_type_tx =3D gi;
+		break;
+	}
+	case FORMATMOD_HE_MU: {
+		union rwnx_mcs_index *r =3D (union rwnx_mcs_index *)r_cfg;
+
+		r_cfg->format_mod_tx =3D formatmod;
+		r->he.nss =3D nss;
+		r->he.mcs =3D mcs;
+		r_cfg->bw_tx =3D 0;
+		r_cfg->gi_and_pre_type_tx =3D gi;
+		break;
+	}
+	default:
+		AICWFDBG(LOGDEBUG, "Don't have the formatmod");
+	}
+}
