+	/* Get Trident path mapping */
+	tag_ptr =3D rwnx_find_tag(config_fw->data, config_fw->size,
+				"TRD_PATH_MAPPING=3D", strlen("00"));
+	if (tag_ptr) {
+		u8 val;
+
+		if (kstrtou8(tag_ptr, 16, &val) =3D=3D 0)
+			config->trd.path_mapping =3D val;
+		else
+			config->trd.path_mapping =3D path;
+	} else {
+		config->trd.path_mapping =3D path;
