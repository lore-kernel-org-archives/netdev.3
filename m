+	if (RWNX_VIF_TYPE(vif) !=3D NL80211_IFTYPE_AP &&
+	    RWNX_VIF_TYPE(vif) !=3D NL80211_IFTYPE_P2P_GO &&
+	    RWNX_VIF_TYPE(vif) !=3D NL80211_IFTYPE_AP_VLAN)
+		return -EINVAL;
