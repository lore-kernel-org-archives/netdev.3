+/*********************************************************************
+ * Cfg80211 callbacks (and helper)
+ *********************************************************************/
+static struct rwnx_vif *rwnx_interface_add(struct rwnx_hw *rwnx_hw,
+					   const char *name,
+					   unsigned char name_assign_type,
+					   enum nl80211_iftype type,
+					   struct vif_params *params)
+{
+	struct net_device *ndev;
+	struct rwnx_vif *vif;
+	int min_idx, max_idx;
+	int vif_idx =3D -1;
+	int i;
+	int nx_nb_ndev_txq =3D NX_NB_NDEV_TXQ;
+
+	if (g_rwnx_plat->sdiodev->chipid =3D=3D PRODUCT_ID_AIC8801 ||
+	    ((g_rwnx_plat->sdiodev->chipid =3D=3D PRODUCT_ID_AIC8800DC ||
+	      g_rwnx_plat->sdiodev->chipid =3D=3D PRODUCT_ID_AIC8800DW) &&
+	    chip_id < 3))
+		nx_nb_ndev_txq =3D NX_NB_NDEV_TXQ_FOR_OLD_IC;
+
+	AICWFDBG(LOGINFO, "%s: %s, %d, %d\r\n", __func__, name, type,
+		 NL80211_IFTYPE_P2P_DEVICE);
+	// Look for an available VIF
+	if (type =3D=3D NL80211_IFTYPE_AP_VLAN) {
+		min_idx =3D NX_VIRT_DEV_MAX;
+		max_idx =3D NX_VIRT_DEV_MAX + NX_REMOTE_STA_MAX;
+	} else {
+		min_idx =3D 0;
+		max_idx =3D NX_VIRT_DEV_MAX;
+	}
+
+	for (i =3D min_idx; i < max_idx; i++) {
+		if (rwnx_hw->avail_idx_map & BIT(i)) {
+			vif_idx =3D i;
+			break;
+		}
+	}
+	if (vif_idx < 0)
+		return NULL;
+
+#ifndef CONFIG_RWNX_MON_DATA
+	list_for_each_entry(vif, &rwnx_hw->vifs, list) {
+		// Check if monitor interface already exists or type is monitor
+		if (RWNX_VIF_TYPE(vif) =3D=3D NL80211_IFTYPE_MONITOR ||
+		    type =3D=3D NL80211_IFTYPE_MONITOR) {
+			wiphy_err(rwnx_hw->wiphy,
+				  "Monitor+Data interface support (MON_DATA) disabled\n");
+			return NULL;
+		}
+	}
+#endif
+
+#ifndef CONFIG_ONE_TXQ
+	ndev =3D alloc_netdev_mqs(sizeof(*vif), name, name_assign_type,
+				rwnx_netdev_setup, nx_nb_ndev_txq, 1);
+#else
+	ndev =3D alloc_netdev_mqs(sizeof(*vif), name, name_assign_type,
+				rwnx_netdev_setup, 1, 1);
+#endif
+
+	if (!ndev)
+		return NULL;
+
+	vif =3D netdev_priv(ndev);
+	vif->key_has_add =3D 0;
+	ndev->ieee80211_ptr =3D &vif->wdev;
+	vif->wdev.wiphy =3D rwnx_hw->wiphy;
+	vif->rwnx_hw =3D rwnx_hw;
+	vif->ndev =3D ndev;
+	vif->drv_vif_index =3D vif_idx;
+	SET_NETDEV_DEV(ndev, wiphy_dev(vif->wdev.wiphy));
+	vif->wdev.netdev =3D ndev;
+	vif->wdev.iftype =3D type;
+	vif->up =3D false;
+	vif->ch_index =3D RWNX_CH_NOT_SET;
+	memset(&vif->net_stats, 0, sizeof(vif->net_stats));
+	vif->is_p2p_vif =3D 0;
+
+#ifdef CONFIG_BR_SUPPORT
+	spin_lock_init(&vif->br_ext_lock);
+#endif /* CONFIG_BR_SUPPORT */
+
+	switch (type) {
+	case NL80211_IFTYPE_STATION:
+		vif->sta.ap =3D NULL;
+		vif->sta.tdls_sta =3D NULL;
+		vif->sta.external_auth =3D false;
+		break;
+	case NL80211_IFTYPE_P2P_CLIENT:
+		vif->sta.ap =3D NULL;
+		vif->sta.tdls_sta =3D NULL;
+		vif->sta.external_auth =3D false;
+		vif->is_p2p_vif =3D 1;
+		break;
+	case NL80211_IFTYPE_MESH_POINT:
+		INIT_LIST_HEAD(&vif->ap.mpath_list);
+		INIT_LIST_HEAD(&vif->ap.proxy_list);
+		vif->ap.create_path =3D false;
+		vif->ap.generation =3D 0;
+		vif->ap.mesh_pm =3D NL80211_MESH_POWER_ACTIVE;
+		vif->ap.next_mesh_pm =3D NL80211_MESH_POWER_ACTIVE;
+		// no break
+	case NL80211_IFTYPE_AP:
+		INIT_LIST_HEAD(&vif->ap.sta_list);
+		memset(&vif->ap.bcn, 0, sizeof(vif->ap.bcn));
+		break;
+	case NL80211_IFTYPE_P2P_GO:
+		INIT_LIST_HEAD(&vif->ap.sta_list);
+		memset(&vif->ap.bcn, 0, sizeof(vif->ap.bcn));
+		vif->is_p2p_vif =3D 1;
+		break;
+	case NL80211_IFTYPE_AP_VLAN: {
+		struct rwnx_vif *master_vif;
+		bool found =3D false;
+
+		list_for_each_entry(master_vif, &rwnx_hw->vifs, list) {
+			if (RWNX_VIF_TYPE(master_vif) =3D=3D NL80211_IFTYPE_AP &&
+			    !(!memcmp(master_vif->ndev->dev_addr, params->macaddr,
+				      ETH_ALEN))) {
+				found =3D true;
+				break;
+			}
+		}
+
+		if (!found)
+			goto err;
+
+		vif->ap_vlan.master =3D master_vif;
+		vif->ap_vlan.sta_4a =3D NULL;
+		break;
+	}
+	case NL80211_IFTYPE_MONITOR:
+		ndev->type =3D ARPHRD_IEEE80211_RADIOTAP;
+		ndev->netdev_ops =3D &rwnx_netdev_monitor_ops;
+		break;
+	default:
+		break;
+	}
+
+	if (type =3D=3D NL80211_IFTYPE_AP_VLAN) {
+		memcpy((void *)ndev->dev_addr, (const void *)params->macaddr, ETH_ALEN);
+		memcpy((void *)vif->wdev.address, (const void *)params->macaddr,
+		       ETH_ALEN);
+	} else {
+		unsigned char mac_addr[6];
+
+		memcpy(mac_addr, rwnx_hw->wiphy->perm_addr, ETH_ALEN);
+		mac_addr[5] ^=3D vif_idx;
+		eth_hw_addr_set(ndev, mac_addr);
+		memcpy(vif->wdev.address, mac_addr, ETH_ALEN);
+	}
+
+	AICWFDBG(LOGINFO, "interface add:%x %x %x %x %x %x\n", vif->wdev.address[=
0],
+		 vif->wdev.address[1], vif->wdev.address[2], vif->wdev.address[3],
+		 vif->wdev.address[4], vif->wdev.address[5]);
+
+	if (params) {
+		vif->use_4addr =3D params->use_4addr;
+		ndev->ieee80211_ptr->use_4addr =3D params->use_4addr;
+	} else {
+		vif->use_4addr =3D false;
+	}
+
+#ifdef CONFIG_USE_WIRELESS_EXT
+	aicwf_set_wireless_ext(ndev, rwnx_hw);
+#else
+#ifdef CONFIG_WIRELESS_EXT
+	memset(&aic_handlers_def, 0, sizeof(struct iw_handler_def));
+	ndev->wireless_handlers =3D (struct iw_handler_def *)&aic_handlers_def;
+#endif
+#endif
+	if (cfg80211_register_netdevice(ndev))
+		goto err;
+
+	spin_lock_bh(&rwnx_hw->cb_lock);
+	list_add_tail(&vif->list, &rwnx_hw->vifs);
+	spin_unlock_bh(&rwnx_hw->cb_lock);
+	rwnx_hw->avail_idx_map &=3D ~BIT(vif_idx);
+
+	return vif;
+
+err:
+	free_netdev(ndev);
+	return NULL;
+}
