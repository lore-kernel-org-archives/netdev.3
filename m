+/**
+ * rwnx_amsdu_add_subframe_header - Add AMSDU header and link subframe
+ *
+ * @rwnx_hw Driver main data
+ * @skb Buffer to aggregate
+ * @sw_txhdr Tx descriptor for the first A-MSDU subframe
+ *
+ * return 0 on success, -1 otherwise
+ *
+ * This functions Add A-MSDU header and LLC/SNAP header in the buffer
+ * and update sw_txhdr of the first subframe to link this buffer.
+ * If an error happens, the buffer will be queued as a normal buffer.
+ *
+ *
+ *            Before           After
+ *         +-------------+  +-------------+
+ *         | HEADROOM    |  | HEADROOM    |
+ *         |             |  +-------------+ <- data
+ *         |             |  | amsdu_txhdr |
+ *         |             |  | * pad size  |
+ *         |             |  +-------------+
+ *         |             |  | ETH hdr     | keep original eth hdr
+ *         |             |  |             | to restore it once transmitted
+ *         |             |  +-------------+ <- packet_addr[x]
+ *         |             |  | Pad         |
+ *         |             |  +-------------+
+ * data -> +-------------+  | AMSDU HDR   |
+ *         | ETH hdr     |  +-------------+
+ *         |             |  | LLC/SNAP    |
+ *         +-------------+  +-------------+
+ *         | DATA        |  | DATA        |
+ *         |             |  |             |
+ *         +-------------+  +-------------+
+ *
+ * Called with tx_lock hold
+ */
+static int rwnx_amsdu_add_subframe_header(struct rwnx_hw *rwnx_hw,
+					  struct sk_buff *skb,
+					  struct rwnx_sw_txhdr *sw_txhdr)
+{
+	struct rwnx_amsdu *amsdu =3D &sw_txhdr->amsdu;
+	struct rwnx_amsdu_txhdr *amsdu_txhdr;
+	struct ethhdr *amsdu_hdr, *eth =3D (struct ethhdr *)skb->data;
+	int headroom_need, map_len, msdu_len;
+	dma_addr_t dma_addr;
+	u8 *pos, *map_start;
+
+	msdu_len =3D skb->len - sizeof(*eth);
+	headroom_need =3D sizeof(*amsdu_txhdr) + amsdu->pad + sizeof(*amsdu_hdr);
+	if (ntohs(eth->h_proto) >=3D ETH_P_802_3_MIN) {
+		headroom_need +=3D sizeof(rfc1042_header) + 2;
+		msdu_len +=3D sizeof(rfc1042_header) + 2;
+	}
+
+	/* we should have enough headroom (checked in xmit) */
+	if (WARN_ON(skb_headroom(skb) < headroom_need))
+		return -1;
+
+	/* allocate headroom */
+	pos =3D skb_push(skb, headroom_need);
+	amsdu_txhdr =3D (struct rwnx_amsdu_txhdr *)pos;
+	pos +=3D sizeof(*amsdu_txhdr);
+
+	/* move eth header */
+	memmove(pos, eth, sizeof(*eth));
+	eth =3D (struct ethhdr *)pos;
+	pos +=3D sizeof(*eth);
+
+	/* Add padding from previous subframe */
+	map_start =3D pos;
+	memset(pos, 0, amsdu->pad);
+	pos +=3D amsdu->pad;
+
+	/* Add AMSDU hdr */
+	amsdu_hdr =3D (struct ethhdr *)pos;
+	memcpy(amsdu_hdr->h_dest, eth->h_dest, ETH_ALEN);
+	memcpy(amsdu_hdr->h_source, eth->h_source, ETH_ALEN);
+	amsdu_hdr->h_proto =3D htons(msdu_len);
+	pos +=3D sizeof(*amsdu_hdr);
+
+	if (ntohs(eth->h_proto) >=3D ETH_P_802_3_MIN) {
+		memcpy(pos, rfc1042_header, sizeof(rfc1042_header));
+		pos +=3D sizeof(rfc1042_header);
+	}
+
+	/* MAP (and sync) memory for DMA */
+	map_len =3D msdu_len + amsdu->pad + sizeof(*amsdu_hdr);
+	dma_addr =3D
+		dma_map_single(rwnx_hw->dev, map_start, map_len, DMA_BIDIRECTIONAL);
+	if (WARN_ON(dma_mapping_error(rwnx_hw->dev, dma_addr))) {
+		pos -=3D sizeof(*eth);
+		memmove(pos, eth, sizeof(*eth));
+		skb_pull(skb, headroom_need);
+		return -1;
+	}
+
+	/* update amdsu_txhdr */
+	amsdu_txhdr->map_len =3D map_len;
+	amsdu_txhdr->dma_addr =3D dma_addr;
+	amsdu_txhdr->skb =3D skb;
+	amsdu_txhdr->pad =3D amsdu->pad;
+	amsdu_txhdr->msdu_len =3D msdu_len;
+
+	/* update rwnx_sw_txhdr (of the first subframe) */
+	WARN_ON_ONCE(amsdu->nb !=3D sw_txhdr->desc.host.packet_cnt);
+
+	sw_txhdr->desc.host.packet_addr[amsdu->nb] =3D dma_addr;
+	sw_txhdr->desc.host.packet_len[amsdu->nb] =3D map_len;
+	sw_txhdr->desc.host.packet_cnt++;
+	amsdu->nb++;
+
+	amsdu->pad =3D AMSDU_PADDING(map_len - amsdu->pad);
+	list_add_tail(&amsdu_txhdr->list, &amsdu->hdrs);
+	amsdu->len +=3D map_len;
+
+	trace_amsdu_subframe(sw_txhdr);
+	return 0;
+}
