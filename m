+				#else
+				txq->amsdu_ht_len_cap, txq->amsdu_vht_len_cap
+				#endif /* CONFIG_RWNX_FULLMAC */
+		);
+		idx +=3D res;
+		size -=3D res;
+	}
+#endif
+
+	res =3D scnprintf(&buf[idx], size, "\n");
+	idx +=3D res;
+	size -=3D res;
+
+	return idx;
+}
