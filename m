+/**
+ * rwnx_rx_statistic - save some statistics about received frames
+ *
+ * @rwnx_hw: main driver data.
+ * @hw_rxhdr: Rx Hardware descriptor of the received frame.
+ * @sta: STA that sent the frame.
+ */
+static void rwnx_rx_statistic(struct rwnx_hw *rwnx_hw,
+			      struct hw_rxhdr *hw_rxhdr, struct rwnx_sta *sta)
+{
+	struct rwnx_stats *stats =3D &rwnx_hw->stats;
+	struct rwnx_rx_rate_stats *rate_stats =3D &sta->stats.rx_rate;
+	struct rx_vector_1 *rxvect =3D &hw_rxhdr->hwvect.rx_vect1;
+	int mpdu, ampdu, mpdu_prev, rate_idx;
+
+	/* save complete hwvect */
+	sta->stats.last_rx =3D hw_rxhdr->hwvect;
+
+	/* update ampdu rx stats */
+	mpdu =3D hw_rxhdr->hwvect.mpdu_cnt;
+	ampdu =3D hw_rxhdr->hwvect.ampdu_cnt;
+	mpdu_prev =3D stats->ampdus_rx_map[ampdu];
+
+	if (mpdu_prev < mpdu)
+		stats->ampdus_rx_miss +=3D mpdu - mpdu_prev - 1;
+	else
+		stats->ampdus_rx[mpdu_prev]++;
+	stats->ampdus_rx_map[ampdu] =3D mpdu;
+
+	/* update rx rate statistic */
+	if (!rate_stats->size)
+		return;
+
+	if (rxvect->format_mod > FORMATMOD_NON_HT_DUP_OFDM) {
+		int mcs;
+		int bw =3D rxvect->ch_bw;
+		int sgi;
+		int nss;
+
+		switch (rxvect->format_mod) {
+		case FORMATMOD_HT_MF:
+		case FORMATMOD_HT_GF:
+			mcs =3D rxvect->ht.mcs % 8;
+			nss =3D rxvect->ht.mcs / 8;
+			sgi =3D rxvect->ht.short_gi;
+			rate_idx =3D N_CCK + N_OFDM + nss * 32 + mcs * 4 + bw * 2 + sgi;
+			break;
+		case FORMATMOD_VHT:
+			mcs =3D rxvect->vht.mcs;
+			nss =3D rxvect->vht.nss;
+			sgi =3D rxvect->vht.short_gi;
+			rate_idx =3D
+				N_CCK + N_OFDM + N_HT + nss * 80 + mcs * 8 + bw * 2 + sgi;
+			break;
+		case FORMATMOD_HE_SU:
+			mcs =3D rxvect->he.mcs;
+			nss =3D rxvect->he.nss;
+			sgi =3D rxvect->he.gi_type;
+			rate_idx =3D N_CCK + N_OFDM + N_HT + N_VHT + nss * 144 + mcs * 12 +
+					   bw * 3 + sgi;
+			break;
+		default:
+			mcs =3D rxvect->he.mcs;
+			nss =3D rxvect->he.nss;
+			sgi =3D rxvect->he.gi_type;
+			rate_idx =3D N_CCK + N_OFDM + N_HT + N_VHT + N_HE_SU + nss * 216 +
+					   mcs * 18 + rxvect->he.ru_size * 3 + sgi;
+			break;
+		}
+	} else {
+		int idx =3D legrates_lut[rxvect->leg_rate].idx;
+
+		if (idx < 4)
+			rate_idx =3D idx * 2 + rxvect->pre_type;
+		else
+			rate_idx =3D N_CCK + idx - 4;
+	}
+	if (rate_idx < rate_stats->size) {
+		if (!rate_stats->table[rate_idx])
+			rate_stats->rate_cnt++;
+		rate_stats->table[rate_idx]++;
+		rate_stats->cpt++;
+	} else {
+		wiphy_err(rwnx_hw->wiphy, "RX: Invalid index conversion =3D> %d/%d\n",
+			  rate_idx, rate_stats->size);
+	}
+}
