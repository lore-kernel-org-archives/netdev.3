+		return;
+	}
+
+	memcpy(skb_push(aic_skb_copy, 1), &bt_cb(skb)->pkt_type, 1);
+	aic_enqueue(aic_skb_copy);
+
+	/* Make sure bt char device existing before wakeup read queue */
+	hdev =3D hci_dev_get(0);
+	if (hdev)
+		wake_up_interruptible(&btchr_read_wait);
+}
