+/**
+ * rwnx_rx_add_rtap_hdr - Add radiotap header to sk_buff
+ *
+ * @rwnx_hw: main driver data
+ * @skb: skb received (will include the radiotap header)
+ * @rxvect: Rx vector
+ * @phy_info: Information regarding the phy
+ * @hwvect: HW Info (NULL if vendor specific data is available)
+ * @rtap_len: Length of the radiotap header
+ * @vend_rtap_len: radiotap vendor length (0 if not present)
+ * @vend_it_present: radiotap vendor present
+ *
+ * Builds a radiotap header and add it to @skb.
+ */
+static void rwnx_rx_add_rtap_hdr(struct rwnx_hw *rwnx_hw, struct sk_buff *=
skb,
+				 struct rx_vector_1 *rxvect,
+				 struct phy_channel_info_desc *phy_info,
+				 struct hw_vect *hwvect, int rtap_len,
+				 u8 vend_rtap_len, u32 vend_it_present)
+{
+	struct ieee80211_radiotap_header *rtap;
+	u8 *pos, rate_idx;
+	__le32 *it_present;
+	u32 it_present_val =3D 0;
+	bool fec_coding =3D false;
+	bool short_gi =3D false;
+	bool stbc =3D false;
+	bool aggregation =3D false;
+
+	rtap =3D (struct ieee80211_radiotap_header *)skb_push(skb, rtap_len);
+	memset((u8 *)rtap, 0, rtap_len);
+
+	rtap->it_version =3D 0;
+	rtap->it_pad =3D 0;
+	rtap->it_len =3D cpu_to_le16(rtap_len + vend_rtap_len);
+
+	it_present =3D &rtap->it_present;
+
+	// Check for multiple antennas
+	if (hweight32(rxvect->antenna_set) > 1) {
+		int chain;
+		unsigned long chains =3D rxvect->antenna_set;
+
+		for_each_set_bit(chain, &chains, IEEE80211_MAX_CHAINS) {
+			it_present_val |=3D BIT(IEEE80211_RADIOTAP_EXT) |
+					  BIT(IEEE80211_RADIOTAP_RADIOTAP_NAMESPACE);
+			put_unaligned_le32(it_present_val, it_present);
+			it_present++;
+			it_present_val =3D BIT(IEEE80211_RADIOTAP_ANTENNA) |
+					 BIT(IEEE80211_RADIOTAP_DBM_ANTSIGNAL);
+		}
+	}
+
+	// Check if vendor specific data is present
+	if (vend_rtap_len) {
+		it_present_val |=3D BIT(IEEE80211_RADIOTAP_VENDOR_NAMESPACE) |
+						  BIT(IEEE80211_RADIOTAP_EXT);
+		put_unaligned_le32(it_present_val, it_present);
+		it_present++;
+		it_present_val =3D vend_it_present;
+	}
+
+	put_unaligned_le32(it_present_val, it_present);
+	pos =3D (void *)(it_present + 1);
+
+	// IEEE80211_RADIOTAP_TSFT
+	if (hwvect) {
+		rtap->it_present |=3D cpu_to_le32(1 << IEEE80211_RADIOTAP_TSFT);
+		// padding
+		while ((pos - (u8 *)rtap) & 7)
+			*pos++ =3D 0;
+		put_unaligned_le64((((u64)le32_to_cpu(hwvect->tsf_hi) << 32) +
+						(u64)le32_to_cpu(hwvect->tsf_lo)),
+						pos);
+		pos +=3D 8;
+	}
+
+	// IEEE80211_RADIOTAP_FLAGS
+	rtap->it_present |=3D cpu_to_le32(1 << IEEE80211_RADIOTAP_FLAGS);
+	if (hwvect && !hwvect->frm_successful_rx)
+		*pos |=3D IEEE80211_RADIOTAP_F_BADFCS;
+	if (!rxvect->pre_type && rxvect->format_mod <=3D FORMATMOD_NON_HT_DUP_OFD=
M)
+		*pos |=3D IEEE80211_RADIOTAP_F_SHORTPRE;
+	pos++;
+
+	// IEEE80211_RADIOTAP_RATE
+	// check for HT, VHT or HE frames
+	if (rxvect->format_mod >=3D FORMATMOD_HE_SU) {
+		rate_idx =3D rxvect->he.mcs;
+		fec_coding =3D rxvect->he.fec;
+		stbc =3D rxvect->he.stbc;
+		aggregation =3D true;
+		*pos =3D 0;
+	} else if (rxvect->format_mod =3D=3D FORMATMOD_VHT) {
+		rate_idx =3D rxvect->vht.mcs;
+		fec_coding =3D rxvect->vht.fec;
+		short_gi =3D rxvect->vht.short_gi;
+		stbc =3D rxvect->vht.stbc;
+		aggregation =3D true;
+		*pos =3D 0;
+	} else if (rxvect->format_mod > FORMATMOD_NON_HT_DUP_OFDM) {
+		rate_idx =3D rxvect->ht.mcs;
+		fec_coding =3D rxvect->ht.fec;
+		short_gi =3D rxvect->ht.short_gi;
+		stbc =3D rxvect->ht.stbc;
+		aggregation =3D rxvect->ht.aggregation;
+		*pos =3D 0;
+	} else {
+		struct ieee80211_supported_band *band =3D
+			rwnx_hw->wiphy->bands[phy_info->phy_band];
+		rtap->it_present |=3D cpu_to_le32(1 << IEEE80211_RADIOTAP_RATE);
+		WARN_ON_ONCE((rate_idx =3D legrates_lut[rxvect->leg_rate].idx) =3D=3D -1=
);
+		if (phy_info->phy_band =3D=3D NL80211_BAND_5GHZ)
+			rate_idx -=3D 4; /* rwnx_ratetable_5ghz[0].hw_value =3D=3D 4 */
+		*pos =3D DIV_ROUND_UP(band->bitrates[rate_idx].bitrate, 5);
+	}
+	pos++;
+
+	// IEEE80211_RADIOTAP_CHANNEL
+	rtap->it_present |=3D cpu_to_le32(1 << IEEE80211_RADIOTAP_CHANNEL);
+	put_unaligned_le16(phy_info->phy_prim20_freq, pos);
+	pos +=3D 2;
+
+	if (phy_info->phy_band =3D=3D NL80211_BAND_5GHZ)
+		put_unaligned_le16(IEEE80211_CHAN_OFDM | IEEE80211_CHAN_5GHZ, pos);
+	else if (rxvect->format_mod > FORMATMOD_NON_HT_DUP_OFDM)
+		put_unaligned_le16(IEEE80211_CHAN_DYN | IEEE80211_CHAN_2GHZ, pos);
+	else
+		put_unaligned_le16(IEEE80211_CHAN_CCK | IEEE80211_CHAN_2GHZ, pos);
+	pos +=3D 2;
+
+	if (hweight32(rxvect->antenna_set) =3D=3D 1) {
+		// IEEE80211_RADIOTAP_DBM_ANTSIGNAL
+		rtap->it_present |=3D cpu_to_le32(1 << IEEE80211_RADIOTAP_DBM_ANTSIGNAL)=
;
+		*pos++ =3D rxvect->rssi1;
+
+		// IEEE80211_RADIOTAP_ANTENNA
+		rtap->it_present |=3D cpu_to_le32(1 << IEEE80211_RADIOTAP_ANTENNA);
+		*pos++ =3D rxvect->antenna_set;
+	}
+
+	// IEEE80211_RADIOTAP_RX_FLAGS
+	rtap->it_present |=3D cpu_to_le32(1 << IEEE80211_RADIOTAP_RX_FLAGS);
+	// 2 byte alignment
+	if ((pos - (u8 *)rtap) & 1)
+		*pos++ =3D 0;
+	put_unaligned_le16(0, pos);
+	// Right now, we only support fcs error (no RX_FLAG_FAILED_PLCP_CRC)
+	pos +=3D 2;
+
+	// Check if HT
+	if (rxvect->format_mod =3D=3D FORMATMOD_HT_MF ||
+	    rxvect->format_mod =3D=3D FORMATMOD_HT_GF) {
+		rtap->it_present |=3D cpu_to_le32(1 << IEEE80211_RADIOTAP_MCS);
+		*pos++ =3D IEEE80211_RADIOTAP_MCS_HAVE_MCS |
+				 IEEE80211_RADIOTAP_MCS_HAVE_GI |
+				 IEEE80211_RADIOTAP_MCS_HAVE_BW;
+		*pos =3D 0;
+		if (short_gi)
+			*pos |=3D IEEE80211_RADIOTAP_MCS_SGI;
+		if (rxvect->ch_bw =3D=3D PHY_CHNL_BW_40)
+			*pos |=3D IEEE80211_RADIOTAP_MCS_BW_40;
+		if (rxvect->format_mod =3D=3D FORMATMOD_HT_GF)
+			*pos |=3D IEEE80211_RADIOTAP_MCS_FMT_GF;
+		if (fec_coding)
+			*pos |=3D IEEE80211_RADIOTAP_MCS_FEC_LDPC;
+		*pos++ |=3D stbc << IEEE80211_RADIOTAP_MCS_STBC_SHIFT;
+		*pos++ =3D rate_idx;
+	}
+
+	// check for HT or VHT frames
+	if (aggregation && hwvect) {
+		// 4 byte alignment
+		while ((pos - (u8 *)rtap) & 3)
+			pos++;
+		rtap->it_present |=3D cpu_to_le32(1 << IEEE80211_RADIOTAP_AMPDU_STATUS);
+		put_unaligned_le32(hwvect->ampdu_cnt, pos);
+		pos +=3D 4;
+		put_unaligned_le32(0, pos);
+		pos +=3D 4;
+	}
+
+	// Check for VHT frames
+	if (rxvect->format_mod =3D=3D FORMATMOD_VHT) {
+		u16 vht_details =3D IEEE80211_RADIOTAP_VHT_KNOWN_GI |
+						  IEEE80211_RADIOTAP_VHT_KNOWN_BANDWIDTH;
+		u8 vht_nss =3D rxvect->vht.nss + 1;
+
+		rtap->it_present |=3D cpu_to_le32(1 << IEEE80211_RADIOTAP_VHT);
+
+		if (rxvect->ch_bw =3D=3D PHY_CHNL_BW_160 && phy_info->phy_center2_freq)
+			vht_details &=3D ~IEEE80211_RADIOTAP_VHT_KNOWN_BANDWIDTH;
+		put_unaligned_le16(vht_details, pos);
+		pos +=3D 2;
+
+		// flags
+		if (short_gi)
+			*pos |=3D IEEE80211_RADIOTAP_VHT_FLAG_SGI;
+		if (stbc)
+			*pos |=3D IEEE80211_RADIOTAP_VHT_FLAG_STBC;
+		pos++;
+
+		// bandwidth
+		if (rxvect->ch_bw =3D=3D PHY_CHNL_BW_40)
+			*pos++ =3D 1;
+		if (rxvect->ch_bw =3D=3D PHY_CHNL_BW_80)
+			*pos++ =3D 4;
+		else if ((rxvect->ch_bw =3D=3D PHY_CHNL_BW_160) &&
+			 phy_info->phy_center2_freq)
+			*pos++ =3D 0; // 80P80
+		else if (rxvect->ch_bw =3D=3D PHY_CHNL_BW_160)
+			*pos++ =3D 11;
+		else // 20 MHz
+			*pos++ =3D 0;
+
+		// MCS/NSS
+		*pos =3D (rate_idx << 4) | vht_nss;
+		pos +=3D 4;
+		if (fec_coding)
+			*pos |=3D IEEE80211_RADIOTAP_CODING_LDPC_USER0;
+		pos++;
+		// group ID
+		pos++;
+		// partial_aid
+		pos +=3D 2;
+	}
+
+	// Check for HE frames
+	if (rxvect->format_mod =3D=3D FORMATMOD_HE_SU) {
+		struct ieee80211_radiotap_he he;
+#define HE_PREP(f, val) cpu_to_le16(FIELD_PREP(IEEE80211_RADIOTAP_HE_##f, =
val))
+#define D1_KNOWN(f)     cpu_to_le16(IEEE80211_RADIOTAP_HE_DATA1_##f##_KNOW=
N)
+#define D2_KNOWN(f)     cpu_to_le16(IEEE80211_RADIOTAP_HE_DATA2_##f##_KNOW=
N)
+
+		he.data1 =3D D1_KNOWN(DATA_MCS) | D1_KNOWN(BSS_COLOR) |
+				   D1_KNOWN(BEAM_CHANGE) | D1_KNOWN(UL_DL) | D1_KNOWN(CODING) |
+				   D1_KNOWN(STBC) | D1_KNOWN(BW_RU_ALLOC) | D1_KNOWN(DOPPLER) |
+				   D1_KNOWN(DATA_DCM);
+		he.data2 =3D D2_KNOWN(GI) | D2_KNOWN(TXBF);
+
+		if (stbc) {
+			he.data6 |=3D HE_PREP(DATA6_NSTS, 2);
+			he.data3 |=3D HE_PREP(DATA3_STBC, 1);
+		} else {
+			he.data6 |=3D HE_PREP(DATA6_NSTS, rxvect->he.nss);
+		}
+
+		he.data3 |=3D HE_PREP(DATA3_BSS_COLOR, rxvect->he.bss_color);
+		he.data3 |=3D HE_PREP(DATA3_BEAM_CHANGE, rxvect->he.beam_change);
+		he.data3 |=3D HE_PREP(DATA3_UL_DL, rxvect->he.uplink_flag);
+		he.data3 |=3D HE_PREP(DATA3_BSS_COLOR, rxvect->he.bss_color);
+		he.data3 |=3D HE_PREP(DATA3_DATA_MCS, rxvect->he.mcs);
+		he.data3 |=3D HE_PREP(DATA3_DATA_DCM, rxvect->he.dcm);
+		he.data3 |=3D HE_PREP(DATA3_CODING, rxvect->he.fec);
+
+		he.data5 |=3D HE_PREP(DATA5_GI, rxvect->he.gi_type);
+		he.data5 |=3D HE_PREP(DATA5_TXBF, rxvect->he.beamformed);
+		he.data5 |=3D HE_PREP(DATA5_LTF_SIZE, rxvect->he.he_ltf_type + 1);
+
+		switch (rxvect->ch_bw) {
+		case PHY_CHNL_BW_20:
+			he.data5 |=3D
+				HE_PREP(DATA5_DATA_BW_RU_ALLOC,
+					IEEE80211_RADIOTAP_HE_DATA5_DATA_BW_RU_ALLOC_20MHZ);
+			break;
+		case PHY_CHNL_BW_40:
+			he.data5 |=3D
+				HE_PREP(DATA5_DATA_BW_RU_ALLOC,
+					IEEE80211_RADIOTAP_HE_DATA5_DATA_BW_RU_ALLOC_40MHZ);
+			break;
+		case PHY_CHNL_BW_80:
+			he.data5 |=3D
+				HE_PREP(DATA5_DATA_BW_RU_ALLOC,
+					IEEE80211_RADIOTAP_HE_DATA5_DATA_BW_RU_ALLOC_80MHZ);
+			break;
+		case PHY_CHNL_BW_160:
+			he.data5 |=3D
+				HE_PREP(DATA5_DATA_BW_RU_ALLOC,
+					IEEE80211_RADIOTAP_HE_DATA5_DATA_BW_RU_ALLOC_160MHZ);
+			break;
+		default:
+			WARN_ONCE(1, "Invalid SU BW %d\n", rxvect->ch_bw);
+		}
+
+		he.data6 |=3D HE_PREP(DATA6_DOPPLER, rxvect->he.doppler);
+
+		/* ensure 2 byte alignment */
+		while ((pos - (u8 *)rtap) & 1)
+			pos++;
+		rtap->it_present |=3D cpu_to_le32(1 << IEEE80211_RADIOTAP_HE);
+		if ((pos + sizeof(he)) <=3D (u8 *)rtap + rtap_len) {
+			u8 *src =3D (u8 *)&he;
+			u8 *dst =3D pos;
+
+			for (size_t i =3D 0; i < sizeof(he); i++)
+				dst[i] =3D src[i];
+			pos +=3D sizeof(he);
+		} else {
+			AICWFDBG(LOGERROR, "Not enough space for HE radiotap data\n");
+			return;
+		}
+		//memcpy(pos, &he, sizeof(he));
+		//pos +=3D sizeof(he);
+	}
+
+	// Rx Chains
+	if (hweight32(rxvect->antenna_set) > 1) {
+		int chain;
+		unsigned long chains =3D rxvect->antenna_set;
+		u8 rssis[4] =3D {rxvect->rssi1, rxvect->rssi1, rxvect->rssi1,
+					   rxvect->rssi1};
+
+		for_each_set_bit(chain, &chains, IEEE80211_MAX_CHAINS) {
+			*pos++ =3D rssis[chain];
+			*pos++ =3D chain;
+		}
+	}
+}
