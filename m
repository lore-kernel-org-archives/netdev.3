+				       size_t count, loff_t *ppos)
+{
+	struct rwnx_hw *priv =3D file->private_data;
+	char buf[32];
+	int idx =3D 0;
+	u32 mod =3D 0;
+	size_t len =3D min_t(size_t, count, sizeof(buf) - 1);
+
+	if (copy_from_user(buf, user_buf, len))
+		return -EFAULT;
+	buf[len] =3D '\0';
+
+#define RWNX_MOD_TOKEN(str, val)						\
+	do {									\
+		if (strncmp(&buf[idx], str, sizeof(str) - 1) =3D=3D 0) {		\
+			idx +=3D sizeof(str) - 1;					\
+			mod |=3D val;						\
+			continue;						\
+		}								\
+	} while (0)
+
+	while ((idx + 4) < len) {
+		if (strncmp(&buf[idx], "MOD:", 4) =3D=3D 0) {
+			idx +=3D 4;
+			RWNX_MOD_TOKEN("ALL", 0xffffffff);
+			RWNX_MOD_TOKEN("KE", BIT(0));
+			RWNX_MOD_TOKEN("DBG", BIT(1));
+			RWNX_MOD_TOKEN("IPC", BIT(2));
+			RWNX_MOD_TOKEN("DMA", BIT(3));
+			RWNX_MOD_TOKEN("MM", BIT(4));
+			RWNX_MOD_TOKEN("TX", BIT(5));
+			RWNX_MOD_TOKEN("RX", BIT(6));
+			RWNX_MOD_TOKEN("PHY", BIT(7));
+			idx++;
+		} else if (strncmp(&buf[idx], "DBG:", 4) =3D=3D 0) {
+			u32 dbg =3D 0;
+
+			idx +=3D 4;
+			if (strncmp(&buf[idx], "NONE", sizeof("NONE") - 1) =3D=3D 0) {
+				idx +=3D sizeof("NONE") - 1;
+				dbg =3D 0;
+				goto dbg_done;
+			}
+			if (strncmp(&buf[idx], "CRT", sizeof("CRT") - 1) =3D=3D 0) {
+				idx +=3D sizeof("CRT") - 1;
+				dbg =3D 1;
+				goto dbg_done;
+			}
+			if (strncmp(&buf[idx], "ERR", sizeof("ERR") - 1) =3D=3D 0) {
+				idx +=3D sizeof("ERR") - 1;
+				dbg =3D 2;
+				goto dbg_done;
+			}
+			if (strncmp(&buf[idx], "WRN", sizeof("WRN") - 1) =3D=3D 0) {
+				idx +=3D sizeof("WRN") - 1;
+				dbg =3D 3;
+				goto dbg_done;
+			}
+			if (strncmp(&buf[idx], "INF", sizeof("INF") - 1) =3D=3D 0) {
+				idx +=3D sizeof("INF") - 1;
+				dbg =3D 4;
+				goto dbg_done;
+			}
+			if (strncmp(&buf[idx], "VRB", sizeof("VRB") - 1) =3D=3D 0) {
+				idx +=3D sizeof("VRB") - 1;
+				dbg =3D 5;
+				goto dbg_done;
+			}
+			idx++;
+			continue;
+dbg_done:
+	rwnx_send_dbg_set_sev_filter_req(priv, dbg);
+		} else {
+			idx++;
+		}
+	}
+
+	if (mod)
+		rwnx_send_dbg_set_mod_filter_req(priv, mod);
+
+	return count;
+}
+
+DEBUGFS_READ_FUNC(fw_dbg);
+DEBUGFS_WRITE_FUNC(fw_dbg);
