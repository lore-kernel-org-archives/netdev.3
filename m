+struct rwnx_term_stream;
+
+#else /* !CONFIG_RWNX_FHOST */
+#include "ipc_shared.h"
+#define rwnx_cmd_e2amsg         ipc_e2a_msg
+#define rwnx_cmd_a2emsg         lmac_msg
+#define RWNX_CMD_A2EMSG_LEN(m)  (sizeof(struct lmac_msg) + (m)->param_len)
