+static ssize_t rwnx_dbgfs_rc_stats_read(struct file *file,
+					char __user *user_buf, size_t count,
+					loff_t *ppos)
+{
+	struct rwnx_sta *sta =3D NULL;
+	struct rwnx_hw *priv =3D file->private_data;
+	char *buf;
+	int bufsz, len =3D 0;
+	ssize_t read;
+	int i =3D 0;
+	int error =3D 0;
+	struct me_rc_stats_cfm me_rc_stats_cfm;
+	unsigned int no_samples;
+	struct st *st;
+	u8 mac[6];
+	int ret =3D 0;
+
+	RWNX_DBG(RWNX_FN_ENTRY_STR);
+
+	/* everything should fit in one call */
+	if (*ppos)
+		return 0;
+
+	/* Get the station index from MAC address */
+	ret =3D sscanf(file->f_path.dentry->d_parent->d_iname,
+		     "%hhx:%hhx:%hhx:%hhx:%hhx:%hhx", &mac[0],
+		     &mac[1], &mac[2], &mac[3], &mac[4], &mac[5]);
+	if (ret !=3D 6)
+		pr_err("Invalid MAC format in d_iname: %s\n",
+		       file->f_path.dentry->d_parent->d_iname);
+
+	sta =3D rwnx_get_sta(priv, mac);
+	if (!sta)
+		return 0;
+
+	/* Forward the information to the LMAC */
+	error =3D rwnx_send_me_rc_stats(priv, sta->sta_idx, &me_rc_stats_cfm);
+	if (error)
+		return error;
+
+	no_samples =3D me_rc_stats_cfm.no_samples;
+	if (no_samples =3D=3D 0)
+		return 0;
+
+	bufsz =3D no_samples * LINE_MAX_SZ + 500;
+
+	buf =3D kmalloc(bufsz + 1, GFP_ATOMIC);
+	if (!buf)
+		return 0;
+
+	st =3D kmalloc_array(no_samples, sizeof(*st), GFP_ATOMIC);
+	if (!st) {
+		kfree(buf);
+		return 0;
+	}
+
+	for (i =3D 0; i < no_samples; i++) {
+		unsigned int tp, eprob;
+
+		len =3D print_rate_from_cfg(st[i].line, LINE_MAX_SZ,
+					  me_rc_stats_cfm.rate_stats[i].rate_config,
+					  &st[i].r_idx, 0);
+
+		if (me_rc_stats_cfm.sw_retry_step !=3D 0) {
+			len +=3D
+			scnprintf(&st[i].line[len], LINE_MAX_SZ - len, "%c",
+				  me_rc_stats_cfm.retry_step_idx[me_rc_stats_cfm.sw_retry_step] =3D=3D
+					i ? '*' : ' ');
+		} else {
+			len +=3D scnprintf(&st[i].line[len], LINE_MAX_SZ - len, " ");
+		}
+		len +=3D scnprintf(&st[i].line[len], LINE_MAX_SZ - len, "%c",
+				 me_rc_stats_cfm.retry_step_idx[0] =3D=3D i ? 'T' : ' ');
+		len +=3D scnprintf(&st[i].line[len], LINE_MAX_SZ - len, "%c",
+				 me_rc_stats_cfm.retry_step_idx[1] =3D=3D i ? 't' : ' ');
+		len +=3D scnprintf(&st[i].line[len], LINE_MAX_SZ - len, "%c ",
+				 me_rc_stats_cfm.retry_step_idx[2] =3D=3D i ? 'P' : ' ');
+
+		tp =3D me_rc_stats_cfm.tp[i] / 10;
+		len +=3D scnprintf(&st[i].line[len], LINE_MAX_SZ - len, " %4u.%1u",
+				 tp / 10, tp % 10);
+
+		eprob =3D ((me_rc_stats_cfm.rate_stats[i].probability * 1000) >> 16) + 1=
;
+		len +=3D scnprintf(&st[i].line[len], LINE_MAX_SZ - len,
+				 "  %4u.%1u %5u(%6u)  %6u", eprob / 10, eprob % 10,
+				 me_rc_stats_cfm.rate_stats[i].success,
+				 me_rc_stats_cfm.rate_stats[i].attempts,
+				 me_rc_stats_cfm.rate_stats[i].sample_skipped);
+	}
+	len =3D scnprintf(buf, bufsz,
+			"\nTX rate info for %02X:%02X:%02X:%02X:%02X:%02X:\n",
+			mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
+
+	len +=3D scnprintf(&buf[len], bufsz - len,
+			 " #  type           rate             tpt   eprob    ok(   tot)   skipp=
ed\n");
+
+	// add sorted statistics to the buffer
+	sort(st, no_samples, sizeof(st[0]), compare_idx, NULL);
+	for (i =3D 0; i < no_samples; i++)
+		len +=3D scnprintf(&buf[len], bufsz - len, "%s\n", st[i].line);
+
+	// display HE TB statistics if any
+	if (me_rc_stats_cfm.rate_stats[RC_HE_STATS_IDX].rate_config !=3D 0) {
+		unsigned int tp, eprob;
+		struct rc_rate_stats *rate_stats =3D
+			&me_rc_stats_cfm.rate_stats[RC_HE_STATS_IDX];
+		int ru_index =3D rate_stats->ru_and_length & 0x07;
+		int ul_length =3D rate_stats->ru_and_length >> 3;
+
+		len +=3D scnprintf(&buf[len], bufsz - len, "\nHE TB rate info:\n");
+
+		len +=3D scnprintf(&buf[len], bufsz - len,
+						 "    type           rate             tpt   eprob    ok(   tot)   ul=
_length\n    ");
+		len +=3D print_rate_from_cfg(&buf[len], bufsz - len,
+					   rate_stats->rate_config, NULL, ru_index);
+
+		tp =3D me_rc_stats_cfm.tp[RC_HE_STATS_IDX] / 10;
+		len +=3D scnprintf(&buf[len], bufsz - len, "      %4u.%1u", tp / 10,
+				 tp % 10);
+
+		eprob =3D ((rate_stats->probability * 1000) >> 16) + 1;
+		len +=3D scnprintf(&buf[len], bufsz - len, "  %4u.%1u %5u(%6u)  %6u\n",
+				 eprob / 10, eprob % 10, rate_stats->success,
+				 rate_stats->attempts, ul_length);
+	}
+
+	len +=3D scnprintf(&buf[len], bufsz - len, "\n MPDUs AMPDUs AvLen trialP"=
);
+	len +=3D scnprintf(&buf[len], bufsz - len, "\n%6u %6u %3d.%1d %6u\n",
+			 me_rc_stats_cfm.ampdu_len, me_rc_stats_cfm.ampdu_packets,
+			 me_rc_stats_cfm.avg_ampdu_len >> 16,
+			 ((me_rc_stats_cfm.avg_ampdu_len * 10) >> 16) % 10,
+			 me_rc_stats_cfm.sample_wait);
+
+	read =3D simple_read_from_buffer(user_buf, count, ppos, buf, len);
+
+	kfree(buf);
+	kfree(st);
+
+	return read;
+}
