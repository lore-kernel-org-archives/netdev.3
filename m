+	pr_info("Custom msg cfm: cmd=3D%d, len=3D%d, status=3D%x\n", cust_msg_cfm=
->cmd,
+		bytes_read, cust_msg_cfm->status);
+	if (bytes_read) {
+		memcpy(command, cust_msg_cfm->buf, bytes_read);
+		command[bytes_read] =3D '\0';
