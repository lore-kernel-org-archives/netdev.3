+/**
+ * rwnx_mu_group_sta_init - Initialize group information for a STA
+ *
+ * @sta: Sta to initialize
+ */
+void rwnx_mu_group_sta_init(struct rwnx_sta *sta,
+			    const struct ieee80211_vht_cap *vht_cap)
+{
+	sta->group_info.map =3D 0;
+	sta->group_info.cnt =3D 0;
+	sta->group_info.active.next =3D LIST_POISON1;
+	sta->group_info.update.next =3D LIST_POISON1;
+	sta->group_info.last_update =3D 0;
+	sta->group_info.traffic =3D 0;
+	sta->group_info.group =3D 0;
+
+	if (!vht_cap ||
+	    !(vht_cap->vht_cap_info & IEEE80211_VHT_CAP_MU_BEAMFORMEE_CAPABLE)) {
+		sta->group_info.map =3D RWNX_SU_GROUP;
+	}
+}
