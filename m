+static void rwnx_tdls_add_aid_ie(struct rwnx_vif *rwnx_vif, struct sk_buff=
 *skb)
+{
+	u8 *pos =3D (void *)skb_put(skb, 4);
+
+	*pos++ =3D WLAN_EID_AID;
+	*pos++ =3D 2; /* len */
+	*pos++ =3D rwnx_vif->sta.ap->aid;
+}
