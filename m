+	u8 ipc_host_dbg_idx;
+	// Store the number of Debug messages buffers
+	u32 ipc_dbg_bufnb;
+	// Store the size of the Debug messages buffers
+	u32 ipc_dbg_bufsz;
+
+	/// Pointer to the attached object (used in callbacks and register access=
es)
