+		return 0;
+
+	// Get number of RX paths
+	nrx =3D (priv->version_cfm.version_phy_1 & MDM_NRX_MASK) >> MDM_NRX_LSB;
+
+	len +=3D scnprintf(buf, bufsz,
+			 "\nRX rate info for %02X:%02X:%02X:%02X:%02X:%02X:\n",
+			 mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
+
+	// Display Statistics
+	for (i =3D 0; i < rate_stats->size; i++) {
+		if (rate_stats->table[i]) {
+			union rwnx_rate_ctrl_info rate_config;
+			int percent =3D (rate_stats->table[i] * 1000) / rate_stats->cpt;
+			int p =3D 0;
+			int ru_size =3D 0;
+
+			idx_to_rate_cfg(i, &rate_config, &ru_size);
+			len +=3D print_rate_from_cfg(&buf[len], bufsz - len,
+						   rate_config.value, NULL, ru_size);
+			p =3D (percent * hist_len) / 1000;
+			len +=3D scnprintf(&buf[len], bufsz - len, ": %6d(%3d.%1d%%)%.*s\n",
+					 rate_stats->table[i], percent / 10, percent % 10,
+					 p, hist);
+		}
+	}
+
+	// Display detailed info of the last received rate
+	last_rx =3D &sta->stats.last_rx.rx_vect1;
+
+	len +=3D scnprintf(&buf[len], bufsz - len,
+			 "\nLast received rate\n  type         rate    LDPC STBC BEAMFM DCM DOP=
PLER %s\n",
+			 (nrx > 1) ? "rssi1(dBm) rssi2(dBm)" : "rssi(dBm)");
+
+	fmt =3D last_rx->format_mod;
+	bw =3D last_rx->ch_bw;
+	pre =3D last_rx->pre_type;
+	if (fmt >=3D FORMATMOD_HE_SU) {
+		mcs =3D last_rx->he.mcs;
+		nss =3D last_rx->he.nss;
+		gi =3D last_rx->he.gi_type;
+		if (fmt =3D=3D FORMATMOD_HE_MU)
+			bw =3D last_rx->he.ru_size;
+	} else if (fmt =3D=3D FORMATMOD_VHT) {
+		mcs =3D last_rx->vht.mcs;
+		nss =3D last_rx->vht.nss;
+		gi =3D last_rx->vht.short_gi;
+	} else if (fmt >=3D FORMATMOD_HT_MF) {
+		mcs =3D last_rx->ht.mcs % 8;
+		nss =3D last_rx->ht.mcs / 8;
+		gi =3D last_rx->ht.short_gi;
+	} else {
+		mcs =3D legrates_lut[last_rx->leg_rate].idx;
+		WARN_ON_ONCE(mcs =3D=3D -1);
+		nss =3D 0;
+		gi =3D 0;
+	}
+
+	len +=3D print_rate(&buf[len], bufsz - len, fmt, nss, mcs, bw, gi, pre, N=
ULL);
+
+	/* flags for HT/VHT/HE */
+	if (fmt >=3D FORMATMOD_HE_SU) {
+		len +=3D scnprintf(&buf[len], bufsz - len, "  %c    %c     %c    %c     =
%c",
+				 last_rx->he.fec ? 'L' : ' ', last_rx->he.stbc ? 'S' : ' ',
+				 last_rx->he.beamformed ? 'B' : ' ', last_rx->he.dcm ? 'D' : ' ',
+				 last_rx->he.doppler ? 'D' : ' ');
+	} else if (fmt =3D=3D FORMATMOD_VHT) {
+		len +=3D scnprintf(&buf[len], bufsz - len, "  %c    %c     %c           =
",
+				 last_rx->vht.fec ? 'L' : ' ',
+				 last_rx->vht.stbc ? 'S' : ' ',
+				 last_rx->vht.beamformed ? 'B' : ' ');
+	} else if (fmt >=3D FORMATMOD_HT_MF) {
+		len +=3D scnprintf(&buf[len], bufsz - len, "  %c    %c                  =
",
+				 last_rx->ht.fec ? 'L' : ' ',
+				 last_rx->ht.stbc ? 'S' : ' ');
+	} else {
+		len +=3D scnprintf(&buf[len], bufsz - len, "                         ");
+	}
+	if (nrx > 1) {
+		len +=3D scnprintf(&buf[len], bufsz - len, "       %-4d       %d\n",
+						 last_rx->rssi1, last_rx->rssi1);
+	} else {
+		len +=3D scnprintf(&buf[len], bufsz - len, "      %d\n", last_rx->rssi1)=
;
+	}
+
+	read =3D simple_read_from_buffer(user_buf, count, ppos, buf, len);
+
+	kfree(buf);
+	return read;
+}
