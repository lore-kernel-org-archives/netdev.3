+int devipc_cust_msg(struct net_device *net, struct ifreq *ifr, int cmd)
+{
+#ifdef PRIVATE_COMMAND_MAX_LEN
+#undef PRIVATE_COMMAND_MAX_LEN
+#undef PRIVATE_COMMAND_DEF_LEN
+#define PRIVATE_COMMAND_MAX_LEN 8192
+#define PRIVATE_COMMAND_DEF_LEN 4096
+#endif
+	int ret =3D 0;
+	char *command =3D NULL;
+	int bytes_written =3D 0;
+	struct android_wifi_priv_cmd priv_cmd;
+	int buf_size =3D 0;
+
+	RWNX_DBG(RWNX_FN_ENTRY_STR);
+
+	if (!ifr->ifr_data) {
+		ret =3D -EINVAL;
+		goto exit;
+	}
+
+#ifdef CONFIG_COMPAT
+	if (in_compat_syscall()) {
+		struct compat_android_wifi_priv_cmd compat_priv_cmd;
+
+		if (copy_from_user(&compat_priv_cmd, ifr->ifr_data,
+				   sizeof(struct compat_android_wifi_priv_cmd))) {
+			ret =3D -EFAULT;
+			goto exit;
+		}
+		priv_cmd.buf =3D compat_ptr(compat_priv_cmd.buf);
+		priv_cmd.used_len =3D compat_priv_cmd.used_len;
+		priv_cmd.total_len =3D compat_priv_cmd.total_len;
+	} else {
+#endif /* CONFIG_COMPAT */
+		if (copy_from_user(&priv_cmd, ifr->ifr_data,
+				   sizeof(struct android_wifi_priv_cmd))) {
+			ret =3D -EFAULT;
+			goto exit;
+		}
+	}
+	if (priv_cmd.total_len > PRIVATE_COMMAND_MAX_LEN ||
+	    priv_cmd.total_len < 0) {
+		pr_err("%s: buf length invalid:%d\n", __func__, priv_cmd.total_len);
+		ret =3D -EINVAL;
+		goto exit;
+	}
+
+	buf_size =3D max(priv_cmd.total_len, PRIVATE_COMMAND_DEF_LEN);
+	command =3D
+		kmalloc((buf_size + 1), GFP_KERNEL);
+	if (!command) {
+		pr_err("%s: failed to allocate memory\n", __func__);
+		ret =3D -ENOMEM;
+		goto exit;
+	}
+	if (copy_from_user(command, priv_cmd.buf, priv_cmd.used_len)) {
+		ret =3D -EFAULT;
+		goto exit;
+	}
+	command[priv_cmd.used_len] =3D '\0';
+
+	/* outputs */
+	pr_info("%s: Devipc custom msg \"%s\" on %s\n", __func__, command,
+		ifr->ifr_name);
+	pr_info("cmd =3D %x\n", cmd);
+	pr_info("buf_size=3D%d\n", buf_size);
+
+	bytes_written =3D handle_custom_msg(command, priv_cmd.used_len);
+	if (bytes_written >=3D 0) {
+		if (bytes_written =3D=3D 0 && priv_cmd.total_len > 0)
+			command[0] =3D '\0';
+		if (bytes_written >=3D priv_cmd.total_len) {
+			pr_err("%s: err. bytes_written:%d >=3D buf_size:%d\n", __func__,
+			       bytes_written, buf_size);
+			goto exit;
+		}
+		bytes_written++;
+		priv_cmd.used_len =3D bytes_written;
+		if (copy_to_user(priv_cmd.buf, command, bytes_written)) {
+			pr_err("%s: failed to copy data to user buffer\n", __func__);
+			ret =3D -EFAULT;
+		}
+	} else {
+		/* Propagate the error */
+		ret =3D bytes_written;
+	}
+
+exit:
+	kfree(command);
+	return ret;
+}
+#endif
