+	AICWFDBG(LOGDEBUG, "formatModTx=3D%u mcsIndexTx=3D%u bwTx=3D%u giAndPreTy=
peTx=3D%u\n",
+		 r_cfg->format_mod_tx, r_cfg->mcs_index_tx, r_cfg->bw_tx,
