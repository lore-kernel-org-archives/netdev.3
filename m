+static void rwnx_set_ht_capa(struct rwnx_hw *rwnx_hw, struct wiphy *wiphy)
+{
+	struct ieee80211_supported_band *band_5ghz =3D
+		wiphy->bands[NL80211_BAND_5GHZ];
+	struct ieee80211_supported_band *band_2ghz =3D
+		wiphy->bands[NL80211_BAND_2GHZ];
+	int i;
+	int nss =3D rwnx_hw->mod_params->nss;
+
+	if (!rwnx_hw->mod_params->ht_on) {
+		band_2ghz->ht_cap.ht_supported =3D false;
+		if (rwnx_hw->band_5g_support)
+			band_5ghz->ht_cap.ht_supported =3D false;
+		return;
+	}
+
+	if (rwnx_hw->mod_params->stbc_on)
+		band_2ghz->ht_cap.cap |=3D 1 << IEEE80211_HT_CAP_RX_STBC_SHIFT;
+	if (rwnx_hw->mod_params->ldpc_on)
+		band_2ghz->ht_cap.cap |=3D IEEE80211_HT_CAP_LDPC_CODING;
+	if (rwnx_hw->mod_params->use_2040) {
+		band_2ghz->ht_cap.mcs.rx_mask[4] =3D 0x1; /* MCS32 */
+		band_2ghz->ht_cap.cap |=3D IEEE80211_HT_CAP_SUP_WIDTH_20_40;
+		band_2ghz->ht_cap.mcs.rx_highest =3D cpu_to_le16(135 * nss);
+	} else {
+		band_2ghz->ht_cap.mcs.rx_highest =3D cpu_to_le16(65 * nss);
+	}
+	if (nss > 1)
+		band_2ghz->ht_cap.cap |=3D IEEE80211_HT_CAP_TX_STBC;
+
+	// Update the AMSDU max RX size
+	if (rwnx_hw->mod_params->amsdu_rx_max)
+		band_2ghz->ht_cap.cap |=3D IEEE80211_HT_CAP_MAX_AMSDU;
+
+	if (rwnx_hw->mod_params->sgi) {
+		band_2ghz->ht_cap.cap |=3D IEEE80211_HT_CAP_SGI_20;
+		if (rwnx_hw->mod_params->use_2040) {
+			band_2ghz->ht_cap.cap |=3D IEEE80211_HT_CAP_SGI_40;
+			band_2ghz->ht_cap.mcs.rx_highest =3D cpu_to_le16(150 * nss);
+		} else {
+			band_2ghz->ht_cap.mcs.rx_highest =3D cpu_to_le16(72 * nss);
+		}
+	}
+	if (rwnx_hw->mod_params->gf_rx_on)
+		band_2ghz->ht_cap.cap |=3D IEEE80211_HT_CAP_GRN_FLD;
+
+	for (i =3D 0; i < nss; i++)
+		band_2ghz->ht_cap.mcs.rx_mask[i] =3D 0xFF;
+
+	if (rwnx_hw->band_5g_support)
+		band_5ghz->ht_cap =3D band_2ghz->ht_cap;
+}
