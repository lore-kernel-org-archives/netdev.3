+int aicwf_dpd_result_write_8800dc(void *buf, int buf_len)
+{
+	int sum =3D 0, len =3D 0;
+	char *path =3D NULL;
+	struct file *fp =3D NULL;
+	loff_t pos =3D 0;
+	mm_segment_t fs;
+
+	path =3D __getname();
+	if (!path) {
+		AICWFDBG(LOGINFO, "get path fail\n");
+		return -1;
+	}
+
+	len =3D snprintf(path, FW_PATH_MAX_LEN, "%s/%s", AICBSP_FW_PATH,
+		       FW_DPDRESULT_NAME_8800DC);
+	pr_info("%s\n", path);
+
+	fp =3D filp_open(path, O_RDWR | O_CREAT, 0644);
+	if (IS_ERR(fp)) {
+		AICWFDBG(LOGINFO, "fp open fial\n");
+		__putname(path);
+		fp =3D NULL;
+		return -1;
