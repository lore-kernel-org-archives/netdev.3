+
+static void aicwf_usb_rx_complete(struct urb *urb)
+{
+	struct aicwf_usb_buf *usb_buf =3D (struct aicwf_usb_buf *)urb->context;
+	struct aic_usb_dev *usb_dev =3D usb_buf->usbdev;
+	struct aicwf_rx_priv *rx_priv =3D usb_dev->rx_priv;
+	struct sk_buff *skb =3D NULL;
+	unsigned long flags =3D 0;
+
+	skb =3D usb_buf->skb;
+	usb_buf->skb =3D NULL;
+
+	if (urb->actual_length > urb->transfer_buffer_length) {
+		aicwf_dev_skb_free(skb);
+		aicwf_usb_rx_buf_put(usb_dev, usb_buf);
+		schedule_work(&usb_dev->rx_urb_work);
+		return;
+	}
+
+	if (urb->status !=3D 0 || !urb->actual_length) {
+		aicwf_dev_skb_free(skb);
+		aicwf_usb_rx_buf_put(usb_dev, usb_buf);
+		schedule_work(&usb_dev->rx_urb_work);
+		return;
+	}
+
+	if (usb_dev->state =3D=3D USB_UP_ST) {
+		skb_put(skb, urb->actual_length);
+
+		spin_lock_irqsave(&rx_priv->rxqlock, flags);
