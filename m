+static struct airoha_gdm_dev *
+airoha_eth_get_gdm_dev(struct airoha_eth *eth, unsigned int id)
+{
+    struct airoha_gdm_port *port;
+
+    if (!id || id > eth->soc->max_gdm_ports)
+        return NULL;
+
+    port = eth->ports[id - 1];
+    return port ? port->devs[0] : NULL;
+}
