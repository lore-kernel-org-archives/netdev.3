+static bool aicwf_another_ptk_1(struct rx_buff *buffer)
+{
+	u8 *read =3D buffer->read;
+	u16 aggr_len =3D 0;
+
+	WARN_ON_ONCE((read - buffer->start) % 4 !=3D 0);
+
+	if (!read || read >=3D buffer->end)
+		return false;
+
+	aggr_len =3D (*read | (*(read + 1) << 8));
+	if (aggr_len =3D=3D 0)
+		return false;
+
+	return true;
+}
