+		}
+		while (aicwf_another_ptk(skb)) {
+			data =3D skb->data;
+			pkt_len =3D (*skb->data | (*(skb->data + 1) << 8));
+
+			if ((skb->data[2] & SDIO_TYPE_CFG) !=3D SDIO_TYPE_CFG) {
+				// type: data
+				aggr_len =3D pkt_len + RX_HWHRD_LEN;
+
+				if (aggr_len & (RX_ALIGNMENT - 1))
+					adjust_len =3D roundup(aggr_len, RX_ALIGNMENT);
+				else
+					adjust_len =3D aggr_len;
+
+				skb_inblock =3D
+					__dev_alloc_skb(aggr_len + CCMP_OR_WEP_INFO, GFP_KERNEL);
+				if (!skb_inblock) {
+					txrx_err("no more space! skip\n");
+					skb_pull(skb, adjust_len);
+					continue;
+				}
+
+				skb_put(skb_inblock, aggr_len);
+				memcpy(skb_inblock->data, data, aggr_len);
+				rwnx_rxdataind_aicwf(rx_priv->sdiodev->rwnx_hw, skb_inblock,
+						     (void *)rx_priv);
+				skb_pull(skb, adjust_len);
+			} else {
+				// type: config
+				aggr_len =3D pkt_len;
+
+				if (aggr_len & (RX_ALIGNMENT - 1))
+					adjust_len =3D roundup(aggr_len, RX_ALIGNMENT);
+				else
+					adjust_len =3D aggr_len;
+
+				msg =3D
+					kmalloc(aggr_len + 4, GFP_KERNEL);
+				if (!msg) {
+					txrx_err("no more space for msg!\n");
+					aicwf_dev_skb_free(skb);
+					return -EBADE;
+				}
+
+				memcpy(msg, data, aggr_len + 4);
+				if (((*(msg + 2) & 0x7f) =3D=3D SDIO_TYPE_CFG_CMD_RSP) &&
+				    rx_priv->sdiodev->bus_if->state !=3D BUS_DOWN_ST)
+					rwnx_rx_handle_msg(rx_priv->sdiodev->rwnx_hw,
+							   (struct ipc_e2a_msg *)(msg + 4));
+
+				struct sdio_host_env_tag *env =3D
+					&rx_priv->sdiodev->rwnx_hw->sdio_env;
+				if ((*(msg + 2) & 0x7f) =3D=3D SDIO_TYPE_CFG_DATA_CFM)
+					aicwf_sdio_host_tx_cfm_handler(env, (u32 *)(msg + 4));
+
+				if ((*(msg + 2) & 0x7f) =3D=3D SDIO_TYPE_CFG_PRINT)
+					rwnx_rx_handle_print(rx_priv->sdiodev->rwnx_hw,
+							     msg + 4, aggr_len);
+
+				skb_pull(skb, adjust_len + 4);
+				kfree(msg);
+			}
+		}
+
+		dev_kfree_skb(skb);
+		atomic_dec(&rx_priv->rx_cnt);
+	}
+#endif
+
+#if defined(CONFIG_SDIO_PWRCTRL)
+	aicwf_sdio_pwr_stctl(rx_priv->sdiodev, SDIO_ACTIVE_ST);
+#endif
+
+	return ret;
+#else  // AICWF_USB_SUPPORT
+	int ret =3D 0;
+	unsigned long flags =3D 0;
+	struct sk_buff *skb =3D NULL; /* Packet for event or data frames */
+	u16 pkt_len =3D 0;
+	struct sk_buff *skb_inblock =3D NULL;
+	u16 aggr_len =3D 0, adjust_len =3D 0;
+	u8 *data =3D NULL;
+	u8_l *msg =3D NULL;
+
+	while (1) {
+		spin_lock_irqsave(&rx_priv->rxqlock, flags);
+		if (aicwf_is_framequeue_empty(&rx_priv->rxq)) {
+			usb_info("no more rxdata\n");
+			spin_unlock_irqrestore(&rx_priv->rxqlock, flags);
+			break;
+		}
+		skb =3D aicwf_frame_dequeue(&rx_priv->rxq);
+		spin_unlock_irqrestore(&rx_priv->rxqlock, flags);
+		if (!skb) {
+			txrx_err("skb_error\r\n");
+			break;
+		}
+		data =3D skb->data;
+		pkt_len =3D (*skb->data | (*(skb->data + 1) << 8));
+		if (pkt_len > 1600) {
+			dev_kfree_skb(skb);
+			atomic_dec(&rx_priv->rx_cnt);
+			continue;
+		}
+
+		if ((skb->data[2] & USB_TYPE_CFG) !=3D USB_TYPE_CFG) {
+			// type: data
+			aggr_len =3D pkt_len + RX_HWHRD_LEN;
+			if (aggr_len & (RX_ALIGNMENT - 1))
+				adjust_len =3D roundup(aggr_len, RX_ALIGNMENT);
+			else
+				adjust_len =3D aggr_len;
+
+			// 8 is for ccmp mic or wep icv
+			skb_inblock =3D
+				__dev_alloc_skb(aggr_len + CCMP_OR_WEP_INFO,
+						GFP_KERNEL);
+			if (!skb_inblock) {
+				txrx_err("no more space! skip!\n");
+				skb_pull(skb, adjust_len);
+				continue;
+			}
+
+			skb_put(skb_inblock, aggr_len);
+			memcpy(skb_inblock->data, data, aggr_len);
+			rwnx_rxdataind_aicwf(rx_priv->usbdev->rwnx_hw, skb_inblock,
+					     (void *)rx_priv);
+			/// TODO: here need to add rx data process
+
+			skb_pull(skb, adjust_len);
+		} else { //  type : config
+			aggr_len =3D pkt_len;
+			if (aggr_len & (RX_ALIGNMENT - 1))
+				adjust_len =3D roundup(aggr_len, RX_ALIGNMENT);
+			else
+				adjust_len =3D aggr_len;
+
+			msg =3D
+				kmalloc(aggr_len + 4, GFP_KERNEL);
+			if (!msg) {
+				txrx_err("no more space for msg!\n");
+				aicwf_dev_skb_free(skb);
+				return -EBADE;
+			}
+			memcpy(msg, data, aggr_len + 4);
+			if ((*(msg + 2) & 0x7f) =3D=3D USB_TYPE_CFG_CMD_RSP)
+				rwnx_rx_handle_msg(rx_priv->usbdev->rwnx_hw,
+						   (struct ipc_e2a_msg *)(msg + 4));
+
+			struct usb_host_env_tag *env =3D &rx_priv->usbdev->rwnx_hw->usb_env;
+
+			if ((*(msg + 2) & 0x7f) =3D=3D USB_TYPE_CFG_DATA_CFM)
+				aicwf_usb_host_tx_cfm_handler(env, (u32 *)(msg + 4));
+			skb_pull(skb, adjust_len + 4);
+			kfree(msg);
+		}
+
+		dev_kfree_skb(skb);
+		atomic_dec(&rx_priv->rx_cnt);
+	}
+
+	return ret;
+#endif // AICWF_SDIO_SUPPORT
+}
