+	} else {
+		usb_buf =3D list_first_entry(q, struct aicwf_usb_buf, list);
+		list_del_init(&usb_buf->list);
+		if (counter)
+			(*counter)--;
+	}
+	spin_unlock_irqrestore(qlock, flags);
+	return usb_buf;
+}
