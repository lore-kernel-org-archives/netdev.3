+		}
+	} else if ((ieee80211_is_deauth(mgmt->frame_control) ||
+				ieee80211_is_disassoc(mgmt->frame_control)) &&
+			   (mgmt->u.deauth.reason_code =3D=3D
+					WLAN_REASON_CLASS2_FRAME_FROM_NONAUTH_STA ||
+				mgmt->u.deauth.reason_code =3D=3D
+					WLAN_REASON_CLASS3_FRAME_FROM_NONASSOC_STA)) {
+		cfg80211_rx_unprot_mlme_mgmt(rwnx_vif->ndev, skb->data, skb->len);
+	} else if ((RWNX_VIF_TYPE(rwnx_vif) =3D=3D NL80211_IFTYPE_STATION) &&
+			   (ieee80211_is_action(mgmt->frame_control) &&
+				(mgmt->u.action.category =3D=3D 6))) {
+		struct cfg80211_ft_event_params ft_event;
+
+		ft_event.target_ap =3D (uint8_t *)&mgmt->u.action + ETH_ALEN + 2;
+		ft_event.ies =3D (uint8_t *)&mgmt->u.action + ETH_ALEN * 2 + 2;
+		ft_event.ies_len =3D skb->len - (ft_event.ies - (uint8_t *)mgmt);
+		ft_event.ric_ies =3D NULL;
+		ft_event.ric_ies_len =3D 0;
