+ * Maps hw_txhdr and buffer data for transmission via DMA.
+ * - Data buffer with be downloaded by embebded side.
+ * - hw_txhdr will be uploaded by embedded side when buffer has been
+ *   transmitted over the air.
+ */
+static int rwnx_prep_tx(struct rwnx_hw *rwnx_hw, struct rwnx_txhdr *txhdr)
+{
+	return 0;
+}
+
+/**
+ *  rwnx_tx_push - Push one packet to fw
+ *
+ * @rwnx_hw: Driver main data
+ * @txhdr: tx desc of the buffer to push
+ * @flags: push flags (see @rwnx_push_flags)
+ *
+ * Push one packet to fw. Sw desc of the packet has already been updated.
+ * Only MORE_DATA flag will be set if needed.
+ */
+void rwnx_tx_push(struct rwnx_hw *rwnx_hw, struct rwnx_txhdr *txhdr, int f=
lags)
+{
+	struct rwnx_sw_txhdr *sw_txhdr =3D txhdr->sw_hdr;
+	struct sk_buff *skb =3D sw_txhdr->skb;
+	struct rwnx_txq *txq =3D sw_txhdr->txq;
+	u16 hw_queue =3D txq->hwq->id;
+	int user =3D 0;
+
+	lockdep_assert_held(&rwnx_hw->tx_lock);
+
+	/* RETRY flag is not always set so retest here */
+	if (txq->nb_retry) {
+		flags |=3D RWNX_PUSH_RETRY;
+		txq->nb_retry--;
+		if (txq->nb_retry =3D=3D 0) {
+			WARN(skb !=3D txq->last_retry_skb,
+			     "last retry buffer is not the expected one");
+			txq->last_retry_skb =3D NULL;
+		}
+	} else if (!(flags & RWNX_PUSH_RETRY)) {
+		txq->pkt_sent++;
+	}
+#ifdef CONFIG_RWNX_AMSDUS_TX
+	if (txq->amsdu =3D=3D sw_txhdr) {
+		WARN((flags & RWNX_PUSH_RETRY), "End A-MSDU on a retry");
+		rwnx_hw->stats.amsdus[sw_txhdr->amsdu.nb - 1].done++;
+		txq->amsdu =3D NULL;
+	} else if (!(flags & RWNX_PUSH_RETRY) &&
+			   !(sw_txhdr->desc.host.flags & TXU_CNTRL_AMSDU)) {
+		rwnx_hw->stats.amsdus[0].done++;
+	}
+#endif /* CONFIG_RWNX_AMSDUS_TX */
+
+	/*
+	 * Wait here to update hw_queue, as for multicast STA hwq may change
+	 * between queue and push (because of PS)
+	 */
+	sw_txhdr->hw_queue =3D hw_queue;
+
+	// sw_txhdr->desc.host.packet_addr =3D hw_queue; //use packet_addr field =
for
+	// hw_txq
+	sw_txhdr->desc.host.ac =3D hw_queue; // use ac field for hw_txq
+#ifdef CONFIG_RWNX_MUMIMO_TX
+	/* MU group is only selected during hwq processing */
+	sw_txhdr->desc.host.mumimo_info =3D txq->mumimo_info;
+	user =3D RWNX_TXQ_POS_ID(txq);
+#endif /* CONFIG_RWNX_MUMIMO_TX */
+
+	if (sw_txhdr->rwnx_sta) {
+		/* only for AP mode */
+		rwnx_set_more_data_flag(rwnx_hw, sw_txhdr);
+	}
+#ifdef CREATE_TRACE_POINTS
+	trace_push_desc(skb, sw_txhdr, flags);
+#endif
+
+	txq->pkt_pushed[user]++;
+
+	if (txq->push_limit)
+		txq->push_limit--;
+
+#ifdef AICWF_SDIO_SUPPORT
+	if (((sw_txhdr->desc.host.flags & TXU_CNTRL_MGMT) &&
+	     (*(skb->data + sw_txhdr->headroom) =3D=3D 0xd0 ||
+	      *(skb->data + sw_txhdr->headroom) =3D=3D 0x10 ||
+	      *(skb->data + sw_txhdr->headroom) =3D=3D 0x30)) ||
+	    sw_txhdr->desc.host.ethertype =3D=3D 0x8e88 ||
+	    sw_txhdr->desc.host.ethertype =3D=3D 0xb488) {
+		sw_txhdr->need_cfm =3D 1;
+		sw_txhdr->desc.host.hostid =3D
+			((1 << 31) | rwnx_hw->sdio_env.txdesc_free_idx[0]);
+		aicwf_sdio_host_txdesc_push(&rwnx_hw->sdio_env, 0, (long)skb);
+		AICWFDBG(LOGINFO, "need cfm ethertype:%8x,user_idx=3D%d, skb=3D%p\n",
+			 sw_txhdr->desc.host.ethertype,
+			 rwnx_hw->sdio_env.txdesc_free_idx[0], skb);
+	} else {
+		sw_txhdr->need_cfm =3D 0;
+		sw_txhdr->desc.host.hostid =3D 0;
+
+		sw_txhdr->rwnx_vif->net_stats.tx_packets++;
+		sw_txhdr->rwnx_vif->net_stats.tx_bytes +=3D sw_txhdr->frame_len;
+		rwnx_hw->stats.last_tx =3D jiffies;
+	}
+	aicwf_frame_tx((void *)(rwnx_hw->sdiodev), skb);
+#endif
+#ifdef AICWF_USB_SUPPORT
+	if (((sw_txhdr->desc.host.flags & TXU_CNTRL_MGMT) &&
+	     (*(skb->data + sw_txhdr->headroom) =3D=3D 0xd0 ||
+	      *(skb->data + sw_txhdr->headroom) =3D=3D 0x10 ||
+	      *(skb->data + sw_txhdr->headroom) =3D=3D 0x30)) ||
+	    sw_txhdr->desc.host.ethertype =3D=3D 0x8e88) {
+		AICWFDBG(LOGDEBUG, "push need cfm flags 0x%x\n", sw_txhdr->desc.host.fla=
gs);
+		sw_txhdr->need_cfm =3D 1;
+		sw_txhdr->desc.host.hostid =3D
+			((1 << 31) | rwnx_hw->usb_env.txdesc_free_idx[0]);
+		aicwf_usb_host_txdesc_push(&rwnx_hw->usb_env, 0, (long)(skb));
+	} else {
+		sw_txhdr->need_cfm =3D 0;
+		sw_txhdr->desc.host.hostid =3D 0;
+
+		sw_txhdr->rwnx_vif->net_stats.tx_packets++;
+		sw_txhdr->rwnx_vif->net_stats.tx_bytes +=3D sw_txhdr->frame_len;
+		rwnx_hw->stats.last_tx =3D jiffies;
+	}
+	aicwf_frame_tx((void *)(rwnx_hw->usbdev), skb);
+#endif
+	rwnx_hw->stats.cfm_balance[hw_queue]++;
+}
