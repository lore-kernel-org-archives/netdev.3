+++ b/drivers/net/wireless/aic/aic8800/aic8800_fdrv/rwnx_dini.c
@@ -0,0 +1,292 @@
+// SPDX-License-Identifier: GPL-2.0
+/**
+ *************************************************************************=
*****
+ *
+ * Copyright (C) 2020 AIC semiconductor.
+ *
+ * @brief Add support for dini platform
+ *
