+		rwnx_key =3D &sta->key;
+		if (vif->wdev.iftype =3D=3D NL80211_IFTYPE_STATION ||
+		    vif->wdev.iftype =3D=3D NL80211_IFTYPE_P2P_CLIENT)
+			vif->sta.paired_cipher_type =3D 0xff;
+	} else {
+		rwnx_key =3D &vif->key[key_index];
+		vif->key_has_add =3D 0;
+		if (vif->wdev.iftype =3D=3D NL80211_IFTYPE_STATION ||
+		    vif->wdev.iftype =3D=3D NL80211_IFTYPE_P2P_CLIENT)
+			vif->sta.group_cipher_type =3D 0xff;
+	}
+
+	error =3D rwnx_send_key_del(rwnx_hw, rwnx_key->hw_idx);
+
+	rwnx_key->hw_idx =3D 0;
+	return error;
+}
