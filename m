+static int aicwf_sdio_resume(struct device *dev)
+{
+	int ret;
+	struct aicwf_bus *bus_if =3D dev_get_drvdata(dev);
+	struct aic_sdio_dev *sdiodev =3D bus_if->bus_priv.sdio;
+	struct rwnx_vif *rwnx_vif, *tmp;
+
+#ifdef CONFIG_NO_WAKE_COUNT
+	if (testmode =3D=3D 0)
+		rwnx_send_me_set_lp_level(sdiodev->rwnx_hw, 0, 1); //dynamic switch
+#endif
