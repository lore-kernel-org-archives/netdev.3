+static inline bool IS_2P4GHZ(int freq)
+{
+	return (freq >=3D 2412 && freq <=3D 2484);
+}
+
+static inline bool IS_5GHZ(int freq)
+{
+	return (freq >=3D 4000 && freq <=3D 5895);
+}
