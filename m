+
+struct sl_ctrl_lgrp;
+
+#define SL_CTRL_MAC_MAGIC 0x646c6c79
+#define SL_CTRL_MAC_VER   1
+struct sl_ctrl_mac {
+	u32                         magic;
+	u32                         ver;
+
+	u8                          num;
+
+	spinlock_t                  data_lock; /* data lock for mac object  */
+
+	struct sl_ctrl_mac_counter *counters;
