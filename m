+
+	pr_info("free pre alloc rxbuff list %d\n",
+		(int)atomic_read(&aic_rx_buff_list.rxbuff_list_len));
+	list_for_each_entry_safe(rxbuff, pos, &aic_rx_buff_list.rxbuff_list, queu=
e) {
+		list_del_init(&rxbuff->queue);
+		kfree(rxbuff->data);
+		kfree(rxbuff);
+	}
+}
