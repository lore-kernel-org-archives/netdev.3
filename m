+int aicbt_patch_table_free(struct aicbt_patch_table **head)
+{
+	struct aicbt_patch_table *p =3D *head, *n =3D NULL;
+
+	while (p) {
+		n =3D p->next;
+		vfree(p->name);
+		vfree(p->data);
+		vfree(p);
+		p =3D n;
+	}
+	*head =3D NULL;
+	return 0;
+}
