+static ssize_t rwnx_dbgfs_acsinfo_read(struct file *file, char __user *use=
r_buf,
+				       size_t count, loff_t *ppos)
+{
+	struct rwnx_hw *priv =3D file->private_data;
+#ifdef CONFIG_RWNX_FULLMAC
+	struct wiphy *wiphy =3D priv->wiphy;
+#endif // CONFIG_RWNX_FULLMAC
+	int survey_cnt =3D 0;
+	int len =3D 0;
+	int band, chan_cnt;
+	int band_max =3D NL80211_BAND_5GHZ;
+	char *buf =3D vmalloc((SCAN_CHANNEL_MAX + 1) * 43);
+	ssize_t size;
+
+	if (!buf)
+		return 0;
+
+	if (priv->band_5g_support)
+		band_max =3D NL80211_BAND_5GHZ + 1;
+
+	mutex_lock(&priv->dbgdump_elem.mutex);
+
+	len +=3D scnprintf(buf, min_t(size_t, sizeof(buf) - 1, count),
+			 "FREQ    TIME(ms)    BUSY(ms)    NOISE(dBm)\n");
+
+	for (band =3D NL80211_BAND_2GHZ; band < band_max; band++) {
+		for (chan_cnt =3D 0; chan_cnt < wiphy->bands[band]->n_channels;
+			 chan_cnt++) {
+			struct rwnx_survey_info *p_survey_info =3D &priv->survey[survey_cnt];
+			struct ieee80211_channel *p_chan =3D
+				&wiphy->bands[band]->channels[chan_cnt];
+
+			if (p_survey_info->filled) {
+				len +=3D scnprintf(&buf[len],
+						 min_t(size_t, sizeof(buf) - len - 1, count),
+						 "%d    %03d         %03d         %d\n",
+						 p_chan->center_freq,
+						 p_survey_info->chan_time_ms,
+						 p_survey_info->chan_time_busy_ms,
+						 p_survey_info->noise_dbm);
+			} else {
+				len +=3D scnprintf(&buf[len],
+						 min_t(size_t, sizeof(buf) - len - 1, count),
+						 "%d    NOT AVAILABLE\n", p_chan->center_freq);
+			}
+
+			survey_cnt++;
+		}
+	}
+
+	mutex_unlock(&priv->dbgdump_elem.mutex);
+
+	size =3D simple_read_from_buffer(user_buf, count, ppos, buf, len);
+	vfree(buf);
+
+	return size;
+}
