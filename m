+
+#ifdef CONFIG_RWNX_DEBUGFS
+#ifdef CONFIG_RWNX_FULLMAC
+static ssize_t rwnx_dbgfs_stats_read(struct file *file, char __user *user_=
buf,
+				     size_t count, loff_t *ppos)
+{
+	struct rwnx_hw *priv =3D file->private_data;
+	char *buf;
+	int ret;
+	int i, skipped;
+	ssize_t read;
+	int bufsz =3D (NX_TXQ_CNT) * 20 +
+			(ARRAY_SIZE(priv->stats.amsdus_rx) + 1) * 40 +
+			(ARRAY_SIZE(priv->stats.ampdus_tx) * 30);
+
+	if (*ppos)
+		return 0;
+
+	buf =3D kmalloc(bufsz, GFP_ATOMIC);
+	if (!buf)
+		return 0;
+
+	ret =3D scnprintf(buf, bufsz, "TXQs CFM balances ");
+	for (i =3D 0; i < NX_TXQ_CNT; i++)
+		ret +=3D scnprintf(&buf[ret], bufsz - ret, "  [%1d]:%3d", i,
+				 priv->stats.cfm_balance[i]);
+
+	ret +=3D scnprintf(&buf[ret], bufsz - ret, "\n");
+
+#ifdef CONFIG_RWNX_SPLIT_TX_BUF
+	ret +=3D scnprintf(&buf[ret], bufsz - ret,
+			 "\nAMSDU[len]       done         failed   received\n");
+	for (i =3D skipped =3D 0; i < NX_TX_PAYLOAD_MAX; i++) {
+		if (priv->stats.amsdus[i].done) {
+			per =3D DIV_ROUND_UP((priv->stats.amsdus[i].failed) * 100,
+					   priv->stats.amsdus[i].done);
+		} else if (priv->stats.amsdus_rx[i]) {
+			per =3D 0;
+		} else {
+			per =3D 0;
+			skipped =3D 1;
+			continue;
+		}
+		if (skipped) {
+			ret +=3D scnprintf(&buf[ret], bufsz - ret, "   ...\n");
+			skipped =3D 0;
+		}
+
+		ret +=3D scnprintf(&buf[ret], bufsz - ret, "   [%2d]    %10d %8d(%3d%%) =
%10d\n",
+				 i ? i + 1 : i, priv->stats.amsdus[i].done,
+				 priv->stats.amsdus[i].failed, per, priv->stats.amsdus_rx[i]);
+	}
+
+	for (; i < ARRAY_SIZE(priv->stats.amsdus_rx); i++) {
+		if (!priv->stats.amsdus_rx[i]) {
+			skipped =3D 1;
+			continue;
+		}
+		if (skipped) {
+			ret +=3D scnprintf(&buf[ret], bufsz - ret, "   ...\n");
+			skipped =3D 0;
+		}
+
+		ret +=3D scnprintf(&buf[ret], bufsz - ret,
+				 "   [%2d]                              %10d\n", i + 1,
+				 priv->stats.amsdus_rx[i]);
+	}
+#else
+	ret +=3D scnprintf(&buf[ret], bufsz - ret, "\nAMSDU[len]   received\n");
+	for (i =3D skipped =3D 0; i < ARRAY_SIZE(priv->stats.amsdus_rx); i++) {
+		if (!priv->stats.amsdus_rx[i]) {
+			skipped =3D 1;
+			continue;
+		}
+		if (skipped) {
+			ret +=3D scnprintf(&buf[ret], bufsz - ret, "   ...\n");
+			skipped =3D 0;
+		}
+
+		ret +=3D scnprintf(&buf[ret], bufsz - ret, "   [%2d]    %10d\n", i + 1,
+				 priv->stats.amsdus_rx[i]);
+	}
+
+#endif /* CONFIG_RWNX_SPLIT_TX_BUF */
+
+	ret +=3D
+		scnprintf(&buf[ret], bufsz - ret, "\nAMPDU[len]     done  received\n");
+	for (i =3D skipped =3D 0; i < ARRAY_SIZE(priv->stats.ampdus_tx); i++) {
+		if (!priv->stats.ampdus_tx[i] && !priv->stats.ampdus_rx[i]) {
+			skipped =3D 1;
+			continue;
+		}
+		if (skipped) {
+			ret +=3D scnprintf(&buf[ret], bufsz - ret, "    ...\n");
+			skipped =3D 0;
+		}
+
+		ret +=3D scnprintf(&buf[ret], bufsz - ret, "   [%2d]   %9d %9d\n",
+				 i ? i + 1 : i, priv->stats.ampdus_tx[i],
+				 priv->stats.ampdus_rx[i]);
+	}
+
+	ret +=3D scnprintf(&buf[ret], bufsz - ret, "#mpdu missed        %9d\n",
+			 priv->stats.ampdus_rx_miss);
+	read =3D simple_read_from_buffer(user_buf, count, ppos, buf, ret);
+
+	kfree(buf);
+
+	return read;
+}
