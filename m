+static int aic_open(struct hci_uart *hu)
+{
+	struct aic_data *aic;
+	struct list_head *p;
+	int err;
+
+	bt_dev_dbg(hu->hdev, "hu %p", hu);
+
+	if (!aic_hci_uart_has_flow_control(hu))
+		return -EOPNOTSUPP;
+
+	aic =3D kzalloc(sizeof(*aic), GFP_KERNEL);
+	if (!aic)
+		return -ENOMEM;
+
+	skb_queue_head_init(&aic->txq);
+
+	hu->priv =3D aic;
+
+	mutex_lock(&aic_device_lock);
+
+	if (hu->serdev) {
+		aic->dev =3D serdev_device_get_drvdata(hu->serdev);
+		goto out;
+	}
+
+	if (!hu->tty->dev)
+		goto out;
+
+	list_for_each(p, &aic_device_list)
+	{
+		struct aic_device *dev =3D list_entry(p, struct aic_device, list);
+
+		/* Retrieve saved aic_device based on parent of the
+		 * platform device (saved during device probe) and
+		 * parent of tty device used by hci_uart
+		 */
+		if (hu->tty->dev->parent =3D=3D dev->dev->parent) {
+			aic->dev =3D dev;
+#ifdef CONFIG_PM
+			dev->hu =3D hu;
+#endif
+			break;
+		}
+	}
+
+out:
+	if (aic->dev) {
+		if (aic->dev->drive_rts_on_open)
+			aic_hci_uart_set_flow_control(hu, true);
+
+		hu->init_speed =3D aic->dev->init_speed;
+
+		/* If oper_speed is set, ldisc/serdev will set the baudrate
+		 * before calling setup()
+		 */
+		if (!aic->dev->no_early_set_baudrate)
+			hu->oper_speed =3D aic->dev->oper_speed;
+
+		err =3D aic_gpio_set_power(aic->dev, true);
+
+		if (aic->dev->drive_rts_on_open)
+			aic_hci_uart_set_flow_control(hu, false);
+
+		if (err)
+			goto err_unset_hu;
+	}
+
+	mutex_unlock(&aic_device_lock);
+	return 0;
+
+err_unset_hu:
+#ifdef CONFIG_PM
+	if (!hu->serdev)
+		aic->dev->hu =3D NULL;
+#endif
+	mutex_unlock(&aic_device_lock);
+	hu->priv =3D NULL;
+	kfree(aic);
+	return err;
+}
+
+static int aic_close(struct hci_uart *hu)
+{
+	struct aic_data *aic =3D hu->priv;
+	struct aic_device *bdev =3D NULL;
+	int err;
+
+	bt_dev_dbg(hu->hdev, "hu %p", hu);
+
+	/* Protect aic->dev against removal of the device or driver */
+	mutex_lock(&aic_device_lock);
+
+	if (hu->serdev) {
+		bdev =3D serdev_device_get_drvdata(hu->serdev);
+	} else if (aic_device_exists(aic->dev)) {
+		bdev =3D aic->dev;
+#ifdef CONFIG_PM
+		bdev->hu =3D NULL;
+#endif
+	}
+
+	if (bdev) {
+		if (IS_ENABLED(CONFIG_PM) && bdev->irq_acquired) {
+			devm_free_irq(bdev->dev, bdev->irq, bdev);
+			device_init_wakeup(bdev->dev, false);
+			pm_runtime_disable(bdev->dev);
+		}
+
+		err =3D aic_gpio_set_power(bdev, false);
+		if (err)
+			bt_dev_err(hu->hdev, "Failed to power down");
+		else
+			pm_runtime_set_suspended(bdev->dev);
+	}
+	mutex_unlock(&aic_device_lock);
+
+	skb_queue_purge(&aic->txq);
+	kfree_skb(aic->rx_skb);
+	kfree(aic);
+
+	hu->priv =3D NULL;
+	return 0;
+}
+
+static int aic_flush(struct hci_uart *hu)
+{
+	struct aic_data *aic =3D hu->priv;
+
+	bt_dev_dbg(hu->hdev, "hu %p", hu);
+
+	skb_queue_purge(&aic->txq);
+
+	return 0;
+}
