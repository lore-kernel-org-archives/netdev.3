+/**
+ * @dump_station: dump station callback -- resume dump at index @idx
+ */
+static int rwnx_cfg80211_dump_station(struct wiphy *wiphy,
+				      struct net_device *dev, int idx, u8 *mac,
+				      struct station_info *sinfo)
+{
+	struct rwnx_vif *rwnx_vif =3D netdev_priv(dev);
+	struct rwnx_hw *rwnx_hw =3D wiphy_priv(wiphy);
+	struct rwnx_sta *sta_iter, *sta =3D NULL;
+	struct mesh_peer_info_cfm peer_info_cfm;
+	struct cfg80211_bss *bss =3D NULL;
+	const u8 *tim =3D NULL;
+	int i =3D 0;
+
+	if (RWNX_VIF_TYPE(rwnx_vif) =3D=3D NL80211_IFTYPE_STATION ||
+	    RWNX_VIF_TYPE(rwnx_vif) =3D=3D NL80211_IFTYPE_P2P_CLIENT) {
+		if (idx =3D=3D 0) {
+			bss =3D cfg80211_get_bss(wiphy, NULL, rwnx_vif->sta.bssid,
+					       rwnx_vif->sta.ssid, rwnx_vif->sta.ssid_len,
+					       dev->ieee80211_ptr->conn_bss_type,
+					       IEEE80211_PRIVACY_ANY);
+			if (bss) {
+				rwnx_vif->sta.capability =3D bss->capability;
+				rwnx_vif->sta.b_interval =3D bss->beacon_interval;
+				if (bss->beacon_ies && bss->beacon_ies->len > 0) {
+					tim =3D cfg80211_find_ie(WLAN_EID_TIM,
+							       bss->beacon_ies->data,
+							       bss->beacon_ies->len);
+					if (tim)
+						rwnx_vif->sta.dtim_peroid =3D *(tim + 3);
+				}
+			}
+			memcpy(mac, rwnx_vif->sta.bssid, ETH_ALEN);
+			return rwnx_cfg80211_get_station(wiphy, dev, mac, sinfo);
+		}
+		return -ENOENT;
+	}
+
+	if (RWNX_VIF_TYPE(rwnx_vif) !=3D NL80211_IFTYPE_MESH_POINT)
+		return -EOPNOTSUPP;
+
+	list_for_each_entry(sta_iter, &rwnx_vif->ap.sta_list, list) {
+		if (i < idx) {
+			i++;
+			continue;
+		}
+		sta =3D sta_iter;
+		break;
+	}
+
+	if (!sta)
+		return -ENOENT;
+
+	/* Forward the information to the UMAC */
+	if (rwnx_send_mesh_peer_info_req(rwnx_hw, rwnx_vif, sta->sta_idx,
+					 &peer_info_cfm))
+		return -ENOMEM;
+
+	/* Copy peer MAC address */
+	memcpy(mac, &sta->mac_addr, ETH_ALEN);
+
+	/* Fill station information */
+	sinfo->llid =3D peer_info_cfm.local_link_id;
+	sinfo->plid =3D peer_info_cfm.peer_link_id;
+	sinfo->plink_state =3D peer_info_cfm.link_state;
+	sinfo->local_pm =3D peer_info_cfm.local_ps_mode;
+	sinfo->peer_pm =3D peer_info_cfm.peer_ps_mode;
+	sinfo->nonpeer_pm =3D peer_info_cfm.non_peer_ps_mode;
+	sinfo->filled =3D
+		(BIT(NL80211_STA_INFO_LLID) | BIT(NL80211_STA_INFO_PLID) |
+		 BIT(NL80211_STA_INFO_PLINK_STATE) | BIT(NL80211_STA_INFO_LOCAL_PM) |
+		 BIT(NL80211_STA_INFO_PEER_PM) | BIT(NL80211_STA_INFO_NONPEER_PM));
+
+	return 0;
+}
