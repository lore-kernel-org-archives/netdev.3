+/**
+ *
+ * @channel_switch: initiate channel-switch procedure (with CSA). Driver i=
s
+ *	responsible for veryfing if the switch is possible. Since this is
+ *	inherently tricky driver may decide to disconnect an interface later
+ *	with cfg80211_stop_iface(). This doesn't mean driver can accept
+ *	everything. It should do it's best to verify requests and reject them
+ *	as soon as possible.
+ */
+static int rwnx_cfg80211_channel_switch(struct wiphy *wiphy, struct net_de=
vice *dev,
+					struct cfg80211_csa_settings *params)
+{
+	struct rwnx_hw *rwnx_hw =3D wiphy_priv(wiphy);
+	struct rwnx_vif *vif =3D netdev_priv(dev);
+	struct rwnx_bcn *bcn, *bcn_after;
+	struct rwnx_csa *csa;
+	u16 csa_oft[BCN_MAX_CSA_CPT];
+	u8 *buf;
+	int i, error =3D 0;
+
+	if (vif->ap.csa)
+		return -EBUSY;
+
+	if (params->n_counter_offsets_beacon > BCN_MAX_CSA_CPT)
+		return -EINVAL;
+
+	/* Build the new beacon with CSA IE */
+	bcn =3D &vif->ap.bcn;
+	buf =3D rwnx_build_bcn(bcn, &params->beacon_csa);
+	if (!buf)
+		return -ENOMEM;
+
+	memset(csa_oft, 0, sizeof(csa_oft));
+	for (i =3D 0; i < params->n_counter_offsets_beacon; i++)
+		csa_oft[i] =3D
+			params->counter_offsets_beacon[i] + bcn->head_len + bcn->tim_len;
+
+	/* If count is set to 0 (i.e anytime after this beacon) force it to 2 */
+	if (params->count =3D=3D 0) {
+		params->count =3D 2;
+		for (i =3D 0; i < params->n_counter_offsets_beacon; i++)
+			buf[csa_oft[i]] =3D 2;
+	}
+
+	error =3D rwnx_send_bcn(rwnx_hw, buf, vif->vif_index, bcn->len);
+	if (error)
+		goto end;
+
+	/* Build the beacon to use after CSA. It will only be sent to fw once
+	 * CSA is over, but do it before sending the beacon as it must be ready
+	 * when CSA is finished.
+	 */
+	csa =3D kzalloc(sizeof(*csa), GFP_KERNEL);
+	if (!csa) {
+		error =3D -ENOMEM;
+		goto end;
+	}
+
+	bcn_after =3D &csa->bcn;
+	buf =3D rwnx_build_bcn(bcn_after, &params->beacon_after);
+	if (!buf) {
+		error =3D -ENOMEM;
+		rwnx_del_csa(vif);
+		goto end;
+	}
+
+	error =3D rwnx_send_bcn(rwnx_hw, buf, vif->vif_index, bcn_after->len);
+	if (error)
+		goto end;
+
+	vif->ap.csa =3D csa;
+	csa->vif =3D vif;
+	csa->chandef =3D params->chandef;
+
+	/* Send new Beacon. FW will extract channel and count from the beacon */
+	error =3D rwnx_send_bcn_change(rwnx_hw, vif->vif_index, 0, bcn->len,
+				     bcn->head_len, bcn->tim_len, csa_oft);
+
+	if (error) {
+		rwnx_del_csa(vif);
+		goto end;
+	} else {
+		INIT_WORK(&csa->work, rwnx_csa_finish);
+		cfg80211_ch_switch_started_notify(dev, &csa->chandef, 0, params->count,
+						  false);
+	}
+end:
+	return error;
+}
