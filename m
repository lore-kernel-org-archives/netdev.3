****/
+static int rwnx_radar_dump_pri_detector(char *buf, size_t len,
+					struct pri_detector *pde)
+{
+	char freq_info[] =3D "Freq =3D %3.dMhz\n";
+	char seq_info[] =3D " pri    | count | false\n";
+	struct pri_sequence *seq;
+	int res, write =3D 0;
+
+	if (list_empty(&pde->sequences))
+		return 0;
+
+	if (!buf) {
+		int nb_seq =3D 1;
+
+		list_for_each_entry(seq, &pde->sequences, head) {
+			nb_seq++;
+		}
+
+		return (sizeof(freq_info) + nb_seq * sizeof(seq_info));
+	}
+
+	res =3D scnprintf(buf, len, freq_info, pde->freq);
+	write +=3D res;
+	len -=3D res;
+
+	res =3D scnprintf(&buf[write], len, "%s", seq_info);
+	write +=3D res;
+	len -=3D res;
+
+	list_for_each_entry(seq, &pde->sequences, head) {
+		res =3D scnprintf(&buf[write], len, " %6.d |   %2.d  |    %.2d\n",
+				seq->pri, seq->count, seq->count_falses);
+		write +=3D res;
+		len -=3D res;
+	}
+
+	return write;
+}
+
+int rwnx_radar_dump_pattern_detector(char *buf, size_t len,
+				     struct rwnx_radar *radar, u8 chain)
+{
+	struct dfs_pattern_detector *dpd =3D radar->dpd[chain];
+	char info[] =3D "Type =3D %3.d\n";
+	struct pri_detector *pde;
+	int i, res, write =3D 0;
+
+	/* if buf is NULL return size needed for dump */
+	if (!buf) {
+		int size_needed =3D 0;
+
+		for (i =3D 0; i < dpd->num_radar_types; i++) {
+			list_for_each_entry(pde, &dpd->detectors[i], head) {
+				size_needed +=3D rwnx_radar_dump_pri_detector(NULL, 0, pde);
+			}
+			size_needed +=3D sizeof(info);
+
+			return size_needed;
+		}
+	}
+
+	/* */
+	for (i =3D 0; i < dpd->num_radar_types; i++) {
+		res =3D scnprintf(&buf[write], len, info, i);
+
+		write +=3D res;
+		len -=3D res;
+
+		list_for_each_entry(pde, &dpd->detectors[i], head) {
+			res =3D rwnx_radar_dump_pri_detector(&buf[write], len, pde);
+			write +=3D res;
+			len -=3D res;
+		}
+	}
+
+	return write;
+}
+
+int rwnx_radar_dump_radar_detected(char *buf, size_t len,
+				   struct rwnx_radar *radar, u8 chain)
+{
+	struct rwnx_radar_detected *detect =3D &radar->detected[chain];
+	char info[] =3D "2001/02/02 - 02:20 5126MHz\n";
+	int idx, i, res, write =3D 0;
+	int count =3D detect->count;
+
+	if (count > NX_NB_RADAR_DETECTED)
+		count =3D NX_NB_RADAR_DETECTED;
+
+	if (!buf)
+		return (count * sizeof(info)) + 1;
+
+	idx =3D (detect->index - detect->count) % NX_NB_RADAR_DETECTED;
+
+	for (i =3D 0; i < count; i++) {
+		struct tm tm;
+
+		time64_to_tm(detect->time[idx], 0, &tm);
+		res =3D
+			scnprintf(&buf[write], len, "%.4d/%.2d/%.2d - %.2d:%.2d %4.4dMHz\n",
+				  (int)tm.tm_year + 1900, tm.tm_mon + 1, tm.tm_mday,
+				  tm.tm_hour, tm.tm_min, detect->freq[idx]);
+		write +=3D res;
+		len -=3D res;
+
+		idx =3D (idx + 1) % NX_NB_RADAR_DETECTED;
+	}
+
+	return write;
+}
