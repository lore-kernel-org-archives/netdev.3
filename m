+#if defined(CONFIG_SDIO_PWRCTRL)
+int aicwf_sdio_wakeup(struct aic_sdio_dev *sdiodev)
+{
+	int ret =3D 0;
+	int read_retry;
+	int write_retry =3D 1;
+	int wakeup_reg_val =3D 0;
+
+	if (sdiodev->chipid =3D=3D PRODUCT_ID_AIC8801 ||
+	    sdiodev->chipid =3D=3D PRODUCT_ID_AIC8800DC ||
+		sdiodev->chipid =3D=3D PRODUCT_ID_AIC8800DW) {
+		wakeup_reg_val =3D 1;
+	} else if (sdiodev->chipid =3D=3D PRODUCT_ID_AIC8800D80) {
+		wakeup_reg_val =3D 0x11;
+	}
+
+	if (sdiodev->state =3D=3D SDIO_SLEEP_ST) {
+		AICWFDBG(LOGSDPWRC, "%s w\n", __func__);
+
+		while (write_retry) {
+			ret =3D aicwf_sdio_writeb(sdiodev, sdiodev->sdio_reg.wakeup_reg,
+						wakeup_reg_val);
+			if (ret) {
+				txrx_err("sdio wakeup fail\n");
+				ret =3D -1;
+			} else {
+				read_retry =3D 50;
+				while (read_retry) {
+					u8 val;
+
+					ret =3D aicwf_sdio_readb(sdiodev,
+							       sdiodev->sdio_reg.wakeup_reg,
+							       &val);
+					if (ret < 0)
+						txrx_err("sdio wakeup read fail\n");
+					else if ((val & 0x1) =3D=3D 0)
+						break;
+					read_retry--;
+					usleep_range(50, 60);
+				}
+				if (read_retry !=3D 0)
+					break;
+			}
+			sdio_dbg("write retry:  %d\n", write_retry);
+			write_retry--;
+			usleep_range(40, 50);
+		}
+
+		sdiodev->state =3D SDIO_ACTIVE_ST;
+		aicwf_sdio_pwrctl_timer(sdiodev, sdiodev->active_duration);
+	}
+	return ret;
+}
