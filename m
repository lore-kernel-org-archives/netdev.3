+static u16 rwnx_get_tdls_sta_capab(struct rwnx_vif *rwnx_vif, u16 status_c=
ode)
+{
+	u16 capab =3D 0;
+
+	/* The capability will be 0 when sending a failure code */
+	if (status_code !=3D 0)
+		return capab;
+
+	if (rwnx_vif->sta.ap->band !=3D NL80211_BAND_2GHZ)
+		return capab;
+
+	capab |=3D WLAN_CAPABILITY_SHORT_SLOT_TIME;
+	capab |=3D WLAN_CAPABILITY_SHORT_PREAMBLE;
+
+	return capab;
+}
+
+static int rwnx_tdls_prepare_encap_data(struct rwnx_hw *rwnx_hw,
+					struct rwnx_vif *rwnx_vif,
+					const u8 *peer, u8 action_code,
+					u8 dialog_token, u16 status_code,
+					struct sk_buff *skb)
+{
+	struct ieee80211_tdls_data *tf;
+
+	tf =3D (void *)skb_put(skb,
+			     sizeof(struct ieee80211_tdls_data) - sizeof(tf->u));
+
+	// set eth header
+	memcpy(tf->da, peer, ETH_ALEN);
+	memcpy(tf->sa, rwnx_hw->wiphy->perm_addr, ETH_ALEN);
+	tf->ether_type =3D cpu_to_be16(ETH_P_TDLS);
+
+	// set common TDLS info
+	tf->payload_type =3D WLAN_TDLS_SNAP_RFTYPE;
+	tf->category =3D WLAN_CATEGORY_TDLS;
+	tf->action_code =3D action_code;
+
+	// set action specific TDLS info
+	switch (action_code) {
+	case WLAN_TDLS_SETUP_REQUEST:
+		skb_put(skb, sizeof(tf->u.setup_req));
+		tf->u.setup_req.dialog_token =3D dialog_token;
+		tf->u.setup_req.capability =3D
+			cpu_to_le16(rwnx_get_tdls_sta_capab(rwnx_vif, status_code));
+		break;
+
+	case WLAN_TDLS_SETUP_RESPONSE:
+		skb_put(skb, sizeof(tf->u.setup_resp));
+		tf->u.setup_resp.status_code =3D cpu_to_le16(status_code);
+		tf->u.setup_resp.dialog_token =3D dialog_token;
+		tf->u.setup_resp.capability =3D
+			cpu_to_le16(rwnx_get_tdls_sta_capab(rwnx_vif, status_code));
+		break;
+
+	case WLAN_TDLS_SETUP_CONFIRM:
+		skb_put(skb, sizeof(tf->u.setup_cfm));
+		tf->u.setup_cfm.status_code =3D cpu_to_le16(status_code);
+		tf->u.setup_cfm.dialog_token =3D dialog_token;
+		break;
+
+	case WLAN_TDLS_TEARDOWN:
+		skb_put(skb, sizeof(tf->u.teardown));
+		tf->u.teardown.reason_code =3D cpu_to_le16(status_code);
+		break;
+
+	case WLAN_TDLS_DISCOVERY_REQUEST:
+		skb_put(skb, sizeof(tf->u.discover_req));
+		tf->u.discover_req.dialog_token =3D dialog_token;
+		break;
+
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int rwnx_prep_tdls_direct(struct rwnx_hw *rwnx_hw,
+				 struct rwnx_vif *rwnx_vif, const u8 *peer,
+				 u8 action_code, u8 dialog_token,
+				 u16 status_code, struct sk_buff *skb)
+{
+	struct ieee80211_mgmt *mgmt;
+
+	mgmt =3D (void *)skb_put(skb, 24);
+	memset(mgmt, 0, 24);
+	memcpy(mgmt->da, peer, ETH_ALEN);
+	memcpy(mgmt->sa, rwnx_hw->wiphy->perm_addr, ETH_ALEN);
+	memcpy(mgmt->bssid, rwnx_vif->sta.ap->mac_addr, ETH_ALEN);
+
+	mgmt->frame_control =3D
+		cpu_to_le16(IEEE80211_FTYPE_MGMT | IEEE80211_STYPE_ACTION);
+
+	switch (action_code) {
+	case WLAN_PUB_ACTION_TDLS_DISCOVER_RES:
+		skb_put(skb, 1 + sizeof(mgmt->u.action.u.tdls_discover_resp));
+		mgmt->u.action.category =3D WLAN_CATEGORY_PUBLIC;
+		mgmt->u.action.u.tdls_discover_resp.action_code =3D
+			WLAN_PUB_ACTION_TDLS_DISCOVER_RES;
+		mgmt->u.action.u.tdls_discover_resp.dialog_token =3D dialog_token;
+		mgmt->u.action.u.tdls_discover_resp.capability =3D
+			cpu_to_le16(rwnx_get_tdls_sta_capab(rwnx_vif, status_code));
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int rwnx_add_srates_ie(struct rwnx_hw *rwnx_hw, struct sk_buff *skb=
)
+{
+	u8 i, rates, *pos;
+	int rate;
+	struct ieee80211_supported_band *rwnx_band_2ghz =3D
+		rwnx_hw->wiphy->bands[NL80211_BAND_2GHZ];
+
+	rates =3D 8;
+
+	if (skb_tailroom(skb) < rates + 2)
+		return -ENOMEM;
+
+	pos =3D skb_put(skb, rates + 2);
+	*pos++ =3D WLAN_EID_SUPP_RATES;
+	*pos++ =3D rates;
+	for (i =3D 0; i < rates; i++) {
+		rate =3D rwnx_band_2ghz->bitrates[i].bitrate;
+		rate =3D DIV_ROUND_UP(rate, 5);
+		*pos++ =3D (u8)rate;
+	}
+
+	return 0;
+}
+
+static int rwnx_add_ext_srates_ie(struct rwnx_hw *rwnx_hw, struct sk_buff =
*skb)
+{
+	u8 i, exrates, *pos;
+	int rate;
+	struct ieee80211_supported_band *rwnx_band_2ghz =3D
+		rwnx_hw->wiphy->bands[NL80211_BAND_2GHZ];
+
+	exrates =3D rwnx_band_2ghz->n_bitrates - 8;
+
+	if (skb_tailroom(skb) < exrates + 2)
+		return -ENOMEM;
+
+	pos =3D skb_put(skb, exrates + 2);
+	*pos++ =3D WLAN_EID_EXT_SUPP_RATES;
+	*pos++ =3D exrates;
+	for (i =3D 8; i < (8 + exrates); i++) {
+		rate =3D rwnx_band_2ghz->bitrates[i].bitrate;
+		rate =3D DIV_ROUND_UP(rate, 5);
+		*pos++ =3D (u8)rate;
+	}
+
+	return 0;
+}
+
+static void rwnx_tdls_add_supp_channels(struct rwnx_hw *rwnx_hw,
+					struct sk_buff *skb)
+{
+	/*
+	 * Add possible channels for TDLS. These are channels that are allowed
+	 * to be active.
+	 */
+	u8 subband_cnt =3D 0;
+	u8 *pos_subband;
+	u8 *pos =3D skb_put(skb, 2);
+	struct ieee80211_supported_band *rwnx_band_2ghz =3D
+		rwnx_hw->wiphy->bands[NL80211_BAND_2GHZ];
+	struct ieee80211_supported_band *rwnx_band_5ghz =3D
+		rwnx_hw->wiphy->bands[NL80211_BAND_5GHZ];
+
+	*pos++ =3D WLAN_EID_SUPPORTED_CHANNELS;
+
+	/*
+	 * 5GHz and 2GHz channels numbers can overlap. Ignore this for now, as
+	 * this doesn't happen in real world scenarios.
+	 */
+
+	/* 2GHz, with 5MHz spacing */
+	pos_subband =3D skb_put(skb, 2);
+	if (rwnx_band_2ghz->n_channels > 0) {
+		*pos_subband++ =3D ieee80211_frequency_to_channel
+				(rwnx_band_2ghz->channels[0].center_freq);
+		*pos_subband++ =3D rwnx_band_2ghz->n_channels;
+		subband_cnt++;
+	}
+
+	/* 5GHz, with 20MHz spacing */
+	pos_subband =3D skb_put(skb, 2);
+	if (rwnx_hw->band_5g_support) {
+		if (rwnx_band_5ghz->n_channels > 0) {
+			*pos_subband++ =3D ieee80211_frequency_to_channel
+					(rwnx_band_5ghz->channels[0].center_freq);
+			*pos_subband++ =3D rwnx_band_5ghz->n_channels;
+			subband_cnt++;
+		}
+	}
+	/* length */
+	*pos =3D 2 * subband_cnt;
+}
