+		is_chip_id_h =3D (u8)(((rd_mem_addr_cfm.memdata >> 16) & 0xC0) =3D=3D 0x=
C0);
+		btenable =3D 1;
+		if (is_chip_id_h) {
+			AICWFDBG(LOGINFO, "IS_CHIP_ID_H\n");
