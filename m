+/**
+ * @change_virtual_intf: change type/configuration of virtual interface,
+ *	keep the struct wireless_dev's iftype updated.
+ */
+static int rwnx_cfg80211_change_iface(struct wiphy *wiphy,
+				      struct net_device *dev,
+				      enum nl80211_iftype type,
+				      struct vif_params *params)
+{
+#ifndef CONFIG_RWNX_MON_DATA
+	struct rwnx_hw *rwnx_hw =3D wiphy_priv(wiphy);
+#endif
+	struct rwnx_vif *vif =3D netdev_priv(dev);
+	struct mm_add_if_cfm add_if_cfm;
+	bool p2p =3D false;
+	int ret;
+
+	RWNX_DBG(RWNX_FN_ENTRY_STR);
+	AICWFDBG(LOGDEBUG, "AICWF change_if: %d to %d, %d, %d", vif->wdev.iftype,=
 type,
+		 NL80211_IFTYPE_P2P_CLIENT, NL80211_IFTYPE_STATION);
+
+#ifdef CONFIG_COEX
+	if (type =3D=3D NL80211_IFTYPE_AP || type =3D=3D NL80211_IFTYPE_P2P_GO)
+		rwnx_send_coex_req(vif->rwnx_hw, 1, 0);
+	if (RWNX_VIF_TYPE(vif) =3D=3D NL80211_IFTYPE_AP ||
+	    RWNX_VIF_TYPE(vif) =3D=3D NL80211_IFTYPE_P2P_GO)
+		rwnx_send_coex_req(vif->rwnx_hw, 0, 1);
+#endif
+#ifndef CONFIG_RWNX_MON_DATA
+	if (type =3D=3D NL80211_IFTYPE_MONITOR &&
+	    RWNX_VIF_TYPE(vif) !=3D NL80211_IFTYPE_MONITOR) {
+		struct rwnx_vif *vif_el;
+
+		list_for_each_entry(vif_el, &rwnx_hw->vifs, list) {
+			// Check if data interface already exists
+			if (vif_el !=3D vif &&
+			    RWNX_VIF_TYPE(vif) !=3D NL80211_IFTYPE_MONITOR) {
+				wiphy_err(rwnx_hw->wiphy,
+					  "Monitor+Data interface support (MON_DATA) disabled\n");
+				return -EIO;
+			}
+		}
+	}
+#endif
+
+	// Reset to default case (i.e. not monitor)
+	dev->type =3D ARPHRD_ETHER;
+	dev->netdev_ops =3D &rwnx_netdev_ops;
+
+	switch (type) {
+	case NL80211_IFTYPE_STATION:
+	case NL80211_IFTYPE_P2P_CLIENT:
+		vif->sta.ap =3D NULL;
+		vif->sta.tdls_sta =3D NULL;
+		vif->sta.external_auth =3D false;
+		break;
+	case NL80211_IFTYPE_MESH_POINT:
+		INIT_LIST_HEAD(&vif->ap.mpath_list);
+		INIT_LIST_HEAD(&vif->ap.proxy_list);
+		vif->ap.create_path =3D false;
+		vif->ap.generation =3D 0;
+		// no break
+	case NL80211_IFTYPE_AP:
+	case NL80211_IFTYPE_P2P_GO:
+		INIT_LIST_HEAD(&vif->ap.sta_list);
+		memset(&vif->ap.bcn, 0, sizeof(vif->ap.bcn));
+		break;
+	case NL80211_IFTYPE_AP_VLAN:
+		return -EPERM;
+	case NL80211_IFTYPE_MONITOR:
+		dev->type =3D ARPHRD_IEEE80211_RADIOTAP;
+		dev->netdev_ops =3D &rwnx_netdev_monitor_ops;
+		break;
+	default:
+		break;
+	}
+
+	vif->wdev.iftype =3D type;
+	if (params->use_4addr !=3D -1)
+		vif->use_4addr =3D params->use_4addr;
+	if (type =3D=3D NL80211_IFTYPE_P2P_CLIENT || type =3D=3D NL80211_IFTYPE_P=
2P_GO)
+		p2p =3D true;
+
+	if (vif->up) {
+		/* Abort scan request on the vif */
+		if (vif->rwnx_hw->scan_request &&
+		    vif->rwnx_hw->scan_request->wdev =3D=3D &vif->wdev) {
+			ret =3D rwnx_send_scanu_cancel_req(vif->rwnx_hw, NULL);
+			if (ret) {
+				AICWFDBG(LOGERROR, "scanu_cancel fail\n");
+				return ret;
+			}
+		}
+		ret =3D rwnx_send_remove_if(vif->rwnx_hw, vif->vif_index, false);
+		if (ret) {
+			AICWFDBG(LOGDEBUG, "AICWF remove_if fail\n");
+			return ret;
+		}
+		vif->rwnx_hw->vif_table[vif->vif_index] =3D NULL;
+		AICWFDBG(LOGDEBUG, "AICWF change_if from %d\n", vif->vif_index);
+		ret =3D rwnx_send_add_if(vif->rwnx_hw, vif->wdev.address,
+				       RWNX_VIF_TYPE(vif), p2p, &add_if_cfm);
+		if (ret) {
+			AICWFDBG(LOGDEBUG, "AICWF add if fail\n");
+			return ret;
+		}
+		if (add_if_cfm.status !=3D 0) {
+			AICWFDBG(LOGDEBUG, "AICWF add if status fail\n");
+			return -EIO;
+		}
+
+		AICWFDBG(LOGDEBUG, "AICWF change_if to %d\n", add_if_cfm.inst_nbr);
+		/* Save the index retrieved from LMAC */
+		spin_lock_bh(&vif->rwnx_hw->cb_lock);
+		vif->vif_index =3D add_if_cfm.inst_nbr;
+		vif->rwnx_hw->vif_table[add_if_cfm.inst_nbr] =3D vif;
+		spin_unlock_bh(&vif->rwnx_hw->cb_lock);
+	}
+
+	return 0;
+}
