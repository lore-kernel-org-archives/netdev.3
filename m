+int rwnx_ic_system_init(struct rwnx_hw *rwnx_hw)
+{
+	u32 mem_addr;
+	struct dbg_mem_read_cfm rd_mem_addr_cfm;
+
+	mem_addr =3D 0x40500000;
+
+	if (rwnx_send_dbg_mem_read_req(rwnx_hw, mem_addr, &rd_mem_addr_cfm))
+		return -1;
+
+	chip_id =3D (u8)(rd_mem_addr_cfm.memdata >> 16);
+
+	if (rwnx_send_dbg_mem_read_req(rwnx_hw, 0x00000020, &rd_mem_addr_cfm)) {
+		AICWFDBG(LOGERROR, "[0x00000020] rd fail\n");
+		return -1;
+	}
+	chip_sub_id =3D (u8)(rd_mem_addr_cfm.memdata);
+
+	AICWFDBG(LOGINFO, "FDRV chip_id=3D%x, chip_sub_id=3D%x!!\n", chip_id,
+		 chip_sub_id);
+
+#ifdef CONFIG_OOB
+	if (rwnx_hw->sdiodev->chipid =3D=3D PRODUCT_ID_AIC8800D80) {
+		u32 memdata_temp =3D 0x00000006;
+		int ret;
+
+		ret =3D rwnx_send_dbg_mem_block_write_req(rwnx_hw, 0x40504084, 4,
+							&memdata_temp);
+		if (ret) {
+			AICWFDBG(LOGERROR, "[0x40504084] write fail: %d\n", ret);
+			return -1;
+		}
+
+		ret =3D rwnx_send_dbg_mem_read_req(rwnx_hw, 0x40504084, &rd_mem_addr_cfm=
);
+		if (ret) {
+			AICWFDBG(LOGERROR, "[0x40504084] rd fail\n");
+			return -1;
+		}
+		AICWFDBG(LOGINFO, "rd [0x40504084] =3D %x\n", rd_mem_addr_cfm.memdata);
+	}
+#endif
+
+	if (rwnx_platform_on(rwnx_hw, NULL))
+		return -1;
+	return 0;
+}
