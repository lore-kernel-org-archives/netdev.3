+static int gpon_wait_bits(struct xpon_priv *priv, u32 reg, u32 mask,
+              unsigned int timeout_us)
+{
+    u32 val;
+
+    return readl_poll_timeout_atomic(priv->gpon_reg + reg, val, val & mask,
+                      1, timeout_us);
