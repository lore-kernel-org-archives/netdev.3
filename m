+/* return val: 0 for not filter, 1 for filter */
+int filter_send_tcp_ack(struct rwnx_hw *priv, struct msg_buf *msgbuf,
+			unsigned char *buf, unsigned int plen)
+{
+	int ret =3D 0;
+	int index, drop;
+	unsigned short win_scale =3D 0;
+	unsigned int win =3D 0;
+	struct tcp_ack_msg ack_msg;
+	struct tcp_ack_msg *ack;
+	struct tcp_ack_info *ack_info;
+	struct tcp_ack_manage *ack_m =3D &priv->ack_m;
+
+	tcp_ack_update(ack_m);
+	drop =3D tcp_check_ack(buf, &ack_msg, &win_scale);
+	// printk("AICWF drop:%d win_scale:%d",drop,win_scale); /* debug trace */
+	if (!drop && win_scale =3D=3D 0)
+		return 0;
+
+	index =3D tcp_ack_match(ack_m, &ack_msg);
+	if (index >=3D 0) {
+		ack_info =3D ack_m->ack_info + index;
+		if (win_scale !=3D 0 && ack_info->win_scale !=3D win_scale) {
+			write_seqlock_bh(&ack_info->seqlock);
+			ack_info->win_scale =3D win_scale;
+			write_sequnlock_bh(&ack_info->seqlock);
+		}
+
+		if (drop > 0 && atomic_read(&ack_m->enable)) {
+			win =3D ack_info->win_scale * ack_msg.win;
+			if (win_scale !=3D 0 && (win < (ack_m->ack_winsize * SIZE_KB))) {
+				drop =3D 2;
+				pr_info("AICWF %d %d %d", win_scale, win,
+					(ack_m->ack_winsize * SIZE_KB));
+			}
+			ret =3D tcp_ack_handle_new(msgbuf, ack_m, ack_info, &ack_msg, drop);
+		}
+
+		goto out;
+	}
+
+	index =3D tcp_ack_alloc_index(ack_m);
+	if (index >=3D 0) {
+		write_seqlock_bh(&ack_m->ack_info[index].seqlock);
+		ack_m->ack_info[index].busy =3D 1;
+		ack_m->ack_info[index].psh_flag =3D 0;
+		ack_m->ack_info[index].last_time =3D jiffies;
+		ack_m->ack_info[index].drop_cnt =3D atomic_read(&ack_m->max_drop_cnt);
+		ack_m->ack_info[index].win_scale =3D (win_scale !=3D 0) ? win_scale : 1;
+
+		ack =3D &ack_m->ack_info[index].ack_msg;
+		ack->dest =3D ack_msg.dest;
+		ack->source =3D ack_msg.source;
+		ack->saddr =3D ack_msg.saddr;
+		ack->daddr =3D ack_msg.daddr;
+		ack->seq =3D ack_msg.seq;
+		write_sequnlock_bh(&ack_m->ack_info[index].seqlock);
+	}
+
+out:
+	return ret;
+}
