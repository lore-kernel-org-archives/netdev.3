+		return -1;
+	}
+
+	if (aicbsp_sdiodev->chipid =3D=3D PRODUCT_ID_AIC8801 ||
+	    aicbsp_sdiodev->chipid =3D=3D PRODUCT_ID_AIC8800DC ||
+		aicbsp_sdiodev->chipid =3D=3D PRODUCT_ID_AIC8800DW) {
+		feature->sdio_clock =3D FEATURE_SDIO_CLOCK;
+	} else if (aicbsp_sdiodev->chipid =3D=3D PRODUCT_ID_AIC8800D80) {
+		feature->sdio_clock =3D FEATURE_SDIO_CLOCK_V3;
+	}
+	feature->sdio_phase =3D FEATURE_SDIO_PHASE;
+	feature->cpmode =3D aicbsp_info.cpmode;
+	feature->adapt =3D aicbsp_info.adap_test;
+	feature->hwinfo =3D aicbsp_info.hwinfo;
+	feature->fwlog_en =3D aicbsp_info.fwlog_en;
+	feature->irqf =3D aicbsp_info.irqf;
+	if (fw_path)
+		sprintf(fw_path, "%s", AICBSP_FW_PATH);
