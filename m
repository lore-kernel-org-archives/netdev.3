+static struct sk_buff *aic_dequeue(struct hci_uart *hu)
+{
+	struct aic_data *aic =3D hu->priv;
+	struct sk_buff *skb =3D NULL;
+	struct aic_device *bdev =3D NULL;
+
+	mutex_lock(&aic_device_lock);
+
+	if (aic_device_exists(aic->dev)) {
+		bdev =3D aic->dev;
+		pm_runtime_get_sync(bdev->dev);
+		/* Shall be resumed here */
+	}
+
+	skb =3D skb_dequeue(&aic->txq);
+
+	if (bdev) {
+		pm_runtime_mark_last_busy(bdev->dev);
+		pm_runtime_put_autosuspend(bdev->dev);
+	}
+
+	mutex_unlock(&aic_device_lock);
+
+	return skb;
+}
+
+#ifdef CONFIG_PM
+static int aic_suspend_device(struct device *dev)
+{
+	struct aic_device *bdev =3D dev_get_drvdata(dev);
+	int err;
+
+	bt_dev_dbg(bdev, "");
+
+	if (!bdev->is_suspended && bdev->hu) {
+		aic_hci_uart_set_flow_control(bdev->hu, true);
+
+		/* Once this returns, driver suspends BT via GPIO */
+		bdev->is_suspended =3D true;
+	}
+
+	/* Suspend the device */
+	err =3D bdev->set_device_wakeup(bdev, false);
+	if (err) {
+		if (bdev->is_suspended && bdev->hu) {
+			bdev->is_suspended =3D false;
+			aic_hci_uart_set_flow_control(bdev->hu, false);
+		}
+		return -EBUSY;
+	}
+
+	bt_dev_dbg(bdev, "suspend, delaying 15 ms");
+	msleep(20);
+
+	return 0;
+}
+
+static int aic_resume_device(struct device *dev)
+{
+	struct aic_device *bdev =3D dev_get_drvdata(dev);
+	int err;
+
+	bt_dev_dbg(bdev, "");
+
+	err =3D bdev->set_device_wakeup(bdev, true);
+	if (err) {
+		dev_err(dev, "Failed to power up\n");
+		return err;
+	}
+
+	bt_dev_dbg(bdev, "resume, delaying 15 ms");
+	msleep(20);
+
+	/* When this executes, the device has woken up already */
+	if (bdev->is_suspended && bdev->hu) {
+		bdev->is_suspended =3D false;
+
+		aic_hci_uart_set_flow_control(bdev->hu, false);
+	}
+
+	return 0;
+}
+#endif
+
+#ifdef CONFIG_PM_SLEEP
+/* suspend callback */
+static int aic_suspend(struct device *dev)
+{
+	struct aic_device *bdev =3D dev_get_drvdata(dev);
+	int error;
+
+	bt_dev_dbg(bdev, "suspend: is_suspended %d", bdev->is_suspended);
+
+	/*
+	 * When used with a device instantiated as platform_device, aic_suspend
+	 * can be called at any time as long as the platform device is bound,
+	 * so it should use aic_device_lock to protect access to hci_uart
+	 * and device_wake-up GPIO.
+	 */
+	mutex_lock(&aic_device_lock);
+
+	if (!bdev->hu)
+		goto unlock;
+
+	if (pm_runtime_active(dev))
+		aic_suspend_device(dev);
+
+	if (device_may_wakeup(dev) && bdev->irq > 0) {
+		error =3D enable_irq_wake(bdev->irq);
+		if (!error)
+			bt_dev_dbg(bdev, "AIC irq: enabled");
+	}
+
+unlock:
+	mutex_unlock(&aic_device_lock);
+
+	return 0;
+}
+
+/* resume callback */
+static int aic_resume(struct device *dev)
+{
+	struct aic_device *bdev =3D dev_get_drvdata(dev);
+	int err =3D 0;
+
+	bt_dev_dbg(bdev, "resume: is_suspended %d", bdev->is_suspended);
+
+	/*
+	 * When used with a device instantiated as platform_device, aic_resume
+	 * can be called at any time as long as platform device is bound,
+	 * so it should use aic_device_lock to protect access to hci_uart
+	 * and device_wake-up GPIO.
+	 */
+	mutex_lock(&aic_device_lock);
+
+	if (!bdev->hu)
+		goto unlock;
+
+	if (device_may_wakeup(dev) && bdev->irq > 0) {
+		disable_irq_wake(bdev->irq);
+		bt_dev_dbg(bdev, "AIC irq: disabled");
+	}
+
+	err =3D aic_resume_device(dev);
+
+unlock:
+	mutex_unlock(&aic_device_lock);
+
+	if (!err) {
+		pm_runtime_disable(dev);
+		pm_runtime_set_active(dev);
+		pm_runtime_enable(dev);
+	}
+
+	return 0;
+}
+#endif
