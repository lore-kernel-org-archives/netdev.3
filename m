+static inline char *aicwf_get_iwe_stream_wpa_wpa2(struct rwnx_hw *rwnx_hw,
+						  struct iw_request_info *info,
+						  struct scanu_result_wext *scan_re,
+						  char *start, char *stop,
+						  struct iw_event *iwe)
+{
+	struct ieee80211_mgmt *mgmt =3D (struct ieee80211_mgmt *)scan_re->payload=
;
+	u8 *payload =3D mgmt->u.beacon.variable;
+	int buf_size =3D MAX_WPA_IE_LEN * 2;
+	u8 *pbuf;
+
+	u8 wpa_ie[255] =3D {0}, rsn_ie[255] =3D {0};
+	u16 i, wpa_len =3D 0, rsn_len =3D 0;
+	u8 *p;
+	int out_len =3D 0;
+
+	pbuf =3D vmalloc(sizeof(u8) * buf_size);
+
+	if (pbuf) {
+		p =3D pbuf;
+
+		/* parsing WPA/WPA2 IE */
+			out_len =3D aic_get_sec_ie(payload,
+						 scan_re->ind->length,
+						 rsn_ie, &rsn_len,
+						 wpa_ie, &wpa_len);
+
+			if (wpa_len > 0) {
+				memset(pbuf, 0, buf_size);
+				p +=3D sprintf(p, "wpa_ie=3D");
+				for (i =3D 0; i < wpa_len; i++)
+					p +=3D sprintf(p, "%02x", wpa_ie[i]);
+
+				if (wpa_len > 100) {
+					pr_info("-----------------Len %d----------------\n",
+						wpa_len);
+					for (i =3D 0; i < wpa_len; i++)
+						pr_info("%02x ", wpa_ie[i]);
+					pr_info("\n");
+					pr_info("-----------------Len %d----------------\n",
+						wpa_len);
+				}
+
+				memset(iwe, 0, sizeof(*iwe));
+				iwe->cmd =3D IWEVCUSTOM;
+				iwe->u.data.length =3D strlen(pbuf);
+				start =3D iwe_stream_add_point(info, start, stop, iwe, pbuf);
+
+				memset(iwe, 0, sizeof(*iwe));
+				iwe->cmd =3D IWEVGENIE;
+				iwe->u.data.length =3D wpa_len;
+				start =3D iwe_stream_add_point(info, start, stop, iwe, wpa_ie);
+			}
+			if (rsn_len > 0) {
+				memset(pbuf, 0, buf_size);
+				p +=3D sprintf(p, "rsn_ie=3D");
+				for (i =3D 0; i < rsn_len; i++)
+					p +=3D sprintf(p, "%02x", rsn_ie[i]);
+				memset(iwe, 0, sizeof(*iwe));
+				iwe->cmd =3D IWEVCUSTOM;
+				iwe->u.data.length =3D strlen(pbuf);
+				start =3D iwe_stream_add_point(info, start, stop, iwe, pbuf);
+
+				memset(iwe, 0, sizeof(*iwe));
+				iwe->cmd =3D IWEVGENIE;
+				iwe->u.data.length =3D rsn_len;
+				start =3D iwe_stream_add_point(info, start, stop, iwe, rsn_ie);
+			}
+
+		vfree(pbuf);
+	}
+	return start;
+}
