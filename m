+static int aic_recv(struct hci_uart *hu, const void *data, int count)
+{
+	struct aic_data *aic =3D hu->priv;
+
+	if (!test_bit(HCI_UART_REGISTERED, &hu->flags))
+		return -EUNATCH;
+
+	aic->rx_skb =3D aic_h4_recv_buf(hu->hdev, aic->rx_skb, data, count,
+				      aic_recv_pkts, ARRAY_SIZE(aic_recv_pkts));
+	if (IS_ERR(aic->rx_skb)) {
+		int err =3D PTR_ERR(aic->rx_skb);
+
+		bt_dev_err(hu->hdev, "Frame reassembly failed (%d)", err);
+		aic->rx_skb =3D NULL;
+		return err;
+	} else if (!aic->rx_skb) {
+		/* Delay auto-suspend when receiving completed packet */
+		mutex_lock(&aic_device_lock);
+		if (aic->dev && aic_device_exists(aic->dev)) {
+			pm_runtime_get(aic->dev->dev);
+			pm_runtime_mark_last_busy(aic->dev->dev);
+			pm_runtime_put_autosuspend(aic->dev->dev);
+		}
+		mutex_unlock(&aic_device_lock);
+	}
+
+	return count;
+}
