+static int parse_line(char *line, char *argv[])
+{
+	int nargs =3D 0;
+
+	while (nargs < CMD_MAXARGS) {
+		/* skip any white space */
+		while ((*line =3D=3D ' ') || (*line =3D=3D '\t'))
+			++line;
+
+		if (*line =3D=3D '\0') { /* end of line, no more args    */
+			argv[nargs] =3D 0;
+			return nargs;
+		}
+
+		/* Argument include space should be bracketed by quotation mark */
+		if (*line =3D=3D '\"') {
+			/* Skip quotation mark */
+			line++;
+
+			/* Begin of argument string */
+			argv[nargs++] =3D line;
+
+			/* Until end of argument */
+			while (*line && (*line !=3D '\"'))
+				++line;
+		} else {
+			argv[nargs++] =3D line; /* begin of argument string    */
+
+			/* find end of string */
+			while (*line && (*line !=3D ' ') && (*line !=3D '\t'))
+				++line;
+		}
+
+		if (*line =3D=3D '\0') { /* end of line, no more args    */
+			argv[nargs] =3D 0;
+			return nargs;
+		}
+
+		*line++ =3D '\0'; /* terminate current arg     */
+	}
+
+	pr_info("** Too many args (max. %d) **\n", CMD_MAXARGS);
+
+	return nargs;
+}
