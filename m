+		if (btenable =3D=3D 0) {
+			sdiodev->chipid =3D PRODUCT_ID_AIC8800DW;
+			AICWFDBG(LOGINFO, "AIC8800DC change to AIC8800DW\n");
+		}
+
+		if (aicbsp_info.chip_rev !=3D CHIP_REV_U01 &&
+		    aicbsp_info.chip_rev !=3D CHIP_REV_U02 &&
+			aicbsp_info.chip_rev !=3D CHIP_REV_U03 &&
