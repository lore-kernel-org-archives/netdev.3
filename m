+static ssize_t rwnx_dbgfs_txq_read(struct file *file, char __user *user_bu=
f,
+				   size_t count, loff_t *ppos)
+{
+	struct rwnx_hw *rwnx_hw =3D file->private_data;
+	struct rwnx_vif *vif;
+	char *buf;
+	int idx, res;
+	ssize_t read;
+	size_t bufsz =3D
+		((NX_VIRT_DEV_MAX * (VIF_HDR_MAX_LEN + 2 * VIF_SEP_LEN)) +
+		 (NX_REMOTE_STA_MAX * STA_HDR_MAX_LEN) +
+		 ((NX_REMOTE_STA_MAX + NX_VIRT_DEV_MAX + NX_NB_TXQ) * TXQ_HDR_MAX_LEN) +
+		 CAPTION_LEN);
+
+	/* everything is read in one go */
+	if (*ppos)
+		return 0;
+
+	bufsz =3D min_t(size_t, bufsz, count);
+	buf =3D kmalloc(bufsz, GFP_ATOMIC);
+	if (!buf)
+		return 0;
+
+	bufsz--;
+	idx =3D 0;
+
+	res =3D scnprintf(&buf[idx], bufsz, CAPTION);
+	idx +=3D res;
+	bufsz -=3D res;
+
+	// spin_lock_bh(&rwnx_hw->tx_lock);
+	list_for_each_entry(vif, &rwnx_hw->vifs, list) {
+		res =3D scnprintf(&buf[idx], bufsz, "\n" VIF_SEP);
+		idx +=3D res;
+		bufsz -=3D res;
+		res =3D rwnx_dbgfs_txq_vif(&buf[idx], bufsz, vif, rwnx_hw);
+		idx +=3D res;
+		bufsz -=3D res;
+		res =3D scnprintf(&buf[idx], bufsz, VIF_SEP);
+		idx +=3D res;
+		bufsz -=3D res;
+	}
+	// spin_unlock_bh(&rwnx_hw->tx_lock);
+
+	read =3D simple_read_from_buffer(user_buf, count, ppos, buf, idx);
+	kfree(buf);
+
+	return read;
+}
