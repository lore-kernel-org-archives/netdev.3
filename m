+/**
+ * @del_station: Remove a station
+ */
+static int rwnx_cfg80211_del_station_compat(struct wiphy *wiphy,
+					    struct net_device *dev,
+					    struct station_del_parameters *params)
+{
+	struct rwnx_hw *rwnx_hw =3D wiphy_priv(wiphy);
+	struct rwnx_vif *rwnx_vif =3D netdev_priv(dev);
+	struct rwnx_sta *cur, *tmp;
+	int error =3D 0, found =3D 0;
+	const u8 *mac =3D NULL;
+#ifdef AICWF_RX_REORDER
+	struct reord_ctrl_info *reord_info, *reord_tmp;
+	u8 *macaddr;
+	struct aicwf_rx_priv *rx_priv;
+#endif
+	AICWFDBG(LOGDEBUG, "AICWF %s: %pM\n", __func__, mac);
+
+	if (params)
+		mac =3D params->mac;
+
+	do {
+		spin_lock_bh(&rwnx_hw->cb_lock);
+		if (list_empty(&rwnx_vif->ap.sta_list)) {
+			spin_unlock_bh(&rwnx_hw->cb_lock);
+			break;
+		}
+
+		list_for_each_entry_safe(cur, tmp, &rwnx_vif->ap.sta_list, list) {
+			if (!mac || !memcmp(cur->mac_addr, mac, ETH_ALEN)) {
+				found =3D 1;
+				break;
+			}
+		}
+
+		if (found) {
+			cur->ps.active =3D false;
+			cur->valid =3D false;
+			list_del(&cur->list);
+		}
+		spin_unlock_bh(&rwnx_hw->cb_lock);
+
+		if (found) {
+			netdev_info(dev, "Del sta %d (%pM)", cur->sta_idx, cur->mac_addr);
+			if (cur->vif_idx !=3D cur->vlan_idx) {
+				struct rwnx_vif *vlan_vif;
+
+				vlan_vif =3D rwnx_hw->vif_table[cur->vlan_idx];
+				if (vlan_vif->up) {
+					if (RWNX_VIF_TYPE(vlan_vif) =3D=3D NL80211_IFTYPE_AP_VLAN &&
+					    vlan_vif->use_4addr) {
+						vlan_vif->ap_vlan.sta_4a =3D NULL;
+					} else {
+						WARN(1,
+						     "Deleting sta belonging to VLAN other than AP_VLAN 4A");
+					}
+				}
+			}
+			if (rwnx_vif->wdev.iftype =3D=3D NL80211_IFTYPE_AP ||
+			    rwnx_vif->wdev.iftype =3D=3D NL80211_IFTYPE_P2P_GO) {
+				cfg80211_del_sta(rwnx_vif->ndev, cur->mac_addr, GFP_KERNEL);
+			}
+
+#ifdef AICWF_RX_REORDER
+#ifdef AICWF_SDIO_SUPPORT
+			rx_priv =3D rwnx_hw->sdiodev->rx_priv;
+#else
+			rx_priv =3D rwnx_hw->usbdev->rx_priv;
+#endif
+			if (rwnx_vif->wdev.iftype =3D=3D NL80211_IFTYPE_STATION ||
+			    rwnx_vif->wdev.iftype =3D=3D NL80211_IFTYPE_P2P_CLIENT) {
+				//WARN_ON_ONCE(); // should be other function
+			} else if (rwnx_vif->wdev.iftype =3D=3D NL80211_IFTYPE_AP ||
+				   rwnx_vif->wdev.iftype =3D=3D NL80211_IFTYPE_P2P_GO) {
+				macaddr =3D cur->mac_addr;
+				AICWFDBG(LOGDEBUG, "AICWF deinit:macaddr:%x,%x,%x,%x,%x,%x\r\n",
+					 macaddr[0], macaddr[1], macaddr[2],
+					 macaddr[3], macaddr[4], macaddr[5]);
+				spin_lock_bh(&rx_priv->stas_reord_lock);
+				list_for_each_entry_safe(reord_info, reord_tmp,
+							 &rx_priv->stas_reord_list, list) {
+					AICWFDBG(LOGDEBUG, "AICWF reord_mac:%x,%x,%x,%x,%x,%x\r\n",
+						 reord_info->mac_addr[0], reord_info->mac_addr[1],
+						 reord_info->mac_addr[2], reord_info->mac_addr[3],
+						 reord_info->mac_addr[4], reord_info->mac_addr[5]);
+					if (!memcmp(reord_info->mac_addr, macaddr, 6)) {
+						reord_deinit_sta(rx_priv, reord_info);
+						break;
+					}
+				}
+				spin_unlock_bh(&rx_priv->stas_reord_lock);
+			}
+#endif
+			rwnx_txq_sta_deinit(rwnx_hw, cur);
+			error =3D rwnx_send_me_sta_del(rwnx_hw, cur->sta_idx, false);
+			if (error !=3D 0 && error !=3D -EPIPE)
+				return error;
+
+#ifdef CONFIG_RWNX_BFMER
+			// Disable Beamformer if supported
+			rwnx_bfmer_report_del(rwnx_hw, cur);
+			rwnx_mu_group_sta_del(rwnx_hw, cur);
+#endif /* CONFIG_RWNX_BFMER */
+
+#ifdef CONFIG_RWNX_DEBUGFS
+			rwnx_dbgfs_unregister_rc_stat(rwnx_hw, cur);
+#endif
+		}
+
+		if (mac)
+			break;
+	} while (1);
+
+	rwnx_update_mesh_power_mode(rwnx_vif);
+
+	if (!found && mac)
+		return -ENOENT;
+	else
+		return 0;
+}
