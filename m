+static int hci_reassembly(struct hci_dev *hdev, int type, void *data, int =
count,
+			  __u8 index)
+{
+	int len =3D 0;
+	int hlen =3D 0;
+	int remain =3D count;
+	struct sk_buff *skb;
+	struct bt_skb_cb *scb;
+
+	if ((type < HCI_ACLDATA_PKT || type > HCI_EVENT_PKT) ||
+	    index >=3D NUM_REASSEMBLY)
+		return -EILSEQ;
+
+	skb =3D hdev->reassembly[index];
+
+	if (!skb) {
+		switch (type) {
+		case HCI_ACLDATA_PKT:
+			len =3D HCI_MAX_FRAME_SIZE;
+			hlen =3D HCI_ACL_HDR_SIZE;
+			break;
+		case HCI_EVENT_PKT:
+			len =3D HCI_MAX_EVENT_SIZE;
+			hlen =3D HCI_EVENT_HDR_SIZE;
+			break;
+		case HCI_SCODATA_PKT:
+			len =3D HCI_MAX_SCO_SIZE;
+			hlen =3D HCI_SCO_HDR_SIZE;
+			break;
+		}
+
+		skb =3D bt_skb_alloc(len, GFP_ATOMIC);
+		if (!skb)
+			return -ENOMEM;
+
+		scb =3D (void *)skb->cb;
+		scb->expect =3D hlen;
+		scb->pkt_type =3D type;
+
+		skb->dev =3D (void *)hdev;
+		hdev->reassembly[index] =3D skb;
+	}
+
+	while (count) {
+		scb =3D (void *)skb->cb;
+		len =3D min_t(uint, scb->expect, count);
+
+		memcpy(skb_put(skb, len), data, len);
+
+		count -=3D len;
+		data +=3D len;
+		scb->expect -=3D len;
+		remain =3D count;
+
+		switch (type) {
+		case HCI_EVENT_PKT:
+			if (skb->len =3D=3D HCI_EVENT_HDR_SIZE) {
+				struct hci_event_hdr *h =3D hci_event_hdr(skb);
+
+				scb->expect =3D h->plen;
+
+				if (skb_tailroom(skb) < scb->expect) {
+					kfree_skb(skb);
+					hdev->reassembly[index] =3D NULL;
+					return -ENOMEM;
+				}
+			}
+			break;
+
+		case HCI_ACLDATA_PKT:
+			if (skb->len =3D=3D HCI_ACL_HDR_SIZE) {
+				struct hci_acl_hdr *h =3D hci_acl_hdr(skb);
+
+				scb->expect =3D __le16_to_cpu(h->dlen);
+
+				if (skb_tailroom(skb) < scb->expect) {
+					kfree_skb(skb);
+					hdev->reassembly[index] =3D NULL;
+					return -ENOMEM;
+				}
+			}
+			break;
+
+		case HCI_SCODATA_PKT:
+			if (skb->len =3D=3D HCI_SCO_HDR_SIZE) {
+				struct hci_sco_hdr *h =3D hci_sco_hdr(skb);
+
+				scb->expect =3D h->dlen;
+
+				if (skb_tailroom(skb) < scb->expect) {
+					kfree_skb(skb);
+					hdev->reassembly[index] =3D NULL;
+					return -ENOMEM;
+				}
+			}
+			break;
+		}
+
+		if (scb->expect =3D=3D 0) {
+			/* Complete frame */
+			if (type =3D=3D HCI_ACLDATA_PKT)
+				print_acl(skb, 0);
+			if (type =3D=3D HCI_SCODATA_PKT)
+				print_sco(skb, 0);
+			if (type =3D=3D HCI_EVENT_PKT)
+				print_event(skb);
+
+			bt_cb(skb)->pkt_type =3D type;
+			hci_recv_frame(skb);
+
+			hdev->reassembly[index] =3D NULL;
+			return remain;
+		}
+	}
+
+	return remain;
+}
