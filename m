+static int print_rate_from_cfg(char *buf, int size, u32 rate_config, int *=
r_idx,
+			       int ru_size)
+{
+	union rwnx_rate_ctrl_info *r_cfg =3D
+		(union rwnx_rate_ctrl_info *)&rate_config;
+	union rwnx_mcs_index *mcs_index =3D (union rwnx_mcs_index *)&rate_config;
+	unsigned int ft, pre, gi, bw, nss, mcs, len;
+
+	ft =3D r_cfg->format_mod_tx;
+	pre =3D r_cfg->gi_and_pre_type_tx >> 1;
+	gi =3D r_cfg->gi_and_pre_type_tx;
+	bw =3D r_cfg->bw_tx;
+
+	if (ft =3D=3D FORMATMOD_HE_MU) {
+		mcs =3D mcs_index->he.mcs;
+		nss =3D mcs_index->he.nss;
+		bw =3D ru_size;
+	} else if (ft =3D=3D FORMATMOD_HE_SU) {
+		mcs =3D mcs_index->he.mcs;
+		nss =3D mcs_index->he.nss;
+	} else if (ft =3D=3D FORMATMOD_VHT) {
+		mcs =3D mcs_index->vht.mcs;
+		nss =3D mcs_index->vht.nss;
+	} else if (ft >=3D FORMATMOD_HT_MF) {
+		mcs =3D mcs_index->ht.mcs;
+		nss =3D mcs_index->ht.nss;
+	} else {
+		mcs =3D mcs_index->legacy;
+		nss =3D 0;
+	}
+
+	len =3D print_rate(buf, size, ft, nss, mcs, bw, gi, pre, r_idx);
+	return len;
+}
