+	RWNX_DBG("Trident path mapping is: %d\n", config->trd.path_mapping);
+
+	/* Get DC offset compensation */
+	tag_ptr =3D rwnx_find_tag(config_fw->data, config_fw->size,
+				"TX_DC_OFF_COMP=3D", strlen("00000000"));
+	if (tag_ptr) {
