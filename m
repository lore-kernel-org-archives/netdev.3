+static int aicwf_vendor_start_mkeep_alive(struct wiphy *wiphy,
+					  struct wireless_dev *wdev,
+					  const void *data, int len)
+{
+	/* max size of IP packet for keep alive */
+	const int MKEEP_ALIVE_IP_PKT_MAX =3D 256;
+
+	int ret =3D 0, rem, type;
+	u8 mkeep_alive_id =3D 0;
+	u8 *ip_pkt =3D NULL;
+	u16 ip_pkt_len =3D 0;
+	u8 src_mac[6];
+	u8 dst_mac[6];
+	u32 period_msec =3D 0;
+	const struct nlattr *iter;
+	struct rwnx_hw *rwnx_hw =3D wiphy_priv(wiphy);
+	struct rwnx_vif *rwnx_vif =3D container_of(wdev, struct rwnx_vif, wdev);
+	gfp_t kflags =3D in_interrupt() ? GFP_ATOMIC : GFP_KERNEL;
+
+	nla_for_each_attr(iter, data, len, rem) {
+		type =3D nla_type(iter);
+		switch (type) {
+		case MKEEP_ALIVE_ATTRIBUTE_ID:
+			mkeep_alive_id =3D nla_get_u8(iter);
+			break;
+		case MKEEP_ALIVE_ATTRIBUTE_IP_PKT_LEN:
+			ip_pkt_len =3D nla_get_u16(iter);
+			if (ip_pkt_len > MKEEP_ALIVE_IP_PKT_MAX) {
+				ret =3D -EINVAL;
+				goto exit;
+			}
+			break;
+		case MKEEP_ALIVE_ATTRIBUTE_IP_PKT:
+			if (!ip_pkt_len) {
+				ret =3D -EINVAL;
+				pr_err("ip packet length is 0\n");
+				goto exit;
+			}
+			ip_pkt =3D kzalloc(ip_pkt_len, kflags);
+			if (!ip_pkt) {
+				ret =3D -ENOMEM;
+				pr_err("Failed to allocate mem for ip packet\n");
+				goto exit;
+			}
+			memcpy(ip_pkt, (u8 *)nla_data(iter), ip_pkt_len);
+			break;
+		case MKEEP_ALIVE_ATTRIBUTE_SRC_MAC_ADDR:
+			memcpy(src_mac, nla_data(iter), 6);
+			break;
+		case MKEEP_ALIVE_ATTRIBUTE_DST_MAC_ADDR:
+			memcpy(dst_mac, nla_data(iter), 6);
+			break;
+		case MKEEP_ALIVE_ATTRIBUTE_PERIOD_MSEC:
+			period_msec =3D nla_get_u32(iter);
+			break;
+		default:
+			pr_err("%s(%d), Unknown type: %d\n", __func__, __LINE__, type);
+			ret =3D -EINVAL;
+			goto exit;
+		}
+	}
+
+	if (!ip_pkt) {
+		ret =3D -EINVAL;
+		pr_err("ip packet is NULL\n");
+		goto exit;
+	}
+
+	ret =3D aic_dev_start_mkeep_alive(rwnx_hw, rwnx_vif, mkeep_alive_id, ip_p=
kt,
+					ip_pkt_len, src_mac, dst_mac, period_msec);
+	if (ret < 0)
+		pr_err("start_mkeep_alive is failed ret: %d\n", ret);
+
+exit:
+	kfree(ip_pkt);
+
+	return ret;
+}
