+/* return val: 0 for not handle tx, 1 for handle tx */
+int tcp_ack_handle(struct msg_buf *new_msgbuf, struct tcp_ack_manage *ack_=
m,
+		   struct tcp_ack_info *ack_info, struct tcp_ack_msg *ack_msg,
+				   int type)
+{
+	int quick_ack =3D 0;
+	struct tcp_ack_msg *ack;
+	int ret =3D 0;
+	struct msg_buf *drop_msg =3D NULL;
+
+	write_seqlock_bh(&ack_info->seqlock);
+
+	ack_info->last_time =3D jiffies;
+	ack =3D &ack_info->ack_msg;
+
+	if (type =3D=3D 2) {
+		if (U32_BEFORE(ack->seq, ack_msg->seq)) {
+			ack->seq =3D ack_msg->seq;
+			if (ack_info->psh_flag &&
+			    !U32_BEFORE(ack_msg->seq, ack_info->psh_seq)) {
+				ack_info->psh_flag =3D 0;
+			}
+
+			if (ack_info->msgbuf) {
+				drop_msg =3D ack_info->msgbuf;
+				ack_info->msgbuf =3D NULL;
+				del_timer(&ack_info->timer);
+			} else {
+				/* debug trace */
+				// printk("AICWF msgbuf is NULL\n");
+			}
+
+			ack_info->in_send_msg =3D NULL;
+			ack_info->drop_cnt =3D atomic_read(&ack_m->max_drop_cnt);
+		} else {
+			pr_info("AICWF %s before abnormal ack: %d, %d\n", __func__, ack->seq,
+				ack_msg->seq);
+			drop_msg =3D new_msgbuf;
+			ret =3D 1;
+		}
+	} else if (U32_BEFORE(ack->seq, ack_msg->seq)) {
+		if (ack_info->msgbuf) {
+			drop_msg =3D ack_info->msgbuf;
+			ack_info->msgbuf =3D NULL;
+		}
+
+		if (ack_info->psh_flag &&
+		    !U32_BEFORE(ack_msg->seq, ack_info->psh_seq)) {
+			ack_info->psh_flag =3D 0;
+			quick_ack =3D 1;
+		} else {
+			ack_info->drop_cnt++;
+		}
+
+		ack->seq =3D ack_msg->seq;
+
+		if (quick_ack ||
+		    (!ack_info->in_send_msg &&
+			 ack_info->drop_cnt >=3D atomic_read(&ack_m->max_drop_cnt))) {
+			ack_info->drop_cnt =3D 0;
+			ack_info->in_send_msg =3D new_msgbuf;
+			del_timer(&ack_info->timer);
+		} else {
+			ret =3D 1;
+			ack_info->msgbuf =3D new_msgbuf;
+			if (!timer_pending(&ack_info->timer))
+				mod_timer(&ack_info->timer, (jiffies + msecs_to_jiffies(5)));
+		}
+	} else {
+		pr_info("AICWF %s before ack: %d, %d\n", __func__, ack->seq, ack_msg->se=
q);
+		drop_msg =3D new_msgbuf;
+		ret =3D 1;
+	}
+
+	write_sequnlock_bh(&ack_info->seqlock);
+
+	if (drop_msg)
+		intf_tcp_drop_msg(ack_m->priv, drop_msg); // drop skb
+
+	return ret;
+}
