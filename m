+	err =3D hci_register_dev(hu->hdev);
+	if (err < 0) {
+		BT_ERR("Can't register HCI device");
+		clear_bit(HCI_UART_PROTO_READY, &hu->flags);
+		hu->proto->close(hu);
+		hdev =3D hu->hdev;
+		hu->hdev =3D NULL;
+		hci_free_dev(hdev);
+		return;
+	}
+
+	set_bit(HCI_UART_REGISTERED, &hu->flags);
+}
