+void rwnx_get_countrycode_channels(struct wiphy *wiphy,
+				   struct ieee80211_regdomain *regdomain)
+{
+	enum nl80211_band band;
+	struct ieee80211_supported_band *sband;
+	int channel_index;
+	int rule_index;
+	int band_num =3D 0;
+	int rule_num =3D regdomain->n_reg_rules;
+	int start_freq =3D 0;
+	int end_freq =3D 0;
+	int center_freq =3D 0;
+	char channel[4];
+#ifdef CONFIG_USE_WIRELESS_EXT
+	struct rwnx_hw *rwnx_hw =3D wiphy_priv(wiphy);
+	int support_freqs_counter =3D 0;
+#endif
+
+	band_num =3D NUM_NL80211_BANDS;
+
+	memset(ccode_channels, 0, 200);
+	index_for_channel_list =3D 0;
+
+	for (band =3D 0; band < band_num; band++) {
+		sband =3D wiphy->bands[band]; // bands: 0:2.4G 1:5G 2:60G
+		if (!sband)
+			continue;
+
+		for (channel_index =3D 0; channel_index < sband->n_channels;
+			 channel_index++) {
+			for (rule_index =3D 0; rule_index < rule_num; rule_index++) {
+				start_freq =3D
+				regdomain->reg_rules[rule_index].freq_range.start_freq_khz / 1000;
+				end_freq =3D
+				regdomain->reg_rules[rule_index].freq_range.end_freq_khz / 1000;
+				center_freq =3D sband->channels[channel_index].center_freq;
+				if ((center_freq - 10) >=3D start_freq &&
+				    (center_freq + 10) <=3D end_freq) {
+#ifdef CONFIG_USE_WIRELESS_EXT
+					rwnx_hw->support_freqs[support_freqs_counter++] =3D
+						center_freq;
+#endif
+					sprintf(channel, "%d",
+						ieee80211_frequency_to_channel(center_freq));
+					memcpy(ccode_channels + index_for_channel_list, channel,
+					       strlen(channel));
+					index_for_channel_list +=3D strlen(channel);
+					memcpy(ccode_channels + index_for_channel_list, " ", 1);
+					index_for_channel_list +=3D 1;
+					break;
+				}
+			}
+		}
+	}
+
+#ifdef CONFIG_USE_WIRELESS_EXT
+	rwnx_hw->support_freqs_number =3D support_freqs_counter;
+#endif
+	AICWFDBG(LOGDEBUG, "%s support channel:%s\r\n", __func__, ccode_channels)=
;
+}
