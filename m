+void remove_sec_hdr_mgmt_frame(struct hw_rxhdr *hw_rxhdr, struct sk_buff *=
skb)
+{
+	u8 hdr_len =3D 24;
+	u8 mgmt_header[24] =3D {0};
+
+	if (!hw_rxhdr->hwvect.ga_frame) {
+		if (((skb->data[0] & 0x0C) =3D=3D 0) &&
+		    (skb->data[1] & 0x40) =3D=3D 0x40) { // protect management frame
+			AICWFDBG(LOGDEBUG, "frame type %x\n", skb->data[0]);
+			if (hw_rxhdr->hwvect.decr_status =3D=3D RWNX_RX_HD_DECR_CCMP128) {
