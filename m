+static int aicwf_sdio_probe(struct sdio_func *func,
+			    const struct sdio_device_id *id)
+{
+	struct mmc_host *host;
+	struct aic_sdio_dev *sdiodev;
+	struct aicwf_bus *bus_if;
+	int err =3D -ENODEV;
+
+	AICWFDBG(LOGDEBUG, "%s:%d\n", __func__, func->num);
+	AICWFDBG(LOGDEBUG, "Class=3D%x\n", func->class);
+	AICWFDBG(LOGDEBUG, "sdio vendor ID: 0x%04x\n", func->vendor);
+	AICWFDBG(LOGDEBUG, "sdio device ID: 0x%04x\n", func->device);
+	AICWFDBG(LOGDEBUG, "Function#: %d\n", func->num);
+
+	if (!func) {
+		pr_warn("%s, NULL sdio func\n", __func__);
+		return 0;
+	}
+
+	host =3D func->card->host;
+	if (func->num !=3D 1)
+		return err;
+
+	bus_if =3D
+		kzalloc(sizeof(*bus_if), GFP_KERNEL);
+	if (!bus_if) {
+		sdio_err("alloc bus fail\n");
+		return -ENOMEM;
+	}
+
+	sdiodev =3D
+		kzalloc(sizeof(*sdiodev), GFP_KERNEL);
+	if (!sdiodev) {
+		sdio_err("alloc sdiodev fail\n");
+		kfree(bus_if);
+		return -ENOMEM;
+	}
+
+	err =3D aicwf_sdio_chipmatch(sdiodev, func->vendor, func->device);
+
+	sdiodev->func =3D func;
+	sdiodev->bus_if =3D bus_if;
+
+#ifdef CONFIG_OOB
+	if (sdiodev->chipid =3D=3D PRODUCT_ID_AIC8801) {
+		AICWFDBG(LOGERROR, "%s ERROR!!! 8801 not support OOB \r\n", __func__);
+		sdiodev->oob_enable =3D false;
+	} else {
+		sdiodev->oob_enable =3D true;
+	}
+#else
+	sdiodev->oob_enable =3D false;
+#endif
+
+	atomic_set(&sdiodev->is_bus_suspend, 0);
+	bus_if->bus_priv.sdio =3D sdiodev;
+
+	dev_set_drvdata(&func->dev, bus_if);
+	sdiodev->dev =3D &func->dev;
+
+	if (sdiodev->chipid =3D=3D PRODUCT_ID_AIC8801 || sdiodev->chipid =3D=3D P=
RODUCT_ID_AIC8800DC ||
+	    sdiodev->chipid =3D=3D PRODUCT_ID_AIC8800DW) {
+		sdiodev->func2 =3D func->card->sdio_func[1];
+	}
+
+	//sdio func init start
+	if (sdiodev->chipid !=3D PRODUCT_ID_AIC8800D80)
+		err =3D aicwf_sdio_func_init(sdiodev);
+	else
+		err =3D aicwf_sdiov3_func_init(sdiodev);
+	if (err < 0) {
+		sdio_err("sdio func init fail\n");
+		goto fail;
+	}
+	// sdio func init end
+
+	if (!aicwf_sdio_bus_init(sdiodev)) {
+		sdio_err("sdio bus init fail\n");
+		err =3D -1;
+		goto fail;
+	}
+
+	host->caps |=3D MMC_CAP_NONREMOVABLE;
+	aicwf_rwnx_sdio_platform_init(sdiodev);
+	aicwf_hostif_ready();
+#ifdef CONFIG_PLATFORM_EXTERNAL
+	regist_wakeup_irq(sdiodev);
+#else
+	err =3D rwnx_register_hostwake_irq(sdiodev->dev);
+#endif
+	if (err !=3D 0)
+		return err;
+
+#ifdef CONFIG_GPIO_WAKEUP
+#ifdef CONFIG_OOB
+	if (sdiodev->oob_enable) {
+		AICWFDBG(LOGINFO, "%s SDIOWIFI_INTR_CONFIG_REG Disable\n", __func__);
+		sdio_claim_host(sdiodev->func);
+		// disable sdio interrupt
+		err =3D aicwf_sdio_writeb(sdiodev, SDIOWIFI_INTR_CONFIG_REG, 0x0);
+		if (err < 0)
+			sdio_err("reg:%d write failed!\n", SDIOWIFI_INTR_CONFIG_REG);
+		sdio_release_irq(sdiodev->func);
+		sdio_release_host(sdiodev->func);
+	}
+#endif
+
+#ifdef CONFIG_WIFI_SUSPEND_FOR_LINUX
+	rwnx_init_wifi_suspend_node();
+#endif // CONFIG_WIFI_SUSPEND_FOR_LINUX
+#endif // CONFIG_GPIO_WAKEUP
+	device_disable_async_suspend(sdiodev->dev);
+
+	return 0;
+fail:
+	aicwf_sdio_func_deinit(sdiodev);
+	dev_set_drvdata(&func->dev, NULL);
+	kfree(sdiodev);
+	kfree(bus_if);
+	aicwf_hostif_fail();
+	return err;
+}
