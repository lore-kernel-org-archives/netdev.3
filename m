+static int airoha_ppe_v1_flow_offload_stats(struct flow_cls_offload *cls)
+{
+    flow_stats_update(&cls->stats, 0, 0, 0, jiffies,
+              FLOW_ACTION_HW_STATS_DELAYED);
+    return 0;
+}
