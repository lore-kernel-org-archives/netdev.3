+					NULL, wakeup_irq_handler,
+					IRQF_ONESHOT | IRQF_TRIGGER_HIGH,
+					"wifi_wakeup", sdiodev);
+	if (ret) {
+		AICWFDBG(LOGERROR, "Failed to request wf_wake_host %d (%d)\n",
+			 sdiodev->wf_wake_host, ret);
