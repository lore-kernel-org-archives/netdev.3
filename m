+u8 *rwnx_build_bcn(struct rwnx_bcn *bcn, struct cfg80211_beacon_data *new)
+{
+	u8 *buf, *pos;
+
+	if (new->head) {
+		u8 *head =3D kmalloc(new->head_len, GFP_KERNEL);
+
+		if (!head)
+			return NULL;
+
+		kfree(bcn->head);
+
+		bcn->head =3D head;
+		bcn->head_len =3D new->head_len;
+		memcpy(bcn->head, new->head, new->head_len);
+	}
+	if (new->tail) {
+		u8 *tail =3D kmalloc(new->tail_len, GFP_KERNEL);
+
+		if (!tail)
+			return NULL;
+
+		kfree(bcn->tail);
+
+		bcn->tail =3D tail;
+		bcn->tail_len =3D new->tail_len;
+		memcpy(bcn->tail, new->tail, new->tail_len);
+	}
+
+	if (!bcn->head)
+		return NULL;
+
+	bcn->tim_len =3D 6;
+	bcn->len =3D bcn->head_len + bcn->tail_len + bcn->ies_len + bcn->tim_len;
+
+	buf =3D kmalloc(bcn->len, GFP_KERNEL);
+	if (!buf)
+		return NULL;
+
+	// Build the beacon buffer
+	pos =3D buf;
+	memcpy(pos, bcn->head, bcn->head_len);
+	pos +=3D bcn->head_len;
+	*pos++ =3D WLAN_EID_TIM;
+	*pos++ =3D 4;
+	*pos++ =3D 0;
+	*pos++ =3D bcn->dtim;
+	*pos++ =3D 0;
+	*pos++ =3D 0;
+
+	if (bcn->tail) {
+		memcpy(pos, bcn->tail, bcn->tail_len);
+		pos +=3D bcn->tail_len;
+	}
+	if (bcn->ies)
+		memcpy(pos, bcn->ies, bcn->ies_len);
+
+	return buf;
+}
+
+static void rwnx_del_bcn(struct rwnx_bcn *bcn)
+{
+	kfree(bcn->head);
+	bcn->head =3D NULL;
+	bcn->head_len =3D 0;
+
+	kfree(bcn->tail);
+	bcn->tail =3D NULL;
+
+	bcn->tail_len =3D 0;
+
+	kfree(bcn->ies);
+	bcn->ies =3D NULL;
+	bcn->ies_len =3D 0;
+	bcn->tim_len =3D 0;
+	bcn->dtim =3D 0;
+	bcn->len =3D 0;
+}
+
+/**
+ * Link channel ctxt to a vif and thus increments count for this context.
+ */
+void rwnx_chanctx_link(struct rwnx_vif *vif, u8 ch_idx,
+		       struct cfg80211_chan_def *chandef)
+{
+	struct rwnx_chanctx *ctxt;
+
+	if (ch_idx >=3D NX_CHAN_CTXT_CNT) {
+		WARN(1, "Invalid channel ctxt id %d", ch_idx);
+		return;
+	}
+
+	vif->ch_index =3D ch_idx;
+	ctxt =3D &vif->rwnx_hw->chanctx_table[ch_idx];
+	ctxt->count++;
+
+	// For now chandef is NULL for STATION interface
+	if (chandef && !ctxt->chan_def.chan)
+		ctxt->chan_def =3D *chandef;
+}
+
+/**
+ * Unlink channel ctxt from a vif and thus decrements count for this conte=
xt
+ */
+void rwnx_chanctx_unlink(struct rwnx_vif *vif)
+{
+	struct rwnx_chanctx *ctxt;
+
+	if (vif->ch_index =3D=3D RWNX_CH_NOT_SET)
+		return;
+
+	ctxt =3D &vif->rwnx_hw->chanctx_table[vif->ch_index];
+
+	if (ctxt->count =3D=3D 0)
+		WARN(1, "Chan ctxt ref count is already 0");
+	else
+		ctxt->count--;
+
+	if (ctxt->count =3D=3D 0) {
+		if (vif->ch_index =3D=3D vif->rwnx_hw->cur_chanctx) {
+			/* If current chan ctxt is no longer linked to a vif
+			 * disable radar detection (no need to check if it was activated)
+			 */
+			rwnx_radar_detection_enable(&vif->rwnx_hw->radar,
+						    RWNX_RADAR_DETECT_DISABLE,
+						    RWNX_RADAR_RIU);
+		}
+		/* set chan to null, so that if this ctxt is relinked to a vif that
+		 * don't have channel information, don't use wrong information
+		 */
+		ctxt->chan_def.chan =3D NULL;
+	}
+	vif->ch_index =3D RWNX_CH_NOT_SET;
+}
+
+int rwnx_chanctx_valid(struct rwnx_hw *rwnx_hw, u8 ch_idx)
+{
+	if (ch_idx >=3D NX_CHAN_CTXT_CNT ||
+	    !rwnx_hw->chanctx_table[ch_idx].chan_def.chan) {
+		return 0;
+	}
+
+	return 1;
+}
+
+static void rwnx_del_csa(struct rwnx_vif *vif)
+{
+	struct rwnx_csa *csa =3D vif->ap.csa;
+
+	if (!csa)
+		return;
+
+	rwnx_del_bcn(&csa->bcn);
+	kfree(csa);
+	vif->ap.csa =3D NULL;
+}
+
+static void rwnx_csa_finish(struct work_struct *ws)
+{
+	struct rwnx_csa *csa =3D container_of(ws, struct rwnx_csa, work);
+	struct rwnx_vif *vif =3D csa->vif;
+	struct rwnx_hw *rwnx_hw =3D vif->rwnx_hw;
+	int error =3D csa->status;
+	u8 *buf, *pos;
+
+	RWNX_DBG(RWNX_FN_ENTRY_STR);
+
+	buf =3D kmalloc(csa->bcn.len, GFP_KERNEL);
+	if (!buf) {
+		AICWFDBG(LOGDEBUG, "AICWF %s buf fail\n", __func__);
+		return;
+	}
+	pos =3D buf;
+
+	memcpy(pos, csa->bcn.head, csa->bcn.head_len);
+	pos +=3D csa->bcn.head_len;
+	*pos++ =3D WLAN_EID_TIM;
+	*pos++ =3D 4;
+	*pos++ =3D 0;
+	*pos++ =3D csa->bcn.dtim;
+	*pos++ =3D 0;
+	*pos++ =3D 0;
+	if (csa->bcn.tail) {
+		memcpy(pos, csa->bcn.tail, csa->bcn.tail_len);
+		pos +=3D csa->bcn.tail_len;
+	}
+	if (csa->bcn.ies)
+		memcpy(pos, csa->bcn.ies, csa->bcn.ies_len);
+
+	if (!error) {
+		error =3D rwnx_send_bcn(rwnx_hw, buf, vif->vif_index, csa->bcn.len);
+		if (error)
+			return;
+		error =3D rwnx_send_bcn_change(rwnx_hw, vif->vif_index, 0, csa->bcn.len,
+					     csa->bcn.head_len, csa->bcn.tim_len, NULL);
+	}
+
+	if (error) {
+		cfg80211_stop_iface(rwnx_hw->wiphy, &vif->wdev, GFP_KERNEL);
+	} else {
+		wiphy_lock(rwnx_hw->wiphy);
+		spin_lock_bh(&rwnx_hw->cb_lock);
+		rwnx_chanctx_unlink(vif);
+		rwnx_chanctx_link(vif, csa->ch_idx, &csa->chandef);
+		if (rwnx_hw->cur_chanctx =3D=3D csa->ch_idx) {
+			rwnx_radar_detection_enable_on_cur_channel(rwnx_hw);
+			rwnx_txq_vif_start(vif, RWNX_TXQ_STOP_CHAN, rwnx_hw);
+		} else {
+			rwnx_txq_vif_stop(vif, RWNX_TXQ_STOP_CHAN, rwnx_hw);
+		}
+		spin_unlock_bh(&rwnx_hw->cb_lock);
+		cfg80211_ch_switch_notify(vif->ndev, &csa->chandef, 0);
+		wiphy_unlock(rwnx_hw->wiphy);
+	}
+
+	rwnx_del_csa(vif);
+}
