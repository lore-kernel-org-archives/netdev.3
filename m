+static void rwnx_ie_build_ht_cap(struct sk_buff *skb,
+				 struct ieee80211_sta_ht_cap *ht_cap, u16 cap)
+{
+	u8 *pos;
+	__le16 tmp;
+
+	pos =3D skb_put(skb, sizeof(struct ieee80211_ht_cap) + 2);
+	*pos++ =3D WLAN_EID_HT_CAPABILITY;
+	*pos++ =3D sizeof(struct ieee80211_ht_cap);
+	memset(pos, 0, sizeof(struct ieee80211_ht_cap));
+
+	/* capability flags */
+	tmp =3D cpu_to_le16(cap);
+	memcpy(pos, &tmp, sizeof(u16));
+	pos +=3D sizeof(u16);
+
+	/* AMPDU parameters */
+	*pos++ =3D ht_cap->ampdu_factor |
+			 (ht_cap->ampdu_density << IEEE80211_HT_AMPDU_PARM_DENSITY_SHIFT);
+
+	/* MCS set */
+	memcpy(pos, &ht_cap->mcs, sizeof(ht_cap->mcs));
+	pos +=3D sizeof(ht_cap->mcs);
+
+	/* extended capabilities */
+	pos +=3D sizeof(__le16);
+
+	/* BF capabilities */
+	pos +=3D sizeof(__le32);
+
+	/* antenna selection */
+	pos +=3D sizeof(u8);
+}
+
+static void rwnx_ie_build_vht_cap(struct sk_buff *skb,
+				  struct ieee80211_sta_vht_cap *vht_cap,
+				  u32 cap)
+{
+	u8 *pos;
+	__le32 tmp;
+
+	pos =3D skb_put(skb, 14);
+
+	*pos++ =3D WLAN_EID_VHT_CAPABILITY;
+	*pos++ =3D sizeof(struct ieee80211_vht_cap);
+	memset(pos, 0, sizeof(struct ieee80211_vht_cap));
+
+	/* capability flags */
+	tmp =3D cpu_to_le32(cap);
+	memcpy(pos, &tmp, sizeof(u32));
+	pos +=3D sizeof(u32);
+
+	/* VHT MCS set */
+	memcpy(pos, &vht_cap->vht_mcs, sizeof(vht_cap->vht_mcs));
+	pos +=3D sizeof(vht_cap->vht_mcs);
+}
