+	if (rwnx_hw->roc_cookie_cnt =3D=3D 0)
+		rwnx_hw->roc_cookie_cnt =3D 1;
+
+	/* Free the allocated RoC element */
+	kfree(roc_elem);
+	rwnx_hw->roc_elem =3D NULL;
+
+#endif /* CONFIG_RWNX_FULLMAC */
+	return 0;
