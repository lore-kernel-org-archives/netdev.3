+u8 crc8_ponl_107(u8 *p_buffer, u16 cal_size)
+{
+	u8 i;
+	u8 crc =3D 0;
+
+	if (cal_size =3D=3D 0)
+		return crc;
+	while (cal_size--) {
+		for (i =3D 0x80; i > 0; i /=3D 2) {
+			if (crc & 0x80) {
+				crc *=3D 2;
+				crc ^=3D 0x07; // polynomial X8 + X2 + X + 1,(0x107)
+			} else {
+				crc *=3D 2;
+			}
+			if ((*p_buffer) & i)
+				crc ^=3D 0x07;
+		}
+		p_buffer++;
+	}
+	return crc;
+}
