+	list_for_each_entry(vif, &rwnx_hw->vifs, list) {
+		if (vif->vif_index =3D=3D ind->vif_index) {
+			found =3D true;
+			break;
+		}
+	}
+
+	if (found) {
+#ifdef CONFIG_RWNX_FULLMAC
+		if (vif->ap.csa)
+			vif->ap.csa->count =3D ind->csa_count;
+		else
+			netdev_err(vif->ndev, "CSA counter update but no active CSA");
+
+#endif
+	}
